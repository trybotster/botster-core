{
  "id": "conf::a2_1_read_of_created_or_lost_is_wrong_state",
  "contract": "core",
  "clause": "A2-1",
  "subject": "core",
  "requires": {
    "controls": [
      "lose_worker"
    ]
  },
  "steps": [
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s1",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ]
            }
          }
        }
      },
      "bind": "$c_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$c_s1",
            "result": {
              "ok": {
                "record": {
                  "id": "s1",
                  "state": "Created"
                }
              }
            }
          }
        }
      },
      "because": "Core LC-3"
    },
    {
      "begin": {
        "op": {
          "ReadScreen": {
            "session": "s1",
            "history": false
          }
        }
      },
      "bind": "$x0",
      "expect_error": {
        "code": "WrongState"
      },
      "because": [
        "Core A2-1",
        "Core ER-0"
      ]
    },
    {
      "begin": {
        "op": {
          "ReadCursor": {
            "session": "s1"
          }
        }
      },
      "bind": "$x1",
      "expect_error": {
        "code": "WrongState"
      },
      "because": [
        "Core A2-1",
        "Core ER-0"
      ]
    },
    {
      "begin": {
        "op": {
          "ReadModeFlags": {
            "session": "s1"
          }
        }
      },
      "bind": "$x2",
      "expect_error": {
        "code": "WrongState"
      },
      "because": [
        "Core A2-1",
        "Core ER-0"
      ]
    },
    {
      "begin": {
        "op": {
          "CaptureSnapshot": {
            "session": "s1",
            "owner": "c1"
          }
        }
      },
      "bind": "$x3",
      "expect_error": {
        "code": "WrongState"
      },
      "because": [
        "Core A2-1",
        "Core ER-0"
      ]
    },
    {
      "begin": {
        "op": {
          "ReadFacts": {
            "session": "s1"
          }
        }
      },
      "bind": "$x4",
      "expect_error": {
        "code": "WrongState"
      },
      "because": [
        "Core A2-1",
        "Core ER-0"
      ]
    },
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s2",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ]
            }
          }
        }
      },
      "bind": "$c_s2"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$c_s2",
            "result": {
              "ok": {
                "record": {
                  "id": "s2",
                  "state": "Created"
                }
              }
            }
          }
        }
      },
      "because": "Core LC-3"
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "s2"
          }
        }
      },
      "bind": "$s_s2"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$s_s2",
            "result": {
              "ok": {
                "record": {
                  "id": "s2",
                  "state": "Running"
                }
              }
            }
          }
        }
      },
      "because": "Core A2-1"
    },
    {
      "control": {
        "op": "lose_worker",
        "session": "s2",
        "reason": "worker_gone"
      }
    },
    {
      "pump_until": {
        "event": {
          "SessionState": {
            "id": "s2",
            "state": {
              "Lost": {
                "$any": true
              }
            }
          }
        }
      },
      "because": "Core AD-2"
    },
    {
      "begin": {
        "op": {
          "ReadScreen": {
            "session": "s2",
            "history": false
          }
        }
      },
      "bind": "$x0",
      "expect_error": {
        "code": "WrongState"
      },
      "because": [
        "Core A2-1",
        "Core ER-0"
      ]
    },
    {
      "begin": {
        "op": {
          "ReadCursor": {
            "session": "s2"
          }
        }
      },
      "bind": "$x1",
      "expect_error": {
        "code": "WrongState"
      },
      "because": [
        "Core A2-1",
        "Core ER-0"
      ]
    },
    {
      "begin": {
        "op": {
          "ReadModeFlags": {
            "session": "s2"
          }
        }
      },
      "bind": "$x2",
      "expect_error": {
        "code": "WrongState"
      },
      "because": [
        "Core A2-1",
        "Core ER-0"
      ]
    },
    {
      "begin": {
        "op": {
          "CaptureSnapshot": {
            "session": "s2",
            "owner": "c1"
          }
        }
      },
      "bind": "$x3",
      "expect_error": {
        "code": "WrongState"
      },
      "because": [
        "Core A2-1",
        "Core ER-0"
      ]
    },
    {
      "begin": {
        "op": {
          "ReadFacts": {
            "session": "s2"
          }
        }
      },
      "bind": "$x4",
      "expect_error": {
        "code": "WrongState"
      },
      "because": [
        "Core A2-1",
        "Core ER-0"
      ]
    }
  ]
}

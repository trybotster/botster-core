{
  "id": "conf::lc_6_signal_reaches_group",
  "contract": "core",
  "clause": "LC-6",
  "subject": "core",
  "requires": {
    "controls": [
      "descendants"
    ]
  },
  "steps": [
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s1",
            "request": {
              "program": [
                {
                  "fork_child": {
                    "script": [
                      {
                        "hold": {}
                      }
                    ]
                  }
                },
                {
                  "print": {
                    "bytes_hex": "2a"
                  }
                },
                {
                  "hold": {}
                }
              ]
            }
          }
        }
      },
      "bind": "$c_s1"
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "s1"
          }
        }
      },
      "bind": "$s_s1"
    },
    {
      "pump_collect": {
        "events": [
          {
            "Completed": {
              "op": "$s_s1",
              "result": {}
            }
          },
          {
            "Activity": {
              "id": "s1",
              "source": "Output"
            }
          }
        ]
      },
      "because": [
        "Core LC-3",
        "Core A5-1",
        "Core LC-6"
      ]
    },
    {
      "control": {
        "op": "descendants",
        "session": "s1"
      },
      "expect": {
        "alive": 1
      },
      "because": "Core LC-6"
    },
    {
      "begin": {
        "op": {
          "Signal": {
            "id": "s1",
            "sig": "kill"
          }
        }
      },
      "bind": "$g"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$g",
            "result": {
              "ok": "unit"
            }
          }
        }
      },
      "because": [
        "Core LC-6",
        "Core A2-1"
      ]
    },
    {
      "pump_until": {
        "event": {
          "SessionState": {
            "id": "s1",
            "state": {
              "Exited": {
                "signal": 9,
                "cause": "HostStop"
              }
            }
          }
        }
      },
      "because": [
        "Core LC-6",
        "Core A2-1",
        "Core EV-4"
      ]
    },
    {
      "control": {
        "op": "descendants",
        "session": "s1"
      },
      "expect": {
        "alive": 0
      },
      "because": "Core LC-6"
    }
  ]
}

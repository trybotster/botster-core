{
  "id": "conf::ev_8_core_has_no_other_query_timer",
  "contract": "core",
  "clause": "EV-8",
  "subject": "core",
  "requires": {
    "controls": [
      "edges_quiet",
      "pty_input",
      "pty_output"
    ]
  },
  "fake": "structural",
  "ruling": "R-12",
  "steps": [
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s1",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ]
            }
          }
        }
      },
      "bind": "$c_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$c_s1",
            "result": {
              "ok": {
                "record": {
                  "id": "s1",
                  "state": "Created"
                }
              }
            }
          }
        }
      },
      "because": "Core LC-3"
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "s1"
          }
        }
      },
      "bind": "$s_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$s_s1",
            "result": {
              "ok": {
                "record": {
                  "id": "s1",
                  "state": "Running"
                }
              }
            }
          }
        }
      },
      "because": "Core A2-1"
    },
    {
      "attach_route": {
        "route": "r1",
        "session": "s1",
        "client": "c1",
        "options": {
          "history": "none",
          "answers_queries": true,
          "query_deadline": 60000
        }
      },
      "because": "Core OU-1"
    },
    {
      "expect": {
        "frame": "attached",
        "terminal_format": {
          "$type": "string"
        }
      },
      "because": "Core OU-9",
      "on": "r1"
    },
    {
      "expect": {
        "frame": "baseline_begin",
        "rows": {
          "$type": "integer"
        },
        "cols": {
          "$type": "integer"
        },
        "modes": {
          "$type": "object"
        }
      },
      "because": "Core OU-9",
      "on": "r1"
    },
    {
      "expect": {
        "frame": "screen",
        "payload": {
          "$any": true
        }
      },
      "because": "Core OU-9",
      "on": "r1"
    },
    {
      "expect_eventually": {
        "frame": "baseline_end",
        "history": "not_requested"
      },
      "because": "Core OU-9",
      "ignore": [
        {
          "frame": "history",
          "payload": {
            "$any": true
          }
        }
      ],
      "on": "r1"
    },
    {
      "expect": {
        "frame": "live"
      },
      "because": "Core OU-9",
      "on": "r1"
    },
    {
      "control": {
        "op": "pty_output",
        "session": "s1",
        "bytes_hex": "1b5b63"
      }
    },
    {
      "await_quiet": {}
    },
    {
      "expect_eventually": {
        "frame": "terminal_query",
        "query_id": "$q"
      },
      "because": [
        "Core EV-8",
        "Core DP-3"
      ],
      "ignore": [
        {
          "$any": true
        }
      ],
      "on": "r1"
    },
    {
      "call": {
        "method": "next_deadline"
      },
      "expect": null,
      "because": [
        "Core EV-8",
        "Core TM-3"
      ]
    },
    {
      "advance_clock": {
        "ms": 3600000
      }
    },
    {
      "pump": {},
      "expect": {
        "more": false,
        "events_posted": 0
      },
      "because": [
        "Core EV-8",
        "Core TM-3"
      ]
    },
    {
      "call": {
        "method": "next_deadline"
      },
      "expect": null,
      "because": [
        "Core EV-8",
        "Core TM-3"
      ]
    },
    {
      "control": {
        "op": "pty_input",
        "session": "s1"
      },
      "expect": {
        "bytes": {
          "$bytes_hex": ""
        }
      },
      "because": [
        "Core EV-8"
      ]
    }
  ]
}

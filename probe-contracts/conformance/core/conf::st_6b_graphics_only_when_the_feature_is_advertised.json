{
  "id": "conf::st_6b_graphics_only_when_the_feature_is_advertised",
  "contract": "core",
  "clause": "ST-6b",
  "subject": "core",
  "requires": {
    "controls": [
      "edges_quiet",
      "oracle_graphics",
      "pty_output"
    ]
  },
  "fake": "structural",
  "ruling": "R-12",
  "steps": [
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s1",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ]
            }
          }
        }
      },
      "bind": "$c_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$c_s1",
            "result": {
              "ok": {
                "record": {
                  "id": "s1",
                  "state": "Created"
                }
              }
            }
          }
        }
      },
      "because": "Core LC-3"
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "s1"
          }
        }
      },
      "bind": "$s_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$s_s1",
            "result": {
              "ok": {
                "record": {
                  "id": "s1",
                  "state": "Running"
                }
              }
            }
          }
        }
      },
      "because": "Core A2-1"
    },
    {
      "call": {
        "method": "get",
        "args": {
          "id": "s1"
        }
      },
      "bind_fields": {
        "worker_features": "$wf"
      }
    },
    {
      "let": {
        "$adv": {
          "contains": [
            "$wf",
            "snapshot_graphics"
          ]
        }
      }
    },
    {
      "drain": {}
    },
    {
      "advance_clock": {
        "unix": 5000
      }
    },
    {
      "control": {
        "op": "pty_output",
        "session": "s1",
        "bytes_hex": "1b5f47663d32342c733d312c763d312c613d543b414141411b5c"
      }
    },
    {
      "await_quiet": {}
    },
    {
      "begin": {
        "op": {
          "CaptureSnapshot": {
            "session": "s1",
            "owner": "c1"
          }
        }
      },
      "bind": "$k_cap"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$k_cap",
            "result": {
              "ok": {
                "capture": {
                  "capture": "$cap"
                }
              }
            }
          }
        }
      },
      "because": "Core ST-6"
    },
    {
      "control": {
        "op": "oracle_graphics",
        "session": "s1",
        "capture": "$cap"
      },
      "bind_fields": {
        "model_holds_images": "$mh",
        "images_in_baseline": "$ib"
      },
      "because": [
        "Core ST-6b"
      ]
    },
    {
      "check": {
        "eq": [
          "$mh",
          "$adv"
        ]
      },
      "because": [
        "Core ST-6b"
      ]
    },
    {
      "check": {
        "eq": [
          "$ib",
          "$adv"
        ]
      },
      "because": [
        "Core ST-6b"
      ]
    }
  ]
}

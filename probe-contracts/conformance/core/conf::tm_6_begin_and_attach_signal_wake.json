{
  "id": "conf::tm_6_begin_and_attach_signal_wake",
  "contract": "core",
  "clause": "TM-6",
  "subject": "core",
  "requires": {
    "controls": [
      "no_spurious_wakes",
      "pty_blocked"
    ]
  },
  "fake": "structural",
  "ruling": "R-12",
  "steps": [
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s1",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ]
            }
          }
        }
      },
      "bind": "$c_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$c_s1",
            "result": {
              "ok": {
                "record": {
                  "id": "s1",
                  "state": "Created"
                }
              }
            }
          }
        }
      },
      "because": "Core LC-3"
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "s1"
          }
        }
      },
      "bind": "$s_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$s_s1",
            "result": {
              "ok": {
                "record": {
                  "id": "s1",
                  "state": "Running"
                }
              }
            }
          }
        }
      },
      "because": "Core A2-1"
    },
    {
      "control": {
        "op": "no_spurious_wakes"
      }
    },
    {
      "pump_idle": {}
    },
    {
      "wait_wake": {
        "timeout_ms": 0
      },
      "expect": "TimedOut",
      "because": [
        "Core TM-6"
      ]
    },
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s2",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ]
            }
          }
        }
      },
      "bind": "$c_s2"
    },
    {
      "wait_wake": {
        "timeout_ms": 0
      },
      "expect": "Woken",
      "because": [
        "Core TM-6"
      ]
    },
    {
      "pump_idle": {}
    },
    {
      "wait_wake": {
        "timeout_ms": 0
      },
      "expect": "TimedOut",
      "because": [
        "Core TM-6"
      ]
    },
    {
      "attach_route": {
        "route": "r1",
        "session": "s1"
      }
    },
    {
      "wait_wake": {
        "timeout_ms": 0
      },
      "expect": "Woken",
      "because": [
        "Core TM-6"
      ]
    },
    {
      "pump_idle": {}
    },
    {
      "wait_wake": {
        "timeout_ms": 0
      },
      "expect": "TimedOut",
      "because": [
        "Core TM-6"
      ]
    },
    {
      "control": {
        "op": "pty_blocked",
        "session": "s1",
        "on": true
      }
    },
    {
      "begin": {
        "op": {
          "WriteInput": {
            "session": "s1",
            "payload": {
              "bytes": {
                "bytes": {
                  "$bytes_hex": "61"
                }
              }
            }
          }
        }
      },
      "bind": "$w"
    },
    {
      "pump_idle": {}
    },
    {
      "wait_wake": {
        "timeout_ms": 0
      },
      "expect": "TimedOut",
      "because": [
        "Core TM-6"
      ]
    },
    {
      "call": {
        "method": "cancel",
        "args": {
          "op": "$w"
        }
      },
      "expect": "Admitted",
      "because": [
        "Core TM-6",
        "Core IN-6"
      ]
    },
    {
      "wait_wake": {
        "timeout_ms": 0
      },
      "expect": "Woken",
      "because": [
        "Core TM-6",
        "Core IN-6"
      ]
    }
  ]
}

{
  "id": "conf::in_6_cancel_reports_progress",
  "contract": "core",
  "clause": "IN-6",
  "subject": "core",
  "requires": {
    "controls": [
      "pty_chunk",
      "pty_input"
    ]
  },
  "steps": [
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s1",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ]
            }
          }
        }
      },
      "bind": "$c_s1"
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "s1"
          }
        }
      },
      "bind": "$s_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$s_s1",
            "result": {}
          }
        }
      },
      "because": "Core LC-3"
    },
    {
      "control": {
        "op": "pty_chunk",
        "session": "s1",
        "bytes": 1
      }
    },
    {
      "begin": {
        "op": {
          "WriteInput": {
            "session": "s1",
            "payload": {
              "bytes": {
                "bytes": {
                  "$bytes_hex": "6162636465"
                }
              }
            }
          }
        }
      },
      "bind": "$w"
    },
    {
      "await_pty": {
        "session": "s1",
        "min_bytes": 1
      }
    },
    {
      "call": {
        "method": "cancel",
        "args": {
          "op": "$w"
        }
      },
      "expect": "Admitted",
      "because": "Core IN-6"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$w",
            "result": {
              "ok": {
                "input": {
                  "outcome": {
                    "$one_of": [
                      "Partial",
                      "Cancelled"
                    ]
                  },
                  "payload_bytes_written": "$p",
                  "pty_bytes_written": "$q"
                }
              }
            }
          }
        }
      },
      "because": "Core IN-6"
    },
    {
      "control": {
        "op": "pty_input",
        "session": "s1"
      },
      "expect": {
        "bytes": "$log"
      },
      "because": "Core IN-6"
    },
    {
      "check": {
        "hex_len_eq": [
          "$log",
          "$p"
        ]
      },
      "because": "Core IN-6"
    },
    {
      "check": {
        "eq": [
          "$p",
          "$q"
        ]
      },
      "because": "Core IN-6"
    }
  ]
}

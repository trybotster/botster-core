{
  "id": "conf::in_5_oversize_payload_is_payload_too_large",
  "contract": "core",
  "clause": "IN-5",
  "subject": "core",
  "setup": {
    "limits": {
      "max_paste_bytes": 1024,
      "max_route_frame_bytes": 1048576
    }
  },
  "steps": [
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s1",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ]
            }
          }
        }
      },
      "bind": "$c_s1"
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "s1"
          }
        }
      },
      "bind": "$s_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$s_s1",
            "result": {}
          }
        }
      },
      "because": "Core LC-3"
    },
    {
      "begin": {
        "op": {
          "WriteInput": {
            "session": "s1",
            "payload": {
              "bytes": {
                "bytes": {
                  "$bytes_hex": ""
                }
              }
            }
          }
        }
      },
      "bind": "$big",
      "expect_error": {
        "code": "PayloadTooLarge"
      },
      "because": [
        "Core IN-5",
        "Core ER-0"
      ]
    },
    {
      "begin": {
        "op": {
          "WriteInput": {
            "session": "s1",
            "payload": {
              "bytes": {
                "bytes": {
                  "$bytes_hex": ""
                }
              }
            }
          }
        }
      },
      "bind": "$ok"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$ok",
            "result": {
              "ok": {
                "input": {
                  "outcome": {
                    "$any": true
                  }
                }
              }
            }
          }
        }
      },
      "because": "Core IN-5"
    }
  ]
}

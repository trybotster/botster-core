{
  "id": "conf::in_9_text_is_one_transaction_and_utf8",
  "contract": "core",
  "clause": "IN-9",
  "subject": "core",
  "requires": {
    "controls": [
      "pty_chunk",
      "pty_input"
    ]
  },
  "steps": [
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s1",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ]
            }
          }
        }
      },
      "bind": "$c_s1"
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "s1"
          }
        }
      },
      "bind": "$s_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$s_s1",
            "result": {}
          }
        }
      },
      "because": "Core LC-3"
    },
    {
      "attach_route": {
        "route": "r1",
        "session": "s1",
        "client": "c1"
      },
      "because": "Core OU-1"
    },
    {
      "expect": {
        "frame": "attached",
        "terminal_format": {
          "$type": "string"
        }
      },
      "on": "r1",
      "because": "Core OU-9"
    },
    {
      "expect": {
        "frame": "baseline_begin",
        "rows": {
          "$type": "integer"
        },
        "cols": {
          "$type": "integer"
        },
        "modes": {
          "$type": "object"
        }
      },
      "on": "r1",
      "because": "Core OU-9"
    },
    {
      "expect": {
        "frame": "screen",
        "payload": {
          "$any": true
        }
      },
      "on": "r1",
      "because": "Core OU-9"
    },
    {
      "expect_eventually": {
        "frame": "baseline_end",
        "history": "not_requested"
      },
      "ignore": [
        {
          "frame": "history",
          "payload": {
            "$any": true
          }
        }
      ],
      "on": "r1",
      "because": "Core OU-9"
    },
    {
      "expect": {
        "frame": "live"
      },
      "on": "r1",
      "because": "Core OU-9"
    },
    {
      "begin": {
        "op": {
          "WriteInput": {
            "session": "s1",
            "payload": {
              "text": {
                "text": "héllo"
              }
            }
          }
        }
      },
      "bind": "$t"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$t",
            "result": {
              "ok": {
                "input": {
                  "outcome": "Written",
                  "payload_bytes_written": 6,
                  "pty_bytes_written": 6
                }
              }
            }
          }
        }
      },
      "because": [
        "Core 5.1A",
        "Core IN-2"
      ]
    },
    {
      "control": {
        "op": "pty_chunk",
        "session": "s1",
        "bytes": 1
      }
    },
    {
      "begin": {
        "op": {
          "WriteInput": {
            "session": "s1",
            "payload": {
              "text": {
                "text": "héllo"
              }
            }
          }
        }
      },
      "bind": "$u"
    },
    {
      "await_pty": {
        "session": "s1",
        "min_bytes": 7
      }
    },
    {
      "route_send": {
        "frame": "bytes",
        "op": "1",
        "bytes": {
          "$bytes_hex": "7a"
        }
      },
      "route": "r1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$u",
            "result": {
              "ok": {
                "input": {
                  "outcome": {
                    "$any": true
                  }
                }
              }
            }
          }
        }
      },
      "because": "Core 5.1A"
    },
    {
      "control": {
        "op": "pty_input",
        "session": "s1"
      },
      "expect": {
        "bytes": "$log"
      },
      "because": [
        "Core 5.1A",
        "Core AM-2"
      ]
    },
    {
      "check": {
        "hex_ends_with": [
          "$log",
          "7a"
        ]
      },
      "because": [
        "Core 5.1A",
        "Core AM-2"
      ]
    }
  ]
}

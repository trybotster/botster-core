{
  "id": "conf::lc_11_adoptall_posts_a_state_for_every_row",
  "contract": "core",
  "clause": "LC-11",
  "subject": "core",
  "steps": [
    {
      "begin": {
        "op": {
          "Create": {
            "session": "c1",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ]
            }
          }
        }
      },
      "bind": "$c"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$c",
            "result": {}
          }
        }
      },
      "because": "Core LC-3"
    },
    {
      "begin": {
        "op": {
          "Create": {
            "session": "r1",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ]
            }
          }
        }
      },
      "bind": "$c_r1"
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "r1"
          }
        }
      },
      "bind": "$s_r1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$s_r1",
            "result": {}
          }
        }
      },
      "because": "Core LC-3"
    },
    {
      "begin": {
        "op": {
          "Create": {
            "session": "x1",
            "request": {
              "program": [
                {
                  "exit": {
                    "code": 0
                  }
                }
              ]
            }
          }
        }
      },
      "bind": "$c_x1"
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "x1"
          }
        }
      },
      "bind": "$s_x1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$s_x1",
            "result": {}
          }
        }
      },
      "because": "Core LC-3"
    },
    {
      "pump_until": {
        "event": {
          "SessionState": {
            "id": "x1",
            "state": {
              "Exited": {
                "$any": true
              }
            }
          }
        }
      },
      "because": "Core EV-4"
    },
    {
      "drop": {
        "handle": "h"
      }
    },
    {
      "open": {
        "as": "h2"
      }
    },
    {
      "begin": {
        "op": "AdoptAll",
        "handle": "h2"
      },
      "bind": "$ad"
    },
    {
      "expect_set": [
        {
          "SessionState": {
            "id": "c1",
            "state": "Created"
          }
        },
        {
          "SessionState": {
            "id": "r1",
            "state": "Running"
          }
        },
        {
          "SessionState": {
            "id": "x1",
            "state": {
              "Exited": {
                "$any": true
              }
            }
          }
        },
        {
          "Completed": {
            "op": "$ad",
            "result": {
              "ok": "unit"
            }
          }
        }
      ],
      "because": [
        "Core LC-11",
        "Core AD-1"
      ],
      "on": {
        "handle": "h2"
      }
    }
  ]
}

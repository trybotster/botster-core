    {
      "pump_until": {
        "event": {
          "ModesChanged": {
            "id": "s2",
            "flags": {
              "bracketed_paste": true
            }
          }
        }
      },
      "because": "Core EV-7"
    },
    {
      "begin": {
        "op": {
          "WriteInput": {
            "session": "s2",
            "payload": {
              "paste": {
                "bytes": {
                  "$bytes_hex": "68656c6c6f"
                },
                "require_bracketed": false
              }
            }
          }
        }
      },
      "bind": "$on"

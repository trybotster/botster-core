{
  "id": "conf::in_8_paste_wraps_by_mode",
  "contract": "core",
  "clause": "IN-8",
  "subject": "core",
  "steps": [
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s1",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ],
              "fake": {
                "writes": {
                  "paste": "1b5b3230307e68656c6c6f1b5b3230317e"
                }
              }
            }
          }
        }
      },
      "bind": "$c_s1"
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "s1"
          }
        }
      },
      "bind": "$s_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$s_s1",
            "result": {}
          }
        }
      },
      "because": "Core LC-3"
    },
    {
      "begin": {
        "op": {
          "WriteInput": {
            "session": "s1",
            "payload": {
              "paste": {
                "bytes": {
                  "$bytes_hex": "68656c6c6f"
                },
                "require_bracketed": false
              }
            }
          }
        }
      },
      "bind": "$off"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$off",
            "result": {
              "ok": {
                "input": {
                  "outcome": "Written",
                  "payload_bytes_written": 5,
                  "pty_bytes_written": 5
                }
              }
            }
          }
        }
      },
      "because": [
        "Core IN-8",
        "Core IN-2"
      ]
    },
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s2",
            "request": {
              "program": [
                {
                  "print": {
                    "bytes_hex": "1b5b3f3230303468",
                    "fake": {
                      "modes": {
                        "bracketed_paste": true
                      }
                    }
                  }
                },
                {
                  "hold": {}
                }
              ],
              "fake": {
                "writes": {
                  "paste": "1b5b3230307e68656c6c6f1b5b3230317e"
                }
              }
            }
          }
        }
      },
      "bind": "$c_s2"
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "s2"
          }
        }
      },
      "bind": "$s_s2"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$s_s2",
            "result": {}
          }
        }
      },
      "because": "Core LC-3"

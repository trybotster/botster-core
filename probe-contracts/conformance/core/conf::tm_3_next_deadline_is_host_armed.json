{
  "id": "conf::tm_3_next_deadline_is_host_armed",
  "contract": "core",
  "clause": "TM-3",
  "subject": "core",
  "requires": {
    "features": [
      "silence"
    ],
    "controls": [
      "pty_output"
    ]
  },
  "setup": {
    "limits": {
      "capture_ttl": 1000
    }
  },
  "fake": "structural",
  "ruling": "R-12",
  "steps": [
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s1",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ]
            }
          }
        }
      },
      "bind": "$c_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$c_s1",
            "result": {
              "ok": {
                "record": {
                  "id": "s1",
                  "state": "Created"
                }
              }
            }
          }
        }
      },
      "because": "Core LC-3"
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "s1"
          }
        }
      },
      "bind": "$s_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$s_s1",
            "result": {
              "ok": {
                "record": {
                  "id": "s1",
                  "state": "Running"
                }
              }
            }
          }
        }
      },
      "because": "Core A2-1"
    },
    {
      "drain": {}
    },
    {
      "call": {
        "method": "next_deadline"
      },
      "expect": null,
      "because": [
        "Core TM-3"
      ]
    },
    {
      "drain": {}
    },
    {
      "advance_clock": {
        "unix": 7000
      }
    },
    {
      "control": {
        "op": "pty_output",
        "session": "s1",
        "bytes_hex": "78"
      }
    },
    {
      "pump_until": {
        "event": {
          "Activity": {
            "id": "s1",
            "source": "Output",
            "at": 7000
          }
        }
      },
      "because": [
        "Core 6.2",
        "Core TM-1"
      ]
    },
    {
      "call": {
        "method": "set_silence_threshold",
        "args": {
          "id": "s1",
          "ms": 3000
        }
      }
    },
    {
      "call": {
        "method": "next_deadline"
      },
      "expect": {
        "in_ms": 3000
      },
      "because": [
        "Core TM-3",
        "Core TM-4"
      ]
    },
    {
      "begin": {
        "op": {
          "CaptureSnapshot": {
            "session": "s1",
            "owner": "c1"
          }
        }
      },
      "bind": "$k"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$k",
            "result": {
              "ok": {
                "capture": {
                  "capture": "$cap"
                }
              }
            }
          }
        }
      },
      "because": "Core ST-6"
    },
    {
      "call": {
        "method": "next_deadline"
      },
      "expect": {
        "in_ms": 1000
      },
      "because": [
        "Core TM-3",
        "Core ST-6"
      ]
    },
    {
      "call": {
        "method": "release",
        "args": {
          "capture": "$cap"
        }
      }
    },
    {
      "call": {
        "method": "next_deadline"
      },
      "expect": {
        "in_ms": 3000
      },
      "because": [
        "Core TM-3",
        "Core TM-4"
      ]
    },
    {
      "advance_clock": {
        "ms": 500
      }
    },
    {
      "call": {
        "method": "next_deadline"
      },
      "expect": {
        "in_ms": 2500
      },
      "because": [
        "Core TM-3",
        "Core TM-1"
      ]
    }
  ]
}

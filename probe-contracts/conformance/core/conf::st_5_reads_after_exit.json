{
  "id": "conf::st_5_reads_after_exit",
  "contract": "core",
  "clause": "ST-5",
  "subject": "core",
  "requires": {
    "controls": [
      "oracle_screen"
    ]
  },
  "fake": "structural",
  "ruling": "R-12",
  "steps": [
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s1",
            "request": {
              "program": [
                {
                  "print": {
                    "bytes_hex": "627965"
                  }
                },
                {
                  "exit": {
                    "code": 0
                  }
                }
              ],
              "size": {
                "rows": 10,
                "cols": 40
              }
            }
          }
        }
      },
      "bind": "$c_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$c_s1",
            "result": {
              "ok": {
                "record": {
                  "id": "s1",
                  "state": "Created"
                }
              }
            }
          }
        }
      },
      "because": "Core LC-3"
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "s1"
          }
        }
      },
      "bind": "$s_s1"
    },
    {
      "pump_collect": {
        "events": [
          {
            "Completed": {
              "op": "$s_s1",
              "result": {
                "ok": {
                  "record": {
                    "id": "s1",
                    "state": "Running"
                  }
                }
              }
            }
          },
          {
            "SessionState": {
              "id": "s1",
              "state": {
                "Exited": {
                  "code": 0
                }
              }
            }
          }
        ]
      },
      "because": "Core LC-5"
    },
    {
      "control": {
        "op": "oracle_screen",
        "session": "s1",
        "history": false
      },
      "bind_fields": {
        "text": "$t"
      }
    },
    {
      "begin": {
        "op": {
          "ReadScreen": {
            "session": "s1",
            "history": false
          }
        }
      },
      "bind": "$a"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$a",
            "result": {
              "ok": {
                "screen": {
                  "text": "$t"
                }
              }
            }
          }
        }
      },
      "because": [
        "Core ST-5",
        "Core LC-5"
      ]
    },
    {
      "begin": {
        "op": {
          "ReadCursor": {
            "session": "s1"
          }
        }
      },
      "bind": "$b"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$b",
            "result": {
              "ok": {
                "cursor": {
                  "model_rev": {
                    "$type": "u64"
                  }
                }
              }
            }
          }
        }
      },
      "because": [
        "Core ST-5"
      ]
    },
    {
      "begin": {
        "op": {
          "CaptureSnapshot": {
            "session": "s1",
            "owner": "c1"
          }
        }
      },
      "bind": "$c"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$c",
            "result": {
              "ok": {
                "capture": {
                  "capture": {
                    "$type": "u64"
                  }
                }
              }
            }
          }
        }
      },
      "because": [
        "Core ST-5"
      ]
    },
    {
      "begin": {
        "op": {
          "Remove": {
            "id": "s1"
          }
        }
      },
      "bind": "$rm"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$rm",
            "result": {}
          }
        }
      },
      "because": "Core LC-7"
    },
    {
      "begin": {
        "op": {
          "ReadScreen": {
            "session": "s1",
            "history": false
          }
        }
      },
      "bind": "$d",
      "expect_error": {
        "code": "UnknownSession"
      },
      "because": [
        "Core ST-5",
        "Core LC-7"
      ]
    }
  ]
}

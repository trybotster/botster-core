{
  "id": "conf::dp_4_worker_encodes_route_frames_with_write_time_modes",
  "contract": "core",
  "clause": "DP-4",
  "subject": "core",
  "requires": {
    "controls": [
      "oracle_encode",
      "pty_accept",
      "pty_blocked",
      "pty_input",
      "pty_output",
      "edges_quiet"
    ]
  },
  "steps": [
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s1",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ],
              "fake": {
                "writes": {
                  "key": "6b",
                  "paste": "70"
                },
                "admission": {
                  "key": 12,
                  "mouse": 12,
                  "focus": 3,
                  "paste": 64
                }
              }
            }
          }
        }
      },
      "bind": "$c_s1"
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "s1"
          }
        }
      },
      "bind": "$s_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$s_s1",
            "result": {}
          }
        }
      },
      "because": "Core LC-3"
    },
    {
      "attach_route": {
        "route": "r1",
        "session": "s1",
        "client": "c1"
      },
      "because": "Core OU-1"
    },
    {
      "expect": {
        "frame": "attached",
        "terminal_format": {
          "$type": "string"
        }
      },
      "on": "r1",
      "because": "Core OU-9"
    },
    {
      "expect": {
        "frame": "baseline_begin",
        "rows": {
          "$type": "integer"
        },
        "cols": {
          "$type": "integer"
        },
        "modes": {
          "$type": "object"
        }
      },
      "on": "r1",
      "because": "Core OU-9"
    },
    {
      "expect": {
        "frame": "screen",
        "payload": {
          "$any": true
        }
      },
      "on": "r1",
      "because": "Core OU-9"
    },
    {
      "expect_eventually": {
        "frame": "baseline_end",
        "history": "not_requested"
      },
      "ignore": [
        {
          "frame": "history",
          "payload": {
            "$any": true
          }
        }
      ],
      "on": "r1",
      "because": "Core OU-9"
    },
    {
      "expect": {
        "frame": "live"
      },
      "on": "r1",
      "because": "Core OU-9"
    },
    {
      "control": {
        "op": "pty_output",
        "session": "s1",
        "bytes_hex": "1b5b3f316c",
        "scripted": {
          "modes": {
            "application_cursor_keys": false
          }
        }
      }
    },
    {
      "await_quiet": {}
    },
    {
      "control": {
        "op": "pty_accept",
        "session": "s1",
        "bytes": 1
      }
    },
    {
      "begin": {
        "op": {
          "WriteInput": {
            "session": "s1",
            "payload": {
              "bytes": {
                "bytes": {
                  "$bytes_hex": "aabb"
                }
              }
            }
          }
        }
      },
      "bind": "$w"
    },
    {
      "await_pty": {
        "session": "s1",
        "min_bytes": 1
      }
    },
    {
      "route_send": {
        "frame": "input",
        "kind": "key",
        "op": "1",
        "key": {
          "named": "arrow_up"
        },
        "mods": [],
        "event": "press"
      }
    },
    {
      "expect_quiet_until": {
        "$one_of": [
          {
            "frame": "input_done"
          },
          {
            "frame": "input_refused",
            "op": {
              "$not": "99"
            }
          }
        ]
      },
      "barrier": {
        "route_send": {
          "frame": "input",
          "kind": "paste_commit",
          "op": "99"
        },
        "route": "r1"
      },
      "until": {
        "frame": "input_refused",
        "op": "99",
        "reason": "refused"
      },
      "on": "r1",
      "because": [
        "Core DP-4",
        "Core DP-5"
      ]
    },
    {
      "control": {
        "op": "pty_output",
        "session": "s1",
        "bytes_hex": "1b5b3f3168",
        "scripted": {
          "modes": {
            "application_cursor_keys": true
          }
        }
      }
    },
    {
      "pump_until": {
        "event": {
          "ModesChanged": {
            "id": "s1",
            "flags": {
              "application_cursor_keys": true
            }
          }
        }
      },
      "because": "Core EV-7"
    },
    {
      "control": {
        "op": "oracle_encode",
        "session": "s1",
        "input": {
          "key": {
            "named": "arrow_up"
          },
          "mods": [],
          "event": "press"
        },
        "kind": "key",
        "modes": {
          "application_cursor_keys": true
        }
      },
      "bind": "$e"
    },
    {
      "control": {
        "op": "pty_blocked",
        "session": "s1",
        "on": false
      }
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$w",
            "result": {
              "ok": {
                "input": {
                  "outcome": "Written"
                }
              }
            }
          }
        }
      },
      "because": [
        "Core AM-2",
        "Core IN-2"
      ]
    },
    {
      "await_pty": {
        "session": "s1",
        "min_bytes": 3
      }
    },
    {
      "await_quiet": {}
    },
    {
      "route_expect_pty": [
        {
          "hex": "aabb"
        },
        {
          "written_by_op": "1"
        }
      ],
      "because": [
        "Core DP-4",
        "Core AM-2"
      ]
    },
    {
      "control": {
        "op": "pty_input",
        "session": "s1"
      },
      "expect": {
        "bytes": "$log"
      },
      "because": [
        "Core DP-4",
        "Core IN-9"
      ]
    },
    {
      "check": {
        "hex_ends_with": [
          "$log",
          "$e"
        ]
      },
      "because": [
        "Core DP-4",
        "Core IN-9"
      ]
    }
  ],
  "fake": "structural",
  "ruling": "R-7"
}

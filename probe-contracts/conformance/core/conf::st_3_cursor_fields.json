{
  "id": "conf::st_3_cursor_fields",
  "contract": "core",
  "clause": "ST-3",
  "subject": "core",
  "requires": {
    "controls": [
      "oracle_cursor"
    ]
  },
  "fake": "structural",
  "ruling": "R-12",
  "steps": [
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s1",
            "request": {
              "program": [
                {
                  "print_after_input": {
                    "match_hex": "31",
                    "bytes_hex": "1b5b3f32356c"
                  }
                },
                {
                  "hold": {}
                }
              ],
              "size": {
                "rows": 10,
                "cols": 40
              }
            }
          }
        }
      },
      "bind": "$c_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$c_s1",
            "result": {
              "ok": {
                "record": {
                  "id": "s1",
                  "state": "Created"
                }
              }
            }
          }
        }
      },
      "because": "Core LC-3"
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "s1"
          }
        }
      },
      "bind": "$s_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$s_s1",
            "result": {
              "ok": {
                "record": {
                  "id": "s1",
                  "state": "Running"
                }
              }
            }
          }
        }
      },
      "because": "Core A2-1"
    },
    {
      "begin": {
        "op": {
          "ReadCursor": {
            "session": "s1"
          }
        }
      },
      "bind": "$a"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$a",
            "result": {
              "ok": {
                "cursor": {
                  "row": "$r",
                  "col": "$c",
                  "visible": "$v",
                  "row_text": "$rt",
                  "text_before_cursor": "$tb",
                  "model_rev": {
                    "$type": "u64"
                  }
                }
              }
            }
          }
        }
      },
      "because": "Core ST-3"
    },
    {
      "control": {
        "op": "oracle_cursor",
        "session": "s1"
      },
      "expect": {
        "row": "$r",
        "col": "$c",
        "visible": "$v",
        "before_raw": "$tb",
        "row_raw": "$raw"
      },
      "because": "Core ST-3"
    },
    {
      "let": {
        "$want": {
          "rtrim_spaces": [
            "$raw"
          ]
        }
      }
    },
    {
      "check": {
        "eq": [
          "$rt",
          "$want"
        ]
      },
      "because": "Core ST-3"
    },
    {
      "begin": {
        "op": {
          "WriteInput": {
            "session": "s1",
            "payload": {
              "bytes": {
                "bytes": {
                  "$bytes_hex": "31"
                }
              }
            }
          }
        }
      },
      "bind": "$t_s1_1"
    },
    {
      "pump_collect": {
        "events": [
          {
            "Completed": {
              "op": "$t_s1_1",
              "result": {
                "ok": {
                  "input": {
                    "outcome": {
                      "$any": true
                    }
                  }
                }
              }
            }
          },
          {
            "ModesChanged": {
              "id": "s1",
              "flags": "$f"
            }
          }
        ]
      },
      "because": "Core ST-4"
    },
    {
      "control": {
        "op": "oracle_modes",
        "session": "s1"
      },
      "expect": {
        "flags": "$f"
      },
      "because": "Core ST-4"
    },
    {
      "let": {
        "$cv": {
          "field": [
            "$f",
            "cursor_visible"
          ]
        }
      }
    },
    {
      "begin": {
        "op": {
          "ReadCursor": {
            "session": "s1"
          }
        }
      },
      "bind": "$b"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$b",
            "result": {
              "ok": {
                "cursor": {
                  "visible": "$v2"
                }
              }
            }
          }
        }
      },
      "because": "Core ST-3"
    },
    {
      "check": {
        "eq": [
          "$v2",
          "$cv"
        ]
      },
      "because": [
        "Core ST-3",
        "Core ST-4"
      ]
    },
    {
      "check": {
        "ne": [
          "$v",
          "$v2"
        ]
      },
      "because": [
        "Core ST-3",
        "Core ST-4"
      ]
    }
  ]
}

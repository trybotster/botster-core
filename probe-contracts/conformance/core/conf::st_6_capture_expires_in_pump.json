{
  "id": "conf::st_6_capture_expires_in_pump",
  "contract": "core",
  "clause": "ST-6",
  "subject": "core",
  "setup": {
    "limits": {
      "capture_ttl": 1000
    }
  },
  "steps": [
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s1",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ]
            }
          }
        }
      },
      "bind": "$c_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$c_s1",
            "result": {
              "ok": {
                "record": {
                  "id": "s1",
                  "state": "Created"
                }
              }
            }
          }
        }
      },
      "because": "Core LC-3"
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "s1"
          }
        }
      },
      "bind": "$s_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$s_s1",
            "result": {
              "ok": {
                "record": {
                  "id": "s1",
                  "state": "Running"
                }
              }
            }
          }
        }
      },
      "because": "Core A2-1"
    },
    {
      "begin": {
        "op": {
          "CaptureSnapshot": {
            "session": "s1",
            "owner": "c1"
          }
        }
      },
      "bind": "$k_cap"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$k_cap",
            "result": {
              "ok": {
                "capture": {
                  "capture": "$cap"
                }
              }
            }
          }
        }
      },
      "because": "Core ST-6"
    },
    {
      "call": {
        "method": "next_deadline"
      },
      "expect": {
        "in_ms": 1000
      },
      "because": [
        "Core ST-6",
        "Core TM-3"
      ]
    },
    {
      "advance_clock": {
        "ms": 1500
      }
    },
    {
      "call": {
        "method": "read_page",
        "args": {
          "capture": "$cap",
          "page": 0
        }
      },
      "because": [
        "Core ST-6",
        "Core OR-1"
      ],
      "expect": {
        "index": 0
      }
    },
    {
      "pump_idle": {}
    },
    {
      "call": {
        "method": "read_page",
        "args": {
          "capture": "$cap",
          "page": 0
        }
      },
      "because": [
        "Core ST-6",
        "Core ER-0"
      ],
      "expect_error": {
        "code": "UnknownCapture"
      }
    },
    {
      "call": {
        "method": "next_deadline"
      },
      "expect": null,
      "because": [
        "Core ST-6",
        "Core TM-3"
      ]
    }
  ]
}

{
  "id": "conf::er_route_limit",
  "contract": "core",
  "clause": "ER-0",
  "subject": "core",
  "setup": {
    "limits": {
      "routes_per_session": 1
    }
  },
  "steps": [
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s1",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ]
            }
          }
        }
      },
      "bind": "$c_s1"
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "s1"
          }
        }
      },
      "bind": "$s_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$s_s1",
            "result": {}
          }
        }
      },
      "because": "Core LC-3"
    },
    {
      "attach_route": {
        "route": "r1",
        "session": "s1",
        "client": "c1"
      },
      "because": "Core OU-1"
    },
    {
      "expect": {
        "frame": "attached",
        "terminal_format": {
          "$type": "string"
        }
      },
      "on": "r1",
      "because": "Core OU-9"
    },
    {
      "expect": {
        "frame": "baseline_begin",
        "rows": {
          "$type": "integer"
        },
        "cols": {
          "$type": "integer"
        },
        "modes": {
          "$type": "object"
        }
      },
      "on": "r1",
      "because": "Core OU-9"
    },
    {
      "expect": {
        "frame": "screen",
        "payload": {
          "$any": true
        }
      },
      "on": "r1",
      "because": "Core OU-9"
    },
    {
      "expect_eventually": {
        "frame": "baseline_end",
        "history": "not_requested"
      },
      "ignore": [
        {
          "frame": "history",
          "payload": {
            "$any": true
          }
        }
      ],
      "on": "r1",
      "because": "Core OU-9"
    },
    {
      "expect": {
        "frame": "live"
      },
      "on": "r1",
      "because": "Core OU-9"
    },
    {
      "attach_route": {
        "route": "r2",
        "session": "s1"
      },
      "expect_error": {
        "code": "RouteLimit"
      },
      "because": "Core ER-0"
    },
    {
      "begin": {
        "op": {
          "Detach": {
            "route": "$r1",
            "reason": "Detached"
          }
        }
      },
      "bind": "$d"
    },
    {
      "pump_until": {
        "event": {
          "RouteClosed": {
            "route": "$r1"
          }
        }
      },
      "because": "Core ER-0"
    },
    {
      "attach_route": {
        "route": "r3",
        "session": "s1"
      },
      "because": "Core ER-0"
    }
  ]
}

{
  "id": "conf::sz_3_coalesced_resize_is_superseded",
  "contract": "core",
  "clause": "SZ-3",
  "subject": "core",
  "steps": [
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s1",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ]
            }
          }
        }
      },
      "bind": "$c_s1"
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "s1"
          }
        }
      },
      "bind": "$s_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$s_s1",
            "result": {}
          }
        }
      },
      "because": "Core LC-3"
    },
    {
      "begin": {
        "op": {
          "Resize": {
            "session": "s1",
            "size": {
              "rows": 30,
              "cols": 100
            }
          }
        }
      },
      "bind": "$a"
    },
    {
      "begin": {
        "op": {
          "Resize": {
            "session": "s1",
            "size": {
              "rows": 40,
              "cols": 120
            }
          }
        }
      },
      "bind": "$b"
    },
    {
      "begin": {
        "op": {
          "Resize": {
            "session": "s1",
            "size": {
              "rows": 50,
              "cols": 130
            }
          }
        }
      },
      "bind": "$c"
    },
    {
      "pump_collect": {
        "events": [
          {
            "Completed": {
              "op": "$b",
              "result": {
                "ok": {
                  "resize": {
                    "Superseded": {
                      "by": "$c"
                    }
                  }
                }
              }
            }
          },
          {
            "Completed": {
              "op": "$c",
              "result": {
                "ok": {
                  "resize": {
                    "Applied": {
                      "actual": {
                        "rows": 50,
                        "cols": 130
                      }
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "because": [
        "Core SZ-3"
      ]
    }
  ]
}

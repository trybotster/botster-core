{
  "id": "conf::sv_8_adoption_cancels_grace",
  "contract": "core",
  "clause": "SV-8",
  "subject": "core",
  "requires": {
    "controls": [
      "service_connect"
    ]
  },
  "fake": "structural",
  "ruling": "R-12",
  "steps": [
    {
      "begin": {
        "op": {
          "Create": {
            "session": "sb",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ]
            }
          }
        }
      },
      "bind": "$c_sb"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$c_sb",
            "result": {
              "ok": {
                "record": {
                  "id": "sb",
                  "state": "Created"
                }
              }
            }
          }
        }
      },
      "because": "Core LC-3"
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "sb"
          }
        }
      },
      "bind": "$s_sb"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$s_sb",
            "result": {
              "ok": {
                "record": {
                  "id": "sb",
                  "state": "Running"
                }
              }
            }
          }
        }
      },
      "because": "Core A2-1"
    },
    {
      "begin": {
        "op": {
          "SpawnService": {
            "service_id": "1111111111111111111111111111111111111111111111111111111111111111",
            "limits": {
              "lanes": [
                {
                  "max_frame_bytes": 1024,
                  "outbound_queue_bytes": 4096,
                  "inbound_queue_bytes": 4096
                }
              ],
              "rlimits": {},
              "startup": 10000,
              "stop_grace": 5000,
              "orphan_grace": 1000
            }
          }
        }
      },
      "bind": "$sp_11"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$sp_11",
            "result": {
              "ok": {
                "spawn": {
                  "$any": true
                }
              }
            }
          }
        }
      },
      "because": "Core SV-1"
    },
    {
      "control": {
        "op": "service_connect",
        "service": "1111111111111111111111111111111111111111111111111111111111111111",
        "epoch": 1
      }
    },
    {
      "pump_until": {
        "event": {
          "LaneConnected": {
            "id": "1111111111111111111111111111111111111111111111111111111111111111",
            "epoch": 1
          }
        }
      },
      "because": "Core A2-5"
    },
    {
      "drop": {
        "handle": "h"
      }
    },
    {
      "open": {
        "as": "h2"
      }
    },
    {
      "begin": {
        "op": "AdoptAll",
        "handle": "h2"
      },
      "bind": "$aa"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$aa",
            "result": {
              "ok": "unit"
            }
          }
        },
        "handle": "h2"
      },
      "because": [
        "Core A2-1",
        "Core LC-11"
      ]
    },
    {
      "real_wait": {
        "ms": 3000,
        "handle": "h2"
      }
    },
    {
      "expect_quiet_until": {
        "ServiceState": {
          "id": "1111111111111111111111111111111111111111111111111111111111111111",
          "state": {
            "$one_of": [
              {
                "Exited": {
                  "$any": true
                }
              },
              {
                "Lost": {
                  "$any": true
                }
              }
            ]
          }
        }
      },
      "barrier": {
        "begin": {
          "op": {
            "UpdateMetadata": {
              "id": "sb",
              "labels": {
                "b": "1"
              }
            }
          },
          "handle": "h2"
        },
        "bind": "$barb"
      },
      "until": {
        "Completed": {
          "op": "$barb",
          "result": {
            "ok": "unit"
          }
        }
      },
      "because": [
        "Core SV-8"
      ],
      "on": {
        "handle": "h2"
      }
    },
    {
      "control": {
        "op": "service_connect",
        "service": "1111111111111111111111111111111111111111111111111111111111111111",
        "epoch": 2,
        "handle": "h2"
      }
    },
    {
      "pump_until": {
        "event": {
          "ServiceState": {
            "id": "1111111111111111111111111111111111111111111111111111111111111111",
            "state": {
              "Reconnected": {
                "epoch": 2
              }
            }
          }
        },
        "handle": "h2"
      },
      "because": [
        "Core SV-8",
        "Core SV-6"
      ]
    }
  ]
}

{
  "id": "conf::id_2_ops_do_not_survive_restart",
  "contract": "core",
  "clause": "ID-2",
  "subject": "core",
  "steps": [
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s1",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ]
            }
          }
        }
      },
      "bind": "$c_s1"
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "s1"
          }
        }
      },
      "bind": "$s_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$s_s1",
            "result": {}
          }
        }
      },
      "because": "Core LC-3"
    },
    {
      "begin": {
        "op": {
          "WriteInput": {
            "session": "s1",
            "payload": {
              "bytes": {
                "bytes": {
                  "$bytes_hex": "61"
                }
              }
            }
          }
        }
      },
      "bind": "$w"
    },
    {
      "drop": {
        "handle": "h"
      }
    },
    {
      "open": {
        "as": "h2"
      }
    },
    {
      "begin": {
        "op": "AdoptAll",
        "handle": "h2"
      },
      "bind": "$ad"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$ad",
            "result": {
              "ok": "unit"
            }
          }
        },
        "handle": "h2"
      },
      "because": "Core AD-1"
    },
    {
      "call": {
        "method": "cancel",
        "args": {
          "op": "$w"
        },
        "handle": "h2"
      },
      "expect": "UnknownOp",
      "because": [
        "Core ID-2",
        "Core IN-6"
      ]
    }
  ]
}

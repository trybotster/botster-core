{
  "id": "conf::st_3_coordinates_are_zero_based_cells",
  "contract": "core",
  "clause": "ST-3",
  "subject": "core",
  "requires": {
    "controls": [
      "oracle_cursor"
    ]
  },
  "fake": "structural",
  "ruling": "R-12",
  "steps": [
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s1",
            "request": {
              "program": [
                {
                  "print": {
                    "bytes_hex": "61"
                  }
                },
                {
                  "print_after_input": {
                    "match_hex": "31",
                    "bytes_hex": "e6bca2"
                  }
                },
                {
                  "hold": {}
                }
              ],
              "size": {
                "rows": 10,
                "cols": 40
              }
            }
          }
        }
      },
      "bind": "$c_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$c_s1",
            "result": {
              "ok": {
                "record": {
                  "id": "s1",
                  "state": "Created"
                }
              }
            }
          }
        }
      },
      "because": "Core LC-3"
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "s1"
          }
        }
      },
      "bind": "$s_s1"
    },
    {
      "pump_collect": {
        "events": [
          {
            "Completed": {
              "op": "$s_s1",
              "result": {
                "ok": {
                  "record": {
                    "id": "s1",
                    "state": "Running"
                  }
                }
              }
            }
          },
          {
            "Activity": {
              "id": "s1",
              "source": "Output"
            }
          }
        ]
      },
      "because": "Core 6.2"
    },
    {
      "begin": {
        "op": {
          "ReadCursor": {
            "session": "s1"
          }
        }
      },
      "bind": "$a"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$a",
            "result": {
              "ok": {
                "cursor": {
                  "row": "$r1",
                  "col": "$c1"
                }
              }
            }
          }
        }
      },
      "because": "Core ST-3"
    },
    {
      "control": {
        "op": "oracle_cursor",
        "session": "s1"
      },
      "expect": {
        "row": "$r1",
        "col": "$c1"
      },
      "because": "Core ST-3"
    },
    {
      "begin": {
        "op": {
          "WriteInput": {
            "session": "s1",
            "payload": {
              "bytes": {
                "bytes": {
                  "$bytes_hex": "31"
                }
              }
            }
          }
        }
      },
      "bind": "$t_s1_1"
    },
    {
      "pump_collect": {
        "events": [
          {
            "Completed": {
              "op": "$t_s1_1",
              "result": {
                "ok": {
                  "input": {
                    "outcome": {
                      "$any": true
                    }
                  }
                }
              }
            }
          },
          {
            "Activity": {
              "id": "s1",
              "source": "Output"
            }
          }
        ]
      },
      "because": "Core 6.2"
    },
    {
      "begin": {
        "op": {
          "ReadCursor": {
            "session": "s1"
          }
        }
      },
      "bind": "$b"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$b",
            "result": {
              "ok": {
                "cursor": {
                  "row": "$r2",
                  "col": "$c2"
                }
              }
            }
          }
        }
      },
      "because": "Core ST-3"
    },
    {
      "let": {
        "$want": {
          "add": [
            "$c1",
            2
          ]
        }
      }
    },
    {
      "check": {
        "eq": [
          "$c2",
          "$want"
        ]
      },
      "because": "Core ST-3"
    },
    {
      "control": {
        "op": "oracle_cursor",
        "session": "s1"
      },
      "expect": {
        "row": "$r2",
        "col": "$c2"
      },
      "because": "Core ST-3"
    }
  ]
}

{
  "id": "conf::a2_1_cancel_non_input_is_not_cancellable",
  "contract": "core",
  "clause": "A2-1",
  "subject": "core",
  "steps": [
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s1",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ]
            }
          }
        }
      },
      "bind": "$c_s1"
    },
    {
      "call": {
        "method": "cancel",
        "args": {
          "op": "$c_s1"
        }
      },
      "expect": {
        "Refused": "NotCancellable"
      },
      "because": [
        "Core A2-1",
        "Core IN-6"
      ]
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$c_s1",
            "result": {
              "ok": {
                "record": {
                  "id": "s1",
                  "state": "Created"
                }
              }
            }
          }
        }
      },
      "because": "Core A2-1"
    },
    {
      "call": {
        "method": "get",
        "args": {
          "id": "s1"
        }
      },
      "expect": {
        "state": "Created"
      },
      "because": "Core A2-1"
    },
    {
      "call": {
        "method": "cancel",
        "args": {
          "op": "$c_s1"
        }
      },
      "expect": "TooLate",
      "because": [
        "Core A2-1",
        "Core IN-6"
      ]
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "s1"
          }
        }
      },
      "bind": "$s_s1"
    },
    {
      "call": {
        "method": "cancel",
        "args": {
          "op": "$s_s1"
        }
      },
      "expect": {
        "Refused": "NotCancellable"
      },
      "because": [
        "Core A2-1",
        "Core IN-6"
      ]
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$s_s1",
            "result": {
              "ok": {
                "record": {
                  "id": "s1",
                  "state": "Running"
                }
              }
            }
          }
        }
      },
      "because": "Core A2-1"
    },
    {
      "call": {
        "method": "cancel",
        "args": {
          "op": "$s_s1"
        }
      },
      "expect": "TooLate",
      "because": [
        "Core A2-1",
        "Core IN-6"
      ]
    }
  ]
}

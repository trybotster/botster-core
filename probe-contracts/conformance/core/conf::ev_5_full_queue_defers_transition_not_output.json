{
  "id": "conf::ev_5_full_queue_defers_transition_not_output",
  "contract": "core",
  "clause": "EV-5",
  "subject": "core",
  "requires": {
    "controls": [
      "edges_quiet",
      "payload_alive",
      "pty_output"
    ]
  },
  "setup": {
    "limits": {
      "max_sessions": 3,
      "mandatory_events": 3
    }
  },
  "fake": "structural",
  "ruling": "R-12",
  "steps": [
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s1",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ]
            }
          }
        }
      },
      "bind": "$c_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$c_s1",
            "result": {
              "ok": {
                "record": {
                  "id": "s1",
                  "state": "Created"
                }
              }
            }
          }
        }
      },
      "because": "Core LC-3"
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "s1"
          }
        }
      },
      "bind": "$s_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$s_s1",
            "result": {
              "ok": {
                "record": {
                  "id": "s1",
                  "state": "Running"
                }
              }
            }
          }
        }
      },
      "because": "Core A2-1"
    },
    {
      "attach_route": {
        "route": "r1",
        "session": "s1",
        "client": "c1"
      },
      "because": "Core OU-1"
    },
    {
      "expect": {
        "frame": "attached",
        "terminal_format": {
          "$type": "string"
        }
      },
      "because": "Core OU-9",
      "on": "r1"
    },
    {
      "expect": {
        "frame": "baseline_begin",
        "rows": {
          "$type": "integer"
        },
        "cols": {
          "$type": "integer"
        },
        "modes": {
          "$type": "object"
        }
      },
      "because": "Core OU-9",
      "on": "r1"
    },
    {
      "expect": {
        "frame": "screen",
        "payload": {
          "$any": true
        }
      },
      "because": "Core OU-9",
      "on": "r1"
    },
    {
      "expect_eventually": {
        "frame": "baseline_end",
        "history": "not_requested"
      },
      "because": "Core OU-9",
      "ignore": [
        {
          "frame": "history",
          "payload": {
            "$any": true
          }
        }
      ],
      "on": "r1"
    },
    {
      "expect": {
        "frame": "live"
      },
      "because": "Core OU-9",
      "on": "r1"
    },
    {
      "drain": {}
    },
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s2",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ]
            }
          }
        }
      },
      "bind": "$c_s2"
    },
    {
      "pump_idle": {}
    },
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s3",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ]
            }
          }
        }
      },
      "bind": "$c_s3"
    },
    {
      "pump_idle": {}
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "s2"
          }
        }
      },
      "bind": "$s_s2"
    },
    {
      "await_control": {
        "control": {
          "op": "payload_alive",
          "session": "s2"
        },
        "expect": {
          "alive": true
        }
      }
    },
    {
      "call": {
        "method": "get",
        "args": {
          "id": "s2"
        }
      },
      "expect": {
        "state": {
          "$one_of": [
            "Created",
            "Starting"
          ]
        }
      },
      "because": [
        "Core EV-5"
      ]
    },
    {
      "control": {
        "op": "pty_output",
        "session": "s1",
        "bytes_hex": "7072657373757265"
      }
    },
    {
      "route_expect_output": {
        "bytes_hex": "7072657373757265"
      },
      "route": "r1",
      "because": [
        "Core EV-5",
        "Core OU-12"
      ]
    },
    {
      "poll_all": {}
    },
    {
      "await_quiet": {}
    },
    {
      "pump_until": {
        "event": {
          "SessionState": {
            "id": "s2",
            "state": "Running"
          }
        }
      },
      "because": [
        "Core EV-5"
      ]
    }
  ]
}

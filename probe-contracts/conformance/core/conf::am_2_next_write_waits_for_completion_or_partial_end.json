{
  "id": "conf::am_2_next_write_waits_for_completion_or_partial_end",
  "contract": "core",
  "clause": "AM-2",
  "subject": "core",
  "requires": {
    "controls": [
      "pty_chunk",
      "pty_input"
    ]
  },
  "steps": [
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s1",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ]
            }
          }
        }
      },
      "bind": "$c_s1"
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "s1"
          }
        }
      },
      "bind": "$s_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$s_s1",
            "result": {}
          }
        }
      },
      "because": "Core LC-3"
    },
    {
      "control": {
        "op": "pty_chunk",
        "session": "s1",
        "bytes": 1
      }
    },
    {
      "begin": {
        "op": {
          "WriteInput": {
            "session": "s1",
            "payload": {
              "bytes": {
                "bytes": {
                  "$bytes_hex": "6162636465"
                }
              }
            }
          }
        }
      },
      "bind": "$w1"
    },
    {
      "begin": {
        "op": {
          "WriteInput": {
            "session": "s1",
            "payload": {
              "bytes": {
                "bytes": {
                  "$bytes_hex": "66"
                }
              }
            }
          }
        }
      },
      "bind": "$w2"
    },
    {
      "pump_collect": {
        "events": [
          {
            "Completed": {
              "op": "$w1",
              "result": {
                "ok": {
                  "input": {
                    "outcome": "Written",
                    "payload_bytes_written": 5,
                    "pty_bytes_written": 5
                  }
                }
              }
            }
          },
          {
            "Completed": {
              "op": "$w2",
              "result": {
                "ok": {
                  "input": {
                    "outcome": "Written",
                    "payload_bytes_written": 1,
                    "pty_bytes_written": 1
                  }
                }
              }
            }
          }
        ]
      },
      "because": "Core AM-2"
    },
    {
      "control": {
        "op": "pty_input",
        "session": "s1"
      },
      "expect": {
        "bytes": {
          "$bytes_hex": "616263646566"
        }
      },
      "because": [
        "Core AM-2"
      ]
    },
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s2",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ]
            }
          }
        }
      },
      "bind": "$c_s2"
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "s2"
          }
        }
      },
      "bind": "$s_s2"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$s_s2",
            "result": {}
          }
        }
      },
      "because": "Core LC-3"
    },
    {
      "control": {
        "op": "pty_chunk",
        "session": "s2",
        "bytes": 1
      }
    },
    {
      "begin": {
        "op": {
          "WriteInput": {
            "session": "s2",
            "payload": {
              "bytes": {
                "bytes": {
                  "$bytes_hex": "6768696a6b"
                }
              }
            }
          }
        }
      },
      "bind": "$w3"
    },
    {
      "begin": {
        "op": {
          "WriteInput": {
            "session": "s2",
            "payload": {
              "bytes": {
                "bytes": {
                  "$bytes_hex": "6c"
                }
              }
            }
          }
        }
      },
      "bind": "$w4"
    },
    {
      "await_pty": {
        "session": "s2",
        "min_bytes": 1
      }
    },
    {
      "call": {
        "method": "cancel",
        "args": {
          "op": "$w3"
        }
      },
      "expect": "Admitted",
      "because": "Core IN-6"
    },
    {
      "pump_collect": {
        "events": [
          {
            "Completed": {
              "op": "$w3",
              "result": {
                "ok": {
                  "input": {
                    "outcome": {
                      "$one_of": [
                        "Partial",
                        "Cancelled"
                      ]
                    },
                    "payload_bytes_written": "$p",
                    "pty_bytes_written": "$p"
                  }
                }
              }
            }
          },
          {
            "Completed": {
              "op": "$w4",
              "result": {
                "ok": {
                  "input": {
                    "outcome": "Written",
                    "payload_bytes_written": 1,
                    "pty_bytes_written": 1
                  }
                }
              }
            }
          }
        ]
      },
      "because": [
        "Core AM-2",
        "Core IN-6"
      ]
    },
    {
      "control": {
        "op": "pty_input",
        "session": "s2"
      },
      "expect": {
        "bytes": "$log"
      },
      "because": [
        "Core AM-2",
        "Core IN-6"
      ]
    },
    {
      "check": {
        "hex_ends_with": [
          "$log",
          "6c"
        ]
      },
      "because": [
        "Core AM-2"
      ]
    },
    {
      "check": {
        "hex_prefix": [
          "67",
          "$log"
        ]
      },
      "because": [
        "Core AM-2"
      ]
    }
  ]
}

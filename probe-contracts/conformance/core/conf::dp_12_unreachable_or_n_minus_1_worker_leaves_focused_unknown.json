{
  "id": "conf::dp_12_unreachable_or_n_minus_1_worker_leaves_focused_unknown",
  "contract": "core",
  "clause": "DP-12",
  "subject": "core",
  "requires": {
    "controls": [
      "withhold_control_link"
    ]
  },
  "steps": [
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s1",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ],
              "fake": {
                "writes": {
                  "key": "6b",
                  "paste": "70"
                },
                "admission": {
                  "key": 12,
                  "mouse": 12,
                  "focus": 3,
                  "paste": 64
                }
              }
            }
          }
        }
      },
      "bind": "$c_s1"
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "s1"
          }
        }
      },
      "bind": "$s_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$s_s1",
            "result": {}
          }
        }
      },
      "because": "Core LC-3"
    },
    {
      "attach_route": {
        "route": "r1",
        "session": "s1",
        "client": "c1"
      },
      "because": "Core OU-1"
    },
    {
      "expect": {
        "frame": "attached",
        "terminal_format": {
          "$type": "string"
        }
      },
      "on": "r1",
      "because": "Core OU-9"
    },
    {
      "expect": {
        "frame": "baseline_begin",
        "rows": {
          "$type": "integer"
        },
        "cols": {
          "$type": "integer"
        },
        "modes": {
          "$type": "object"
        }
      },
      "on": "r1",
      "because": "Core OU-9"
    },
    {
      "expect": {
        "frame": "screen",
        "payload": {
          "$any": true
        }
      },
      "on": "r1",
      "because": "Core OU-9"
    },
    {
      "expect_eventually": {
        "frame": "baseline_end",
        "history": "not_requested"
      },
      "ignore": [
        {
          "frame": "history",
          "payload": {
            "$any": true
          }
        }
      ],
      "on": "r1",
      "because": "Core OU-9"
    },
    {
      "expect": {
        "frame": "live"
      },
      "on": "r1",
      "because": "Core OU-9"
    },
    {
      "route_send": {
        "frame": "input",
        "kind": "focus",
        "op": "1",
        "focused": true
      }
    },
    {
      "expect_quiet_until": {
        "$one_of": [
          {
            "frame": "input_done"
          },
          {
            "frame": "input_refused",
            "op": {
              "$not": "99"
            }
          }
        ]
      },
      "barrier": {
        "route_send": {
          "frame": "input",
          "kind": "paste_commit",
          "op": "99"
        },
        "route": "r1"
      },
      "until": {
        "frame": "input_refused",
        "op": "99",
        "reason": "refused"
      },
      "on": "r1",
      "because": [
        "Core DP-5",
        "Core IN-9"
      ]
    },
    {
      "pump_until": {
        "event": {
          "FocusChanged": {
            "id": "s1",
            "focused": "Focused"
          }
        }
      },
      "because": [
        "Core DP-12",
        "Core EV-6"
      ]
    },
    {
      "control": {
        "op": "withhold_control_link",
        "session": "s1"
      }
    },
    {
      "drop": {
        "handle": "h"
      }
    },
    {
      "open": {
        "as": "h2"
      }
    },
    {
      "begin": {
        "op": "AdoptAll",
        "handle": "h2"
      },
      "bind": "$ad"
    },
    {
      "pump_until": {
        "event": {
          "SessionState": {
            "id": "s1",
            "state": {
              "Lost": "WorkerUnreachable"
            }
          }
        },
        "handle": "h2"
      },
      "because": [
        "Core A6-2",
        "Core AD-2"
      ]
    },
    {
      "expect_eventually": {
        "FocusChanged": {
          "id": "s1",
          "focused": "Unknown"
        }
      },
      "ignore": [
        {
          "$any": true
        }
      ],
      "on": {
        "handle": "h2"
      },
      "because": [
        "Core DP-12",
        "Core EV-6"
      ]
    },
    {
      "call": {
        "method": "terminal_state",
        "args": {
          "id": "s1"
        },
        "handle": "h2"
      },
      "expect": {
        "focused": {
          "$absent": true
        }
      },
      "because": [
        "Core DP-12",
        "Core EV-6"
      ]
    }
  ],
  "fake": "structural",
  "ruling": "R-12"
}

{
  "id": "conf::a2_2_cancel_is_ok_cancelled_never_err",
  "contract": "core",
  "clause": "A2-2",
  "subject": "core",
  "requires": {
    "controls": [
      "pty_blocked",
      "pty_input"
    ]
  },
  "fake": "structural",
  "ruling": "R-12",
  "steps": [
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s1",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ]
            }
          }
        }
      },
      "bind": "$c_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$c_s1",
            "result": {
              "ok": {
                "record": {
                  "id": "s1",
                  "state": "Created"
                }
              }
            }
          }
        }
      },
      "because": "Core LC-3"
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "s1"
          }
        }
      },
      "bind": "$s_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$s_s1",
            "result": {
              "ok": {
                "record": {
                  "id": "s1",
                  "state": "Running"
                }
              }
            }
          }
        }
      },
      "because": "Core A2-1"
    },
    {
      "control": {
        "op": "pty_blocked",
        "session": "s1",
        "on": true
      }
    },
    {
      "begin": {
        "op": {
          "WriteInput": {
            "session": "s1",
            "payload": {
              "bytes": {
                "bytes": {
                  "$bytes_hex": "6162636465"
                }
              }
            }
          }
        }
      },
      "bind": "$w"
    },
    {
      "call": {
        "method": "cancel",
        "args": {
          "op": "$w"
        }
      },
      "expect": "Admitted",
      "because": "Core IN-6"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$w",
            "result": {
              "ok": {
                "input": {
                  "outcome": "Cancelled",
                  "payload_bytes_written": "$p",
                  "pty_bytes_written": "$q"
                }
              }
            }
          }
        }
      },
      "because": [
        "Core A2-2",
        "Core IN-6"
      ]
    },
    {
      "control": {
        "op": "pty_input",
        "session": "s1"
      },
      "expect": {
        "bytes": "$log"
      },
      "because": [
        "Core A2-2",
        "Core IN-6"
      ]
    },
    {
      "check": {
        "hex_len_eq": [
          "$log",
          "$p"
        ]
      },
      "because": [
        "Core A2-2",
        "Core IN-6"
      ]
    },
    {
      "check": {
        "eq": [
          "$p",
          "$q"
        ]
      },
      "because": [
        "Core A2-2",
        "Core IN-2"
      ]
    }
  ]
}

{
  "id": "conf::a5_3_only_sync_column_codes_scripted",
  "contract": "core",
  "clause": "A5-3",
  "subject": "core",
  "requires": {
    "controls": [
      "fail_next"
    ]
  },
  "fake": "structural",
  "ruling": "R-12",
  "steps": [
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s1",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ]
            }
          }
        }
      },
      "bind": "$c_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$c_s1",
            "result": {
              "ok": {
                "record": {
                  "id": "s1",
                  "state": "Created"
                }
              }
            }
          }
        }
      },
      "because": "Core LC-3"
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "s1"
          }
        }
      },
      "bind": "$s_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$s_s1",
            "result": {
              "ok": {
                "record": {
                  "id": "s1",
                  "state": "Running"
                }
              }
            }
          }
        }
      },
      "because": "Core A2-1"
    },
    {
      "control": {
        "op": "fail_next",
        "target": "Start",
        "error": {
          "StartFailed": {
            "ExecFailed": {
              "errno": 2
            }
          }
        }
      },
      "expect_refused": {
        "call": "Start",
        "code": "StartFailed",
        "reason": "not_in_sync_column"
      },
      "because": [
        "Core A5-3"
      ]
    },
    {
      "control": {
        "op": "fail_next",
        "target": "Create",
        "error": {
          "RegistryFailed": {
            "uncertain": false
          }
        }
      },
      "expect_refused": {
        "call": "Create",
        "code": "RegistryFailed",
        "reason": "not_in_sync_column"
      },
      "because": [
        "Core A5-3"
      ]
    },
    {
      "control": {
        "op": "fail_next",
        "target": "ReadScreen",
        "error": "WorkerLinkFailed"
      },
      "expect_refused": {
        "call": "ReadScreen",
        "code": "WorkerLinkFailed",
        "reason": "not_in_sync_column"
      },
      "because": [
        "Core A5-3"
      ]
    },
    {
      "control": {
        "op": "fail_next",
        "target": "Stop",
        "error": "UnknownSession"
      },
      "because": "Core A5-3"
    },
    {
      "begin": {
        "op": {
          "Stop": {
            "id": "s1"
          }
        }
      },
      "bind": "$x",
      "expect_error": {
        "code": "UnknownSession"
      },
      "because": [
        "Core A5-3",
        "Core A2-1"
      ]
    }
  ]
}

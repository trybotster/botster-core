{
  "id": "conf::st_7_facts_after_link_loss",
  "contract": "core",
  "clause": "ST-7",
  "subject": "core",
  "requires": {
    "controls": [
      "process_end_worker"
    ]
  },
  "fake": "structural",
  "ruling": "R-12",
  "steps": [
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s1",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ],
              "size": {
                "rows": 10,
                "cols": 40
              }
            }
          }
        }
      },
      "bind": "$c_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$c_s1",
            "result": {
              "ok": {
                "record": {
                  "id": "s1",
                  "state": "Created"
                }
              }
            }
          }
        }
      },
      "because": "Core LC-3"
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "s1"
          }
        }
      },
      "bind": "$s_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$s_s1",
            "result": {
              "ok": {
                "record": {
                  "id": "s1",
                  "state": "Running"
                }
              }
            }
          }
        }
      },
      "because": "Core A2-1"
    },
    {
      "begin": {
        "op": {
          "WriteInput": {
            "session": "s1",
            "payload": {
              "bytes": {
                "bytes": {
                  "$bytes_hex": "31"
                }
              }
            }
          }
        }
      },
      "bind": "$w1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$w1",
            "result": {
              "ok": {
                "input": {
                  "outcome": {
                    "$any": true
                  }
                }
              }
            }
          }
        }
      },
      "because": "Core IN-2"
    },
    {
      "begin": {
        "op": {
          "ReadFacts": {
            "session": "s1"
          }
        }
      },
      "bind": "$f1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$f1",
            "result": {
              "ok": {
                "facts": {
                  "input": {
                    "tail_complete": {
                      "$type": "boolean"
                    },
                    "gap": {
                      "$type": "boolean"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "because": "Core ST-7"
    },
    {
      "control": {
        "op": "process_end_worker",
        "session": "s1"
      }
    },
    {
      "pump_until": {
        "event": {
          "SessionState": {
            "id": "s1",
            "state": {
              "Lost": "WorkerGone"
            }
          }
        }
      },
      "because": "Core AD-2"
    },
    {
      "begin": {
        "op": {
          "ReadFacts": {
            "session": "s1"
          }
        }
      },
      "bind": "$f2",
      "expect_error": {
        "code": "WrongState"
      },
      "because": [
        "Core ST-7",
        "Core A2-1"
      ]
    }
  ]
}

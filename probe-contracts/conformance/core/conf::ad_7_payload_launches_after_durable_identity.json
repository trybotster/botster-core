{
  "id": "conf::ad_7_payload_launches_after_durable_identity",
  "contract": "core",
  "clause": "AD-7",
  "subject": "core",
  "requires": {
    "controls": [
      "edges_quiet",
      "hold_start_at",
      "payload_alive",
      "registry_row",
      "release_start_at"
    ]
  },
  "fake": "structural",
  "ruling": "R-12",
  "steps": [
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s1",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ]
            }
          }
        }
      },
      "bind": "$c_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$c_s1",
            "result": {
              "ok": {
                "record": {
                  "id": "s1",
                  "state": "Created"
                }
              }
            }
          }
        }
      },
      "because": "Core LC-3"
    },
    {
      "control": {
        "op": "hold_start_at",
        "session": "s1",
        "before": "payload"
      }
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "s1"
          }
        }
      },
      "bind": "$s_s1"
    },
    {
      "await_quiet": {}
    },
    {
      "control": {
        "op": "registry_row",
        "session": "s1"
      },
      "expect": {
        "state": "Starting",
        "identity_recorded": true
      },
      "because": [
        "Core AD-7"
      ]
    },
    {
      "control": {
        "op": "payload_alive",
        "session": "s1"
      },
      "expect": {
        "alive": false
      },
      "because": [
        "Core AD-7"
      ]
    },
    {
      "control": {
        "op": "release_start_at",
        "session": "s1"
      }
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$s_s1",
            "result": {
              "ok": {
                "record": {
                  "id": "s1",
                  "state": "Running"
                }
              }
            }
          }
        }
      },
      "because": [
        "Core AD-7",
        "Core A2-1"
      ]
    },
    {
      "control": {
        "op": "payload_alive",
        "session": "s1"
      },
      "expect": {
        "alive": true
      },
      "because": [
        "Core AD-7"
      ]
    }
  ]
}

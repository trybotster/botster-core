{
  "id": "conf::ou_7_exit_after_last_frame_then_close",
  "contract": "core",
  "clause": "OR-4",
  "subject": "core",
  "steps": [
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s1",
            "request": {
              "program": [
                {
                  "print_after_input": {
                    "match_hex": "78",
                    "bytes_hex": "68656c6c6f0a"
                  }
                },
                {
                  "exit": {
                    "code": 0
                  }
                }
              ]
            }
          }
        }
      },
      "bind": "$c_s1"
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "s1"
          }
        }
      },
      "bind": "$s_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$s_s1",
            "result": {}
          }
        }
      },
      "because": "Core LC-3"
    },
    {
      "attach_route": {
        "route": "r1",
        "session": "s1",
        "client": "c1"
      },
      "because": "Core OU-1"
    },
    {
      "expect": {
        "frame": "attached",
        "terminal_format": {
          "$type": "string"
        }
      },
      "on": "r1",
      "because": "Core OU-9"
    },
    {
      "expect": {
        "frame": "baseline_begin",
        "rows": {
          "$type": "integer"
        },
        "cols": {
          "$type": "integer"
        },
        "modes": {
          "$type": "object"
        }
      },
      "on": "r1",
      "because": "Core OU-9"
    },
    {
      "expect": {
        "frame": "screen",
        "payload": {
          "$any": true
        }
      },
      "on": "r1",
      "because": "Core OU-9"
    },
    {
      "expect_eventually": {
        "frame": "baseline_end",
        "history": "not_requested"
      },
      "ignore": [
        {
          "frame": "history",
          "payload": {
            "$any": true
          }
        }
      ],
      "on": "r1",
      "because": "Core OU-9"
    },
    {
      "expect": {
        "frame": "live"
      },
      "on": "r1",
      "because": "Core OU-9"
    },
    {
      "route_send": {
        "frame": "bytes",
        "op": "1",
        "bytes": {
          "$bytes_hex": "78"
        }
      },
      "route": "r1"
    },
    {
      "route_expect_output": {
        "bytes_hex": "68656c6c6f0a"
      },
      "route": "r1",
      "because": [
        "Core OU-7",
        "Core OU-12"
      ]
    },
    {
      "expect": {
        "frame": "route_closed",
        "reason": "session_ended",
        "exit": {
          "code": 0
        }
      },
      "because": [
        "Core OU-7",
        "Core OU-2b"
      ],
      "on": "r1"
    },
    {
      "expect_closed": null,
      "on": "r1",
      "because": [
        "Core OU-7"
      ]
    },
    {
      "expect_eventually": {
        "SessionState": {
          "id": "s1",
          "state": {
            "Exited": {
              "code": 0
            }
          }
        }
      },
      "because": "Core OU-7",
      "ignore": [
        {
          "$any": true
        }
      ]
    },
    {
      "expect_eventually": {
        "RouteClosed": {
          "route": "$r1",
          "reason": {
            "SessionEnded": {
              "exit": {
                "code": 0
              }
            }
          }
        }
      },
      "because": [
        "Core OU-7",
        "Core A2-3"
      ],
      "ignore": [
        {
          "$any": true
        }
      ]
    }
  ]
}

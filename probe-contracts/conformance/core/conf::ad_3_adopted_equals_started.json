{
  "id": "conf::ad_3_adopted_equals_started",
  "contract": "core",
  "clause": "AD-3",
  "subject": "core",
  "requires": {
    "controls": [
      "edges_quiet",
      "pty_input",
      "pty_output"
    ]
  },
  "fake": "structural",
  "ruling": "R-12",
  "steps": [
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s1",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ]
            }
          }
        }
      },
      "bind": "$c_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$c_s1",
            "result": {
              "ok": {
                "record": {
                  "id": "s1",
                  "state": "Created"
                }
              }
            }
          }
        }
      },
      "because": "Core LC-3"
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "s1"
          }
        }
      },
      "bind": "$s_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$s_s1",
            "result": {
              "ok": {
                "record": {
                  "id": "s1",
                  "state": "Running"
                }
              }
            }
          }
        }
      },
      "because": "Core A2-1"
    },
    {
      "control": {
        "op": "pty_output",
        "session": "s1",
        "bytes_hex": "68690a"
      }
    },
    {
      "await_quiet": {}
    },
    {
      "call": {
        "method": "terminal_state",
        "args": {
          "id": "s1"
        }
      },
      "bind": "$ts0"
    },
    {
      "begin": {
        "op": {
          "ReadScreen": {
            "session": "s1",
            "history": false
          }
        }
      },
      "bind": "$rs0"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$rs0",
            "result": {
              "ok": {
                "screen": {
                  "text": "$text",
                  "rows": "$rows",
                  "cols": "$cols"
                }
              }
            }
          }
        }
      },
      "because": [
        "Core AD-3",
        "Core ST-3"
      ]
    },
    {
      "drop": {
        "handle": "h"
      }
    },
    {
      "open": {
        "as": "h2"
      }
    },
    {
      "begin": {
        "op": "AdoptAll",
        "handle": "h2"
      },
      "bind": "$aa"
    },
    {
      "pump_collect": {
        "events": [
          {
            "SessionState": {
              "id": "s1",
              "state": "Running"
            }
          },
          {
            "Completed": {
              "op": "$aa",
              "result": {
                "ok": "unit"
              }
            }
          }
        ],
        "handle": "h2"
      },
      "because": [
        "Core AD-1",
        "Core LC-11",
        "Core A2-1"
      ]
    },
    {
      "call": {
        "method": "terminal_state",
        "args": {
          "id": "s1"
        },
        "handle": "h2"
      },
      "bind": "$ts1"
    },
    {
      "let": {
        "$ts0_kept": {
          "without": [
            "$ts0",
            "last_output_at"
          ]
        },
        "$ts1_kept": {
          "without": [
            "$ts1",
            "last_output_at"
          ]
        }
      }
    },
    {
      "check": {
        "eq": [
          "$ts0_kept",
          "$ts1_kept"
        ]
      },
      "because": [
        "Core AD-3",
        "Core ST-4",
        "Core A18-1"
      ]
    },
    {
      "begin": {
        "op": {
          "ReadScreen": {
            "session": "s1",
            "history": false
          }
        },
        "handle": "h2"
      },
      "bind": "$rs1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$rs1",
            "result": {
              "ok": {
                "screen": {
                  "text": "$text",
                  "rows": "$rows",
                  "cols": "$cols"
                }
              }
            }
          }
        },
        "handle": "h2"
      },
      "because": [
        "Core AD-3",
        "Core ST-3"
      ]
    },
    {
      "begin": {
        "op": {
          "WriteInput": {
            "session": "s1",
            "payload": {
              "bytes": {
                "bytes": {
                  "$bytes_hex": "61"
                }
              }
            }
          }
        },
        "handle": "h2"
      },
      "bind": "$wr"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$wr",
            "result": {
              "ok": {
                "input": {
                  "outcome": "Written"
                }
              }
            }
          }
        },
        "handle": "h2"
      },
      "because": [
        "Core AD-3",
        "Core A2-2",
        "Core IN-2"
      ]
    },
    {
      "await_pty": {
        "session": "s1",
        "min_bytes": 1,
        "handle": "h2"
      }
    },
    {
      "control": {
        "op": "pty_input",
        "session": "s1",
        "handle": "h2"
      },
      "bind_fields": {
        "bytes": "$in"
      }
    },
    {
      "check": {
        "hex_ends_with": [
          "$in",
          "61"
        ]
      },
      "because": [
        "Core AD-3",
        "Core IN-2"
      ]
    },
    {
      "advance_clock": {
        "unix": 5000
      }
    },
    {
      "control": {
        "op": "pty_output",
        "session": "s1",
        "bytes_hex": "07",
        "handle": "h2"
      }
    },
    {
      "await_quiet": {
        "handle": "h2"
      }
    },
    {
      "pump_until": {
        "event": {
          "Bell": {
            "id": "s1",
            "at": 5000
          }
        },
        "handle": "h2"
      },
      "because": [
        "Core AD-3",
        "Core A2-4"
      ]
    }
  ]
}

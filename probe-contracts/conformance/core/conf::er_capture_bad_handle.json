{
  "id": "conf::er_capture_bad_handle",
  "contract": "core",
  "clause": "ER-0",
  "subject": "core",
  "steps": [
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s1",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ]
            }
          }
        }
      },
      "bind": "$c_s1"
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "s1"
          }
        }
      },
      "bind": "$s_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$s_s1",
            "result": {}
          }
        }
      },
      "because": "Core LC-3"
    },
    {
      "call": {
        "method": "read_page",
        "args": {
          "capture": 999,
          "page": 0
        }
      },
      "expect_error": {
        "code": "UnknownCapture"
      },
      "because": "Core ER-0"
    },
    {
      "begin": {
        "op": {
          "CaptureSnapshot": {
            "session": "s1",
            "owner": "c1"
          }
        }
      },
      "bind": "$k1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$k1",
            "result": {
              "ok": {
                "capture": {
                  "capture": "$cap",
                  "page_count": "$n"
                }
              }
            }
          }
        }
      },
      "because": "Core ST-6"
    },
    {
      "call": {
        "method": "read_page",
        "args": {
          "capture": "$cap",
          "page": 9999
        }
      },
      "expect_error": {
        "code": "PageOutOfRange"
      },
      "because": "Core ST-6"
    }
  ]
}

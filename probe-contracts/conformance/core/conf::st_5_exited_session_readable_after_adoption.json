{
  "id": "conf::st_5_exited_session_readable_after_adoption",
  "contract": "core",
  "clause": "ST-5",
  "subject": "core",
  "steps": [
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s1",
            "request": {
              "program": [
                {
                  "exit": {
                    "code": 0
                  }
                }
              ]
            }
          }
        }
      },
      "bind": "$c_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$c_s1",
            "result": {
              "ok": {
                "record": {
                  "id": "s1",
                  "state": "Created"
                }
              }
            }
          }
        }
      },
      "because": "Core LC-3"
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "s1"
          }
        }
      },
      "bind": "$s_s1"
    },
    {
      "pump_until": {
        "event": {
          "SessionState": {
            "id": "s1",
            "state": {
              "Exited": {
                "$any": true
              }
            }
          }
        }
      },
      "because": "Core OR-2"
    },
    {
      "drop": {
        "handle": "h"
      }
    },
    {
      "open": {
        "as": "h2"
      }
    },
    {
      "begin": {
        "op": "AdoptAll",
        "handle": "h2"
      },
      "bind": "$aa"
    },
    {
      "pump_collect": {
        "events": [
          {
            "SessionState": {
              "id": "s1",
              "state": {
                "Exited": {
                  "$any": true
                }
              }
            }
          },
          {
            "Completed": {
              "op": "$aa",
              "result": {
                "ok": "unit"
              }
            }
          }
        ],
        "handle": "h2"
      },
      "because": [
        "Core ST-5",
        "Core AD-3",
        "Core A2-1"
      ]
    },
    {
      "begin": {
        "op": {
          "ReadScreen": {
            "session": "s1",
            "history": false
          }
        },
        "handle": "h2"
      },
      "bind": "$rs"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$rs",
            "result": {
              "ok": {
                "screen": {
                  "text": {
                    "$type": "string"
                  }
                }
              }
            }
          }
        },
        "handle": "h2"
      },
      "because": [
        "Core ST-5",
        "Core AD-3"
      ]
    },
    {
      "begin": {
        "op": {
          "ReadCursor": {
            "session": "s1"
          }
        },
        "handle": "h2"
      },
      "bind": "$rc"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$rc",
            "result": {
              "ok": {
                "cursor": {
                  "row": {
                    "$type": "integer"
                  }
                }
              }
            }
          }
        },
        "handle": "h2"
      },
      "because": [
        "Core ST-5",
        "Core AD-3"
      ]
    },
    {
      "begin": {
        "op": {
          "CaptureSnapshot": {
            "session": "s1",
            "owner": "c1"
          }
        },
        "handle": "h2"
      },
      "bind": "$cp"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$cp",
            "result": {
              "ok": {
                "capture": {
                  "capture": {
                    "$type": "integer"
                  }
                }
              }
            }
          }
        },
        "handle": "h2"
      },
      "because": [
        "Core ST-5",
        "Core AD-3"
      ]
    }
  ]
}

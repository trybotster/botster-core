{
  "id": "conf::dp_8_old_epoch_commands_and_descriptors_are_refused",
  "contract": "core",
  "clause": "DP-8",
  "subject": "core",
  "requires": {
    "controls": [
      "lose_host",
      "payload_alive",
      "pty_input"
    ]
  },
  "fake": "structural",
  "ruling": "R-12",
  "steps": [
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s1",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ]
            }
          }
        }
      },
      "bind": "$c_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$c_s1",
            "result": {
              "ok": {
                "record": {
                  "id": "s1",
                  "state": "Created"
                }
              }
            }
          }
        }
      },
      "because": "Core LC-3"
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "s1"
          }
        }
      },
      "bind": "$s_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$s_s1",
            "result": {
              "ok": {
                "record": {
                  "id": "s1",
                  "state": "Running"
                }
              }
            }
          }
        }
      },
      "because": "Core A2-1"
    },
    {
      "control": {
        "op": "lose_host",
        "handle": "h"
      }
    },
    {
      "open": {
        "as": "h2"
      }
    },
    {
      "begin": {
        "op": "AdoptAll",
        "handle": "h2"
      },
      "bind": "$aa"
    },
    {
      "pump_collect": {
        "events": [
          {
            "SessionState": {
              "id": "s1",
              "state": "Running"
            }
          },
          {
            "Completed": {
              "op": "$aa",
              "result": {
                "ok": "unit"
              }
            }
          }
        ],
        "handle": "h2"
      },
      "because": [
        "Core DP-8",
        "Core AD-1",
        "Core LC-11",
        "Core A2-1"
      ]
    },
    {
      "begin": {
        "op": {
          "Signal": {
            "id": "s1",
            "sig": "term"
          }
        },
        "handle": "h"
      },
      "bind": "$sig"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$sig",
            "result": {
              "err": {
                "code": "WorkerLinkFailed"
              }
            }
          }
        },
        "handle": "h"
      },
      "because": [
        "Core DP-8",
        "Core A2-1"
      ]
    },
    {
      "attach_route": {
        "route": "stale",
        "session": "s1",
        "client": "c9",
        "handle": "h"
      },
      "because": [
        "Core DP-8",
        "Core DP-2"
      ]
    },
    {
      "pump_until": {
        "event": {
          "RouteClosed": {
            "route": "$stale",
            "reason": "HandoffFailed"
          }
        },
        "handle": "h"
      },
      "because": [
        "Core DP-8",
        "Core DP-2",
        "Core OU-2b"
      ]
    },
    {
      "control": {
        "op": "payload_alive",
        "session": "s1",
        "handle": "h2"
      },
      "expect": {
        "alive": true
      },
      "because": [
        "Core DP-8"
      ]
    },
    {
      "begin": {
        "op": {
          "WriteInput": {
            "session": "s1",
            "payload": {
              "bytes": {
                "bytes": {
                  "$bytes_hex": "6e6577"
                }
              }
            }
          }
        },
        "handle": "h2"
      },
      "bind": "$new"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$new",
            "result": {
              "ok": {
                "input": {
                  "outcome": "Written"
                }
              }
            }
          }
        },
        "handle": "h2"
      },
      "because": [
        "Core DP-8",
        "Core A2-2"
      ]
    },
    {
      "await_pty": {
        "session": "s1",
        "min_bytes": 3,
        "handle": "h2"
      }
    },
    {
      "control": {
        "op": "pty_input",
        "session": "s1",
        "handle": "h2"
      },
      "bind_fields": {
        "bytes": "$in"
      }
    },
    {
      "check": {
        "hex_len_eq": [
          "$in",
          3
        ]
      },
      "because": [
        "Core DP-8",
        "Core IN-2"
      ]
    },
    {
      "check": {
        "hex_ends_with": [
          "$in",
          "6e6577"
        ]
      },
      "because": [
        "Core DP-8",
        "Core IN-2"
      ]
    }
  ]
}

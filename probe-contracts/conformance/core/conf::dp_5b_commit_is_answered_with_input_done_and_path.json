{
  "id": "conf::dp_5b_commit_is_answered_with_input_done_and_path",
  "contract": "core",
  "clause": "DP-5b",
  "subject": "core",
  "requires": {
    "controls": [
      "edges_quiet",
      "fs_directory",
      "fs_list",
      "pty_input",
      "pty_output"
    ]
  },
  "fake": "structural",
  "ruling": "R-12",
  "steps": [
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s1",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ]
            }
          }
        }
      },
      "bind": "$c_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$c_s1",
            "result": {
              "ok": {
                "record": {
                  "id": "s1",
                  "state": "Created"
                }
              }
            }
          }
        }
      },
      "because": "Core LC-3"
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "s1"
          }
        }
      },
      "bind": "$s_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$s_s1",
            "result": {
              "ok": {
                "record": {
                  "id": "s1",
                  "state": "Running"
                }
              }
            }
          }
        }
      },
      "because": "Core A2-1"
    },
    {
      "control": {
        "op": "fs_directory"
      },
      "bind_fields": {
        "path": "$dir",
        "name_max": "$name_max"
      }
    },
    {
      "attach_route": {
        "route": "r1",
        "session": "s1",
        "client": "c1",
        "options": {
          "history": "none",
          "file_directory": "$dir",
          "file_permissions": 416
        }
      },
      "because": "Core OU-1"
    },
    {
      "expect": {
        "frame": "attached",
        "terminal_format": {
          "$type": "string"
        }
      },
      "because": "Core OU-9",
      "on": "r1"
    },
    {
      "expect": {
        "frame": "baseline_begin",
        "rows": {
          "$type": "integer"
        },
        "cols": {
          "$type": "integer"
        },
        "modes": {
          "$type": "object"
        }
      },
      "because": "Core OU-9",
      "on": "r1"
    },
    {
      "expect": {
        "frame": "screen",
        "payload": {
          "$any": true
        }
      },
      "because": "Core OU-9",
      "on": "r1"
    },
    {
      "expect_eventually": {
        "frame": "baseline_end",
        "history": "not_requested"
      },
      "because": "Core OU-9",
      "ignore": [
        {
          "frame": "history",
          "payload": {
            "$any": true
          }
        }
      ],
      "on": "r1"
    },
    {
      "expect": {
        "frame": "live"
      },
      "because": "Core OU-9",
      "on": "r1"
    },
    {
      "route_send": {
        "frame": "input",
        "kind": "file_begin",
        "op": "1",
        "name": "pic.png"
      }
    },
    {
      "route_send": {
        "frame": "file_chunk",
        "op": "1",
        "bytes": {
          "$bytes_hex": "504e4744415441"
        }
      }
    },
    {
      "route_send": {
        "frame": "input",
        "kind": "file_commit",
        "op": "1"
      }
    },
    {
      "expect_eventually": {
        "frame": "input_done",
        "op": "1",
        "written_bytes": "$wb1",
        "path": "$p1"
      },
      "because": [
        "Core DP-5b"
      ],
      "ignore": [
        {
          "frame": "modes"
        },
        {
          "frame": "output"
        },
        {
          "frame": "output_deflate"
        }
      ],
      "on": "r1"
    },
    {
      "control": {
        "op": "fs_list",
        "path": "$dir"
      },
      "expect": {
        "outside_directory": 0,
        "files": [
          {
            "path": "$p1",
            "mode": 416,
            "content": {
              "$bytes_hex": "504e4744415441"
            }
          }
        ]
      },
      "because": [
        "Core DP-5b"
      ]
    },
    {
      "route_send": {
        "frame": "input",
        "kind": "file_commit",
        "op": "2"
      }
    },
    {
      "expect_eventually": {
        "frame": "input_refused",
        "op": "2",
        "reason": "refused"
      },
      "because": [
        "Core DP-5b"
      ],
      "ignore": [
        {
          "frame": "modes"
        },
        {
          "frame": "output"
        },
        {
          "frame": "output_deflate"
        }
      ],
      "on": "r1"
    }
  ]
}

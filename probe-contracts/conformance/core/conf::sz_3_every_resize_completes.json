{
  "id": "conf::sz_3_every_resize_completes",
  "contract": "core",
  "clause": "SZ-3",
  "subject": "core",
  "steps": [
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s1",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ]
            }
          }
        }
      },
      "bind": "$c_s1"
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "s1"
          }
        }
      },
      "bind": "$s_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$s_s1",
            "result": {}
          }
        }
      },
      "because": "Core LC-3"
    },
    {
      "begin": {
        "op": {
          "Resize": {
            "session": "s1",
            "size": {
              "rows": 30,
              "cols": 100
            }
          }
        }
      },
      "bind": "$a"
    },
    {
      "begin": {
        "op": {
          "Resize": {
            "session": "s1",
            "size": {
              "rows": 40,
              "cols": 120
            }
          }
        }
      },
      "bind": "$b"
    },
    {
      "begin": {
        "op": {
          "Resize": {
            "session": "s1",
            "size": {
              "rows": 50,
              "cols": 130
            }
          }
        }
      },
      "bind": "$c"
    },
    {
      "pump_collect": {
        "events": [
          {
            "Completed": {
              "op": "$a",
              "result": {
                "ok": {
                  "resize": {
                    "$one_of": [
                      {
                        "Applied": {
                          "actual": {
                            "$any": true
                          }
                        }
                      },
                      {
                        "Superseded": {
                          "by": {
                            "$any": true
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          },
          {
            "Completed": {
              "op": "$b",
              "result": {
                "ok": {
                  "resize": {
                    "$one_of": [
                      {
                        "Applied": {
                          "actual": {
                            "$any": true
                          }
                        }
                      },
                      {
                        "Superseded": {
                          "by": {
                            "$any": true
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          },
          {
            "Completed": {
              "op": "$c",
              "result": {
                "ok": {
                  "resize": {
                    "Applied": {
                      "actual": {
                        "rows": 50,
                        "cols": 130
                      }
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "because": [
        "Core SZ-3"
      ]
    },
    {
      "expect_quiet_until": {
        "$one_of": [
          {
            "Completed": {
              "op": "$a",
              "result": {}
            }
          },
          {
            "Completed": {
              "op": "$b",
              "result": {}
            }
          },
          {
            "Completed": {
              "op": "$c",
              "result": {}
            }
          }
        ]
      },
      "barrier": {
        "begin": {
          "op": {
            "UpdateMetadata": {
              "id": "s1",
              "labels": {}
            }
          }
        },
        "bind": "$u"
      },
      "until": {
        "Completed": {
          "op": "$u",
          "result": {
            "ok": "unit"
          }
        }
      },
      "because": [
        "Core SZ-3",
        "Core AM-3"
      ]
    },
    {
      "call": {
        "method": "get",
        "args": {
          "id": "s1"
        }
      },
      "expect": {
        "size": {
          "rows": 50,
          "cols": 130
        }
      },
      "because": "Core SZ-2"
    }
  ]
}

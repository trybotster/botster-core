{
  "id": "conf::in_3_host_write_result_is_a_completed_event",
  "contract": "core",
  "clause": "IN-3",
  "subject": "core",
  "steps": [
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s1",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ]
            }
          }
        }
      },
      "bind": "$c_s1"
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "s1"
          }
        }
      },
      "bind": "$s_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$s_s1",
            "result": {}
          }
        }
      },
      "because": "Core LC-3"
    },
    {
      "begin": {
        "op": {
          "WriteInput": {
            "session": "s1",
            "payload": {
              "bytes": {
                "bytes": {
                  "$bytes_hex": "61"
                }
              }
            }
          }
        }
      },
      "bind": "$w"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$w",
            "result": {
              "ok": {
                "input": {
                  "outcome": "Written",
                  "payload_bytes_written": 1,
                  "pty_bytes_written": 1
                }
              }
            }
          }
        }
      },
      "because": [
        "Core IN-3",
        "Core IN-2"
      ]
    }
  ]
}

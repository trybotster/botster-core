{
  "id": "conf::ou_2b_handoff_failure_is_reported_as_handoff_failed",
  "contract": "core",
  "clause": "OU-2b",
  "subject": "core",
  "requires": {
    "controls": [
      "fail_handoff"
    ]
  },
  "setup": {
    "limits": {
      "routes_per_session": 1
    }
  },
  "steps": [
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s1",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ]
            }
          }
        }
      },
      "bind": "$c_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$c_s1",
            "result": {
              "ok": {
                "record": {
                  "id": "s1",
                  "state": "Created"
                }
              }
            }
          }
        }
      },
      "because": "Core LC-3"
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "s1"
          }
        }
      },
      "bind": "$s_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$s_s1",
            "result": {
              "ok": {
                "record": {
                  "id": "s1",
                  "state": "Running"
                }
              }
            }
          }
        }
      },
      "because": "Core A2-1"
    },
    {
      "control": {
        "op": "fail_handoff"
      }
    },
    {
      "attach_route": {
        "route": "r1",
        "session": "s1",
        "client": "c1",
        "options": {
          "history": "none"
        }
      },
      "because": "Core OU-1"
    },
    {
      "pump_until": {
        "event": {
          "RouteClosed": {
            "route": "$r1",
            "reason": "HandoffFailed"
          }
        }
      },
      "because": [
        "Core OU-2b",
        "Core A2-3"
      ]
    },
    {
      "expect_closed": {
        "ended": "handoff_failed"
      },
      "on": "r1",
      "because": [
        "Core OU-2b"
      ]
    },
    {
      "attach_route": {
        "route": "r2",
        "session": "s1",
        "client": "c2",
        "options": {
          "history": "none"
        }
      },
      "because": "Core OU-1"
    },
    {
      "expect": {
        "frame": "attached",
        "terminal_format": {
          "$type": "string"
        }
      },
      "on": "r2",
      "because": [
        "Core OU-1",
        "Codec TS-1"
      ]
    },
    {
      "expect": {
        "frame": "baseline_begin",
        "rows": {
          "$type": "integer"
        },
        "cols": {
          "$type": "integer"
        },
        "modes": {
          "$type": "object"
        }
      },
      "on": "r2",
      "because": [
        "Core OU-9",
        "Codec TS-4"
      ]
    },
    {
      "expect": {
        "frame": "screen",
        "payload": {
          "$any": true
        }
      },
      "on": "r2",
      "because": [
        "Core OU-9",
        "Codec TS-4"
      ]
    },
    {
      "expect_eventually": {
        "frame": "baseline_end",
        "history": "not_requested"
      },
      "ignore": [
        {
          "frame": "history",
          "payload": {
            "$any": true
          }
        }
      ],
      "on": "r2",
      "because": [
        "Core OU-9",
        "Codec TS-4"
      ]
    },
    {
      "expect": {
        "frame": "live"
      },
      "on": "r2",
      "because": [
        "Core OU-9",
        "Codec TS-4"
      ]
    }
  ],
  "fake": "structural",
  "ruling": "R-12"
}

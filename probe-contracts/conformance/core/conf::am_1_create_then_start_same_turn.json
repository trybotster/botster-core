{
  "id": "conf::am_1_create_then_start_same_turn",
  "contract": "core",
  "clause": "AM-1",
  "subject": "core",
  "steps": [
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s1",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ]
            }
          }
        }
      },
      "bind": "$c"
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "s1"
          }
        }
      },
      "bind": "$s"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$s",
            "result": {
              "ok": {
                "record": {
                  "id": "s1",
                  "state": "Running"
                }
              }
            }
          }
        }
      },
      "because": "Core AM-1"
    }
  ]
}

{
  "id": "conf::er_session_limit",
  "contract": "core",
  "clause": "ER-0",
  "subject": "core",
  "setup": {
    "limits": {
      "max_sessions": 1
    }
  },
  "steps": [
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s1",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ]
            }
          }
        }
      },
      "bind": "$c"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$c",
            "result": {}
          }
        }
      },
      "because": "Core ER-0"
    },
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s2",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ]
            }
          }
        }
      },
      "bind": "$c2",
      "expect_error": {
        "code": "SessionLimit"
      },
      "because": "Core ER-0"
    },
    {
      "begin": {
        "op": {
          "Remove": {
            "id": "s1"
          }
        }
      },
      "bind": "$r"
    },
    {
      "pump_until": {
        "event": {
          "SessionState": {
            "id": "s1",
            "state": "Released"
          }
        }
      },
      "because": "Core ER-0"
    },
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s2",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ]
            }
          }
        }
      },
      "bind": "$c2"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$c2",
            "result": {}
          }
        }
      },
      "because": "Core ER-0"
    }
  ]
}

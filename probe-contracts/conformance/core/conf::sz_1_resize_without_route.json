{
  "id": "conf::sz_1_resize_without_route",
  "contract": "core",
  "clause": "SZ-1",
  "subject": "core",
  "steps": [
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s1",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ]
            }
          }
        }
      },
      "bind": "$c_s1"
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "s1"
          }
        }
      },
      "bind": "$s_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$s_s1",
            "result": {}
          }
        }
      },
      "because": "Core LC-3"
    },
    {
      "begin": {
        "op": {
          "Resize": {
            "session": "s1",
            "size": {
              "rows": 30,
              "cols": 100
            }
          }
        }
      },
      "bind": "$z"
    },
    {
      "pump_collect": {
        "events": [
          {
            "Completed": {
              "op": "$z",
              "result": {
                "ok": {
                  "resize": {
                    "Applied": {
                      "actual": {
                        "rows": 30,
                        "cols": 100
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "SizeChanged": {
              "id": "s1",
              "size": {
                "rows": 30,
                "cols": 100
              }
            }
          }
        ]
      },
      "because": [
        "Core SZ-1",
        "Core SZ-3"
      ]
    },
    {
      "call": {
        "method": "get",
        "args": {
          "id": "s1"
        }
      },
      "expect": {
        "size": {
          "rows": 30,
          "cols": 100
        }
      },
      "because": "Core SZ-1"
    },
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s2",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ]
            }
          }
        }
      },
      "bind": "$c2"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$c2",
            "result": {}
          }
        }
      },
      "because": "Core LC-3"
    },
    {
      "begin": {
        "op": {
          "Resize": {
            "session": "s2",
            "size": {
              "rows": 40,
              "cols": 100
            }
          }
        }
      },
      "bind": "$z2"
    },
    {
      "pump": {}
    },
    {
      "poll_events": {
        "max": 64
      },
      "expect": [
        {
          "Completed": {
            "op": "$z2",
            "result": {
              "ok": {
                "resize": {
                  "Applied": {
                    "actual": {
                      "rows": 40,
                      "cols": 100
                    }
                  }
                }
              }
            }
          }
        }
      ],
      "because": [
        "Core SZ-1",
        "Core A2-1"
      ]
    }
  ]
}

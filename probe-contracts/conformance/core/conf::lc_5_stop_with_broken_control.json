{
  "id": "conf::lc_5_stop_with_broken_control",
  "contract": "core",
  "clause": "LC-5",
  "subject": "core",
  "requires": {
    "controls": [
      "break_control"
    ]
  },
  "setup": {
    "limits": {
      "stop_grace": 100
    }
  },
  "steps": [
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s1",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ]
            }
          }
        }
      },
      "bind": "$c_s1"
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "s1"
          }
        }
      },
      "bind": "$s_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$s_s1",
            "result": {}
          }
        }
      },
      "because": "Core LC-3"
    },
    {
      "control": {
        "op": "break_control",
        "session": "s1"
      }
    },
    {
      "begin": {
        "op": {
          "ReadScreen": {
            "session": "s1",
            "history": false
          }
        }
      },
      "bind": "$rd"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$rd",
            "result": {
              "err": {
                "code": "WorkerLinkFailed"
              }
            }
          }
        }
      },
      "because": [
        "Core A2-1"
      ]
    },
    {
      "begin": {
        "op": {
          "Stop": {
            "id": "s1"
          }
        }
      },
      "bind": "$p"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$p",
            "result": {
              "ok": {
                "end": {
                  "$one_of": [
                    {
                      "Exited": {
                        "$any": true
                      }
                    },
                    {
                      "Lost": {
                        "$any": true
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      },
      "because": "Core LC-5"
    }
  ]
}

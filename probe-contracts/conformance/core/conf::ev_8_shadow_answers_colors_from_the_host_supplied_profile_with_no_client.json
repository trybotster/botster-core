{
  "id": "conf::ev_8_shadow_answers_colors_from_the_host_supplied_profile_with_no_client",
  "contract": "core",
  "clause": "EV-8",
  "subject": "core",
  "requires": {
    "controls": [
      "edges_quiet",
      "oracle_query_reply",
      "pty_input",
      "pty_output"
    ]
  },
  "fake": "structural",
  "ruling": "R-12",
  "steps": [
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s1",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ]
            }
          }
        }
      },
      "bind": "$c_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$c_s1",
            "result": {
              "ok": {
                "record": {
                  "id": "s1",
                  "state": "Created"
                }
              }
            }
          }
        }
      },
      "because": "Core LC-3"
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "s1"
          }
        }
      },
      "bind": "$s_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$s_s1",
            "result": {
              "ok": {
                "record": {
                  "id": "s1",
                  "state": "Running"
                }
              }
            }
          }
        }
      },
      "because": "Core A2-1"
    },
    {
      "begin": {
        "op": {
          "SetColorProfile": {
            "session": "s1",
            "profile": {
              "foreground": {
                "r": 10,
                "g": 20,
                "b": 30
              },
              "background": {
                "r": 40,
                "g": 50,
                "b": 60
              }
            }
          }
        }
      },
      "bind": "$cp"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$cp",
            "result": {
              "ok": "unit"
            }
          }
        }
      },
      "because": [
        "Core A2-1",
        "Core EV-8"
      ]
    },
    {
      "control": {
        "op": "oracle_query_reply",
        "session": "s1",
        "request_hex": "1b5d31313b3f1b5c",
        "profile": {
          "foreground": {
            "r": 10,
            "g": 20,
            "b": 30
          },
          "background": {
            "r": 40,
            "g": 50,
            "b": 60
          }
        }
      },
      "bind": "$or_sh"
    },
    {
      "let": {
        "$ans_sh": {
          "field": [
            "$or_sh",
            "answerable"
          ]
        }
      }
    },
    {
      "assume": {
        "eq": [
          "$ans_sh",
          true
        ]
      },
      "because": [
        "Core EV-8"
      ]
    },
    {
      "let": {
        "$sh": {
          "field": [
            "$or_sh",
            "reply_hex"
          ]
        }
      }
    },
    {
      "control": {
        "op": "pty_output",
        "session": "s1",
        "bytes_hex": "1b5d31313b3f1b5c"
      }
    },
    {
      "await_quiet": {}
    },
    {
      "let": {
        "$wl0": {
          "hex_len": [
            "$sh",
            0
          ]
        }
      }
    },
    {
      "await_pty": {
        "session": "s1",
        "min_bytes": "$wl0"
      }
    },
    {
      "await_quiet": {}
    },
    {
      "control": {
        "op": "pty_input",
        "session": "s1"
      },
      "bind_fields": {
        "bytes": "$in"
      }
    },
    {
      "let": {
        "$n_sh": {
          "hex_len": [
            "$sh",
            0
          ]
        }
      }
    },
    {
      "check": {
        "hex_prefix": [
          "$sh",
          "$in"
        ]
      },
      "because": [
        "Core EV-8"
      ]
    },
    {
      "check": {
        "hex_len_eq": [
          "$in",
          "$n_sh"
        ]
      },
      "because": [
        "Core EV-8"
      ]
    }
  ]
}

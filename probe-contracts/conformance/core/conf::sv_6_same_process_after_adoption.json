{
  "id": "conf::sv_6_same_process_after_adoption",
  "contract": "core",
  "clause": "SV-6",
  "subject": "core",
  "requires": {
    "controls": [
      "process_identity",
      "service_connect"
    ]
  },
  "fake": "structural",
  "ruling": "R-12",
  "steps": [
    {
      "begin": {
        "op": {
          "SpawnService": {
            "service_id": "1111111111111111111111111111111111111111111111111111111111111111"
          }
        }
      },
      "bind": "$sp_11"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$sp_11",
            "result": {
              "ok": {
                "spawn": {
                  "$any": true
                }
              }
            }
          }
        }
      },
      "because": "Core SV-1"
    },
    {
      "control": {
        "op": "service_connect",
        "service": "1111111111111111111111111111111111111111111111111111111111111111",
        "epoch": 1
      }
    },
    {
      "pump_until": {
        "event": {
          "LaneConnected": {
            "id": "1111111111111111111111111111111111111111111111111111111111111111",
            "epoch": 1
          }
        }
      },
      "because": "Core A2-5"
    },
    {
      "control": {
        "op": "process_identity",
        "service": "1111111111111111111111111111111111111111111111111111111111111111"
      },
      "bind_fields": {
        "identity": "$pid"
      }
    },
    {
      "drop": {
        "handle": "h"
      }
    },
    {
      "open": {
        "as": "h2"
      }
    },
    {
      "begin": {
        "op": "AdoptAll",
        "handle": "h2"
      },
      "bind": "$aa"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$aa",
            "result": {
              "ok": "unit"
            }
          }
        },
        "handle": "h2"
      },
      "because": [
        "Core A2-1",
        "Core LC-11"
      ]
    },
    {
      "control": {
        "op": "service_connect",
        "service": "1111111111111111111111111111111111111111111111111111111111111111",
        "epoch": 2,
        "handle": "h2"
      }
    },
    {
      "pump_until": {
        "event": {
          "ServiceState": {
            "id": "1111111111111111111111111111111111111111111111111111111111111111",
            "state": {
              "Reconnected": {
                "epoch": 2
              }
            }
          }
        },
        "handle": "h2"
      },
      "because": [
        "Core SV-6",
        "Core A2-5"
      ]
    },
    {
      "control": {
        "op": "process_identity",
        "service": "1111111111111111111111111111111111111111111111111111111111111111",
        "handle": "h2"
      },
      "expect": {
        "identity": "$pid"
      },
      "because": [
        "Core SV-6"
      ]
    },
    {
      "begin": {
        "op": {
          "SpawnService": {
            "service_id": "1111111111111111111111111111111111111111111111111111111111111111"
          }
        },
        "handle": "h2"
      },
      "bind": "$again",
      "expect_error": {
        "code": "IdInUse"
      },
      "because": [
        "Core SV-6",
        "Core ER-0"
      ]
    }
  ]
}

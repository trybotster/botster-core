{
  "id": "conf::in_10_both_guards_are_checked_atomically_with_ordering",
  "contract": "core",
  "clause": "IN-10",
  "subject": "core",
  "requires": {
    "controls": [
      "pty_output"
    ]
  },
  "steps": [
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s1",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ]
            }
          }
        }
      },
      "bind": "$c_s1"
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "s1"
          }
        }
      },
      "bind": "$s_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$s_s1",
            "result": {}
          }
        }
      },
      "because": "Core LC-3"
    },
    {
      "attach_route": {
        "route": "r1",
        "session": "s1",
        "client": "c1"
      },
      "because": "Core OU-1"
    },
    {
      "expect": {
        "frame": "attached",
        "terminal_format": {
          "$type": "string"
        }
      },
      "on": "r1",
      "because": "Core OU-9"
    },
    {
      "expect": {
        "frame": "baseline_begin",
        "rows": {
          "$type": "integer"
        },
        "cols": {
          "$type": "integer"
        },
        "modes": {
          "$type": "object"
        }
      },
      "on": "r1",
      "because": "Core OU-9"
    },
    {
      "expect": {
        "frame": "screen",
        "payload": {
          "$any": true
        }
      },
      "on": "r1",
      "because": "Core OU-9"
    },
    {
      "expect_eventually": {
        "frame": "baseline_end",
        "history": "not_requested"
      },
      "ignore": [
        {
          "frame": "history",
          "payload": {
            "$any": true
          }
        }
      ],
      "on": "r1",
      "because": "Core OU-9"
    },
    {
      "expect": {
        "frame": "live"
      },
      "on": "r1",
      "because": "Core OU-9"
    },
    {
      "pump": {}
    },
    {
      "call": {
        "method": "terminal_state",
        "args": {
          "id": "s1"
        }
      },
      "expect": {
        "input_rev": {
          "client": "$a",
          "host": "$h"
        },
        "model_rev": "$m"
      },
      "because": "Core ST-4"
    },
    {
      "begin": {
        "op": {
          "WriteInput": {
            "session": "s1",
            "payload": {
              "bytes": {
                "bytes": {
                  "$bytes_hex": "61"
                }
              }
            },
            "guard": {
              "input": {
                "source_class": "Client",
                "rev": "$a"
              },
              "model_rev": "$m"
            }
          }
        }
      },
      "bind": "$w1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$w1",
            "result": {
              "ok": {
                "input": {
                  "outcome": "Written",
                  "payload_bytes_written": 1,
                  "pty_bytes_written": 1
                }
              }
            }
          }
        }
      },
      "because": "Core IN-10"
    },
    {
      "route_send": {
        "frame": "bytes",
        "op": "1",
        "bytes": {
          "$bytes_hex": "62"
        }
      },
      "route": "r1"
    },
    {
      "pump_until": {
        "event": {
          "Activity": {
            "id": "s1",
            "source": {
              "Client": "$r1"
            }
          }
        }
      },
      "because": "Core IN-4"
    },
    {
      "begin": {
        "op": {
          "WriteInput": {
            "session": "s1",
            "payload": {
              "bytes": {
                "bytes": {
                  "$bytes_hex": "63"
                }
              }
            },
            "guard": {
              "input": {
                "source_class": "Client",
                "rev": "$a"
              },
              "model_rev": "$m"
            }
          }
        }
      },
      "bind": "$w2"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$w2",
            "result": {
              "ok": {
                "input": {
                  "outcome": {
                    "NotWritten": "Stale"
                  },
                  "payload_bytes_written": 0,
                  "pty_bytes_written": 0
                }
              }
            }
          }
        }
      },
      "because": "Core IN-10"
    },
    {
      "pump": {}
    },
    {
      "call": {
        "method": "terminal_state",
        "args": {
          "id": "s1"
        }
      },
      "expect": {
        "input_rev": {
          "client": "$a2",
          "host": "$h2"
        },
        "model_rev": "$m2"
      },
      "because": "Core ST-4"
    },
    {
      "control": {
        "op": "pty_output",
        "session": "s1",
        "bytes_hex": "78"
      }
    },
    {
      "pump_until": {
        "event": {
          "Activity": {
            "id": "s1",
            "source": "Output"
          }
        }
      },
      "because": "Core 6.2"
    },
    {
      "begin": {
        "op": {
          "WriteInput": {
            "session": "s1",
            "payload": {
              "bytes": {
                "bytes": {
                  "$bytes_hex": "64"
                }
              }
            },
            "guard": {
              "input": {
                "source_class": "Client",
                "rev": "$a2"
              },
              "model_rev": "$m2"
            }
          }
        }
      },
      "bind": "$w3"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$w3",
            "result": {
              "ok": {
                "input": {
                  "outcome": {
                    "NotWritten": "Stale"
                  },
                  "payload_bytes_written": 0,
                  "pty_bytes_written": 0
                }
              }
            }
          }
        }
      },
      "because": "Core IN-10"
    }
  ]
}

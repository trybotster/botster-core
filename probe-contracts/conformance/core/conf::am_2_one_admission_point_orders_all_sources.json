{
  "id": "conf::am_2_one_admission_point_orders_all_sources",
  "contract": "core",
  "clause": "AM-2",
  "subject": "core",
  "requires": {
    "controls": [
      "pty_input"
    ]
  },
  "steps": [
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s1",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ]
            }
          }
        }
      },
      "bind": "$c_s1"
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "s1"
          }
        }
      },
      "bind": "$s_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$s_s1",
            "result": {}
          }
        }
      },
      "because": "Core LC-3"
    },
    {
      "attach_route": {
        "route": "r1",
        "session": "s1",
        "client": "c1"
      },
      "because": "Core OU-1"
    },
    {
      "expect": {
        "frame": "attached",
        "terminal_format": {
          "$type": "string"
        }
      },
      "on": "r1",
      "because": "Core OU-9"
    },
    {
      "expect": {
        "frame": "baseline_begin",
        "rows": {
          "$type": "integer"
        },
        "cols": {
          "$type": "integer"
        },
        "modes": {
          "$type": "object"
        }
      },
      "on": "r1",
      "because": "Core OU-9"
    },
    {
      "expect": {
        "frame": "screen",
        "payload": {
          "$any": true
        }
      },
      "on": "r1",
      "because": "Core OU-9"
    },
    {
      "expect_eventually": {
        "frame": "baseline_end",
        "history": "not_requested"
      },
      "ignore": [
        {
          "frame": "history",
          "payload": {
            "$any": true
          }
        }
      ],
      "on": "r1",
      "because": "Core OU-9"
    },
    {
      "expect": {
        "frame": "live"
      },
      "on": "r1",
      "because": "Core OU-9"
    },
    {
      "route_send": {
        "frame": "bytes",
        "op": "1",
        "bytes": {
          "$bytes_hex": "41"
        }
      },
      "route": "r1"
    },
    {
      "begin": {
        "op": {
          "WriteInput": {
            "session": "s1",
            "payload": {
              "bytes": {
                "bytes": {
                  "$bytes_hex": "42"
                }
              }
            }
          }
        }
      },
      "bind": "$w"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$w",
            "result": {
              "ok": {
                "input": {
                  "outcome": "Written",
                  "payload_bytes_written": 1,
                  "pty_bytes_written": 1
                }
              }
            }
          }
        }
      },
      "because": "Core AM-2"
    },
    {
      "route_send": {
        "frame": "bytes",
        "op": "2",
        "bytes": {
          "$bytes_hex": "43"
        }
      },
      "route": "r1"
    },
    {
      "route_expect_pty": [
        {
          "hex": "41"
        },
        {
          "hex": "42"
        },
        {
          "hex": "43"
        }
      ],
      "route": "r1",
      "because": [
        "Core AM-2",
        "Core DP-4"
      ]
    }
  ]
}

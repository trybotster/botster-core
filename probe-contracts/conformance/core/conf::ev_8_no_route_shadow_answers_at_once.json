{
  "id": "conf::ev_8_no_route_shadow_answers_at_once",
  "contract": "core",
  "clause": "EV-8",
  "subject": "core",
  "requires": {
    "controls": [
      "edges_quiet",
      "oracle_query_reply",
      "pty_input",
      "pty_output"
    ]
  },
  "fake": "structural",
  "ruling": "R-12",
  "steps": [
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s1",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ]
            }
          }
        }
      },
      "bind": "$c_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$c_s1",
            "result": {
              "ok": {
                "record": {
                  "id": "s1",
                  "state": "Created"
                }
              }
            }
          }
        }
      },
      "because": "Core LC-3"
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "s1"
          }
        }
      },
      "bind": "$s_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$s_s1",
            "result": {
              "ok": {
                "record": {
                  "id": "s1",
                  "state": "Running"
                }
              }
            }
          }
        }
      },
      "because": "Core A2-1"
    },
    {
      "control": {
        "op": "oracle_query_reply",
        "session": "s1",
        "request_hex": "1b5b63"
      },
      "bind": "$or_sh"
    },
    {
      "let": {
        "$ans_sh": {
          "field": [
            "$or_sh",
            "answerable"
          ]
        }
      }
    },
    {
      "assume": {
        "eq": [
          "$ans_sh",
          true
        ]
      },
      "because": [
        "Core EV-8"
      ]
    },
    {
      "let": {
        "$sh": {
          "field": [
            "$or_sh",
            "reply_hex"
          ]
        }
      }
    },
    {
      "control": {
        "op": "pty_output",
        "session": "s1",
        "bytes_hex": "1b5b63"
      }
    },
    {
      "await_quiet": {}
    },
    {
      "let": {
        "$wl0": {
          "hex_len": [
            "$sh",
            0
          ]
        }
      }
    },
    {
      "await_pty": {
        "session": "s1",
        "min_bytes": "$wl0"
      }
    },
    {
      "await_quiet": {}
    },
    {
      "control": {
        "op": "pty_input",
        "session": "s1"
      },
      "bind_fields": {
        "bytes": "$in"
      }
    },
    {
      "let": {
        "$n_sh": {
          "hex_len": [
            "$sh",
            0
          ]
        }
      }
    },
    {
      "check": {
        "hex_prefix": [
          "$sh",
          "$in"
        ]
      },
      "because": [
        "Core EV-8"
      ]
    },
    {
      "check": {
        "hex_len_eq": [
          "$in",
          "$n_sh"
        ]
      },
      "because": [
        "Core EV-8"
      ]
    },
    {
      "attach_route": {
        "route": "r1",
        "session": "s1",
        "client": "c1",
        "options": {
          "history": "none",
          "answers_queries": false
        }
      },
      "because": "Core OU-1"
    },
    {
      "expect": {
        "frame": "attached",
        "terminal_format": {
          "$type": "string"
        }
      },
      "because": "Core OU-9",
      "on": "r1"
    },
    {
      "expect": {
        "frame": "baseline_begin",
        "rows": {
          "$type": "integer"
        },
        "cols": {
          "$type": "integer"
        },
        "modes": {
          "$type": "object"
        }
      },
      "because": "Core OU-9",
      "on": "r1"
    },
    {
      "expect": {
        "frame": "screen",
        "payload": {
          "$any": true
        }
      },
      "because": "Core OU-9",
      "on": "r1"
    },
    {
      "expect_eventually": {
        "frame": "baseline_end",
        "history": "not_requested"
      },
      "because": "Core OU-9",
      "ignore": [
        {
          "frame": "history",
          "payload": {
            "$any": true
          }
        }
      ],
      "on": "r1"
    },
    {
      "expect": {
        "frame": "live"
      },
      "because": "Core OU-9",
      "on": "r1"
    },
    {
      "control": {
        "op": "pty_output",
        "session": "s1",
        "bytes_hex": "1b5b63"
      }
    },
    {
      "await_quiet": {}
    },
    {
      "let": {
        "$wl0": {
          "hex_len": [
            "$sh",
            0
          ]
        }
      }
    },
    {
      "let": {
        "$wl1": {
          "hex_len": [
            "$sh",
            0
          ]
        }
      }
    },
    {
      "let": {
        "$ws1": {
          "add": [
            "$wl0",
            "$wl1"
          ]
        }
      }
    },
    {
      "await_pty": {
        "session": "s1",
        "min_bytes": "$ws1"
      }
    },
    {
      "await_quiet": {}
    },
    {
      "control": {
        "op": "pty_input",
        "session": "s1"
      },
      "bind_fields": {
        "bytes": "$in"
      }
    },
    {
      "check": {
        "hex_ends_with": [
          "$in",
          "$sh"
        ]
      },
      "because": [
        "Core EV-8"
      ]
    },
    {
      "expect_quiet_until": {
        "frame": "terminal_query"
      },
      "barrier": {
        "route_send": {
          "frame": "input",
          "kind": "paste_commit",
          "op": "99"
        },
        "route": "r1"
      },
      "until": {
        "frame": "input_refused",
        "op": "99",
        "reason": "refused"
      },
      "on": "r1",
      "because": [
        "Core EV-8"
      ]
    }
  ]
}

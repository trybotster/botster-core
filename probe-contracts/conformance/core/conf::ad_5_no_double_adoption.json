{
  "id": "conf::ad_5_no_double_adoption",
  "contract": "core",
  "clause": "AD-5",
  "subject": "core",
  "setup": {
    "open": false
  },
  "steps": [
    {
      "data_dir": "d"
    },
    {
      "open": {
        "as": "a",
        "data_dir": "d"
      }
    },
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s1",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ]
            }
          }
        },
        "handle": "a"
      },
      "bind": "$c_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$c_s1",
            "result": {
              "ok": {
                "record": {
                  "id": "s1",
                  "state": "Created"
                }
              }
            }
          }
        },
        "handle": "a"
      },
      "because": "Core LC-3"
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "s1"
          }
        },
        "handle": "a"
      },
      "bind": "$s_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$s_s1",
            "result": {
              "ok": {
                "record": {
                  "id": "s1",
                  "state": "Running"
                }
              }
            }
          }
        },
        "handle": "a"
      },
      "because": "Core A2-1"
    },
    {
      "open": {
        "as": "b",
        "data_dir": "d"
      },
      "expect_error": {
        "code": "DataDirInUse"
      },
      "because": [
        "Core AD-5",
        "Core LC-2"
      ]
    },
    {
      "call": {
        "method": "get",
        "args": {
          "id": "s1"
        },
        "handle": "a"
      },
      "expect": {
        "id": "s1",
        "state": "Running"
      },
      "because": [
        "Core AD-5",
        "Core LC-2"
      ]
    },
    {
      "drop": {
        "handle": "a"
      }
    },
    {
      "open": {
        "as": "c",
        "data_dir": "d"
      }
    },
    {
      "begin": {
        "op": "AdoptAll",
        "handle": "c"
      },
      "bind": "$aa"
    },
    {
      "pump_collect": {
        "events": [
          {
            "SessionState": {
              "id": "s1",
              "state": "Running"
            }
          },
          {
            "Completed": {
              "op": "$aa",
              "result": {
                "ok": "unit"
              }
            }
          }
        ],
        "handle": "c"
      },
      "because": [
        "Core AD-5",
        "Core AD-1",
        "Core A2-1"
      ]
    }
  ]
}

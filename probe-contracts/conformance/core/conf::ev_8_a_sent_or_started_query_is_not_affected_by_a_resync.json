{
  "id": "conf::ev_8_a_sent_or_started_query_is_not_affected_by_a_resync",
  "contract": "core",
  "clause": "EV-8",
  "subject": "core",
  "requires": {
    "controls": [
      "edges_quiet",
      "pty_input",
      "pty_output",
      "queue_overflow",
      "route_gate"
    ]
  },
  "fake": "structural",
  "ruling": "R-12",
  "steps": [
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s1",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ]
            }
          }
        }
      },
      "bind": "$c_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$c_s1",
            "result": {
              "ok": {
                "record": {
                  "id": "s1",
                  "state": "Created"
                }
              }
            }
          }
        }
      },
      "because": "Core LC-3"
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "s1"
          }
        }
      },
      "bind": "$s_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$s_s1",
            "result": {
              "ok": {
                "record": {
                  "id": "s1",
                  "state": "Running"
                }
              }
            }
          }
        }
      },
      "because": "Core A2-1"
    },
    {
      "attach_route": {
        "route": "r1",
        "session": "s1",
        "client": "c1",
        "options": {
          "history": "none",
          "answers_queries": true,
          "query_deadline": 60000
        }
      },
      "because": "Core OU-1"
    },
    {
      "expect": {
        "frame": "attached",
        "terminal_format": {
          "$type": "string"
        }
      },
      "because": "Core OU-9",
      "on": "r1"
    },
    {
      "expect": {
        "frame": "baseline_begin",
        "rows": {
          "$type": "integer"
        },
        "cols": {
          "$type": "integer"
        },
        "modes": {
          "$type": "object"
        }
      },
      "because": "Core OU-9",
      "on": "r1"
    },
    {
      "expect": {
        "frame": "screen",
        "payload": {
          "$any": true
        }
      },
      "because": "Core OU-9",
      "on": "r1"
    },
    {
      "expect_eventually": {
        "frame": "baseline_end",
        "history": "not_requested"
      },
      "because": "Core OU-9",
      "ignore": [
        {
          "frame": "history",
          "payload": {
            "$any": true
          }
        }
      ],
      "on": "r1"
    },
    {
      "expect": {
        "frame": "live"
      },
      "because": "Core OU-9",
      "on": "r1"
    },
    {
      "control": {
        "op": "pty_output",
        "session": "s1",
        "bytes_hex": "1b5b63"
      }
    },
    {
      "await_quiet": {}
    },
    {
      "expect_eventually": {
        "frame": "terminal_query",
        "query_id": "$q1"
      },
      "because": [
        "Core EV-8",
        "Core DP-3"
      ],
      "ignore": [
        {
          "$any": true
        }
      ],
      "on": "r1"
    },
    {
      "control": {
        "op": "queue_overflow"
      },
      "route": "r1"
    },
    {
      "expect_eventually": {
        "frame": "resync",
        "reason": "overflow"
      },
      "because": [
        "Core EV-8",
        "Core OU-9"
      ],
      "ignore": [
        {
          "frame": "modes"
        },
        {
          "frame": "output"
        },
        {
          "frame": "output_deflate"
        }
      ],
      "on": "r1"
    },
    {
      "expect_eventually": {
        "frame": "live"
      },
      "because": [
        "Core EV-8",
        "Core OU-9"
      ],
      "ignore": [
        {
          "$any": true
        }
      ],
      "on": "r1"
    },
    {
      "route_send": {
        "frame": "input",
        "kind": "reply_terminal_query",
        "op": "1",
        "query_id": "$q1",
        "reply": {
          "encoded": {
            "bytes_base64": "G1s/NjJj"
          }
        }
      },
      "route": "r1"
    },
    {
      "let": {
        "$wl0": {
          "hex_len": [
            "1b5b3f363263",
            0
          ]
        }
      }
    },
    {
      "await_pty": {
        "session": "s1",
        "min_bytes": "$wl0"
      }
    },
    {
      "await_quiet": {}
    },
    {
      "control": {
        "op": "pty_input",
        "session": "s1"
      },
      "bind_fields": {
        "bytes": "$in"
      }
    },
    {
      "let": {
        "$n_lit": {
          "hex_len": [
            "1b5b3f363263",
            0
          ]
        }
      }
    },
    {
      "check": {
        "hex_prefix": [
          "1b5b3f363263",
          "$in"
        ]
      },
      "because": [
        "Core EV-8"
      ]
    },
    {
      "check": {
        "hex_len_eq": [
          "$in",
          "$n_lit"
        ]
      },
      "because": [
        "Core EV-8"
      ]
    }
  ]
}

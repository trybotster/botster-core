    {
      "expect": {
        "frame": "live"
      },
      "on": "r4",
      "because": [
        "Core OU-9",
        "Codec TS-4"
      ]
    },
    {
      "control": {
        "op": "lose_worker",
        "session": "s1"
      }
    },
    {
      "pump_until": {
        "event": {
          "RouteClosed": {
            "route": "$r4",
            "reason": "SessionLost"
          }
        }
      },
      "because": [
        "Core OU-2b",
        "Core A2-3"
      ]
    },
    {
      "expect_closed": {
        "ended": "session_lost"
      },
      "on": "r4",

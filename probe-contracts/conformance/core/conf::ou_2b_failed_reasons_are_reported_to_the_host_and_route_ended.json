    {
      "control": {
        "op": "fail_writes"
      },
      "route": "r2"
    },
    {
      "control": {
        "op": "pty_output",
        "session": "s1",
        "bytes_hex": "41"
      }
    },
    {
      "pump_until": {
        "event": {
          "RouteClosed": {
            "route": "$r2",
            "reason": "WriteFailed"
          }
        }
      },
      "because": [
        "Core OU-2b",
        "Core A2-3"
      ]
    },
    {
      "expect_closed": {
        "ended": "write_failed"
      },
      "on": "r2",
      "because": [
        "Core OU-2b"
      ]
    },
    {
      "control": {
        "op": "route_gate",
        "on": true
      },
      "route": "r3"
    },
    {
      "control": {
        "op": "pty_output",
        "session": "s1",
        "bytes_hex": "41"
      }
    },
    {
      "await_quiet": {}
    },
    {
      "advance_clock": {
        "ms": 1000
      }
    },
    {
      "pump_until": {
        "event": {
          "RouteStalled": {
            "route": "$r3"
          }
        }
      },
      "because": "Core OU-2"
    },
    {
      "await_quiet": {}
    },
    {
      "advance_clock": {
        "ms": 6000
      }
    },
    {
      "pump_until": {
        "event": {
          "RouteClosed": {
            "route": "$r3",
            "reason": "StallTimeout"
          }
        }
      },
      "because": [
        "Core OU-2b",
        "Core A2-3"
      ]
    },
    {
      "expect_closed": {
        "ended": "stalled"
      },
      "on": "r3",
      "because": [
        "Core OU-2b"
      ]
    },
    {
      "attach_route": {
        "route": "r4",
        "session": "s1",
        "client": "c4",

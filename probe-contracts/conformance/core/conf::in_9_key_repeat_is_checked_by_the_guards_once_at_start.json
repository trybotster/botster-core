{
  "id": "conf::in_9_key_repeat_is_checked_by_the_guards_once_at_start",
  "contract": "core",
  "clause": "IN-9",
  "subject": "core",
  "requires": {
    "controls": [
      "pty_output"
    ]
  },
  "steps": [
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s1",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ],
              "fake": {
                "writes": {
                  "key": "61",
                  "mouse": "4d",
                  "focus_in": "49",
                  "focus_out": "4f",
                  "paste": "1b5b3230307e68656c6c6f1b5b3230317e"
                },
                "admission": {
                  "key": 12,
                  "mouse": 12,
                  "focus": 3,
                  "paste": 64
                }
              }
            }
          }
        }
      },
      "bind": "$c_s1"
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "s1"
          }
        }
      },
      "bind": "$s_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$s_s1",
            "result": {}
          }
        }
      },
      "because": "Core LC-3"
    },
    {
      "pump": {}
    },
    {
      "call": {
        "method": "terminal_state",
        "args": {
          "id": "s1"
        }
      },
      "expect": {
        "input_rev": {
          "client": "$a",
          "host": "$h"
        },
        "model_rev": "$m"
      },
      "because": "Core ST-4"
    },
    {
      "control": {
        "op": "pty_output",
        "session": "s1",
        "bytes_hex": "78"
      }
    },
    {
      "pump": {}
    },
    {
      "begin": {
        "op": {
          "WriteInput": {
            "session": "s1",
            "payload": {
              "key": {
                "key": {
                  "char": "a"
                },
                "mods": [],
                "event": "press",
                "text": "a",
                "repeat": 3
              }
            },
            "guard": {
              "model_rev": "$m"
            }
          }
        }
      },
      "bind": "$w"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$w",
            "result": {
              "ok": {
                "input": {
                  "outcome": {
                    "NotWritten": "Stale"
                  },
                  "payload_bytes_written": 0,
                  "pty_bytes_written": 0
                }
              }
            }
          }
        }
      },
      "because": [
        "Core IN-9",
        "Core IN-10"
      ]
    },
    {
      "pump": {}
    },
    {
      "call": {
        "method": "terminal_state",
        "args": {
          "id": "s1"
        }
      },
      "expect": {
        "input_rev": {
          "client": "$a2",
          "host": "$h2"
        },
        "model_rev": "$m2"
      },
      "because": "Core ST-4"
    },
    {
      "begin": {
        "op": {
          "WriteInput": {
            "session": "s1",
            "payload": {
              "key": {
                "key": {
                  "char": "a"
                },
                "mods": [],
                "event": "press",
                "text": "a",
                "repeat": 3
              }
            },
            "guard": {
              "model_rev": "$m2"
            }
          }
        }
      },
      "bind": "$w2"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$w2",
            "result": {
              "ok": {
                "input": {
                  "outcome": "Written",
                  "payload_bytes_written": "$p",
                  "pty_bytes_written": "$q"
                }
              }
            }
          }
        }
      },
      "because": [
        "Core IN-9",
        "Core IN-10"
      ]
    },
    {
      "check": {
        "lt": [
          0,
          "$q"
        ]
      },
      "because": "Core IN-9"
    }
  ]
}

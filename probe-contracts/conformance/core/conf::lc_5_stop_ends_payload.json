{
  "id": "conf::lc_5_stop_ends_payload",
  "contract": "core",
  "clause": "LC-5",
  "subject": "core",
  "setup": {
    "limits": {
      "stop_grace": 100
    }
  },
  "steps": [
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s1",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ]
            }
          }
        }
      },
      "bind": "$c_s1"
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "s1"
          }
        }
      },
      "bind": "$s_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$s_s1",
            "result": {}
          }
        }
      },
      "because": "Core LC-3"
    },
    {
      "begin": {
        "op": {
          "Stop": {
            "id": "s1"
          }
        }
      },
      "bind": "$p"
    },
    {
      "expect_eventually": {
        "SessionState": {
          "id": "s1",
          "state": {
            "Exited": {
              "cause": "HostStop"
            }
          }
        }
      },
      "because": [
        "Core LC-5",
        "Core A2-1"
      ],
      "ignore": [
        {
          "SessionState": {
            "id": "s1",
            "state": "Stopping"
          }
        }
      ]
    },
    {
      "expect": {
        "Completed": {
          "op": "$p",
          "result": {
            "ok": {
              "end": {
                "Exited": {
                  "cause": "HostStop"
                }
              }
            }
          }
        }
      },
      "because": [
        "Core LC-5",
        "Core A2-1",
        "Core OR-2"
      ]
    },
    {
      "call": {
        "method": "get",
        "args": {
          "id": "s1"
        }
      },
      "expect": {
        "state": {
          "Exited": {
            "cause": "HostStop"
          }
        }
      },
      "because": "Core LC-5"
    },
    {
      "begin": {
        "op": {
          "Stop": {
            "id": "s1"
          }
        }
      },
      "bind": "$p2"
    },
    {
      "pump": {}
    },
    {
      "poll_events": {
        "max": 64
      },
      "expect": [
        {
          "Completed": {
            "op": "$p2",
            "result": {
              "ok": {
                "end": {
                  "Exited": {
                    "cause": "HostStop"
                  }
                }
              }
            }
          }
        }
      ],
      "because": [
        "Core LC-5"
      ]
    },
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s2",
            "request": {
              "program": [
                {
                  "ignore_sigterm": {}
                },
                {
                  "print": {
                    "bytes_hex": "2a"
                  }
                },
                {
                  "hold": {}
                }
              ]
            }
          }
        }
      },
      "bind": "$c_s2"
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "s2"
          }
        }
      },
      "bind": "$s_s2"
    },
    {
      "pump_collect": {
        "events": [
          {
            "Completed": {
              "op": "$s_s2",
              "result": {}
            }
          },
          {
            "Activity": {
              "id": "s2",
              "source": "Output"
            }
          }
        ]
      },
      "because": [
        "Core LC-3",
        "Core A5-1",
        "Core LC-5"
      ]
    },
    {
      "begin": {
        "op": {
          "Stop": {
            "id": "s2"
          }
        }
      },
      "bind": "$p3"
    },
    {
      "pump_until": {
        "event": {
          "SessionState": {
            "id": "s2",
            "state": "Stopping"
          }
        }
      },
      "because": [
        "Core LC-5",
        "Core A2-1"
      ]
    },
    {
      "advance_clock": {
        "ms": 100
      }
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$p3",
            "result": {
              "ok": {
                "end": {
                  "Exited": {
                    "cause": "Killed"
                  }
                }
              }
            }
          }
        }
      },
      "because": [
        "Core LC-5",
        "Core A2-1"
      ]
    }
  ]
}

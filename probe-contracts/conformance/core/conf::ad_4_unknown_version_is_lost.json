{
  "id": "conf::ad_4_unknown_version_is_lost",
  "contract": "core",
  "clause": "AD-4",
  "subject": "core",
  "requires": {
    "controls": [
      "announce_protocol"
    ]
  },
  "fake": "structural",
  "ruling": "R-12",
  "steps": [
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s1",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ]
            }
          }
        }
      },
      "bind": "$c_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$c_s1",
            "result": {
              "ok": {
                "record": {
                  "id": "s1",
                  "state": "Created"
                }
              }
            }
          }
        }
      },
      "because": "Core LC-3"
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "s1"
          }
        }
      },
      "bind": "$s_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$s_s1",
            "result": {
              "ok": {
                "record": {
                  "id": "s1",
                  "state": "Running"
                }
              }
            }
          }
        }
      },
      "because": "Core A2-1"
    },
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s2",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ]
            }
          }
        }
      },
      "bind": "$c_s2"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$c_s2",
            "result": {
              "ok": {
                "record": {
                  "id": "s2",
                  "state": "Created"
                }
              }
            }
          }
        }
      },
      "because": "Core LC-3"
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "s2"
          }
        }
      },
      "bind": "$s_s2"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$s_s2",
            "result": {
              "ok": {
                "record": {
                  "id": "s2",
                  "state": "Running"
                }
              }
            }
          }
        }
      },
      "because": "Core A2-1"
    },
    {
      "call": {
        "method": "worker_protocol"
      },
      "expect": "$t",
      "because": "Core AD-4"
    },
    {
      "let": {
        "$tp1": {
          "add": [
            "$t",
            1
          ]
        },
        "$tp2": {
          "add": [
            "$t",
            2
          ]
        }
      }
    },
    {
      "control": {
        "op": "announce_protocol",
        "session": "s1",
        "protocol": "$tp1"
      }
    },
    {
      "control": {
        "op": "announce_protocol",
        "session": "s2",
        "protocol": "$tp2"
      }
    },
    {
      "drop": {
        "handle": "h"
      }
    },
    {
      "open": {
        "as": "h2"
      }
    },
    {
      "begin": {
        "op": "AdoptAll",
        "handle": "h2"
      },
      "bind": "$aa"

            }
          },
          {
            "SessionState": {
              "id": "s2",
              "state": {
                "Lost": "WorkerVersion"
              }
            }
          },
          {
            "Completed": {
              "op": "$aa",
              "result": {
                "ok": "unit"
              }
            }
          }
        ],
        "handle": "h2"

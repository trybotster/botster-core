{
  "id": "conf::a12_1b_partial_cleanup_claims_no_paths",
  "contract": "core",
  "clause": "A12-1b",
  "subject": "core",
  "requires": {
    "controls": [
      "edges_quiet",
      "fs_directory",
      "fs_list",
      "hold_cleanup_after",
      "lose_worker",
      "pty_input",
      "pty_output"
    ]
  },
  "fake": "structural",
  "ruling": "R-12",
  "steps": [
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s1",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ]
            }
          }
        }
      },
      "bind": "$c_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$c_s1",
            "result": {
              "ok": {
                "record": {
                  "id": "s1",
                  "state": "Created"
                }
              }
            }
          }
        }
      },
      "because": "Core LC-3"
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "s1"
          }
        }
      },
      "bind": "$s_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$s_s1",
            "result": {
              "ok": {
                "record": {
                  "id": "s1",
                  "state": "Running"
                }
              }
            }
          }
        }
      },
      "because": "Core A2-1"
    },
    {
      "control": {
        "op": "fs_directory"
      },
      "bind_fields": {
        "path": "$dir",
        "name_max": "$name_max"
      }
    },
    {
      "attach_route": {
        "route": "r1",
        "session": "s1",
        "client": "c1",
        "options": {
          "history": "none",
          "file_directory": "$dir"
        }
      },
      "because": "Core OU-1"
    },
    {
      "expect": {
        "frame": "attached",
        "terminal_format": {
          "$type": "string"
        }
      },
      "because": "Core OU-9",
      "on": "r1"
    },
    {
      "expect": {
        "frame": "baseline_begin",
        "rows": {
          "$type": "integer"
        },
        "cols": {
          "$type": "integer"
        },
        "modes": {
          "$type": "object"
        }
      },
      "because": "Core OU-9",
      "on": "r1"
    },
    {
      "expect": {
        "frame": "screen",
        "payload": {
          "$any": true
        }
      },
      "because": "Core OU-9",
      "on": "r1"
    },
    {
      "expect_eventually": {
        "frame": "baseline_end",
        "history": "not_requested"
      },
      "because": "Core OU-9",
      "ignore": [
        {
          "frame": "history",
          "payload": {
            "$any": true
          }
        }
      ],
      "on": "r1"
    },
    {
      "expect": {
        "frame": "live"
      },
      "because": "Core OU-9",
      "on": "r1"
    },
    {
      "route_send": {
        "frame": "input",
        "kind": "file_begin",
        "op": "1",
        "name": "a.txt"
      }
    },
    {
      "route_send": {
        "frame": "file_chunk",
        "op": "1",
        "bytes": {
          "$bytes_hex": "61"
        }
      }
    },
    {
      "route_send": {
        "frame": "input",
        "kind": "file_commit",
        "op": "1"
      }
    },
    {
      "expect_eventually": {
        "frame": "input_done",
        "op": "1",
        "written_bytes": "$wb1",
        "path": "$p1"
      },
      "because": [
        "Core A6-3",
        "Core LC-7",
        "Core DP-5b"
      ],
      "ignore": [
        {
          "frame": "modes"
        },
        {
          "frame": "output"
        },
        {
          "frame": "output_deflate"
        }
      ],
      "on": "r1"
    },
    {
      "route_send": {
        "frame": "input",
        "kind": "file_begin",
        "op": "2",
        "name": "b.txt"
      }
    },
    {
      "route_send": {
        "frame": "file_chunk",
        "op": "2",
        "bytes": {
          "$bytes_hex": "62"
        }
      }
    },
    {
      "route_send": {
        "frame": "input",
        "kind": "file_commit",
        "op": "2"
      }
    },
    {
      "expect_eventually": {
        "frame": "input_done",
        "op": "2",
        "written_bytes": "$wb2",
        "path": "$p2"
      },
      "because": [
        "Core A6-3",
        "Core LC-7",
        "Core DP-5b"
      ],
      "ignore": [
        {
          "frame": "modes"
        },
        {
          "frame": "output"
        },
        {
          "frame": "output_deflate"
        }
      ],
      "on": "r1"
    },
    {
      "route_send": {
        "frame": "input",
        "kind": "file_begin",
        "op": "3",
        "name": "c.txt"
      }
    },
    {
      "route_send": {
        "frame": "file_chunk",
        "op": "3",
        "bytes": {
          "$bytes_hex": "63"
        }
      }
    },
    {
      "route_send": {
        "frame": "input",
        "kind": "file_commit",
        "op": "3"
      }
    },
    {
      "expect_eventually": {
        "frame": "input_done",
        "op": "3",
        "written_bytes": "$wb3",
        "path": "$p3"
      },
      "because": [
        "Core A6-3",
        "Core LC-7",
        "Core DP-5b"
      ],
      "ignore": [
        {
          "frame": "modes"
        },
        {
          "frame": "output"
        },
        {
          "frame": "output_deflate"
        }
      ],
      "on": "r1"
    },
    {
      "control": {
        "op": "fs_list",
        "path": "$dir"
      },
      "expect": {
        "count": 3
      },
      "because": [
        "Core A6-3",
        "Core LC-7",
        "Core DP-5b"
      ]
    },
    {
      "begin": {
        "op": {
          "Stop": {
            "id": "s1"
          }
        }
      },
      "bind": "$stp"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$stp",
            "result": {
              "ok": {
                "end": {
                  "$any": true
                }
              }
            }
          }
        }
      },
      "because": [
        "Core LC-5",
        "Core A2-1"
      ]
    },
    {
      "control": {
        "op": "hold_cleanup_after",
        "session": "s1",
        "deleted": 1
      }
    },
    {
      "begin": {
        "op": {
          "Remove": {
            "id": "s1"
          }
        }
      },
      "bind": "$rm"
    },
    {
      "await_control": {
        "control": {
          "op": "fs_list",
          "path": "$dir"
        },
        "expect": {
          "count": 2
        }
      }
    },
    {
      "control": {
        "op": "lose_worker",
        "session": "s1",
        "reason": "worker_gone"
      }
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$rm",
            "result": {
              "ok": {
                "remove_report": {
                  "uploads": {
                    "not_deleted": {
                      "reason": "outcome_unknown",
                      "paths": {
                        "$absent": true
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "because": [
        "Core A12-1",
        "Core A6-3",
        "Core LC-7"
      ]
    },
    {
      "control": {
        "op": "fs_list",
        "path": "$dir"
      },
      "expect": {
        "count": {
          "$between": [
            1,
            2
          ]
        }
      },
      "because": [
        "Core A12-1",
        "Core A6-3",
        "Core LC-7"
      ]
    },
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s1",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ]
            }
          }
        }
      },
      "bind": "$again"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$again",
            "result": {
              "ok": {
                "record": {
                  "id": "s1",
                  "state": "Created"
                }
              }
            }
          }
        }
      },
      "because": [
        "Core A6-3",
        "Core LC-7"
      ]
    }
  ]
}

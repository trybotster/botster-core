{
  "id": "conf::in_6_refused_full_wakes_on_room",
  "contract": "core",
  "clause": "IN-6",
  "subject": "core",
  "requires": {
    "controls": [
      "pty_chunk",
      "control_queue"
    ]
  },
  "steps": [
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s1",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ]
            }
          }
        }
      },
      "bind": "$c_s1"
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "s1"
          }
        }
      },
      "bind": "$s_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$s_s1",
            "result": {}
          }
        }
      },
      "because": "Core LC-3"
    },
    {
      "control": {
        "op": "pty_chunk",
        "session": "s1",
        "bytes": 1
      }
    },
    {
      "control": {
        "op": "control_queue",
        "session": "s1",
        "on": true
      }
    },
    {
      "begin": {
        "op": {
          "WriteInput": {
            "session": "s1",
            "payload": {
              "bytes": {
                "bytes": {
                  "$bytes_hex": "6162"
                }
              }
            }
          }
        }
      },
      "bind": "$w"
    },
    {
      "call": {
        "method": "cancel",
        "args": {
          "op": "$w"
        }
      },
      "expect": {
        "Refused": "Full"
      },
      "because": "Core IN-6"
    },
    {
      "control": {
        "op": "control_queue",
        "session": "s1",
        "on": false
      }
    },
    {
      "pump_until": {
        "event": {
          "SessionWritable": {
            "id": "s1"
          }
        }
      },
      "because": "Core IN-6"
    },
    {
      "call": {
        "method": "cancel",
        "args": {
          "op": "$w"
        }
      },
      "expect": "Admitted",
      "because": "Core IN-6"
    }
  ]
}

{
  "id": "conf::a3_2_stall_changes_no_focus_value_and_posts_no_focus_changed",
  "contract": "core",
  "clause": "OU-2",
  "subject": "core",
  "requires": {
    "controls": [
      "edges_quiet",
      "pty_input",
      "pty_output",
      "route_gate"
    ]
  },
  "setup": {
    "limits": {
      "reader_progress_deadline": 1000,
      "stall_close_after": 5000
    }
  },
  "steps": [
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s1",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ]
            }
          }
        }
      },
      "bind": "$c_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$c_s1",
            "result": {
              "ok": {
                "record": {
                  "id": "s1",
                  "state": "Created"
                }
              }
            }
          }
        }
      },
      "because": "Core LC-3"
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "s1"
          }
        }
      },
      "bind": "$s_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$s_s1",
            "result": {
              "ok": {
                "record": {
                  "id": "s1",
                  "state": "Running"
                }
              }
            }
          }
        }
      },
      "because": "Core A2-1"
    },
    {
      "attach_route": {
        "route": "r1",
        "session": "s1",
        "client": "c1",
        "options": {
          "history": "none"
        }
      },
      "because": "Core OU-1"
    },
    {
      "expect": {
        "frame": "attached",
        "terminal_format": {
          "$type": "string"
        }
      },
      "on": "r1",
      "because": [
        "Core OU-1",
        "Codec TS-1"
      ]
    },
    {
      "expect": {
        "frame": "baseline_begin",
        "rows": {
          "$type": "integer"
        },
        "cols": {
          "$type": "integer"
        },
        "modes": {
          "$type": "object"
        }
      },
      "on": "r1",
      "because": [
        "Core OU-9",
        "Codec TS-4"
      ]
    },
    {
      "expect": {
        "frame": "screen",
        "payload": {
          "$any": true
        }
      },
      "on": "r1",
      "because": [
        "Core OU-9",
        "Codec TS-4"
      ]
    },
    {
      "expect_eventually": {
        "frame": "baseline_end",
        "history": "not_requested"
      },
      "ignore": [
        {
          "frame": "history",
          "payload": {
            "$any": true
          }
        }
      ],
      "on": "r1",
      "because": [
        "Core OU-9",
        "Codec TS-4"
      ]
    },
    {
      "expect": {
        "frame": "live"
      },
      "on": "r1",
      "because": [
        "Core OU-9",
        "Codec TS-4"
      ]
    },
    {
      "control": {
        "op": "pty_output",
        "session": "s1",
        "bytes_hex": "1b5b3f3130303468"
      }
    },
    {
      "pump_until": {
        "event": {
          "ModesChanged": {
            "id": "s1",
            "flags": {
              "focus_reporting": true
            }
          }
        }
      },
      "because": "Core EV-7"
    },
    {
      "route_send": {
        "frame": "input",
        "kind": "focus",
        "op": "1",
        "focused": true
      },
      "route": "r1"
    },
    {
      "pump_until": {
        "event": {
          "FocusChanged": {
            "id": "s1",
            "focused": "Focused"
          }
        }
      },
      "because": [
        "Core DP-12",
        "Core EV-6"
      ]
    },
    {
      "await_quiet": {}
    },
    {
      "control": {
        "op": "pty_input",
        "session": "s1"
      },
      "bind_fields": {
        "bytes": "$before"
      }
    },
    {
      "control": {
        "op": "route_gate",
        "on": true
      },
      "route": "r1"
    },
    {
      "control": {
        "op": "pty_output",
        "session": "s1",
        "bytes_hex": "41"
      }
    },
    {
      "await_quiet": {}
    },
    {
      "expect_quiet_until": {
        "FocusChanged": {
          "id": "s1"
        }
      },
      "barrier": {
        "advance_clock": {
          "ms": 1000
        }
      },
      "until": {
        "RouteStalled": {
          "route": "$r1"
        }
      },
      "because": [
        "Core A3-2",
        "Core OU-2"
      ]
    },
    {
      "await_quiet": {}
    },
    {
      "expect_quiet_until": {
        "FocusChanged": {
          "id": "s1"
        }
      },
      "barrier": {
        "begin": {
          "op": {
            "UpdateMetadata": {
              "id": "s1",
              "labels": {
                "fence": "1"
              }
            }
          }
        },
        "bind": "$bar"
      },
      "until": {
        "Completed": {
          "op": "$bar",
          "result": {
            "ok": "unit"
          }
        }
      },
      "because": [
        "Core A3-2",
        "Core OU-2"
      ]
    },
    {
      "call": {
        "method": "terminal_state",
        "args": {
          "id": "s1"
        }
      },
      "expect": {
        "focused": "Focused"
      },
      "because": [
        "Core A3-2"
      ]
    }
  ],
  "fake": "structural",
  "ruling": "R-12"
}

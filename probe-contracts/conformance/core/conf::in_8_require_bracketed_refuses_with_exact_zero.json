{
  "id": "conf::in_8_require_bracketed_refuses_with_exact_zero",
  "contract": "core",
  "clause": "IN-8",
  "subject": "core",
  "requires": {
    "controls": [
      "pty_input"
    ]
  },
  "steps": [
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s1",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ]
            }
          }
        }
      },
      "bind": "$c_s1"
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "s1"
          }
        }
      },
      "bind": "$s_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$s_s1",
            "result": {}
          }
        }
      },
      "because": "Core LC-3"
    },
    {
      "begin": {
        "op": {
          "WriteInput": {
            "session": "s1",
            "payload": {
              "paste": {
                "bytes": {
                  "$bytes_hex": "68656c6c6f"
                },
                "require_bracketed": true
              }
            }
          }
        }
      },
      "bind": "$p"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$p",
            "result": {
              "ok": {
                "input": {
                  "outcome": {
                    "NotWritten": "ModePreconditionFailed"
                  },
                  "payload_bytes_written": 0,
                  "pty_bytes_written": 0
                }
              }
            }
          }
        }
      },
      "because": [
        "Core IN-8",
        "Core IN-2"
      ]
    },
    {
      "control": {
        "op": "pty_input",
        "session": "s1"
      },
      "expect": {
        "bytes": {
          "$bytes_hex": ""
        }
      },
      "because": "Core IN-8"
    }
  ]
}

{
  "id": "conf::ou_9_attach_is_sync_baseline_in_pump",
  "contract": "core",
  "clause": "OU-9",
  "subject": "core",
  "requires": {
    "controls": [
      "edges_quiet",
      "hold_handoff",
      "oracle_screen",
      "oracle_screen_payload",
      "pty_output",
      "release_handoff",
      "route_stream_written"
    ]
  },
  "setup": {
    "limits": {
      "routes_per_session": 1
    }
  },
  "steps": [
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s1",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ]
            }
          }
        }
      },
      "bind": "$c_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$c_s1",
            "result": {
              "ok": {
                "record": {
                  "id": "s1",
                  "state": "Created"
                }
              }
            }
          }
        }
      },
      "because": "Core LC-3"
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "s1"
          }
        }
      },
      "bind": "$s_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$s_s1",
            "result": {
              "ok": {
                "record": {
                  "id": "s1",
                  "state": "Running"
                }
              }
            }
          }
        }
      },
      "because": "Core A2-1"
    },
    {
      "control": {
        "op": "oracle_screen",
        "session": "s1",
        "history": false
      },
      "expect": {
        "text": "$t0"
      },
      "because": [
        "Core OU-9",
        "Steward R-7"
      ]
    },
    {
      "control": {
        "op": "hold_handoff"
      },
      "because": [
        "Core OU-9",
        "Core A5-1"
      ]
    },
    {
      "attach_route": {
        "route": "r1",
        "session": "s1",
        "client": "c1",
        "options": {
          "history": "none"
        }
      },
      "because": [
        "Core OU-1",
        "Core OU-9"
      ]
    },
    {
      "attach_route": {
        "route": "r2",
        "session": "s1",
        "client": "c2",
        "options": {
          "history": "none"
        }
      },
      "expect_error": {
        "code": "RouteLimit"
      },
      "because": [
        "Core OU-9",
        "Core OU-1"
      ]
    },
    {
      "control": {
        "op": "route_stream_written"
      },
      "route": "r1",
      "expect": {
        "bytes": 0
      },
      "because": [
        "Core OU-9",
        "Steward R-14.3"
      ]
    },
    {
      "control": {
        "op": "pty_output",
        "session": "s1",
        "bytes_hex": "6d6f64656c2d6166746572"
      }
    },
    {
      "await_quiet": {}
    },
    {
      "control": {
        "op": "oracle_screen",
        "session": "s1",
        "history": false
      },
      "expect": {
        "text": "$t1"
      },
      "because": [
        "Core OU-9",
        "Steward R-7"
      ]
    },
    {
      "check": {
        "ne": [
          "$t1",
          "$t0"
        ]
      },
      "because": [
        "Core OU-9"
      ]
    },
    {
      "control": {
        "op": "route_stream_written"
      },
      "route": "r1",
      "expect": {
        "bytes": 0
      },
      "because": [
        "Core OU-9",
        "Steward R-14.3"
      ]
    },
    {
      "control": {
        "op": "release_handoff"
      },
      "because": [
        "Core OU-9",
        "Core A5-1"
      ]
    },
    {
      "await_quiet": {}
    },
    {
      "expect": {
        "frame": "attached",
        "terminal_format": {
          "$type": "string"
        }
      },
      "on": "r1",
      "because": [
        "Core OU-1",
        "Codec TS-1"
      ]
    },
    {
      "expect": {
        "frame": "baseline_begin",
        "rows": {
          "$type": "integer"
        },
        "cols": {
          "$type": "integer"
        },
        "modes": {
          "$type": "object"
        }
      },
      "on": "r1",
      "because": [
        "Core OU-9",
        "Codec TS-4"
      ]
    },
    {
      "expect": {
        "frame": "screen",
        "payload": "$scr"
      },
      "on": "r1",
      "because": [
        "Core OU-9",
        "Core DP-3"
      ]
    },
    {
      "expect_eventually": {
        "frame": "baseline_end",
        "history": "not_requested"
      },
      "ignore": [
        {
          "frame": "history",
          "payload": {
            "$any": true
          }
        }
      ],
      "on": "r1",
      "because": [
        "Core OU-9",
        "Codec TS-4"
      ]
    },
    {
      "expect": {
        "frame": "live"
      },
      "on": "r1",
      "because": [
        "Core OU-9",
        "Codec TS-4"
      ]
    },
    {
      "control": {
        "op": "oracle_screen_payload",
        "payload": "$scr"
      },
      "expect": {
        "text": "$t1"
      },
      "because": [
        "Core OU-9",
        "Core DP-3",
        "Steward R-7"
      ]
    },
    {
      "control": {
        "op": "pty_output",
        "session": "s1",
        "bytes_hex": "6c697665"
      }
    },
    {
      "await_quiet": {}
    },
    {
      "route_expect_output": {
        "bytes_hex": "6c697665"
      },
      "route": "r1",
      "because": [
        "Core OU-9",
        "Core OU-12"
      ]
    }
  ],
  "fake": "structural",
  "ruling": "R-12"
}

{
  "id": "conf::am_2_no_interleave_across_paste_markers",
  "contract": "core",
  "clause": "AM-2",
  "subject": "core",
  "requires": {
    "controls": [
      "pty_chunk",
      "pty_input"
    ]
  },
  "steps": [
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s1",
            "request": {
              "program": [
                {
                  "print": {
                    "bytes_hex": "1b5b3f3230303468",
                    "fake": {
                      "modes": {
                        "bracketed_paste": true
                      }
                    }
                  }
                },
                {
                  "hold": {}
                }
              ],
              "fake": {
                "writes": {
                  "paste": "1b5b3230307e68656c6c6f1b5b3230317e"
                }
              }
            }
          }
        }
      },
      "bind": "$c_s1"
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "s1"
          }
        }
      },
      "bind": "$s_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$s_s1",
            "result": {}
          }
        }
      },
      "because": "Core LC-3"
    },
    {
      "pump_until": {
        "event": {
          "ModesChanged": {
            "id": "s1",
            "flags": {
              "bracketed_paste": true
            }
          }
        }
      },
      "because": "Core EV-7"
    },
    {
      "attach_route": {
        "route": "r1",
        "session": "s1",
        "client": "c1"
      },
      "because": "Core OU-1"
    },
    {
      "expect": {
        "frame": "attached",
        "terminal_format": {
          "$type": "string"
        }
      },
      "on": "r1",
      "because": "Core OU-9"
    },
    {
      "expect": {
        "frame": "baseline_begin",
        "rows": {
          "$type": "integer"
        },
        "cols": {
          "$type": "integer"
        },
        "modes": {
          "$type": "object"
        }
      },
      "on": "r1",
      "because": "Core OU-9"
    },
    {
      "expect": {
        "frame": "screen",
        "payload": {
          "$any": true
        }
      },
      "on": "r1",
      "because": "Core OU-9"
    },
    {
      "expect_eventually": {
        "frame": "baseline_end",
        "history": "not_requested"
      },
      "ignore": [
        {
          "frame": "history",
          "payload": {
            "$any": true
          }
        }
      ],
      "on": "r1",
      "because": "Core OU-9"
    },
    {
      "expect": {
        "frame": "live"
      },
      "on": "r1",
      "because": "Core OU-9"
    },
    {
      "control": {
        "op": "pty_chunk",
        "session": "s1",
        "bytes": 1
      }
    },
    {
      "begin": {
        "op": {
          "WriteInput": {
            "session": "s1",
            "payload": {
              "paste": {
                "bytes": {
                  "$bytes_hex": "68656c6c6f"
                },
                "require_bracketed": false
              }
            }
          }
        }
      },
      "bind": "$w"
    },
    {
      "await_pty": {
        "session": "s1",
        "min_bytes": 1
      }
    },
    {
      "route_send": {
        "frame": "bytes",
        "op": "1",
        "bytes": {
          "$bytes_hex": "41"
        }
      },
      "route": "r1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$w",
            "result": {
              "ok": {
                "input": {
                  "outcome": "Written",
                  "payload_bytes_written": 5,
                  "pty_bytes_written": "$q"
                }
              }
            }
          }
        }
      },
      "because": [
        "Core AM-2",
        "Core IN-8"
      ]
    },
    {
      "control": {
        "op": "pty_input",
        "session": "s1"
      },
      "expect": {
        "bytes": "$log"
      },
      "because": [
        "Core AM-2",
        "Core IN-8"
      ]
    },
    {
      "check": {
        "hex_ends_with": [
          "$log",
          "41"
        ]
      },
      "because": [
        "Core AM-2"
      ]
    },
    {
      "check": {
        "gt": [
          "$q",
          5
        ]
      },
      "because": [
        "Core IN-8"
      ]
    }
  ],
  "fake": "structural",
  "ruling": "R-5"
}

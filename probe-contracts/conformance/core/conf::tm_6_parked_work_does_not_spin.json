{
  "id": "conf::tm_6_parked_work_does_not_spin",
  "contract": "core",
  "clause": "TM-6",
  "subject": "core",
  "requires": {
    "controls": [
      "pty_output"
    ]
  },
  "setup": {
    "limits": {
      "max_sessions": 2,
      "mandatory_events": 2,
      "stop_grace": 100
    }
  },
  "fake": "structural",
  "ruling": "R-12",
  "steps": [
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s1",
            "request": {
              "program": [
                {
                  "ignore_sigterm": {}
                },
                {
                  "print": {
                    "bytes_hex": "2a"
                  }
                },
                {
                  "hold": {}
                }
              ]
            }
          }
        }
      },
      "bind": "$c_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$c_s1",
            "result": {
              "ok": {
                "record": {
                  "id": "s1",
                  "state": "Created"
                }
              }
            }
          }
        }
      },
      "because": "Core LC-3"
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "s1"
          }
        }
      },
      "bind": "$s_s1"
    },
    {
      "pump_collect": {
        "events": [
          {
            "Completed": {
              "op": "$s_s1",
              "result": {
                "ok": {
                  "record": {
                    "id": "s1",
                    "state": "Running"
                  }
                }
              }
            }
          },
          {
            "Activity": {
              "id": "s1",
              "source": "Output"
            }
          }
        ]
      },
      "because": [
        "Core A2-1",
        "Core A5-1",
        "Core LC-5"
      ]
    },
    {
      "drain": {}
    },
    {
      "begin": {
        "op": {
          "Stop": {
            "id": "s1"
          }
        }
      },
      "bind": "$p1"
    },
    {
      "await_get": {
        "id": "s1",
        "expect": {
          "state": "Stopping"
        }
      }
    },
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s2",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ]
            }
          }
        }
      },
      "bind": "$c_s2"
    },
    {
      "pump_idle": {}
    },
    {
      "advance_clock": {
        "ms": 1000
      }
    },
    {
      "pump": {},
      "expect": {
        "more": false
      },
      "because": [
        "Core TM-6",
        "Core EV-5"
      ]
    },
    {
      "call": {
        "method": "next_deadline"
      },
      "expect": null,
      "because": [
        "Core TM-6",
        "Core TM-3"
      ]
    },
    {
      "pump": {},
      "expect": {
        "more": false,
        "events_posted": 0
      },
      "because": [
        "Core TM-6",
        "Core EV-5"
      ]
    },
    {
      "call": {
        "method": "get",
        "args": {
          "id": "s1"
        }
      },
      "expect": {
        "state": {
          "$one_of": [
            "Running",
            "Stopping"
          ]
        }
      },
      "because": [
        "Core EV-5"
      ]
    },
    {
      "poll_all": {}
    },
    {
      "pump_idle": {}
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$p1",
            "result": {
              "ok": {
                "end": {
                  "Exited": {
                    "$any": true
                  }
                }
              }
            }
          }
        }
      },
      "because": [
        "Core TM-6",
        "Core EV-5",
        "Core LC-5"
      ]
    }
  ]
}

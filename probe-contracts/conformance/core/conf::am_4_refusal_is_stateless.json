{
  "id": "conf::am_4_refusal_is_stateless",
  "contract": "core",
  "clause": "AM-4",
  "subject": "core",
  "setup": {
    "limits": {
      "pending_ops": 1
    }
  },
  "steps": [
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s1",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ]
            }
          }
        }
      },
      "bind": "$c1"
    },
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s2",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ]
            }
          }
        }
      },
      "bind": "$c2",
      "expect_error": {
        "code": "PendingLimit"
      },
      "because": [
        "Core AM-4",
        "Core ER-0"
      ]
    },
    {
      "expect_quiet_until": {
        "SessionState": {
          "id": "s2"
        }
      },
      "barrier": {
        "pump": {}
      },
      "until": {
        "Completed": {
          "op": "$c1",
          "result": {}
        }
      },
      "because": [
        "Core AM-4"
      ]
    },
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s2",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ]
            }
          }
        }
      },
      "bind": "$c2"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$c2",
            "result": {}
          }
        }
      },
      "because": "Core AM-4"
    }
  ]
}

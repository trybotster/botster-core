        "reason": "not_writable"
      },
      "on": "r3",
      "because": [
        "Core OU-10",
        "Core OU-1"
      ]
    },
    {
      "await_pty": {
        "session": "s1",
        "min_bytes": 2
      }
    },
    {
      "route_expect_pty": {
        "one_of": [
          [
            {
              "hex": "61"
            },
            {
              "hex": "62"
            }
          ],
          [
            {
              "hex": "62"
            },
            {
              "hex": "61"
            }
          ]
        ]
      },
      "because": [
        "Core OU-10",
        "Core IN-4"

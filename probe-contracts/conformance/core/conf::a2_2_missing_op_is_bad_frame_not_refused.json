{
  "id": "conf::a2_2_missing_op_is_bad_frame_not_refused",
  "contract": "core",
  "clause": "A2-2",
  "subject": "core",
  "fake": "structural",
  "ruling": "R-12",
  "steps": [
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s1",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ]
            }
          }
        }
      },
      "bind": "$c_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$c_s1",
            "result": {
              "ok": {
                "record": {
                  "id": "s1",
                  "state": "Created"
                }
              }
            }
          }
        }
      },
      "because": "Core LC-3"
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "s1"
          }
        }
      },
      "bind": "$s_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$s_s1",
            "result": {
              "ok": {
                "record": {
                  "id": "s1",
                  "state": "Running"
                }
              }
            }
          }
        }
      },
      "because": "Core A2-1"
    },
    {
      "attach_route": {
        "route": "r1",
        "session": "s1",
        "client": "c1"
      },
      "because": "Core OU-1"
    },
    {
      "expect": {
        "frame": "attached",
        "terminal_format": {
          "$type": "string"
        }
      },
      "on": "r1",
      "because": "Core OU-9"
    },
    {
      "expect": {
        "frame": "baseline_begin",
        "rows": {
          "$type": "integer"
        },
        "cols": {
          "$type": "integer"
        },
        "modes": {
          "$type": "object"
        }
      },
      "on": "r1",
      "because": "Core OU-9"
    },
    {
      "expect": {
        "frame": "screen",
        "payload": {
          "$any": true
        }
      },
      "on": "r1",
      "because": "Core OU-9"
    },
    {
      "expect_eventually": {
        "frame": "baseline_end",
        "history": "not_requested"
      },
      "ignore": [
        {
          "frame": "history",
          "payload": {
            "$any": true
          }
        }
      ],
      "on": "r1",
      "because": "Core OU-9"
    },
    {
      "expect": {
        "frame": "live"
      },
      "on": "r1",
      "because": "Core OU-9"
    },
    {
      "attach_route": {
        "route": "r2",
        "session": "s1",
        "client": "c2"
      },
      "because": "Core OU-1"
    },
    {
      "expect": {
        "frame": "attached",
        "terminal_format": {
          "$type": "string"
        }
      },
      "on": "r2",
      "because": "Core OU-9"
    },
    {
      "expect": {
        "frame": "baseline_begin",
        "rows": {
          "$type": "integer"
        },
        "cols": {
          "$type": "integer"
        },
        "modes": {
          "$type": "object"
        }
      },
      "on": "r2",
      "because": "Core OU-9"
    },
    {
      "expect": {
        "frame": "screen",
        "payload": {
          "$any": true
        }
      },
      "on": "r2",
      "because": "Core OU-9"
    },
    {
      "expect_eventually": {
        "frame": "baseline_end",
        "history": "not_requested"
      },
      "ignore": [
        {
          "frame": "history",
          "payload": {
            "$any": true
          }
        }
      ],
      "on": "r2",
      "because": "Core OU-9"
    },
    {
      "expect": {
        "frame": "live"
      },
      "on": "r2",
      "because": "Core OU-9"
    },
    {
      "route_send_raw": {
        "bytes_hex": "817b226b696e64223a2270617374655f626567696e227d"
      },
      "route": "r2"
    },
    {
      "expect": {
        "frame": "route_closed",
        "reason": {
          "protocol_error": {
            "code": "malformed_frame"
          }
        }
      },
      "on": "r2",
      "because": [
        "Core A2-2",
        "Codec A.1"
      ]
    },
    {
      "expect_closed": null,
      "on": "r2",
      "because": "Core A2-2"
    },
    {
      "pump_until": {
        "event": {
          "RouteClosed": {
            "route": "$r2",
            "reason": {
              "BadFrame": {
                "code": "malformed_frame"
              }
            }
          }
        }
      },
      "because": [
        "Core A2-2",
        "Core A2-3"
      ]
    },
    {
      "route_send_raw": {
        "bytes_hex": "82000000000000000061"
      },
      "route": "r1"
    },
    {
      "expect": {
        "frame": "route_closed",
        "reason": {
          "protocol_error": {
            "code": "malformed_frame"
          }
        }
      },
      "on": "r1",
      "because": [
        "Core A2-2",
        "Codec A.1"
      ]
    },
    {
      "expect_closed": null,
      "on": "r1",
      "because": "Core A2-2"
    },
    {
      "pump_until": {
        "event": {
          "RouteClosed": {
            "route": "$r1",
            "reason": {
              "BadFrame": {
                "code": "malformed_frame"
              }
            }
          }
        }
      },
      "because": [
        "Core A2-2",
        "Core A2-3"
      ]
    }
  ]
}

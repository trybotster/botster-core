{
  "id": "conf::tm_3_due_deadline_fires_in_pump",
  "contract": "core",
  "clause": "TM-3",
  "subject": "core",
  "requires": {
    "features": [
      "silence"
    ],
    "controls": [
      "pty_output"
    ]
  },
  "fake": "structural",
  "ruling": "R-12",
  "steps": [
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s1",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ]
            }
          }
        }
      },
      "bind": "$c_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$c_s1",
            "result": {
              "ok": {
                "record": {
                  "id": "s1",
                  "state": "Created"
                }
              }
            }
          }
        }
      },
      "because": "Core LC-3"
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "s1"
          }
        }
      },
      "bind": "$s_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$s_s1",
            "result": {
              "ok": {
                "record": {
                  "id": "s1",
                  "state": "Running"
                }
              }
            }
          }
        }
      },
      "because": "Core A2-1"
    },
    {
      "drain": {}
    },
    {
      "advance_clock": {
        "unix": 7000
      }
    },
    {
      "control": {
        "op": "pty_output",
        "session": "s1",
        "bytes_hex": "78"
      }
    },
    {
      "pump_until": {
        "event": {
          "Activity": {
            "id": "s1",
            "source": "Output",
            "at": 7000
          }
        }
      },
      "because": [
        "Core 6.2",
        "Core TM-1"
      ]
    },
    {
      "call": {
        "method": "set_silence_threshold",
        "args": {
          "id": "s1",
          "ms": 1000
        }
      }
    },
    {
      "drain": {}
    },
    {
      "advance_clock": {
        "ms": 1000
      }
    },
    {
      "pump": {},
      "bind": "$rep"
    },
    {
      "let": {
        "$n": {
          "field": [
            "$rep",
            "events_posted"
          ]
        }
      }
    },
    {
      "check": {
        "gt": [
          "$n",
          0
        ]
      },
      "because": [
        "Core TM-3"
      ]
    },
    {
      "poll_events": {
        "max": 64
      },
      "expect": [
        {
          "Silent": {
            "id": "s1"
          }
        }
      ],
      "because": [
        "Core TM-3",
        "Core TM-4"
      ]
    },
    {
      "call": {
        "method": "next_deadline"
      },
      "expect": null,
      "because": [
        "Core TM-3",
        "Core TM-4"
      ]
    }
  ]
}

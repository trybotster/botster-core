{
  "id": "conf::dp_6_host_resize_and_policy_latest_wins",
  "contract": "core",
  "clause": "DP-6",
  "subject": "core",
  "requires": {
    "controls": []
  },
  "steps": [
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s1",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ],
              "fake": {
                "writes": {
                  "key": "6b",
                  "paste": "70"
                },
                "admission": {
                  "key": 12,
                  "mouse": 12,
                  "focus": 3,
                  "paste": 64
                }
              }
            }
          }
        }
      },
      "bind": "$c_s1"
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "s1"
          }
        }
      },
      "bind": "$s_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$s_s1",
            "result": {}
          }
        }
      },
      "because": "Core LC-3"
    },
    {
      "attach_route": {
        "route": "r1",
        "session": "s1",
        "client": "c1"
      },
      "because": "Core OU-1"
    },
    {
      "expect": {
        "frame": "attached",
        "terminal_format": {
          "$type": "string"
        }
      },
      "on": "r1",
      "because": "Core OU-9"
    },
    {
      "expect": {
        "frame": "baseline_begin",
        "rows": {
          "$type": "integer"
        },
        "cols": {
          "$type": "integer"
        },
        "modes": {
          "$type": "object"
        }
      },
      "on": "r1",
      "because": "Core OU-9"
    },
    {
      "expect": {
        "frame": "screen",
        "payload": {
          "$any": true
        }
      },
      "on": "r1",
      "because": "Core OU-9"
    },
    {
      "expect_eventually": {
        "frame": "baseline_end",
        "history": "not_requested"
      },
      "ignore": [
        {
          "frame": "history",
          "payload": {
            "$any": true
          }
        }
      ],
      "on": "r1",
      "because": "Core OU-9"
    },
    {
      "expect": {
        "frame": "live"
      },
      "on": "r1",
      "because": "Core OU-9"
    },
    {
      "begin": {
        "op": {
          "SetSizePolicy": {
            "session": "s1",
            "policy": "latest"
          }
        }
      },
      "bind": "$p"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$p",
            "result": {
              "ok": "unit"
            }
          }
        }
      },
      "because": "Core DP-6"
    },
    {
      "begin": {
        "op": {
          "Resize": {
            "session": "s1",
            "size": {
              "rows": 25,
              "cols": 90
            }
          }
        }
      },
      "bind": "$z1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$z1",
            "result": {
              "ok": {
                "resize": {
                  "Applied": {
                    "actual": {
                      "rows": 25,
                      "cols": 90
                    }
                  }
                }
              }
            }
          }
        }
      },
      "because": [
        "Core DP-6",
        "Core SZ-1"
      ]
    },
    {
      "route_send": {
        "frame": "input",
        "kind": "resize",
        "op": "1",
        "rows": 30,
        "cols": 100
      }
    },
    {
      "expect_quiet_until": {
        "$one_of": [
          {
            "frame": "input_done"
          },
          {
            "frame": "input_refused",
            "op": {
              "$not": "99"
            }
          }
        ]
      },
      "barrier": {
        "route_send": {
          "frame": "input",
          "kind": "paste_commit",
          "op": "99"
        },
        "route": "r1"
      },
      "until": {
        "frame": "input_refused",
        "op": "99",
        "reason": "refused"
      },
      "on": "r1",
      "because": [
        "Core DP-5",
        "Core DP-6"
      ]
    },
    {
      "pump_until": {
        "event": {
          "SizeChanged": {
            "id": "s1",
            "size": {
              "rows": 30,
              "cols": 100
            }
          }
        }
      },
      "because": [
        "Core DP-6",
        "Core SZ-2"
      ]
    },
    {
      "begin": {
        "op": {
          "Resize": {
            "session": "s1",
            "size": {
              "rows": 20,
              "cols": 70
            }
          }
        }
      },
      "bind": "$z2"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$z2",
            "result": {
              "ok": {
                "resize": {
                  "Applied": {
                    "actual": {
                      "rows": 20,
                      "cols": 70
                    }
                  }
                }
              }
            }
          }
        }
      },
      "because": [
        "Core DP-6",
        "Core SZ-1"
      ]
    },
    {
      "call": {
        "method": "get",
        "args": {
          "id": "s1"
        }
      },
      "expect": {
        "size": {
          "rows": 20,
          "cols": 70
        }
      },
      "because": [
        "Core DP-6",
        "Core SZ-2"
      ]
    }
  ],
  "fake": "structural",
  "ruling": "R-12"
}

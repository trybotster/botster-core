{
  "id": "conf::ad_1_starting_without_identity_is_lost",
  "contract": "core",
  "clause": "AD-1",
  "subject": "core",
  "requires": {
    "controls": [
      "edges_quiet",
      "hold_start",
      "payload_alive",
      "registry_row"
    ]
  },
  "fake": "structural",
  "ruling": "R-12",
  "steps": [
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s1",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ]
            }
          }
        }
      },
      "bind": "$c_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$c_s1",
            "result": {
              "ok": {
                "record": {
                  "id": "s1",
                  "state": "Created"
                }
              }
            }
          }
        }
      },
      "because": "Core LC-3"
    },
    {
      "control": {
        "op": "hold_start",
        "session": "s1"
      }
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "s1"
          }
        }
      },
      "bind": "$s_s1"
    },
    {
      "await_quiet": {}
    },
    {
      "control": {
        "op": "registry_row",
        "session": "s1"
      },
      "expect": {
        "state": "Starting",
        "identity_recorded": false
      },
      "because": [
        "Core AD-7",
        "Core AD-1"
      ]
    },
    {
      "drop": {
        "handle": "h"
      }
    },
    {
      "open": {
        "as": "h2"
      }
    },
    {
      "begin": {
        "op": "AdoptAll",
        "handle": "h2"
      },
      "bind": "$aa"
    },
    {
      "pump_collect": {
        "events": [
          {
            "SessionState": {
              "id": "s1",
              "state": {
                "Lost": "StartInterrupted"
              }
            }
          },
          {
            "Completed": {
              "op": "$aa",
              "result": {
                "ok": "unit"
              }
            }
          }
        ],
        "handle": "h2"
      },
      "because": [
        "Core AD-1",
        "Core AD-2",
        "Core A2-1"
      ]
    },
    {
      "control": {
        "op": "payload_alive",
        "session": "s1",
        "handle": "h2"
      },
      "expect": {
        "alive": false
      },
      "because": [
        "Core AD-7"
      ]
    }
  ]
}

{
  "id": "conf::dp_5_input_done_answers_only_want_result_paste_and_file_commit",
  "contract": "core",
  "clause": "DP-5b",
  "subject": "core",
  "requires": {
    "controls": [
      "edges_quiet",
      "fs_directory",
      "fs_list",
      "pty_input",
      "pty_output"
    ]
  },
  "fake": "structural",
  "ruling": "R-12",
  "steps": [
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s1",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ]
            }
          }
        }
      },
      "bind": "$c_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$c_s1",
            "result": {
              "ok": {
                "record": {
                  "id": "s1",
                  "state": "Created"
                }
              }
            }
          }
        }
      },
      "because": "Core LC-3"
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "s1"
          }
        }
      },
      "bind": "$s_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$s_s1",
            "result": {
              "ok": {
                "record": {
                  "id": "s1",
                  "state": "Running"
                }
              }
            }
          }
        }
      },
      "because": "Core A2-1"
    },
    {
      "control": {
        "op": "pty_output",
        "session": "s1",
        "bytes_hex": "1b5b3f3230303468",
        "scripted": {
          "modes": {
            "bracketed_paste": true
          }
        }
      }
    },
    {
      "pump_until": {
        "event": {
          "ModesChanged": {
            "id": "s1",
            "flags": {
              "bracketed_paste": true
            }
          }
        }
      },
      "because": "Core EV-7"
    },
    {
      "control": {
        "op": "fs_directory"
      },
      "bind_fields": {
        "path": "$dir",
        "name_max": "$name_max"
      }
    },
    {
      "attach_route": {
        "route": "r1",
        "session": "s1",
        "client": "c1",
        "options": {
          "history": "none",
          "file_directory": "$dir"
        }
      },
      "because": "Core OU-1"
    },
    {
      "expect": {
        "frame": "attached",
        "terminal_format": {
          "$type": "string"
        }
      },
      "because": "Core OU-9",
      "on": "r1"
    },
    {
      "expect": {
        "frame": "baseline_begin",
        "rows": {
          "$type": "integer"
        },
        "cols": {
          "$type": "integer"
        },
        "modes": {
          "$type": "object"
        }
      },
      "because": "Core OU-9",
      "on": "r1"
    },
    {
      "expect": {
        "frame": "screen",
        "payload": {
          "$any": true
        }
      },
      "because": "Core OU-9",
      "on": "r1"
    },
    {
      "expect_eventually": {
        "frame": "baseline_end",
        "history": "not_requested"
      },
      "because": "Core OU-9",
      "ignore": [
        {
          "frame": "history",
          "payload": {
            "$any": true
          }
        }
      ],
      "on": "r1"
    },
    {
      "expect": {
        "frame": "live"
      },
      "because": "Core OU-9",
      "on": "r1"
    },
    {
      "route_send": {
        "frame": "input",
        "kind": "paste_begin",
        "op": "1"
      }
    },
    {
      "route_send": {
        "frame": "paste_chunk",
        "op": "1",
        "bytes": {
          "$bytes_hex": "61"
        }
      }
    },
    {
      "route_send": {
        "frame": "input",
        "kind": "paste_commit",
        "op": "1"
      }
    },
    {
      "route_send": {
        "frame": "bytes",
        "op": "2",
        "bytes": {
          "$bytes_hex": "7a"
        }
      }
    },
    {
      "route_send": {
        "frame": "text",
        "op": "3",
        "text": "y"
      }
    },
    {
      "await_pty": {
        "session": "s1",
        "min_bytes": 3
      }
    },
    {
      "await_quiet": {}
    },
    {
      "route_expect_pty": [
        {
          "written_by_op": "1"
        },
        {
          "written_by_op": "2"
        },
        {
          "written_by_op": "3"
        }
      ],
      "because": [
        "Core DP-5",
        "Core IN-2"
      ]
    },
    {
      "expect_quiet_until": {
        "$one_of": [
          {
            "frame": "input_done"
          },
          {
            "frame": "input_refused",
            "op": {
              "$not": "99"
            }
          }
        ]
      },
      "barrier": {
        "route_send": {
          "frame": "input",
          "kind": "paste_commit",
          "op": "99"
        },
        "route": "r1"
      },
      "until": {
        "frame": "input_refused",
        "op": "99",
        "reason": "refused"
      },
      "on": "r1",
      "because": [
        "Core DP-5",
        "Core DP-5b"
      ]
    },
    {
      "route_send": {
        "frame": "input",
        "kind": "paste_begin",
        "op": "4"
      }
    },
    {
      "route_send": {
        "frame": "paste_chunk",
        "op": "4",
        "bytes": {
          "$bytes_hex": "62"
        }
      }
    },
    {
      "route_send": {
        "frame": "input",
        "kind": "paste_commit",
        "op": "4",
        "want_result": true
      }
    },
    {
      "expect_eventually": {
        "frame": "input_done",
        "op": "4",
        "written_bytes": {
          "$type": "u64"
        }
      },
      "because": [
        "Core DP-5"
      ],
      "ignore": [
        {
          "frame": "modes"
        },
        {
          "frame": "output"
        },
        {
          "frame": "output_deflate"
        }
      ],
      "on": "r1"
    },
    {
      "route_send": {
        "frame": "input",
        "kind": "file_begin",
        "op": "5",
        "name": "f.txt"
      }
    },
    {
      "route_send": {
        "frame": "file_chunk",
        "op": "5",
        "bytes": {
          "$bytes_hex": "63"
        }
      }
    },
    {
      "route_send": {
        "frame": "input",
        "kind": "file_commit",
        "op": "5"
      }
    },
    {
      "expect_eventually": {
        "frame": "input_done",
        "op": "5",
        "written_bytes": "$wb5",
        "path": "$p5"
      },
      "because": [
        "Core DP-5",
        "Core DP-5b"
      ],
      "ignore": [
        {
          "frame": "modes"
        },
        {
          "frame": "output"
        },
        {
          "frame": "output_deflate"
        }
      ],
      "on": "r1"
    }
  ]
}

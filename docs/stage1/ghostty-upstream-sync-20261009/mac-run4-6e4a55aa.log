jobq: command bash -c project=$1 cpus=$2 volume_branch=$3 base_sha=$4; shift 4
if [ "$(uname -s)" = Darwin ]; then
  # Public sources, as on Linux: the repo's ci/remote/fetch-public.sh (botster-core: the libghostty submodule and its
  # Zig packages); else the submodules at the pinned commits. Every submodule is then cleaned.
  if [ -f ci/remote/fetch-public.sh ]; then
    bash ci/remote/fetch-public.sh || exit 3
  elif [ -f .gitmodules ]; then
    git submodule update -q --init --force || exit 3
  fi
  [ -f .gitmodules ] && { git submodule foreach -q --recursive git clean -q -ffdx || exit 3; }
  exec "$@"
fi
# Linux: one gate of a branch at a time on this host (they share its target volume); the same lock files as testq gates.
locks=$HOME/testq/projects/botster-locks
lock=$locks/branch-$(printf %s "$project:$volume_branch" | sha1sum | cut -c1-16).lock
{ mkdir -p "$locks" && exec 6>"$lock"; } || { echo "botster-gate: cannot open the branch lock $lock"; exit 3; }
if ! flock -n 6; then
  echo "botster-gate: waiting: another gate of $project $volume_branch runs on this host"
  flock 6 || { echo "botster-gate: cannot take the branch lock $lock"; exit 3; }
fi
# job.sh keeps its shared state (image and volume locks, target stamps, artifacts) relative to its checkout, in testq's
# layout <projects>/<project>/jobs/<snapshot>, and removes the snapshot when it ends. So the gate runs, as under testq,
# in a snapshot under ~/testq/projects: a repository fetched from the warm pool slot (another filesystem), checked out at
# the exact commit, base ref included.
snap=$HOME/testq/projects/$project/jobs/$POOL_JOB
mkdir -p "${snap%/*}" || exit 3
# Until job.sh owns the snapshot (it removes it when it ends), a stop or a failure removes it here.
trap 'rm -rf -- "$snap"; exit 143' TERM INT HUP
if ! { git init -q "$snap" && git -C "$snap" fetch -q --no-tags "$PWD" "+refs/pool/head:refs/pool/head" \
    "+refs/remotes/*:refs/remotes/*" && git -C "$snap" checkout -q --detach "$POOL_SHA"; }; then
  echo "botster-gate: could not make the snapshot $snap"
  rm -rf -- "$snap"
  exit 3
fi
trap - TERM INT HUP
exec "$snap/ci/remote/job.sh" "$snap" "$cpus" --run="$POOL_JOB" --branch="$volume_branch" --base="$base_sha" -- "$@" botster-gate botster-core 4 stage1/p2-fork-a6 d15579dadd7cf1ed65b768139d2a668f041bd932 bash docs/stage1/ghostty-upstream-sync-20261009/evidence.sh

{
  "id": "conf::ui_fd_1_link_http_https_only",
  "contract": "ui",
  "clause": "UI-FD-1",
  "subject": "realizer",
  "cases": [
    {
      "name": "an https URL shows its host and carries the URL",
      "document": {
        "ui_contract_view": "1.4",
        "id": "v",
        "title": "T",
        "requires": [
          "ui_1_1"
        ],
        "root": {
          "type": "list",
          "id": "l",
          "source": {
            "kind": "k"
          },
          "item": {
            "fields": [
              {
                "id": "f",
                "path": "/u",
                "display": "link"
              }
            ]
          }
        }
      },
      "kinds": {
        "k": {
          "baseline": true,
          "rows": [
            {
              "id": "r0",
              "u": "https://example.com/a/b?x=1"
            }
          ]
        }
      },
      "capabilities": {
        "ui_contract_view": [
          "1.4"
        ],
        "features": [
          "ui_1_1",
          "external_open"
        ]
      },
      "expect_nodes": {
        "botster-ui-descendant-v1:32:botster-ui-descendant-v1:1:l2:r01:f": {
          "type": "text",
          "props": {
            "text": "example.com",
            "href": "https://example.com/a/b?x=1"
          }
        }
      },
      "because": "UI UI-FD-1"
    },

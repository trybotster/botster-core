{
  "id": "conf::ui_fm_8_secret_contract",
  "contract": "ui",
  "clause": "UI-FM-8",
  "subject": "realizer",
  "cases": [
    {
      "name": "a secret property is a masked input with no value",
      "document": {
        "ui_contract_view": "1.0",
        "id": "v",
        "title": "T",
        "root": {
          "type": "stack",
          "id": "root",
          "direction": "column",
          "children": [
            {
              "type": "actions",
              "id": "acts",
              "items": [
                {
                  "id": "go",
                  "label": "Go",
                  "handler": "h",
                  "args_schema": {
                    "type": "object",
                    "properties": {
                      "tok": {
                        "type": "string",
                        "secret": true
                      }
                    }
                  }
                }
              ]
            },
            {
              "type": "form",
              "id": "f",
              "action": "go",
              "schema": {
                "type": "object",
                "properties": {
                  "tok": {
                    "type": "string",
                    "secret": true
                  }
                }
              }
            }
          ]
        }
      },
      "expect_nodes": {
        "botster-ui-descendant-v1:72:botster-ui-descendant-v1:39:botster-ui-descendant-v1:1:f9:container3:tok6:widget": {
          "type": "text_input",
          "props": {
            "masked": true,
            "value": {
              "$absent": true
            }
          }
        }
      },
      "because": "UI UI-FM-8"
    },

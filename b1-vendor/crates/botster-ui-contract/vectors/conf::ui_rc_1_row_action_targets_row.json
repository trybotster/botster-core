{
  "id": "conf::ui_rc_1_row_action_targets_row",
  "contract": "ui",
  "clause": "UI-RC-1",
  "subject": "realizer",
  "cases": [
    {
      "name": "a row action sends the row key as the target",
      "document": {
        "ui_contract_view": "1.0",
        "id": "workspaces",
        "title": "Workspaces",
        "selections": [
          {
            "id": "sel_ws"
          }
        ],
        "root": {
          "type": "stack",
          "id": "page",
          "direction": "row",
          "children": [
            {
              "type": "list",
              "id": "workspace_list",
              "source": {
                "kind": "botster-workspaces.workspace",
                "order": [
                  {
                    "field": "/name",
                    "dir": "asc"
                  }
                ]
              },
              "selects": "sel_ws",
              "item": {
                "fields": [
                  {
                    "id": "ws_name",
                    "path": "/name"
                  }
                ]
              },
              "empty": {
                "title": "No workspaces yet"
              },
              "error": {
                "title": "Workspaces unavailable"
              }
            },
            {
              "type": "stack",
              "id": "right",
              "direction": "column",
              "children": [
                {
                  "type": "detail",
                  "id": "ws_detail",
                  "source": {
                    "sel": "sel_ws"
                  },
                  "fields": [
                    {
                      "id": "ws_detail_name",
                      "label": "Name",
                      "path": "/name"
                    }
                  ],
                  "empty": {
                    "title": "Select a workspace"
                  }
                },
                {
                  "type": "actions",
                  "id": "ws_actions",
                  "items": [
                    {
                      "id": "act_rename",
                      "label": "Rename",
                      "handler": "rename",
                      "priority": "secondary",
                      "args": {
                        "workspace_id": {
                          "sel": "sel_ws/id"
                        }
                      },
                      "args_schema": {
                        "type": "object",
                        "required": [
                          "name"
                        ],
                        "properties": {
                          "name": {
                            "type": "string",
                            "minLength": 1,
                            "ui": {
                              "placeholder": "Release planning",
                              "help": "A name for this grouping."
                            }
                          }
                        }
                      }
                    },
                    {
                      "id": "act_delete",
                      "label": "Delete",
                      "handler": "delete",
                      "priority": "secondary",
                      "args": {
                        "workspace_id": {
                          "sel": "sel_ws/id"
                        }
                      },
                      "confirm": {
                        "message": "Delete this workspace grouping. Sessions and Git worktrees stay available. This action cannot be undone.",
                        "tone": "danger"
                      }
                    }
                  ]
                },
                {
                  "type": "list",
                  "id": "members_current",
                  "source": {
                    "kind": "botster-workspaces.membership",
                    "where": {
                      "all": [
                        {
                          "eq": [
                            {
                              "path": "/workspace_id"
                            },
                            {
                              "sel": "sel_ws/id"
                            }
                          ]
                        },
                        {
                          "eq": [
                            {
                              "ref": "r_session/lifecycle_class"
                            },
                            {
                              "lit": "current"
                            }
                          ]
                        }
                      ]
                    }
                  },
                  "refs": {
                    "r_session": {
                      "kind": "session",
                      "key": {
                        "hub_id": "/hub_id",
                        "id": "/session_id"
                      },
                      "absent": {
                        "text": "Session unavailable",
                        "tone": "warning"
                      },
                      "activate": {
                        "open": "r_session"
                      }
                    }
                  },
                  "item": {
                    "fields": [
                      {
                        "id": "member_title",
                        "value": {
                          "ref": "r_session/label"
                        }
                      }
                    ],
                    "actions": [
                      {
                        "id": "act_remove",
                        "label": "Remove",
                        "handler": "remove_session",
                        "args": {
                          "membership_id": {
                            "row": "/id"
                          }
                        },
                        "confirm": {
                          "message": "Remove this session from the workspace?",
                          "tone": "neutral"
                        }
                      },
                      {
                        "id": "act_move",
                        "label": "Move",
                        "handler": "move_session",
                        "args": {
                          "membership_id": {
                            "row": "/id"
                          }
                        },
                        "args_schema": {
                          "type": "object",
                          "required": [
                            "workspace_id"
                          ],
                          "properties": {
                            "workspace_id": {
                              "type": "string",
                              "ui": {
                                "options_source": {
                                  "kind": "botster-workspaces.workspace",
                                  "where": {
                                    "ne": [
                                      {
                                        "path": "/id"
                                      },
                                      {
                                        "sel": "sel_ws/id"
                                      }
                                    ]
                                  },
                                  "value_field": "/id",
                                  "label_field": "/name",
                                  "empty": {
                                    "title": "No other workspace",
                                    "body": "Create another workspace before you move a session."
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    ]
                  },
                  "empty": {
                    "title": "No sessions yet"
                  }
                }
              ]
            }
          ]
        }
      },
      "kinds": {
        "botster-workspaces.workspace": {
          "baseline": true,
          "rows": [
            {
              "id": "w1",
              "name": "Alpha"
            },
            {
              "id": "w2",
              "name": "Beta"
            }
          ]
        },
        "botster-workspaces.membership": {
          "baseline": true,
          "rows": [
            {
              "id": "m1",
              "workspace_id": "w1",
              "session_id": "s1",
              "hub_id": "h1"
            },
            {
              "id": "m2",
              "workspace_id": "w1",
              "session_id": "s2",
              "hub_id": "h1"
            },
            {
              "id": "m3",
              "workspace_id": "w2",
              "session_id": "s1",
              "hub_id": "h1"
            }
          ]
        },
        "session": {
          "baseline": true,
          "rows": [
            {
              "id": "s1",
              "label": "Build",
              "lifecycle_class": "current"
            },
            {
              "id": "s2",
              "label": "Old",
              "lifecycle_class": "retired"
            }
          ]
        }
      },
      "local_state": {
        "selections": {
          "sel_ws": "w1"
        }
      },
      "expect_nodes": {
        "botster-ui-descendant-v1:47:botster-ui-descendant-v1:15:members_current2:m110:act_remove": {
          "props": {
            "action": {
              "id": "act_remove",
              "payload": {
                "target": "m1"
              }
            }
          }
        }
      },
      "because": "UI UI-RC-1"
    }
  ]
}

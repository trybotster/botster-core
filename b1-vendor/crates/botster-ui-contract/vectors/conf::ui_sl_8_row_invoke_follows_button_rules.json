{
  "id": "conf::ui_sl_8_row_invoke_follows_button_rules",
  "contract": "ui",
  "clause": "UI-SL-8",
  "subject": "realizer",
  "cases": [
    {
      "name": "the row activation names the action and the row key",
      "document": {
        "ui_contract_view": "1.4",
        "id": "v",
        "title": "T",
        "root": {
          "type": "stack",
          "id": "root",
          "direction": "column",
          "children": [
            {
              "type": "list",
              "id": "members",
              "source": {
                "kind": "acme.member"
              },
              "item": {
                "fields": [
                  {
                    "id": "title",
                    "path": "/name"
                  }
                ],
                "actions": [
                  {
                    "id": "act_remove",
                    "label": "Remove",
                    "handler": "remove",
                    "args": {
                      "membership_id": {
                        "row": "/id"
                      }
                    },
                    "confirm": {
                      "message": "Remove this member?",
                      "tone": "danger"
                    }
                  }
                ]
              },
              "empty": {
                "title": "Nothing here"
              },
              "error": {
                "title": "Nothing here"
              },
              "activate": {
                "invoke": "act_remove"
              }
            }
          ]
        }
      },
      "kinds": {
        "acme.member": {
          "baseline": true,
          "rows": [
            {
              "id": "m1",
              "name": "Ada"
            }
          ]
        }
      },
      "expect_nodes": {
        "botster-ui-descendant-v1:7:members2:m1": {
          "props": {
            "activate": {
              "invoke": "act_remove",
              "row_key": "m1"
            }
          }
        }
      },
      "because": "UI UI-NV-2"
    },

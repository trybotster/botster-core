{
  "id": "conf::ui_pt_2_structural_parts_have_no_bindings",
  "contract": "ui",
  "clause": "UI-PT-2",
  "subject": "realizer",
  "cases": [
    {
      "name": "a stack with a source",
      "document": {
        "ui_contract_view": "1.0",
        "id": "v",
        "title": "T",
        "root": {
          "type": "stack",
          "id": "root",
          "direction": "column",
          "children": [
            {
              "type": "stack",
              "id": "s",
              "direction": "row",
              "children": [],
              "source": {
                "kind": "k"
              }
            }
          ]
        }
      },
      "expect_admission": {
        "code": "unknown_property",
        "path": "/root/children/0/source"
      },
      "context": {
        "kinds": {
          "k": {
            "projection_allowlist": [
              "/id",
              "/v",
              "/name",
              "/n"
            ],
            "field_types": {
              "/n": "integer",
              "/name": "string",
              "/id": "string"
            }
          }
        },
        "handlers": {},
        "views": [
          "other"
        ]
      },
      "because": "UI UI-PT-2"
    },

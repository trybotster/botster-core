{
  "id": "conf::ui_sa_4_absent_pointer_is_static",
  "contract": "ui",
  "clause": "UI-SA-4",
  "subject": "realizer",
  "cases": [
    {
      "name": "metadata without the pointed values leaves the action as declared",
      "document": {
        "ui_contract_view": "1.4",
        "id": "v",
        "title": "T",
        "root": {
          "type": "stack",
          "id": "root",
          "direction": "column",
          "children": [
            {
              "type": "list",
              "id": "sessions",
              "source": {
                "kind": "session"
              },
              "item": {
                "fields": [
                  {
                    "id": "title",
                    "path": "/title"
                  }
                ],
                "actions": [
                  {
                    "id": "tunnel",
                    "label": "Start tunnel",
                    "handler": "tunnel"
                  }
                ]
              },
              "empty": {
                "title": "Nothing here"
              },
              "error": {
                "title": "Nothing here"
              }
            }
          ]
        }
      },
      "kinds": {
        "session": {
          "baseline": true,
          "rows": [
            {
              "id": "s1",
              "title": "Build",
              "metadata": {
                "acme-tunnel": {
                  "unrelated": 1
                }
              }
            }
          ]
        },
        "kind": {
          "baseline": true,
          "rows": [
            {
              "id": "session",
              "kind": "session",
              "actions": {
                "tunnel": {
                  "allowed": true,
                  "owner": "acme-tunnel",
                  "label_pointer": "/label",
                  "status_pointer": "/status",
                  "url_pointer": "/url"
                }
              }
            }
          ]
        }
      },
      "capabilities": {
        "features": [
          "external_open"
        ],
        "ui_contract_view": [
          "1.4"
        ]
      },
      "expect_nodes": {
        "botster-ui-descendant-v1:39:botster-ui-descendant-v1:8:sessions2:s16:action": {
          "children": [
            {
              "id": "botster-ui-descendant-v1:39:botster-ui-descendant-v1:8:sessions2:s16:tunnel",
              "props": {
                "label": "Start tunnel"
              }
            }
          ]
        }
      },
      "expect_no_diagnostics": true,
      "because": "UI UI-SA-4"
    },

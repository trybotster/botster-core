              ],
              "properties": {
                "workspace_id": {
                  "type": "string"
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "delete": {
            "schema": {
              "type": "object",
              "required": [
                "workspace_id"
              ],
              "properties": {
                "workspace_id": {
                  "type": "string"
                }
              }
            }
          },
          "remove_session": {
            "schema": {
              "type": "object",
              "required": [
                "membership_id"
              ],
              "properties": {
                "membership_id": {
                  "type": "string"
                }
              }
            }
          },
          "move_session": {
            "schema": {
              "type": "object",

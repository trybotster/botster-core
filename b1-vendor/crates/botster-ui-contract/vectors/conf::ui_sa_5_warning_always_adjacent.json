{
  "id": "conf::ui_sa_5_warning_always_adjacent",
  "contract": "ui",
  "clause": "UI-SA-5",
  "subject": "realizer",
  "cases": [
    {
      "name": "a row action shows the full warning text next to its button in the warning tone",
      "document": {
        "ui_contract_view": "1.4",
        "id": "v",
        "title": "T",
        "root": {
          "type": "stack",
          "id": "root",
          "direction": "column",
          "children": [
            {
              "type": "list",
              "id": "sessions",
              "source": {
                "kind": "session"
              },
              "item": {
                "fields": [
                  {
                    "id": "title",
                    "path": "/title"
                  }
                ],
                "actions": [
                  {
                    "id": "tunnel",
                    "label": "Start tunnel",
                    "handler": "tunnel"
                  }
                ]
              },
              "empty": {
                "title": "Nothing here"
              },
              "error": {
                "title": "Nothing here"
              }
            }
          ]
        }
      },
      "kinds": {
        "session": {
          "baseline": true,
          "rows": [
            {
              "id": "s1",
              "title": "Build",
              "metadata": {
                "acme-tunnel": {}
              }
            }
          ]
        },
        "kind": {
          "baseline": true,
          "rows": [
            {
              "id": "session",
              "kind": "session",
              "actions": {
                "tunnel": {
                  "allowed": true,
                  "owner": "acme-tunnel",
                  "label_pointer": "/label",
                  "status_pointer": "/status",
                  "url_pointer": "/url",
                  "warning": "Stopping the tunnel closes every open connection for every user of this session, and the public link stops working until somebody starts the tunnel again."
                }
              }
            }
          ]
        }
      },
      "expect_nodes": {
        "botster-ui-descendant-v1:39:botster-ui-descendant-v1:8:sessions2:s16:action": {
          "children": [
            {
              "id": "botster-ui-descendant-v1:39:botster-ui-descendant-v1:8:sessions2:s16:tunnel"
            },
            {
              "id": "botster-ui-descendant-v1:75:botster-ui-descendant-v1:39:botster-ui-descendant-v1:8:sessions2:s16:tunnel7:warning",
              "type": "text",
              "props": {
                "text": "Stopping the tunnel closes every open connection for every user of this session, and the public link stops working until somebody starts the tunnel again.",
                "tone": "warning"
              }
            }
          ]
        }
      },
      "because": "UI UI-SA-5"
    },

{
  "id": "conf::ui_em_1_no_arbitrary_url",
  "contract": "ui",
  "clause": "UI-EM-1",
  "subject": "realizer",
  "cases": [
    {
      "name": "src on an embed",
      "because": "UI UI-EM-11",
      "document": {
        "ui_contract_view": "1.4",
        "id": "v",
        "title": "T",
        "root": {
          "type": "embed",
          "id": "e",
          "title": "Graph",
          "page": {
            "asset": {
              "lit": {
                "name": "graph"
              }
            }
          },
          "empty": {
            "title": "No page"
          },
          "error": {
            "title": "Failed"
          },
          "src": "https://example.com/page"
        },
        "requires": [
          "ui_embed"
        ]
      },
      "expect_admission": {
        "code": "unknown_property",
        "path": "/root/src"
      }
    },
    {
      "name": "srcdoc on an embed",
      "because": "UI UI-EM-11",
      "document": {
        "ui_contract_view": "1.4",
        "id": "v",
        "title": "T",
        "root": {
          "type": "embed",
          "id": "e",
          "title": "Graph",
          "page": {
            "asset": {
              "lit": {
                "name": "graph"
              }
            }
          },
          "empty": {
            "title": "No page"
          },
          "error": {
            "title": "Failed"
          },
          "srcdoc": "<p>x</p>"
        },
        "requires": [
          "ui_embed"
        ]
      },
      "expect_admission": {
        "code": "unknown_property",

            "value": "z"
          }
        },
        "errors": {
          "fields": {
            "botster-ui-descendant-v1:76:botster-ui-descendant-v1:42:botster-ui-descendant-v1:4:pick9:container4:item1:o": {
              "code": "other",
              "message": "Old"
            }
          }
        }
      },
      "expect_idempotent": true,
      "expect_nodes": {
        "botster-ui-descendant-v1:76:botster-ui-descendant-v1:42:botster-ui-descendant-v1:4:pick9:container4:item1:o": {
          "props": {
            "error": {
              "code": "option_unavailable",
              "message": {
                "$absent": true
              }
            }
          }
        }
      }

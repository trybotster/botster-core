    {
      "name": "a slot whose row left its kind is cleared",
      "because": "UI UI-NV-4",
      "document": {
        "ui_contract_view": "1.4",
        "id": "v",
        "title": "T",
        "root": {
          "type": "stack",
          "id": "root",
          "direction": "column",
          "children": [
            {
              "type": "list",
              "id": "l",
              "source": {
                "kind": "k"
              },
              "selects": "sel",
              "item": {
                "fields": [
                  {
                    "id": "f",
                    "path": "/id"
                  }
                ]
              }
            }
          ]
        },
        "selections": [
          {
            "id": "sel"
          }
        ]
      },
      "kinds": {
        "k": {
          "baseline": true,
          "rows": [
            {
              "id": "a"
            }
          ]
        }
      },
      "local_state": {
        "selections": {
          "sel": "gone"
        }
      },
      "expect": {
        "local_changes": {
          "cleared_selections": [
            "sel"
          ],
          "unset_drafts": {
            "$absent": true
          },
          "stamped_errors": {
            "$absent": true
          },
          "dropped_view_state": {
            "$absent": true
          }
        }
      }
    },

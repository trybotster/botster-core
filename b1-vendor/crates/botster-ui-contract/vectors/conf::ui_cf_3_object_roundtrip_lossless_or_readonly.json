              "type": "actions",
              "id": "acts",
              "items": [
                {
                  "id": "go",
                  "label": "Go",
                  "handler": "h",
                  "args_schema": {
                    "type": "object",
                    "properties": {
                      "env": {
                        "type": "object",
                        "default": {
                          "A": "1"
                        }
                      }
                    }
                  }
                }
              ]
            },
            {
              "type": "form",
              "id": "f",
              "action": "go",
              "schema": {
                "type": "object",
                "properties": {
                  "env": {
                    "type": "object",
                    "default": {
                      "A": "1"
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "expect_nodes": {
        "botster-ui-descendant-v1:72:botster-ui-descendant-v1:39:botster-ui-descendant-v1:1:f9:container3:env6:widget": {
          "props": {
            "value": "A=1",
            "read_only": {
              "$absent": true
            }
          }
        }
      },
      "because": "UI UI-CF-3"
    },

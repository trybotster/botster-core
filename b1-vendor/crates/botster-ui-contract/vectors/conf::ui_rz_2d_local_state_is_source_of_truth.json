    {
      "name": "a form operand reads the published draft: visible_when shows the field",
      "document": {
        "ui_contract_view": "1.0",
        "id": "v",
        "title": "T",
        "root": {
          "type": "stack",
          "id": "root",
          "direction": "column",
          "children": [
            {
              "type": "actions",
              "id": "acts",
              "items": [
                {
                  "id": "go",
                  "label": "Go",
                  "handler": "h",
                  "args_schema": {
                    "type": "object",
                    "properties": {
                      "t": {
                        "type": "string"
                      },
                      "b": {
                        "type": "string",
                        "ui": {
                          "visible_when": {
                            "eq": [
                              {
                                "form": "/t"
                              },
                              {
                                "lit": "show"
                              }
                            ]
                          }
                        }
                      }
                    },
                    "required": [
                      "t"
                    ]
                  }
                }
              ]
            },
            {
              "type": "form",
              "id": "f",
              "action": "go",
              "schema": {
                "type": "object",
                "properties": {
                  "t": {
                    "type": "string"
                  },
                  "b": {
                    "type": "string",
                    "ui": {
                      "visible_when": {
                        "eq": [
                          {
                            "form": "/t"
                          },
                          {
                            "lit": "show"
                          }
                        ]
                      }
                    }
                  }
                },
                "required": [
                  "t"
                ]
              }
            }
          ]
        }

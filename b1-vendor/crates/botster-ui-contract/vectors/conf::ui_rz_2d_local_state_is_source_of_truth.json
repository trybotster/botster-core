    {
      "name": "on a conflict the output of realize wins: a draft that left the options is reported for unset",
      "document": {
        "ui_contract_view": "1.0",
        "id": "v",
        "title": "T",
        "root": {
          "type": "stack",
          "id": "root",
          "direction": "column",
          "children": [
            {
              "type": "actions",
              "id": "acts",
              "items": [
                {
                  "id": "go",
                  "label": "Go",
                  "handler": "h",
                  "args_schema": {
                    "type": "object",
                    "properties": {
                      "team": {
                        "type": "string"
                      },
                      "ws": {
                        "type": "string",
                        "ui": {
                          "options_source": {
                            "kind": "ws",
                            "value_field": "/id",
                            "label_field": "/name",
                            "where": {
                              "eq": [
                                {
                                  "path": "/team"
                                },
                                {
                                  "form": "/team"
                                }
                              ]
                            }
                          }
                        }
                      }
                    }
                  }
                }
              ]
            },
            {
              "type": "form",
              "id": "f",
              "action": "go",
              "schema": {
                "type": "object",
                "properties": {
                  "team": {
                    "type": "string"
                  },
                  "ws": {
                    "type": "string",
                    "ui": {
                      "options_source": {
                        "kind": "ws",
                        "value_field": "/id",
                        "label_field": "/name",
                        "where": {
                          "eq": [
                            {
                              "path": "/team"
                            },
                            {
                              "form": "/team"
                            }
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "kinds": {
        "ws": {
          "baseline": true,
          "rows": [
            {
              "id": "w1",
              "name": "Alpha",
              "team": "t1"
            },
            {
              "id": "w2",
              "name": "Beta",
              "team": "t2"
            },
            {
              "id": "w3",
              "name": "Gamma",
              "team": "t1"
            }
          ]
        }
      },
      "local_state": {
        "drafts": {
          "botster-ui-descendant-v1:39:botster-ui-descendant-v1:1:f9:container4:team": {
            "value": "t2"
          },
          "botster-ui-descendant-v1:39:botster-ui-descendant-v1:1:f9:container2:ws": {
            "value": "w1"
          }
        }
      },
      "expect": {
        "local_changes": {
          "unset_drafts": [
            "botster-ui-descendant-v1:39:botster-ui-descendant-v1:1:f9:container2:ws"
          ],
          "stamped_errors": [
            {
              "draft_key": "botster-ui-descendant-v1:39:botster-ui-descendant-v1:1:f9:container2:ws",
              "code": "option_unavailable"
            }
          ]
        }

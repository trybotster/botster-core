{
  "id": "conf::ui_fd_2_object_and_array_are_never_keys",
  "contract": "ui",
  "clause": "UI-FD-2",
  "subject": "realizer",
  "cases": [
    {
      "name": "an object matches nothing and shows as raw text",
      "document": {
        "ui_contract_view": "1.4",
        "id": "v",
        "title": "T",
        "root": {
          "type": "list",
          "id": "l",
          "source": {
            "kind": "k"
          },
          "item": {
            "fields": [
              {
                "id": "f",
                "path": "/v",
                "map": {
                  "{\"a\":1}": {
                    "label": "Mapped",
                    "tone": "success"
                  }
                }
              }
            ]
          }
        }
      },
      "kinds": {
        "k": {
          "baseline": true,
          "rows": [
            {
              "id": "r0",
              "v": {
                "a": 1
              }
            }
          ]
        }
      },
      "expect_nodes": {
        "botster-ui-descendant-v1:32:botster-ui-descendant-v1:1:l2:r01:f": {
          "type": "text",
          "props": {
            "text": "{\"a\":1}",
            "tone": "neutral"
          }
        }
      },
      "because": "UI UI-FD-2"
    },
    {
      "name": "an array matches nothing and shows as raw text",
      "document": {
        "ui_contract_view": "1.4",
        "id": "v",
        "title": "T",
        "root": {
          "type": "list",
          "id": "l",
          "source": {
            "kind": "k"
          },
          "item": {
            "fields": [
              {
                "id": "f",
                "path": "/v",
                "map": {
                  "[1,2]": {
                    "label": "Mapped",
                    "tone": "success"
                  }
                }
              }
            ]
          }
        }
      },
      "kinds": {
        "k": {
          "baseline": true,
          "rows": [
            {
              "id": "r0",
              "v": [
                1,
                2
              ]
            }
          ]
        }
      },
      "expect_nodes": {
        "botster-ui-descendant-v1:32:botster-ui-descendant-v1:1:l2:r01:f": {
          "type": "text",
          "props": {
            "text": "[1,2]",
            "tone": "neutral"
          }
        }
      },
      "because": "UI UI-FD-2"
    },
    {
      "name": "an empty array matches nothing",
      "document": {
        "ui_contract_view": "1.4",
        "id": "v",
        "title": "T",
        "root": {
          "type": "list",
          "id": "l",
          "source": {
            "kind": "k"
          },
          "item": {
            "fields": [
              {
                "id": "f",
                "path": "/v",
                "map": {
                  "[]": {
                    "label": "Mapped"
                  }
                }
              }
            ]
          }
        }
      },
      "kinds": {
        "k": {
          "baseline": true,
          "rows": [
            {
              "id": "r0",
              "v": []
            }
          ]
        }
      },
      "expect_nodes": {
        "botster-ui-descendant-v1:32:botster-ui-descendant-v1:1:l2:r01:f": {
          "type": "text",
          "props": {
            "text": "[]",
            "tone": "neutral"
          }
        }
      },
      "because": "UI UI-FD-2"
    }
  ]
}

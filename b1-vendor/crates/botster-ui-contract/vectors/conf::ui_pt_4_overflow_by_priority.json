  "cases": [
    {
      "name": "order is priority first, then declaration, on a regular width",
      "document": {
        "ui_contract_view": "1.0",
        "id": "v",
        "title": "T",
        "root": {
          "type": "stack",
          "id": "root",
          "direction": "column",
          "children": [
            {
              "type": "actions",
              "id": "bar",
              "items": [
                {
                  "id": "a",
                  "label": "A",
                  "handler": "h"
                },
                {
                  "id": "b",
                  "label": "B",
                  "handler": "h",
                  "priority": "primary"
                },
                {
                  "id": "c",
                  "label": "C",
                  "handler": "h"
                }
              ],
              "overflow": "auto"
            }
          ]
        }
      },
      "expect_nodes": {
        "botster-ui-descendant-v1:3:bar9:container": {
          "type": "toolbar",
          "children": [
            {
              "id": "b"
            },
            {
              "id": "a"
            },
            {
              "id": "c"
            }
          ]
        }
      },
      "because": "UI UI-PT-4"
    },

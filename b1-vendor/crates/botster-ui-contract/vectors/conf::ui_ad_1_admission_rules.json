{
  "id": "conf::ui_ad_1_admission_rules",
  "contract": "ui",
  "clause": "UI-AD-1",
  "subject": "realizer",
  "cases": [
    {
      "name": "the section 14 view passes every rule",
      "document": {
        "ui_contract_view": "1.4",
        "id": "workspaces",
        "title": "Workspaces",
        "selections": [
          {
            "id": "sel_ws"
          }
        ],
        "root": {
          "type": "stack",
          "id": "page",
          "direction": "row",
          "children": [
            {
              "type": "list",
              "id": "workspace_list",
              "source": {
                "kind": "botster-workspaces.workspace",
                "order": [
                  {
                    "field": "/name",
                    "dir": "asc"
                  }
                ]
              },
              "selects": "sel_ws",
              "item": {
                "fields": [
                  {
                    "id": "ws_name",
                    "path": "/name"
                  }
                ]
              },
              "empty": {
                "title": "No workspaces yet"
              },
              "error": {
                "title": "Workspaces unavailable"
              }
            },
            {
              "type": "stack",
              "id": "right",
              "direction": "column",
              "children": [
                {
                  "type": "detail",
                  "id": "ws_detail",
                  "source": {
                    "sel": "sel_ws"
                  },
                  "fields": [
                    {
                      "id": "ws_detail_name",
                      "label": "Name",
                      "path": "/name"
                    }
                  ],
                  "empty": {
                    "title": "Select a workspace"
                  }
                },
                {
                  "type": "actions",
                  "id": "ws_actions",
                  "items": [
                    {
                      "id": "act_rename",
                      "label": "Rename",
                      "handler": "rename",
                      "priority": "secondary",
                      "args": {
                        "workspace_id": {
                          "sel": "sel_ws/id"
                        }
                      },
                      "args_schema": {
                        "type": "object",
                        "required": [
                          "name"
                        ],
                        "properties": {
                          "name": {
                            "type": "string",
                            "minLength": 1,
                            "ui": {
                              "placeholder": "Release planning",
                              "help": "A name for this grouping."
                            }
                          }
                        }
                      }
                    },
                    {
                      "id": "act_delete",
                      "label": "Delete",
                      "handler": "delete",
                      "priority": "secondary",
                      "args": {
                        "workspace_id": {
                          "sel": "sel_ws/id"
                        }
                      },
                      "confirm": {
                        "message": "Delete this workspace grouping. Sessions and Git worktrees stay available. This action cannot be undone.",
                        "tone": "danger"
                      }
                    }
                  ]
                },
                {
                  "type": "list",
                  "id": "members_current",
                  "source": {
                    "kind": "botster-workspaces.membership",
                    "where": {
                      "all": [
                        {
                          "eq": [
                            {
                              "path": "/workspace_id"
                            },
                            {
                              "sel": "sel_ws/id"
                            }
                          ]
                        },
                        {
                          "eq": [
                            {
                              "ref": "r_session/lifecycle_class"
                            },
                            {
                              "lit": "current"
                            }
                          ]
                        }
                      ]
                    }
                  },
                  "refs": {
                    "r_session": {
                      "kind": "session",
                      "key": {
                        "hub_id": "/hub_id",
                        "id": "/session_id"
                      },
                      "absent": {
                        "text": "Session unavailable",
                        "tone": "warning"
                      },
                      "activate": {
                        "open": "r_session"
                      }
                    }
                  },
                  "item": {
                    "fields": [
                      {
                        "id": "member_title",
                        "value": {
                          "ref": "r_session/label"
                        }
                      }
                    ],
                    "actions": [
                      {
                        "id": "act_remove",
                        "label": "Remove",
                        "handler": "remove_session",
                        "args": {
                          "membership_id": {
                            "row": "/id"
                          }
                        },
                        "confirm": {
                          "message": "Remove this session from the workspace?",
                          "tone": "neutral"
                        }
                      },
                      {
                        "id": "act_move",
                        "label": "Move",
                        "handler": "move_session",
                        "args": {
                          "membership_id": {
                            "row": "/id"
                          }
                        },
                        "args_schema": {
                          "type": "object",
                          "required": [
                            "workspace_id"
                          ],
                          "properties": {
                            "workspace_id": {
                              "type": "string",
                              "ui": {
                                "options_source": {
                                  "kind": "botster-workspaces.workspace",
                                  "where": {
                                    "ne": [
                                      {
                                        "path": "/id"
                                      },
                                      {
                                        "sel": "sel_ws/id"
                                      }
                                    ]
                                  },
                                  "value_field": "/id",
                                  "label_field": "/name",
                                  "empty": {
                                    "title": "No other workspace",
                                    "body": "Create another workspace before you move a session."
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    ]
                  },
                  "empty": {
                    "title": "No sessions yet"
                  }
                }
              ]
            }
          ]
        }
      },
      "expect_admitted": true,
      "context": {
        "kinds": {
          "botster-workspaces.workspace": {
            "projection_allowlist": [
              "/id",
              "/name"
            ],
            "field_types": {
              "/id": "string",
              "/name": "string"
            }
          },
          "botster-workspaces.membership": {
            "projection_allowlist": [
              "/id",
              "/workspace_id",
              "/session_id",
              "/hub_id"
            ],
            "field_types": {
              "/id": "string"
            }
          },
          "session": {
            "projection_allowlist": [
              "/id",
              "/label",
              "/lifecycle_class",
              "/owner"
            ],
            "field_types": {
              "/id": "string",
              "/label": "string"
            }
          }
        },
        "handlers": {
          "rename": {
            "schema": {
              "type": "object",
              "required": [
                "workspace_id",
                "name"
              ],
              "properties": {
                "workspace_id": {
                  "type": "string"
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "delete": {
            "schema": {
              "type": "object",
              "required": [
                "workspace_id"
              ],
              "properties": {
                "workspace_id": {
                  "type": "string"
                }
              }
            }
          },
          "remove_session": {
            "schema": {
              "type": "object",
              "required": [
                "membership_id"
              ],
              "properties": {
                "membership_id": {
                  "type": "string"
                }
              }
            }
          },
          "move_session": {
            "schema": {
              "type": "object",
              "required": [
                "membership_id",
                "workspace_id"
              ],
              "properties": {
                "membership_id": {
                  "type": "string"
                },
                "workspace_id": {
                  "type": "string"
                }
              }
            }
          }
        },
        "views": [
          "workspaces"
        ]
      },
      "because": "UI UI-AD-1"
    },

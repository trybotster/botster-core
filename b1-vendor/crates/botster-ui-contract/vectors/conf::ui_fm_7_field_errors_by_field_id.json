                  "label": "A1",
                  "handler": "h",
                  "args_schema": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      }
                    }
                  }
                },
                {
                  "id": "a2",
                  "label": "A2",
                  "handler": "h",
                  "args_schema": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      }
                    }
                  }
                }
              ]
            },
            {
              "type": "form",
              "id": "g1",
              "action": "a1",
              "schema": {
                "type": "object",

  "contract": "ui",
  "clause": "UI-CF-6",
  "subject": "realizer",
  "cases": [
    {
      "name": "an absent parts list means every part: status_badge is drawn as itself",
      "document": {
        "ui_contract_view": "1.4",
        "id": "v",
        "title": "T",
        "root": {
          "type": "stack",
          "id": "root",
          "direction": "column",
          "children": [
            {
              "type": "status_badge",
              "id": "sb",
              "value": {
                "lit": "run"
              },
              "map": {
                "run": {
                  "label": "Running",
                  "tone": "success"
                }
              }
            }
          ]
        }
      },
      "capabilities": {
        "ui_contract_view": [
          "1.4"
        ]
      },
      "expect_nodes": {
        "sb": {
          "type": "status_badge",
          "props": {
            "label": "Running"
          }
        }
      },
      "because": "UI UI-CF-6"
    },

  "contract": "ui",
  "clause": "UI-EM-1",
  "subject": "realizer",
  "cases": [
    {
      "name": "an asset reference by asset_id",
      "because": "UI UI-EM-1",
      "document": {
        "ui_contract_view": "1.4",
        "id": "v",
        "title": "T",
        "root": {
          "type": "embed",
          "id": "e",
          "title": "Graph",
          "page": {
            "asset": {
              "lit": {
                "asset_id": "a1"
              }
            }
          },
          "empty": {
            "title": "No page"
          },
          "error": {
            "title": "Failed"
          }
        },
        "requires": [
          "ui_embed"
        ]
      },
      "capabilities": {
        "ui_contract_view": [
          "1.4"
        ],
        "features": [
          "embed",
          "ui_embed"
        ]
      },
      "expect_nodes": {
        "e": {
          "type": "embed",
          "props": {
            "asset_id": "a1",
            "title": "Graph"
          }
        }
      }
    },

{
  "id": "conf::ui_rf_1_ref_resolves_by_id",
  "contract": "ui",
  "clause": "UI-RF-1",
  "subject": "realizer",
  "cases": [
    {
      "name": "a structured key resolves by the target's own id",
      "document": {
        "ui_contract_view": "1.0",
        "id": "v",
        "title": "T",
        "root": {
          "type": "list",
          "id": "mem",
          "source": {
            "kind": "botster-workspaces.membership"
          },
          "item": {
            "fields": [
              {
                "id": "title",
                "value": {
                  "ref": "r/label"
                }
              }
            ]
          },
          "refs": {
            "r": {
              "kind": "session",
              "key": {
                "hub_id": "/hub_id",
                "id": "/session_id"
              },
              "absent": {
                "text": "Session unavailable",
                "tone": "warning"
              }
            }
          }
        }
      },
      "kinds": {
        "botster-workspaces.membership": {
          "baseline": true,
          "rows": [
            {
              "id": "m1",
              "workspace_id": "w1",
              "session_id": "s1",
              "hub_id": "h1"
            }
          ]
        },
        "session": {
          "baseline": true,
          "rows": [
            {
              "id": "s1",
              "label": "Build"
            }
          ]
        }
      },
      "expect_nodes": {
        "botster-ui-descendant-v1:34:botster-ui-descendant-v1:3:mem2:m15:title": {
          "props": {
            "text": "Build"
          }
        }
      },
      "because": "UI UI-RF-1"
    },

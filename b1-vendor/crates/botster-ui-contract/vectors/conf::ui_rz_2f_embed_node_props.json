{
  "id": "conf::ui_rz_2f_embed_node_props",
  "contract": "ui",
  "clause": "UI-RZ-2f",
  "subject": "realizer",
  "cases": [
    {
      "name": "an asset_id reference realizes as an embed node with title, asset_id and state ready",
      "document": {
        "ui_contract_view": "1.4",
        "id": "v",
        "title": "T",
        "root": {
          "type": "stack",
          "id": "root",
          "direction": "column",
          "children": [
            {
              "type": "embed",
              "id": "graph",
              "title": "Graph",
              "page": {
                "asset": {
                  "asset_id": "a1"
                }
              },
              "empty": {
                "title": "Nothing here"
              },
              "error": {
                "title": "Nothing here"
              }
            }
          ]
        },
        "requires": [
          "ui_embed"
        ]
      },
      "capabilities": {
        "features": [
          "ui_embed",
          "embed"
        ],
        "ui_contract_view": [
          "1.4"
        ]
      },
      "expect_nodes": {
        "graph": {
          "type": "embed",
          "props": {
            "title": "Graph",
            "asset_id": "a1",
            "state": "ready"
          }
        }
      },
      "because": "UI UI-RZ-2f"
    },

{
  "id": "conf::ui_fd_2_unmapped_value_shows_raw_text_neutral",
  "contract": "ui",
  "clause": "UI-FD-2",
  "subject": "realizer",
  "cases": [
    {
      "name": "a string with no key shows as itself in the neutral tone",
      "document": {
        "ui_contract_view": "1.4",
        "id": "v",
        "title": "T",
        "root": {
          "type": "list",
          "id": "l",
          "source": {
            "kind": "k"
          },
          "item": {
            "fields": [
              {
                "id": "f",
                "path": "/v",
                "map": {
                  "open": {
                    "label": "Open",
                    "tone": "info"
                  }
                }
              }
            ]
          }
        }
      },
      "kinds": {
        "k": {
          "baseline": true,
          "rows": [
            {
              "id": "r0",
              "v": "zzz"
            }
          ]
        }
      },
      "expect_nodes": {
        "botster-ui-descendant-v1:32:botster-ui-descendant-v1:1:l2:r01:f": {
          "type": "text",
          "props": {
            "text": "zzz",
            "tone": "neutral"
          }
        }
      },
      "because": "UI UI-FD-2"
    },

{
  "id": "conf::dp_3_frame_limit_checked_before_allocation",
  "contract": "core",
  "clause": "DP-3",
  "subject": "core",
  "requires": {
    "controls": [
      "pty_input",
      "route_read_size",
      "route_stream_consumed",
      "edges_quiet"
    ]
  },
  "steps": [
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s1",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ],
              "fake": {
                "writes": {
                  "key": "6b",
                  "paste": "70"
                },
                "admission": {
                  "key": 12,
                  "mouse": 12,
                  "focus": 3,
                  "paste": 64
                }
              }
            }
          }
        }
      },
      "bind": "$c_s1"
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "s1"
          }
        }
      },
      "bind": "$s_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$s_s1",
            "result": {}
          }
        }
      },
      "because": "Core LC-3"
    },
    {
      "attach_route": {
        "route": "r1",
        "session": "s1",
        "client": "c1",
        "options": {
          "route_limits": {
            "max_frame_bytes": 4096
          }
        }
      },
      "because": "Core OU-1"
    },
    {
      "expect": {
        "frame": "attached",
        "terminal_format": {
          "$type": "string"
        },
        "limits": {
          "max_frame_bytes": 4096
        }
      },
      "on": "r1",
      "because": "Core OU-9"
    },
    {
      "expect": {
        "frame": "baseline_begin",
        "rows": {
          "$type": "integer"
        },
        "cols": {
          "$type": "integer"
        },
        "modes": {
          "$type": "object"
        }
      },
      "on": "r1",
      "because": "Core OU-9"
    },
    {
      "expect": {
        "frame": "screen",
        "payload": {
          "$any": true
        }
      },
      "on": "r1",
      "because": "Core OU-9"
    },
    {
      "expect_eventually": {
        "frame": "baseline_end",
        "history": "not_requested"
      },
      "ignore": [
        {
          "frame": "history",
          "payload": {
            "$any": true
          }
        }
      ],
      "on": "r1",
      "because": "Core OU-9"
    },
    {
      "expect": {
        "frame": "live"
      },
      "on": "r1",
      "because": "Core OU-9"
    },
    {
      "control": {
        "op": "route_read_size",
        "bytes": 1
      },
      "route": "r1"
    },
    {
      "route_send": {
        "frame": "bytes",
        "op": "1",
        "bytes": {
          "$bytes_hex": ""
        }
      }
    },
    {
      "await_pty": {
        "session": "s1",
        "min_bytes": 4087
      }
    },
    {
      "control": {
        "op": "route_stream_consumed"
      },
      "route": "r1",
      "expect": {
        "bytes": "$before"
      },
      "because": [
        "Core DP-3"
      ]
    },
    {
      "route_send_wire": {
        "bytes_hex": ""
      }
    },
    {
      "expect_eventually": {
        "frame": "route_closed",
        "reason": {
          "protocol_error": {
            "code": "frame_too_large"
          }
        }
      },
      "ignore": [
        {
          "frame": "modes"
        },
        {
          "frame": "output"
        }
      ],
      "on": "r1",
      "because": [
        "Core DP-3",
        "Core A2-3"
      ]
    },
    {
      "expect_closed": null,
      "on": "r1",
      "because": [
        "Core DP-3"
      ]
    },
    {
      "pump_until": {
        "event": {
          "RouteClosed": {
            "route": "$r1",
            "reason": {
              "BadFrame": {
                "code": "frame_too_large"
              }
            }
          }
        }
      },
      "because": [
        "Core DP-3",
        "Core A2-3"
      ]
    },
    {
      "await_quiet": {}
    },
    {
      "control": {
        "op": "route_stream_consumed"
      },
      "route": "r1",
      "expect": {
        "bytes": "$after"
      },
      "because": [
        "Core DP-3"
      ]
    },
    {
      "let": {
        "$taken": {
          "sub": [
            "$after",
            "$before"
          ]
        }
      }
    },
    {
      "check": {
        "lt": [
          "$taken",
          7
        ]
      },
      "because": [
        "Core DP-3"
      ]
    }
  ],
  "fake": "structural",
  "ruling": "R-12"
}

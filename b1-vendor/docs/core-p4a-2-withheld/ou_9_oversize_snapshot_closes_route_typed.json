{
  "id": "conf::ou_9_oversize_snapshot_closes_route_typed",
  "contract": "core",
  "clause": "OU-9",
  "subject": "core",
  "requires": {
    "controls": []
  },
  "setup": {
    "limits": {
      "max_snapshot_bytes": 1
    }
  },
  "steps": [
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s1",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ],
              "fake": {
                "writes": {
                  "key": "6b",
                  "paste": "70"
                },
                "admission": {
                  "key": 12,
                  "mouse": 12,
                  "focus": 3,
                  "paste": 64
                }
              }
            }
          }
        }
      },
      "bind": "$c_s1"
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "s1"
          }
        }
      },
      "bind": "$s_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$s_s1",
            "result": {}
          }
        }
      },
      "because": "Core LC-3"
    },
    {
      "begin": {
        "op": {
          "CaptureSnapshot": {
            "session": "s1",
            "owner": "c1"
          }
        }
      },
      "bind": "$cap"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$cap",
            "result": {
              "err": {
                "code": "SnapshotTooLarge"
              }
            }
          }
        }
      },
      "because": [
        "Core OU-9",
        "Core A8-2"
      ]
    },
    {
      "attach_route": {
        "route": "rb",
        "session": "s1",
        "client": "c1",
        "options": {
          "history": "none"
        }
      },
      "because": "Core OU-1"
    },
    {
      "expect_eventually": {
        "frame": "route_closed",
        "reason": {
          "attach_failed": {
            "reason": "snapshot_too_large"
          }
        }
      },
      "ignore": [
        {
          "frame": "attached"
        }
      ],
      "on": "rb",
      "because": [
        "Core OU-9",
        "Core OU-2b"
      ]
    },
    {
      "expect_closed": null,
      "on": "rb",
      "because": [
        "Core OU-9"
      ]
    },
    {
      "pump_until": {
        "event": {
          "RouteClosed": {
            "route": "$rb",
            "reason": "SnapshotTooLarge"
          }
        }
      },
      "because": [
        "Core OU-9",
        "Core OU-2b",
        "Core A2-3"
      ]
    }
  ],
  "fake": "structural",
  "ruling": "R-12"

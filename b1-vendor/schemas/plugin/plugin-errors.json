  "kinds": [
    {
      "kind": "invalid_request",
      "meaning": "argument shape or value refused"
    },
    {
      "kind": "capability_denied",
      "meaning": "the package lacks the grant, or the object is not the plugin's"
    },
    {
      "kind": "not_found",
      "meaning": "the named object does not exist"
    },
    {
      "kind": "conflict",
      "meaning": "revision conflict or already exists"
    },
    {
      "kind": "quota_exceeded",
      "meaning": "a plugin-owned quota is full"
    },
    {
      "kind": "response_too_large",
      "meaning": "one result or item is larger than the bound; nothing is truncated"
    },
    {
      "kind": "backpressured",
      "meaning": "a bounded queue or reservation is full now"
    },
    {
      "kind": "timed_out",
      "meaning": "the deadline expired"
    },
    {
      "kind": "cancelled",
      "meaning": "the plugin or the Hub cancelled the operation"
    },
    {
      "kind": "unavailable",
      "meaning": "the target runtime is stopped, not ready or not configured"
    },
    {
      "kind": "failed",
      "meaning": "the operation ran and failed; detail explains"
    }

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SpawnRequest",
  "description": "What a host asks Core to run.\n\nClause: Core 3, Core A2-1, Core A3-1, Core A3-3, Core DP-6.",
  "type": "object",
  "properties": {
    "argv": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "env": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "cwd": {
      "type": "string"
    },
    "size": {
      "$ref": "#/$defs/Size"
    },
    "labels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "default": {}
    },
    "color_profile": {
      "anyOf": [
        {
          "$ref": "#/$defs/ColorProfile"
        },
        {
          "type": "null"
        }
      ]
    },
    "notification_policy": {
      "description": "The default is `All` (A3-1).",
      "anyOf": [
        {
          "$ref": "#/$defs/NotificationPolicy"
        },
        {
          "type": "null"
        }
      ]
    },
    "size_policy": {
      "description": "DP-6 says the policy is also accepted in `Create`. The default is `Latest`.",
      "anyOf": [
        {
          "$ref": "#/$defs/SizePolicy"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "argv",
    "env",
    "cwd",
    "size"
  ],
  "$defs": {
    "Size": {
      "description": "A terminal size.\n\nClause: Core 3, Core A2-1, Core SZ-1.",
      "type": "object",
      "properties": {
        "rows": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "cols": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "cell_px": {
          "anyOf": [
            {
              "$ref": "#/$defs/CellPx"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "rows",
        "cols"
      ]
    },
    "CellPx": {
      "description": "The pixel size of one cell, from 1.\n\nClause: Core 3, Core EV-8a.",
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "format": "uint32",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "format": "uint32",
          "minimum": 1
        }
      },
      "required": [
        "width",
        "height"
      ]
    },
    "ColorProfile": {
      "description": "The colors that the shadow terminal answers with.\n\nClause: Core A2-1, Core EV-8.",
      "type": "object",
      "properties": {
        "palette": {
          "description": "Exactly 256 entries when present.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/Rgb"
          },
          "minItems": 256,
          "maxItems": 256
        },
        "foreground": {
          "$ref": "#/$defs/Rgb"
        },
        "background": {
          "$ref": "#/$defs/Rgb"
        },
        "cursor": {
          "anyOf": [
            {
              "$ref": "#/$defs/Rgb"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "foreground",
        "background"
      ]
    },
    "Rgb": {
      "description": "One color.\n\nClause: Core A2-1.",
      "type": "object",
      "properties": {
        "r": {
          "type": "integer",
          "format": "uint8",
          "minimum": 0,
          "maximum": 255
        },
        "g": {
          "type": "integer",
          "format": "uint8",
          "minimum": 0,
          "maximum": 255
        },
        "b": {
          "type": "integer",
          "format": "uint8",
          "minimum": 0,
          "maximum": 255
        }
      },
      "required": [
        "r",
        "g",
        "b"
      ]
    },
    "NotificationPolicy": {
      "description": "Which notifications in dropped output count (A3-1). The default is `All`.\n\nClause: Core A3-1.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "all",
            "none"
          ]
        },
        {
          "type": "object",
          "properties": {
            "matching": {
              "type": "object",
              "properties": {
                "patterns": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "patterns"
              ]
            }
          },
          "required": [
            "matching"
          ],
          "additionalProperties": false
        }
      ]
    },
    "SizePolicy": {
      "description": "The size policy of a session.\n\nClause: Core DP-6.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "latest"
          ]
        },
        {
          "description": "Needs the feature `size_policy_other`.",
          "type": "string",
          "const": "smallest"
        },
        {
          "description": "Needs the feature `size_policy_other`.",
          "type": "string",
          "const": "largest"
        }
      ]
    }
  }
}

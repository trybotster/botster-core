{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "hub_id": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/SessionState"
    },
    "lifecycle_class": {
      "$ref": "#/$defs/LifecycleClass"
    },
    "exit": {
      "$ref": "#/$defs/SessionExit"
    },
    "size": {
      "$ref": "#/$defs/SessionSize"
    },
    "session_type": {
      "$ref": "#/$defs/SessionTypeRef"
    },
    "traits": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "restartable": {
      "type": "boolean"
    },
    "activity": {
      "$ref": "#/$defs/Activity"
    },
    "presentation": {
      "$ref": "#/$defs/Presentation"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true
      },
      "description": "A map of plugin namespace to a JSON object, written through HP `sessions.update`; `{}` when no plugin has written."
    },
    "failure_reason": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "interaction": {
      "$ref": "#/$defs/Interaction"
    },
    "port": {
      "type": "integer",
      "format": "uint16",
      "minimum": 0,
      "maximum": 65535,
      "description": "The allocated port when the session type asks for one (HP CA-20)."
    },
    "owner": {
      "type": "string",
      "description": "The key of the plugin that spawned the session."
    },
    "worktree_id": {
      "type": "string"
    },
    "branch": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "description": "Only the terminal's latest title."
    },
    "task": {
      "type": "string"
    },
    "attention": {
      "$ref": "#/$defs/Attention"
    }
  },
  "required": [
    "id",
    "hub_id",
    "label",
    "state",
    "lifecycle_class",
    "exit",
    "size",
    "session_type",
    "traits",
    "restartable",
    "activity",
    "presentation",
    "metadata"
  ],
  "additionalProperties": true,
  "description": "A `session` row: the one shape of the HC `session` kind and of HP SS-1, A2-28.\n\nRequired: `id`, `hub_id`, `label`, `state`, `lifecycle_class`, `exit`, `size`, `session_type`, `traits`, `restartable`, `activity`, `presentation`, `metadata`.\nOptional, absent when there is no value (never `null`, A.1): `failure_reason`, `role`, `interaction`, `port`, `owner`, `worktree_id`, `branch`, `title`, `task`, `attention`.\nA row also accepts descriptive fields that this contract adds later (EN-6).\n\nClause: HC section 6 (`session`), A.8, A.1, A2 H-20, steward ruling R-11.",
  "x-kind": "session",
  "x-schema-version": "1.0",
  "x-verbs": {
    "list": {
      "effect": "read",
      "reasons": [],
      "clause": "VB-1"
    },
    "get": {
      "effect": "read",
      "reasons": [],
      "clause": "VB-2"
    },
    "watch": {
      "effect": "read",
      "reasons": [],
      "clause": "WT-1"
    },
    "update": {
      "effect": "committed",
      "permission": "session.update",
      "args": "SessionPatch",
      "reasons": [
        "conflict",
        "invalid_arguments"
      ],
      "clause": "A.7, A.9, KR-1"
    },
    "delete": {
      "effect": "committed",
      "reasons": [
        "wrong_state"
      ],
      "clause": "A.7, A.2c"
    },
    "create": {
      "effect": "accepted",
      "args": "SessionCreate",
      "result": "SessionCreateReceipt",
      "reasons": [
        "wrong_state:swap_in_progress",
        "internal:credential_unavailable",
        "invalid_arguments:target_mismatch",
        "wrong_state:session_type_unavailable",
        "invalid_arguments:scope_widens",
        "permission_denied",
        "invalid_arguments:argv_empty",
        "invalid_arguments:cwd_not_allowed"
      ],
      "clause": "A.7, A.9, section 6 (session create)"
    }
  },
  "x-actions": {
    "attach": {
      "effect": "immediate",
      "durable_operation": false,
      "reasons": [
        "unsupported:binding_auth_unavailable",
        "unsupported:terminal_format",
        "wrong_state:session_not_running",
        "not_found:route",
        "unsupported:binding",
        "busy"
      ],
      "args": "AttachArgs",
      "result": "AttachResult",
      "clause": "TS-1, A.7, A.9b"
    },
    "detach": {
      "effect": "immediate",
      "durable_operation": false,
      "reasons": [
        "not_found:route"
      ],
      "args": "DetachArgs",
      "result": "Empty",
      "clause": "TS-10, A.7, A.9b"
    },
    "stop": {
      "effect": "accepted",
      "durable_operation": false,
      "reasons": [
        "wrong_state:not_running"
      ],
      "args": "Empty",
      "result": "Receipt",
      "clause": "A.7, A.9, A.9b"
    },
    "restart": {
      "effect": "accepted",
      "durable_operation": true,
      "reasons": [
        "wrong_state:not_ended",
        "wrong_state:not_restartable",
        "wrong_state:record_unavailable",
        "wrong_state:environment_not_retained",
        "wrong_state:not_ready",
        "wrong_state:swap_in_progress"
      ],
      "args": "Empty",
      "result": "Receipt",
      "clause": "section 6 (restart), A.7, A.9b"
    },
    "read_screen": {
      "effect": "read",
      "durable_operation": false,
      "reasons": [
        "wrong_state:no_screen_model"
      ],
      "args": "ReadScreenArgs",
      "result": "ReadScreenResult",
      "clause": "A.7, A.9, A.9b"
    },
    "clear_attention": {
      "effect": "committed",
      "durable_operation": false,
      "reasons": [],
      "args": "Empty",
      "result": "Empty",
      "clause": "SF-5d, A.7, A.9b"
    },
    "safe_write": {
      "effect": "accepted",
      "durable_operation": false,
      "permission": "session.safe_write",
      "reasons": [
        "wrong_state:session_ended",
        "invalid_arguments:text_too_long",
        "invalid_arguments:text_empty",
        "busy"
      ],
      "args": "SafeWriteArgs",
      "result": "Receipt",
      "clause": "MC-4, A.7, A.9b"
    },
    "write": {
      "effect": "immediate",
      "durable_operation": false,
      "permission": "session.write",
      "reasons": [
        "wrong_state:session_ended",
        "busy",
        "invalid_arguments:bytes_too_long",
        "invalid_arguments:bytes_empty",
        "invalid_arguments:bytes_invalid"
      ],
      "args": "WriteArgs",
      "result": "WriteResult",
      "clause": "MC-4, A.7, A.9b"
    }
  },
  "$defs": {
    "SessionPatch": {
      "type": "object",
      "properties": {
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "task": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "description": "The merge patch of `update(session)`: `label` and `task`. `null` deletes a member (A.1, VB-4).\n\nClause: HC A.9, A.1, KR-1."
    },
    "SessionCreate": {
      "anyOf": [
        {
          "$ref": "#/$defs/SessionCreateCommand"
        },
        {
          "$ref": "#/$defs/SessionCreateType"
        }
      ],
      "description": "The two forms of `create(session, …)`.\n\nClause: HC A.9."
    },
    "SessionCreateCommand": {
      "type": "object",
      "properties": {
        "command": {
          "$ref": "#/$defs/CommandSpec"
        },
        "size": {
          "$ref": "#/$defs/RequestedSize"
        },
        "target_id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "agent_scopes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "command"
      ],
      "description": "`create(session, { command, … })`: freeform spawn, permission `session.create_command`.\n\nClause: HC A.9, section 6."
    },
    "CommandSpec": {
      "type": "object",
      "properties": {
        "argv": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cwd": {
          "type": "string"
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "argv"
      ],
      "description": "A freeform command spawn.\n\nClause: HC A.9 (`session` create), section 6."
    },
    "RequestedSize": {
      "type": "object",
      "properties": {
        "rows": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "maximum": 4294967295
        },
        "cols": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "maximum": 4294967295
        }
      },
      "required": [
        "rows",
        "cols"
      ],
      "description": "A requested session size.\n\nClause: HC A.9 (`session` create)."
    },
    "SessionCreateType": {
      "type": "object",
      "properties": {
        "session_type_id": {
          "type": "string"
        },
        "target_id": {
          "type": "string"
        },
        "worktree_id": {
          "type": "string"
        },
        "prompt": {
          "type": "string"
        },
        "context": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "label": {
          "type": "string"
        },
        "agent_scopes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "session_type_id"
      ],
      "description": "`create(session, { session_type_id, … })`. `worktree_id` implies its target; a different `target_id` is `invalid_arguments`.\n\nClause: HC A.9, A2 part 1 (`agent_scopes`)."
    },
    "SessionCreateReceipt": {
      "type": "object",
      "properties": {
        "operation_id": {
          "type": "string"
        },
        "session": {
          "$ref": "#/$defs/SessionRef"
        },
        "state": {
          "$ref": "#/$defs/StartingTag"
        }
      },
      "required": [
        "operation_id",
        "session",
        "state"
      ],
      "description": "The result of `create(session)`: the receipt of a durable accepted operation.\n\nClause: HC section 6 (session create), A.9, A.7b."
    },
    "SessionRef": {
      "type": "object",
      "properties": {
        "hub_id": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        }
      },
      "required": [
        "hub_id",
        "session_id"
      ],
      "description": "A session identity: `{hub_id, session_id}`.\n\nClause: HC P5."
    },
    "StartingTag": {
      "type": "string",
      "enum": [
        "starting"
      ],
      "description": "The word `starting`, the state in the create receipt.\n\nClause: HC A.9."
    },
    "AttachArgs": {
      "type": "object",
      "properties": {
        "history": {
          "$ref": "#/$defs/AttachHistory"
        },
        "replace_route": {
          "type": "string"
        },
        "answers_queries": {
          "type": "boolean",
          "description": "Default true."
        },
        "binding": {
          "type": "string"
        },
        "route_features": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "writable": {
          "type": "boolean",
          "description": "Whether the route may send input (codec revision 30 `attach` `writable?`, A2 part 2)."
        }
      },
      "required": [
        "history"
      ],
      "description": "Arguments of `attach`.\n\nClause: HC TS-1, A.9."
    },
    "AttachHistory": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "none",
            "screen",
            "full"
          ]
        },
        {
          "type": "string"
        }
      ]
    },
    "AttachResult": {
      "type": "object",
      "properties": {
        "route_id": {
          "type": "string"
        },
        "transport": {
          "$ref": "#/$defs/Transport"
        },
        "route_limits": {
          "$ref": "#/$defs/RouteLimits"
        }
      },
      "required": [
        "route_id",
        "transport",
        "route_limits"
      ],
      "description": "The result of `attach`.\n\nClause: HC TS-1, A.9."
    },
    "Transport": {
      "type": "object",
      "properties": {
        "binding": {
          "type": "string"
        },
        "socket_path": {
          "type": "string",
          "description": "`local-stream`: the Hub's listener."
        },
        "route_token": {
          "type": "string",
          "description": "`local-stream`: unguessable, single use."
        }
      },
      "required": [
        "binding"
      ],
      "additionalProperties": true,
      "description": "`transport = { binding, … }`: the binding name and that binding's connect information (section 9).\n\nClause: HC TS-1, TB-L2, TB-W2."
    },
    "RouteLimits": {
      "type": "object",
      "properties": {
        "max_frame_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "max_screen_frame_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "max_history_page_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "max_paste_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "max_file_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "max_query_reply_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "query_client_deadline_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "stall_deadline_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "stall_close_after_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "max_frame_bytes",
        "max_screen_frame_bytes",
        "max_history_page_bytes",
        "max_paste_bytes",
        "max_file_bytes",
        "max_query_reply_bytes",
        "query_client_deadline_ms",
        "stall_deadline_ms",
        "stall_close_after_ms"
      ],
      "description": "The limits of one route (TS-1), as the worker applies them (A.4 `attached`).\n\nClause: Codec TS-1, TS-3, A.4."
    },
    "DetachArgs": {
      "type": "object",
      "properties": {
        "route_id": {
          "type": "string"
        }
      },
      "required": [
        "route_id"
      ],
      "description": "Arguments of `detach`.\n\nClause: HC TS-10, A.9."
    },
    "Empty": {
      "type": "object",
      "description": "The empty arguments or result: `{}`.\n\nClause: HC A.9."
    },
    "Receipt": {
      "type": "object",
      "properties": {
        "operation": {
          "$ref": "#/$defs/OperationRow"
        }
      },
      "required": [
        "operation"
      ],
      "description": "The result of an `accepted` action: the full `operation` row at admission.\n\nClause: HC A.7b, EN-7."
    },
    "OperationRow": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "description": "Non-exhaustive: an unknown kind is shown as \"other\" and the client waits for `terminal`."
        },
        "state": {
          "$ref": "#/$defs/OperationState"
        },
        "terminal": {
          "type": "boolean",
          "description": "Whether the state is final."
        },
        "progress": {
          "$ref": "#/$defs/Progress"
        },
        "result": {
          "description": "The per-kind result of A.7b."
        },
        "error": {
          "$ref": "#/$defs/Error"
        }
      },
      "required": [
        "id",
        "kind",
        "state",
        "terminal"
      ],
      "description": "The wire form of `OperationRow`. The reader checks the `result` of a known kind after it reads the members (A.7b).",
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "spawn"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "result": {
                "$ref": "#/$defs/SessionRef"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "hub.update"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "result": {
                "$ref": "#/$defs/UpdateResult"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "hub.upgrade_packages"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "result": {
                "$ref": "#/$defs/BulkPackagesResult"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "hub.rollback_packages"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "result": {
                "$ref": "#/$defs/BulkPackagesResult"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "package.install"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "result": {
                "$ref": "#/$defs/PackageInstallResult"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "package.upgrade"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "result": {
                "$ref": "#/$defs/PackageUpgradeResult"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "package.rollback"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "result": {
                "$ref": "#/$defs/PackageRollbackResult"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "spawn_target.rescan_packages"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "result": {
                "$ref": "#/$defs/RescanResult"
              }
            }
          }
        }
      ]
    },
    "OperationState": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 1,
          "propertyNames": {
            "enum": [
              "failed",
              "abandoned",
              "cancelled",
              "unknown"
            ]
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "reason"
            ]
          }
        },
        {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 1,
          "propertyNames": {
            "not": {
              "enum": [
                "failed",
                "abandoned",
                "cancelled",
                "unknown"
              ]
            }
          },
          "additionalProperties": {
            "type": "object"
          }
        }
      ]
    },
    "Progress": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string"
        },
        "fraction": {
          "type": "number",
          "format": "double",
          "minimum": 0.0,
          "maximum": 1.0
        }
      },
      "required": [
        "message"
      ],
      "description": "`progress` of a generic operation: `{ message, fraction? }`, `fraction` in 0..1.\n\nClause: HC A.7b."
    },
    "Error": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "category": {
          "$ref": "#/$defs/Category"
        },
        "retryable": {
          "type": "boolean"
        },
        "effect": {
          "description": "Present on every error that answers a mutating request.",
          "$ref": "#/$defs/ErrorEffect"
        },
        "message": {
          "type": "string"
        },
        "reason": {
          "type": "string",
          "description": "A kind-specific sub-code, listed in the kind's `describe`."
        },
        "detail": {
          "type": "object",
          "additionalProperties": true,
          "description": "The data that the contract names next to a code (`sessions`, `candidates`, `interface`, `range`, `key`)."
        },
        "field_errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FieldError"
          }
        },
        "retry_after_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "code",
        "category",
        "retryable",
        "message"
      ],
      "description": "The error object of a `res`, a tool result and an operation.\n\nClause: HC section 11, A.1b (`detail`), EN-3b."
    },
    "ErrorCode": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "invalid_arguments",
            "not_found",
            "unsupported",
            "conflict",
            "wrong_state",
            "permission_denied",
            "too_many_requests",
            "busy",
            "response_too_large",
            "plugin_failed",
            "remote_hub_unsupported",
            "hub_shutdown",
            "expired_cursor",

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "path": {
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/TargetKind"
    },
    "git": {
      "$ref": "#/$defs/GitInfo"
    }
  },
  "required": [
    "id",
    "label",
    "path",
    "kind"
  ],
  "description": "The `spawn_target` row.\n\nClause: HC section 6 (`spawn_target`), A2 H-7.",
  "x-kind": "spawn_target",
  "x-schema-version": "1.0",
  "x-verbs": {
    "list": {
      "effect": "read",
      "reasons": [],
      "clause": "VB-1"
    },
    "get": {
      "effect": "read",
      "reasons": [],
      "clause": "VB-2"
    },
    "watch": {
      "effect": "read",
      "reasons": [],
      "clause": "WT-1"
    },
    "create": {
      "effect": "committed",
      "args": "SpawnTargetInput",
      "reasons": [
        "invalid_arguments:path_not_absolute",
        "invalid_arguments:path_not_found",
        "invalid_arguments:not_a_directory",
        "conflict:path_exists"
      ],
      "clause": "A.7, A.9"
    },
    "update": {
      "effect": "committed",
      "reasons": [
        "invalid_arguments:path_not_absolute",
        "invalid_arguments:path_not_found",
        "invalid_arguments:not_a_directory",
        "conflict:path_exists"
      ],
      "clause": "A.7, A.9"
    },
    "delete": {
      "effect": "committed",
      "reasons": [
        "wrong_state:in_use"
      ],
      "clause": "A.7"
    }
  },
  "x-actions": {
    "validate": {
      "effect": "read",
      "durable_operation": false,
      "reasons": [],
      "args": "Empty",
      "result": "ValidateResult",
      "clause": "A.7, A.9"
    },
    "browse": {
      "effect": "read",
      "durable_operation": false,
      "permission": "spawn_target.browse",
      "reasons": [
        "invalid_arguments:path_not_absolute",
        "not_found:path",
        "wrong_state:not_a_directory",
        "wrong_state:unreadable"
      ],
      "args": "BrowseArgs",
      "result": "BrowseResult",
      "clause": "A.7, A.9, A.9b"
    },
    "rescan_packages": {
      "effect": "accepted",
      "durable_operation": false,
      "reasons": [
        "wrong_state:not_a_directory"
      ],
      "args": "Empty",
      "result": "Receipt",
      "clause": "A2 part 1, A.9b"
    }
  },
  "$defs": {
    "SpawnTargetInput": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/TargetKind"
        },
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "label",
        "path",
        "kind"
      ],
      "description": "The create and update fields of a spawn target.\n\nClause: HC A.9."
    },
    "TargetKind": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "directory",
            "git"
          ]
        },
        {
          "type": "string"
        }
      ]
    },
    "Empty": {
      "type": "object",
      "description": "The empty arguments or result: `{}`.\n\nClause: HC A.9."
    },
    "ValidateResult": {
      "type": "object",
      "properties": {
        "valid": {
          "type": "boolean"
        },
        "problems": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CodeMessage"
          }
        }
      },
      "required": [
        "valid"
      ],
      "description": "The result of `spawn_target.validate`: problems are in the result, not an error. `problems[].code` is non-exhaustive (`path_missing`, `not_a_directory`, `not_git`, `unreadable`).\n\nClause: HC A.9, A2 A.9b."
    },
    "CodeMessage": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "description": "A `{ code, message }` diagnostic or problem.\n\nClause: HC A.9, A2 H-31."
    },
    "BrowseArgs": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "description": "Arguments of `spawn_target.browse`.\n\nClause: HC A.9."
    },
    "BrowseResult": {
      "type": "object",
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BrowseEntry"
          }
        }
      },
      "required": [
        "entries"
      ],
      "description": "The result of `browse`: directories only.\n\nClause: HC A.9."
    },
    "BrowseEntry": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "path"
      ],
      "description": "One directory entry of `browse`.\n\nClause: HC A.9."
    },
    "Receipt": {
      "type": "object",
      "properties": {
        "operation": {
          "$ref": "#/$defs/OperationRow"
        }
      },
      "required": [
        "operation"
      ],
      "description": "The result of an `accepted` action: the full `operation` row at admission.\n\nClause: HC A.7b, EN-7."
    },
    "OperationRow": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "description": "Non-exhaustive: an unknown kind is shown as \"other\" and the client waits for `terminal`."
        },
        "state": {
          "$ref": "#/$defs/OperationState"
        },
        "terminal": {
          "type": "boolean",
          "description": "Whether the state is final."
        },
        "progress": {
          "$ref": "#/$defs/Progress"
        },
        "result": {
          "description": "The per-kind result of A.7b."
        },
        "error": {
          "$ref": "#/$defs/Error"
        }
      },
      "required": [
        "id",
        "kind",
        "state",
        "terminal"
      ],
      "description": "The wire form of `OperationRow`. The reader checks the `result` of a known kind after it reads the members (A.7b).",
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "spawn"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "result": {
                "$ref": "#/$defs/SessionRef"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "hub.update"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "result": {
                "$ref": "#/$defs/UpdateResult"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "hub.upgrade_packages"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "result": {
                "$ref": "#/$defs/BulkPackagesResult"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "hub.rollback_packages"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "result": {
                "$ref": "#/$defs/BulkPackagesResult"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "package.install"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "result": {
                "$ref": "#/$defs/PackageInstallResult"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "package.upgrade"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "result": {
                "$ref": "#/$defs/PackageUpgradeResult"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "package.rollback"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "result": {
                "$ref": "#/$defs/PackageRollbackResult"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "spawn_target.rescan_packages"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "result": {
                "$ref": "#/$defs/RescanResult"
              }
            }
          }
        }
      ]
    },
    "OperationState": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 1,
          "propertyNames": {
            "enum": [
              "failed",
              "abandoned",
              "cancelled",
              "unknown"
            ]
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "reason"
            ]
          }
        },
        {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 1,
          "propertyNames": {
            "not": {
              "enum": [
                "failed",
                "abandoned",
                "cancelled",
                "unknown"
              ]
            }
          },
          "additionalProperties": {
            "type": "object"
          }
        }
      ]
    },
    "Progress": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string"
        },
        "fraction": {
          "type": "number",
          "format": "double",
          "minimum": 0.0,
          "maximum": 1.0
        }
      },
      "required": [
        "message"
      ],
      "description": "`progress` of a generic operation: `{ message, fraction? }`, `fraction` in 0..1.\n\nClause: HC A.7b."
    },
    "Error": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "category": {
          "$ref": "#/$defs/Category"
        },
        "retryable": {
          "type": "boolean"
        },
        "effect": {
          "description": "Present on every error that answers a mutating request.",
          "$ref": "#/$defs/ErrorEffect"
        },
        "message": {
          "type": "string"
        },
        "reason": {
          "type": "string",
          "description": "A kind-specific sub-code, listed in the kind's `describe`."
        },
        "detail": {
          "type": "object",
          "additionalProperties": true,
          "description": "The data that the contract names next to a code (`sessions`, `candidates`, `interface`, `range`, `key`)."
        },
        "field_errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FieldError"
          }
        },
        "retry_after_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "code",
        "category",
        "retryable",
        "message"
      ],
      "description": "The error object of a `res`, a tool result and an operation.\n\nClause: HC section 11, A.1b (`detail`), EN-3b."
    },
    "ErrorCode": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "invalid_arguments",
            "not_found",
            "unsupported",
            "conflict",
            "wrong_state",
            "permission_denied",
            "too_many_requests",
            "busy",
            "response_too_large",
            "plugin_failed",
            "remote_hub_unsupported",
            "hub_shutdown",
            "expired_cursor",
            "stale_descriptor",
            "cancelled",
            "internal"
          ]
        },
        {
          "type": "string"
        }
      ]
    },
    "Category": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "caller",
            "state",
            "auth",
            "capacity",
            "fault"
          ]
        },
        {
          "type": "string"
        }
      ]
    },
    "ErrorEffect": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "none",
            "unknown",
            "partial"
          ]
        },
        {
          "type": "string"
        }
      ]
    },
    "FieldError": {
      "type": "object",
      "properties": {
        "pointer": {
          "type": "string"
        },
        "field_id": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "pointer",
        "code",
        "message"
      ],
      "description": "One entry of `field_errors`: a JSON Pointer, an optional stable field id, a code and a message.\n\nClause: HC section 11, SF-2."
    },
    "SessionRef": {
      "type": "object",
      "properties": {
        "hub_id": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        }
      },
      "required": [
        "hub_id",
        "session_id"
      ],
      "description": "A session identity: `{hub_id, session_id}`.\n\nClause: HC P5."
    },
    "UpdateResult": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string"
        }
      },
      "required": [
        "version"
      ],
      "description": "`result` of a `hub.update` operation.\n\nClause: HC A.7b."
    },
    "BulkPackagesResult": {
      "type": "object",
      "properties": {
        "packages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PackageOutcome"
          }
        }
      },
      "required": [
        "packages"
      ],
      "description": "`result` of `hub.upgrade_packages` and `hub.rollback_packages`.\n\nClause: HC A.7b."
    },
    "PackageOutcome": {
      "type": "object",
      "properties": {
        "package": {
          "type": "string"
        },
        "state": {
          "type": "string",
          "description": "`succeeded` or `failed`."
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "package",
        "state"
      ],
      "description": "One package outcome of a bulk package operation.\n\nClause: HC A.7b."
    },
    "PackageInstallResult": {
      "type": "object",
      "properties": {
        "package": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "package",
        "version"
      ],
      "description": "`result` of `package.install`: the package key and the admitted manifest version, on every end that admitted a package.\n\nClause: HC A.7b, HC A6-1."
    },
    "PackageUpgradeResult": {
      "type": "object",
      "properties": {
        "package": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "resolved_commit": {
          "type": "string"
        }
      },
      "required": [
        "package",
        "version",
        "resolved_commit"
      ],
      "description": "`result` of `package.upgrade`.\n\nClause: HC A.7b."
    },
    "PackageRollbackResult": {
      "type": "object",
      "properties": {
        "package": {
          "type": "string"
        },
        "ref": {
          "type": "string"
        },
        "resolved_commit": {
          "type": "string"
        }
      },
      "required": [
        "package",
        "ref",
        "resolved_commit"
      ],
      "description": "`result` of `package.rollback`.\n\nClause: HC A.7b."
    },
    "RescanResult": {
      "type": "object",
      "properties": {
        "found": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "found",
        "removed"
      ],
      "description": "`result` of `spawn_target.rescan_packages`: the instances found and removed.\n\nClause: HC A.7b, A2 part 1."
    },
    "GitInfo": {
      "type": "object",
      "properties": {
        "repo": {
          "type": "string"
        },
        "current_branch": {
          "type": "string"
        },
        "default_branch": {
          "type": "string"
        }
      },
      "required": [
        "repo"
      ],
      "description": "`git: { repo, current_branch?, default_branch? }`. `repo` is `owner/name`, never a path or a credential.\n\nClause: HC section 6 (`spawn_target`), G-24."
    }
  }
}

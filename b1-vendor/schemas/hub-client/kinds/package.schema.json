{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/PackageKind"
    },
    "state": {
      "$ref": "#/$defs/PackageState"
    },
    "status": {
      "$ref": "#/$defs/PackageStatus"
    },
    "provides": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Provides"
      }
    },
    "requires": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Requires"
      }
    },
    "version": {
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/PackageSource"
    },
    "lock": {
      "$ref": "#/$defs/PackageLock"
    },
    "pinned_ref": {
      "type": "string"
    },
    "pending_grants": {
      "type": "array",
      "items": true,
      "description": "Grants that wait for approval (HP PM-8). The element type is HP's."
    },
    "configuration": true,
    "entrypoints": {
      "type": "array",
      "items": true,
      "description": "The entrypoints of the package. The element type is HP's."
    },
    "notice_reactions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/NoticeReaction"
      }
    },
    "target_id": {
      "type": "string"
    },
    "static_origin": {
      "type": "string",
      "description": "The recorded static origin (HP A2-42), shown to operators only; absent otherwise (HC A7-2)."
    }
  },
  "required": [
    "id",
    "name",
    "kind",
    "state",
    "status",
    "version",
    "source",
    "configuration",
    "entrypoints",
    "notice_reactions"
  ],
  "description": "The `package` row. `id` is the package key (HP CP-8).\n\nClause: HC section 6 (`package`), A1, A.1b, A7-2.",
  "x-kind": "package",
  "x-schema-version": "1.0",
  "x-verbs": {
    "list": {
      "effect": "read",
      "reasons": [],
      "clause": "VB-1"
    },
    "get": {
      "effect": "read",
      "reasons": [],
      "clause": "VB-2"
    },
    "watch": {
      "effect": "read",
      "reasons": [],
      "clause": "WT-1"
    },
    "create": {
      "effect": "accepted",
      "permission": "package.manage",
      "args": "PackageInstallArgs",
      "result": "Receipt",
      "reasons": [
        "invalid_arguments:path_invalid",
        "conflict:already_installed"
      ],
      "clause": "A.7, A.9"
    },
    "update": {
      "effect": "committed",
      "permission": "package.manage",
      "args": "PackagePatch",
      "reasons": [
        "invalid_arguments"
      ],
      "clause": "A.7, A.9"
    },
    "delete": {
      "effect": "accepted",
      "permission": "package.manage",
      "args": "PackageRemoveArgs",
      "result": "Receipt",
      "reasons": [],
      "clause": "A.7, A.9"
    }
  },
  "x-actions": {
    "enable": {
      "effect": "accepted",
      "durable_operation": false,
      "permission": "package.manage",
      "reasons": [
        "wrong_state:staged",
        "wrong_state:quarantined",
        "wrong_state:errored",
        "wrong_state:fs_root_unbound",
        "invalid_arguments:fs_root_unknown",
        "invalid_arguments:path_not_absolute",
        "invalid_arguments:path_not_found"
      ],
      "args": "EnableArgs",
      "result": "Receipt",
      "clause": "A.7, A2 part 1, A.9b"
    },
    "disable": {
      "effect": "accepted",
      "durable_operation": false,
      "permission": "package.manage",
      "reasons": [],
      "args": "Empty",
      "result": "Receipt",
      "clause": "A.7, A.9b"
    },
    "reload": {
      "effect": "accepted",
      "durable_operation": false,
      "permission": "package.manage",
      "reasons": [
        "wrong_state:disabled"
      ],
      "args": "Empty",
      "result": "Receipt",
      "clause": "A.7, A.9b"
    },
    "start_entrypoint": {
      "effect": "accepted",
      "durable_operation": false,
      "permission": "package.manage",
      "reasons": [
        "wrong_state:disabled"
      ],
      "args": "EntrypointArgs",
      "result": "Receipt",
      "clause": "A.7, A.9b"
    },
    "stop_entrypoint": {
      "effect": "accepted",
      "durable_operation": false,
      "permission": "package.manage",
      "reasons": [
        "wrong_state:disabled"
      ],
      "args": "EntrypointArgs",
      "result": "Receipt",
      "clause": "A.7, A.9b"
    },
    "restart_entrypoint": {
      "effect": "accepted",
      "durable_operation": false,
      "permission": "package.manage",
      "reasons": [
        "wrong_state:disabled"
      ],
      "args": "EntrypointArgs",
      "result": "Receipt",
      "clause": "A.7, A.9b"
    },
    "preview_upgrade": {
      "effect": "read",
      "durable_operation": false,
      "permission": "package.manage",
      "reasons": [
        "wrong_state:local_source",
        "wrong_state:fetch_failed"
      ],
      "args": "Empty",
      "result": "UpgradePreview",
      "clause": "A.7, A.9, A.9b"
    },
    "upgrade": {
      "effect": "accepted",
      "durable_operation": true,
      "permission": "package.manage",
      "reasons": [
        "conflict:breaking_not_accepted",
        "conflict:ambiguous_provider",
        "conflict:requirement_missing",
        "conflict:requirement_conflict",
        "wrong_state:pinned",
        "wrong_state:local_source",
        "wrong_state:up_to_date",
        "wrong_state:package_operation_in_progress"
      ],
      "args": "PackageUpgradeArgs",
      "result": "Receipt",
      "clause": "A.7, A.9, A.9b"
    },
    "pin": {
      "effect": "committed",
      "durable_operation": false,
      "permission": "package.manage",
      "reasons": [
        "wrong_state:local_source"
      ],
      "args": "PinArgs",
      "result": "PackageRow",
      "clause": "A.7, A.9, A.9b"
    },
    "unpin": {
      "effect": "committed",
      "durable_operation": false,
      "permission": "package.manage",
      "reasons": [],
      "args": "Empty",
      "result": "PackageRow",
      "clause": "A.7, A.9, A.9b"
    },
    "rollback": {
      "effect": "accepted",
      "durable_operation": true,
      "permission": "package.manage",
      "reasons": [
        "wrong_state:no_history",
        "wrong_state:local_source"
      ],
      "args": "Empty",
      "result": "Receipt",
      "clause": "A.7, A.9, A.9b"
    },
    "approve_grants": {
      "effect": "committed",
      "durable_operation": false,
      "permission": "package.manage",
      "reasons": [
        "conflict:grants_mismatch",
        "wrong_state:nothing_pending"
      ],
      "args": "ApproveGrantsArgs",
      "result": "PackageRow",
      "clause": "A.7, A.9, A.9b"
    },
    "open_asset": {
      "effect": "immediate",
      "durable_operation": false,
      "reasons": [
        "not_found",
        "wrong_state:assets_origin_unconfigured",
        "invalid_arguments"
      ],
      "args": "OpenAssetArgs",
      "result": "OpenAssetResult",
      "clause": "A.7, A.9, A.9b"
    }
  },
  "$defs": {
    "PackageInstallArgs": {
      "type": "object",
      "properties": {
        "source": {
          "$ref": "#/$defs/PackageSource"
        },
        "enable": {
          "type": "boolean"
        },
        "bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/InterfaceBinding"
          }
        }
      },
      "required": [
        "source"
      ],
      "description": "Arguments of `create(package)`, the install.\n\nClause: HC A.9, A1, HP PM-5."
    },
    "PackageSource": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "local"
            }
          },
          "required": [
            "kind",
            "path"
          ],
          "description": "A `local` path is shown to operators only."
        },
        {
          "type": "object",
          "properties": {
            "url": {
              "type": "string"
            },
            "ref": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "git"
            }
          },
          "required": [
            "kind",
            "url"
          ]
        },
        {
          "type": "object",
          "properties": {
            "catalog_id": {
              "type": "string"
            },
            "entry_id": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "catalog"
            }
          },
          "required": [
            "kind",
            "catalog_id",
            "entry_id"
          ]
        }
      ],
      "description": "The source of a package: `{kind: local, path}`, `{kind: git, url, ref?, path?}`, or the catalog entry it came from.\n\nClause: HC section 6 (`package`), A1, A.9 (`package` create)."
    },
    "InterfaceBinding": {
      "type": "object",
      "properties": {
        "interface": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        }
      },
      "required": [
        "interface",
        "provider"
      ],
      "description": "A `{ interface, provider }` binding.\n\nClause: HC A.9 (`package` install, `upgrade`), HP PD-6."
    },
    "Receipt": {
      "type": "object",
      "properties": {
        "operation": {
          "$ref": "#/$defs/OperationRow"
        }
      },
      "required": [
        "operation"
      ],
      "description": "The result of an `accepted` action: the full `operation` row at admission.\n\nClause: HC A.7b, EN-7."
    },
    "OperationRow": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "description": "Non-exhaustive: an unknown kind is shown as \"other\" and the client waits for `terminal`."
        },
        "state": {
          "$ref": "#/$defs/OperationState"
        },
        "terminal": {
          "type": "boolean",
          "description": "Whether the state is final."
        },
        "progress": {
          "$ref": "#/$defs/Progress"
        },
        "result": {
          "description": "The per-kind result of A.7b."
        },
        "error": {
          "$ref": "#/$defs/Error"
        }
      },
      "required": [
        "id",
        "kind",
        "state",
        "terminal"
      ],
      "description": "The wire form of `OperationRow`. The reader checks the `result` of a known kind after it reads the members (A.7b).",
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "spawn"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "result": {
                "$ref": "#/$defs/SessionRef"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "hub.update"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "result": {
                "$ref": "#/$defs/UpdateResult"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "hub.upgrade_packages"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "result": {
                "$ref": "#/$defs/BulkPackagesResult"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "hub.rollback_packages"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "result": {
                "$ref": "#/$defs/BulkPackagesResult"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "package.install"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "result": {
                "$ref": "#/$defs/PackageInstallResult"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "package.upgrade"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "result": {
                "$ref": "#/$defs/PackageUpgradeResult"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "package.rollback"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "result": {
                "$ref": "#/$defs/PackageRollbackResult"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "spawn_target.rescan_packages"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "result": {
                "$ref": "#/$defs/RescanResult"
              }
            }
          }
        }
      ]
    },
    "OperationState": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 1,
          "propertyNames": {
            "enum": [
              "failed",
              "abandoned",
              "cancelled",
              "unknown"
            ]
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "reason"
            ]
          }
        },
        {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 1,
          "propertyNames": {
            "not": {
              "enum": [
                "failed",
                "abandoned",
                "cancelled",
                "unknown"
              ]
            }
          },
          "additionalProperties": {
            "type": "object"
          }
        }
      ]
    },
    "Progress": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string"
        },
        "fraction": {
          "type": "number",
          "format": "double",
          "minimum": 0.0,
          "maximum": 1.0
        }
      },
      "required": [
        "message"
      ],
      "description": "`progress` of a generic operation: `{ message, fraction? }`, `fraction` in 0..1.\n\nClause: HC A.7b."
    },
    "Error": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "category": {
          "$ref": "#/$defs/Category"
        },
        "retryable": {
          "type": "boolean"
        },
        "effect": {
          "description": "Present on every error that answers a mutating request.",
          "$ref": "#/$defs/ErrorEffect"
        },
        "message": {
          "type": "string"
        },
        "reason": {
          "type": "string",
          "description": "A kind-specific sub-code, listed in the kind's `describe`."
        },
        "detail": {
          "type": "object",
          "additionalProperties": true,
          "description": "The data that the contract names next to a code (`sessions`, `candidates`, `interface`, `range`, `key`)."
        },
        "field_errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FieldError"
          }
        },
        "retry_after_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "code",
        "category",
        "retryable",
        "message"
      ],
      "description": "The error object of a `res`, a tool result and an operation.\n\nClause: HC section 11, A.1b (`detail`), EN-3b."
    },
    "ErrorCode": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "invalid_arguments",
            "not_found",
            "unsupported",
            "conflict",
            "wrong_state",
            "permission_denied",
            "too_many_requests",
            "busy",
            "response_too_large",
            "plugin_failed",
            "remote_hub_unsupported",
            "hub_shutdown",
            "expired_cursor",
            "stale_descriptor",
            "cancelled",
            "internal"
          ]
        },
        {
          "type": "string"
        }
      ]
    },
    "Category": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "caller",
            "state",
            "auth",
            "capacity",
            "fault"
          ]
        },
        {
          "type": "string"
        }
      ]
    },
    "ErrorEffect": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "none",
            "unknown",
            "partial"
          ]
        },
        {
          "type": "string"
        }
      ]
    },
    "FieldError": {
      "type": "object",
      "properties": {
        "pointer": {
          "type": "string"
        },
        "field_id": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "pointer",
        "code",
        "message"
      ],
      "description": "One entry of `field_errors`: a JSON Pointer, an optional stable field id, a code and a message.\n\nClause: HC section 11, SF-2."
    },
    "SessionRef": {
      "type": "object",
      "properties": {
        "hub_id": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        }
      },
      "required": [
        "hub_id",
        "session_id"
      ],
      "description": "A session identity: `{hub_id, session_id}`.\n\nClause: HC P5."
    },
    "UpdateResult": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string"
        }
      },
      "required": [
        "version"
      ],
      "description": "`result` of a `hub.update` operation.\n\nClause: HC A.7b."
    },
    "BulkPackagesResult": {
      "type": "object",
      "properties": {
        "packages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PackageOutcome"
          }
        }
      },
      "required": [
        "packages"
      ],
      "description": "`result` of `hub.upgrade_packages` and `hub.rollback_packages`.\n\nClause: HC A.7b."
    },
    "PackageOutcome": {
      "type": "object",
      "properties": {
        "package": {
          "type": "string"
        },
        "state": {
          "type": "string",
          "description": "`succeeded` or `failed`."
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "package",
        "state"
      ],
      "description": "One package outcome of a bulk package operation.\n\nClause: HC A.7b."
    },
    "PackageInstallResult": {
      "type": "object",
      "properties": {
        "package": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "package",
        "version"
      ],
      "description": "`result` of `package.install`: the package key and the admitted manifest version, on every end that admitted a package.\n\nClause: HC A.7b, HC A6-1."
    },
    "PackageUpgradeResult": {
      "type": "object",
      "properties": {
        "package": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "resolved_commit": {
          "type": "string"
        }
      },
      "required": [
        "package",
        "version",
        "resolved_commit"
      ],
      "description": "`result` of `package.upgrade`.\n\nClause: HC A.7b."
    },
    "PackageRollbackResult": {
      "type": "object",
      "properties": {
        "package": {
          "type": "string"
        },
        "ref": {
          "type": "string"
        },
        "resolved_commit": {
          "type": "string"
        }
      },
      "required": [
        "package",
        "ref",
        "resolved_commit"
      ],
      "description": "`result` of `package.rollback`.\n\nClause: HC A.7b."
    },
    "RescanResult": {
      "type": "object",
      "properties": {
        "found": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "found",
        "removed"
      ],
      "description": "`result` of `spawn_target.rescan_packages`: the instances found and removed.\n\nClause: HC A.7b, A2 part 1."
    },
    "PackagePatch": {
      "type": "object",
      "properties": {
        "configuration": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": [
        "configuration"
      ],
      "description": "The merge patch of `update(package)`.\n\nClause: HC A.9, A2 part 1 (`webhook_secret`, SF-3)."
    },
    "PackageRemoveArgs": {
      "type": "object",
      "properties": {
        "purge": {
          "type": "boolean"
        }
      },
      "description": "Arguments of `delete(package)`, the removal.\n\nClause: HC A.9, VB-5."
    },
    "EnableArgs": {
      "type": "object",
      "properties": {
        "fs_roots": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "description": "Arguments of `package.enable`: the filesystem root bindings.\n\nClause: HC A2 part 1."
    },
    "Empty": {
      "type": "object",
      "description": "The empty arguments or result: `{}`.\n\nClause: HC A.9."
    },
    "EntrypointArgs": {
      "type": "object",
      "properties": {
        "entrypoint_id": {
          "type": "string"
        }
      },
      "required": [
        "entrypoint_id"
      ],
      "description": "Arguments of an entrypoint action.\n\nClause: HC A.9."
    },
    "UpgradePreview": {
      "type": "object",
      "properties": {
        "old_commit": {
          "type": "string"
        },
        "new_commit": {
          "type": "string"
        },
        "old_hash": {
          "type": "string"
        },

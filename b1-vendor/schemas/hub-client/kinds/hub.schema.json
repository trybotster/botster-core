{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "software": {
      "$ref": "#/$defs/Software"
    },
    "worker_protocol": {
      "type": "integer",
      "format": "uint16",
      "minimum": 0,
      "maximum": 65535,
      "description": "The session-worker protocol that this Hub speaks (Core AD-4)."
    },
    "components": {
      "$ref": "#/$defs/Components"
    },
    "pid": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0,
      "maximum": 4294967295
    },
    "uptime_seconds": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "data_root": {
      "type": "string",
      "description": "Operators only."
    },
    "sessions": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "plugins": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "update": {
      "$ref": "#/$defs/UpdateStatus"
    },
    "push_public_key": {
      "type": "string",
      "description": "The VAPID public key: base64url without padding of the uncompressed P-256 point (A2 G-20)."
    },
    "web_origin": {
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/HubRunState"
    }
  },
  "required": [
    "id",
    "software",
    "worker_protocol",
    "components",
    "pid",
    "uptime_seconds",
    "sessions",
    "plugins",
    "update",
    "push_public_key",
    "state"
  ],
  "description": "The `hub` row (one row, `id` = `hub_id`).\n\nClause: HC section 6 (`hub`), SF-5b, PR-0, A2 CF-1.",
  "x-kind": "hub",
  "x-schema-version": "1.0",
  "x-verbs": {
    "get": {
      "effect": "read",
      "reasons": [],
      "clause": "VB-2"
    },
    "watch": {
      "effect": "read",
      "reasons": [],
      "clause": "WT-1"
    }
  },
  "x-actions": {
    "check_update": {
      "effect": "read",
      "durable_operation": false,
      "reasons": [],
      "args": "Empty",
      "result": "CheckUpdateResult",
      "clause": "A.7, A.9, H-3"
    },
    "update": {
      "effect": "accepted",
      "durable_operation": true,
      "reasons": [
        "wrong_state:up_to_date",
        "wrong_state:offline",
        "wrong_state:dev_build",
        "wrong_state:update_in_progress",
        "wrong_state:swap_in_progress"
      ],
      "args": "Empty",
      "result": "Receipt",
      "clause": "A.7, A.9, A.9b"
    },
    "shutdown": {
      "effect": "accepted",
      "durable_operation": false,
      "reasons": [
        "wrong_state:swap_in_progress",
        "wrong_state:update_in_progress",
        "wrong_state:package_operation_in_progress"
      ],
      "args": "Empty",
      "result": "Receipt",
      "clause": "A.7, A.9, A.9b"
    },
    "restart": {
      "effect": "accepted",
      "durable_operation": false,
      "reasons": [
        "wrong_state:swap_in_progress",
        "wrong_state:update_in_progress",
        "wrong_state:package_operation_in_progress"
      ],
      "args": "Empty",
      "result": "Receipt",
      "clause": "A.7, A.9, A.9b"
    },
    "issue_pairing": {
      "effect": "immediate",
      "durable_operation": false,
      "permission": "hub.pair",
      "reasons": [
        "wrong_state:no_web_origin",
        "invalid_arguments:ttl_out_of_range"
      ],
      "args": "IssuePairingArgs",
      "result": "IssuePairingResult",
      "clause": "PR-0, A.7, A.9b"
    },
    "diagnostics": {
      "effect": "read",
      "durable_operation": false,
      "permission": "hub.diagnostics",
      "reasons": [],
      "args": "Empty",
      "result": "DiagnosticsResult",
      "clause": "A.7, A.9"
    },
    "swap_preflight": {
      "effect": "read",
      "durable_operation": false,
      "reasons": [
        "invalid_arguments:unknown_worker_protocol"
      ],
      "args": "SwapPreflightArgs",
      "result": "SwapPreflightResult",
      "clause": "A.7, A.9, A.9b"
    },
    "swap": {
      "effect": "accepted",
      "durable_operation": false,
      "reasons": [
        "wrong_state:unadoptable_sessions",
        "wrong_state:swap_in_progress",
        "wrong_state:update_in_progress",
        "wrong_state:package_operation_in_progress",
        "invalid_arguments:unknown_worker_protocol"
      ],
      "args": "SwapArgs",
      "result": "Receipt",
      "clause": "A.7, A.9, A.9b"
    },
    "preview_package_upgrades": {
      "effect": "read",
      "durable_operation": false,
      "reasons": [],
      "args": "Empty",
      "result": "PreviewPackageUpgradesResult",
      "clause": "A.7, A.9"
    },
    "upgrade_packages": {
      "effect": "accepted",
      "durable_operation": true,
      "reasons": [
        "conflict:requirement_conflict",
        "conflict:ambiguous_provider",
        "conflict:requirement_missing",
        "conflict:breaking_not_accepted",
        "wrong_state:package_operation_in_progress"
      ],
      "args": "UpgradePackagesArgs",
      "result": "Receipt",
      "clause": "A.7, A.9, A.9b"
    },
    "rollback_packages": {
      "effect": "accepted",
      "durable_operation": true,
      "reasons": [
        "wrong_state:no_history",
        "wrong_state:package_operation_in_progress"
      ],
      "args": "Empty",
      "result": "Receipt",
      "clause": "A.7, A.9, A.9b"
    },
    "reload_config": {
      "effect": "committed",
      "durable_operation": false,
      "reasons": [
        "invalid_arguments:config_invalid"
      ],
      "args": "Empty",
      "result": "ReloadConfigResult",
      "clause": "CF-1, A.9b"
    }
  },
  "$defs": {
    "Empty": {
      "type": "object",
      "description": "The empty arguments or result: `{}`.\n\nClause: HC A.9."
    },
    "CheckUpdateResult": {
      "type": "object",
      "properties": {
        "state": {
          "$ref": "#/$defs/CheckUpdateState"
        },
        "available": {
          "$ref": "#/$defs/AvailableUpdate"
        }
      },
      "required": [
        "state"
      ],
      "description": "The result of `check_update`.\n\nClause: HC A.9, A2 H-3."
    },
    "CheckUpdateState": {
      "anyOf": [
        {
          "$ref": "#/$defs/CheckState"
        },
        {
          "type": "object",
          "properties": {
            "failed": {
              "$ref": "#/$defs/ReasonData"
            }
          },
          "required": [
            "failed"
          ]
        }
      ],
      "description": "`check_update` result. A failed check is `state: { failed: { reason } }` (`check_failed`, `offline`, `dev_build`).\n\nClause: HC A.9, A2 H-3."
    },
    "CheckState": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "up_to_date",
            "ahead",
            "available"
          ]
        },
        {
          "type": "string"
        }
      ]
    },
    "ReasonData": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "reason"
      ],
      "description": "`{ reason }`, the data of a failed state.\n\nClause: HC A.1b."
    },
    "AvailableUpdate": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string"
        }
      },
      "required": [
        "version"
      ],
      "description": "`{ version }` of an available update.\n\nClause: HC A2 H-3."
    },
    "Receipt": {
      "type": "object",
      "properties": {
        "operation": {
          "$ref": "#/$defs/OperationRow"
        }
      },
      "required": [
        "operation"
      ],
      "description": "The result of an `accepted` action: the full `operation` row at admission.\n\nClause: HC A.7b, EN-7."
    },
    "OperationRow": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "description": "Non-exhaustive: an unknown kind is shown as \"other\" and the client waits for `terminal`."
        },
        "state": {
          "$ref": "#/$defs/OperationState"
        },
        "terminal": {
          "type": "boolean",
          "description": "Whether the state is final."
        },
        "progress": {
          "$ref": "#/$defs/Progress"
        },
        "result": {
          "description": "The per-kind result of A.7b."
        },
        "error": {
          "$ref": "#/$defs/Error"
        }
      },
      "required": [
        "id",
        "kind",
        "state",
        "terminal"
      ],
      "description": "The wire form of `OperationRow`. The reader checks the `result` of a known kind after it reads the members (A.7b).",
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "spawn"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "result": {
                "$ref": "#/$defs/SessionRef"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "hub.update"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "result": {
                "$ref": "#/$defs/UpdateResult"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "hub.upgrade_packages"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "result": {
                "$ref": "#/$defs/BulkPackagesResult"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "hub.rollback_packages"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "result": {
                "$ref": "#/$defs/BulkPackagesResult"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "package.install"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "result": {
                "$ref": "#/$defs/PackageInstallResult"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "package.upgrade"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "result": {
                "$ref": "#/$defs/PackageUpgradeResult"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "package.rollback"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "result": {
                "$ref": "#/$defs/PackageRollbackResult"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "spawn_target.rescan_packages"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "result": {
                "$ref": "#/$defs/RescanResult"
              }
            }
          }
        }
      ]
    },
    "OperationState": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 1,
          "propertyNames": {
            "enum": [
              "failed",
              "abandoned",
              "cancelled",
              "unknown"
            ]
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "reason"
            ]
          }
        },
        {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 1,
          "propertyNames": {
            "not": {
              "enum": [
                "failed",
                "abandoned",
                "cancelled",
                "unknown"
              ]
            }
          },
          "additionalProperties": {
            "type": "object"
          }
        }
      ]
    },
    "Progress": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string"
        },
        "fraction": {
          "type": "number",
          "format": "double",
          "minimum": 0.0,
          "maximum": 1.0
        }
      },
      "required": [
        "message"
      ],
      "description": "`progress` of a generic operation: `{ message, fraction? }`, `fraction` in 0..1.\n\nClause: HC A.7b."
    },
    "Error": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "category": {
          "$ref": "#/$defs/Category"
        },
        "retryable": {
          "type": "boolean"
        },
        "effect": {
          "description": "Present on every error that answers a mutating request.",
          "$ref": "#/$defs/ErrorEffect"
        },
        "message": {
          "type": "string"
        },
        "reason": {
          "type": "string",
          "description": "A kind-specific sub-code, listed in the kind's `describe`."
        },
        "detail": {
          "type": "object",
          "additionalProperties": true,
          "description": "The data that the contract names next to a code (`sessions`, `candidates`, `interface`, `range`, `key`)."
        },
        "field_errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FieldError"
          }
        },
        "retry_after_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "code",
        "category",
        "retryable",
        "message"
      ],
      "description": "The error object of a `res`, a tool result and an operation.\n\nClause: HC section 11, A.1b (`detail`), EN-3b."
    },
    "ErrorCode": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "invalid_arguments",
            "not_found",
            "unsupported",
            "conflict",
            "wrong_state",
            "permission_denied",
            "too_many_requests",
            "busy",
            "response_too_large",
            "plugin_failed",
            "remote_hub_unsupported",
            "hub_shutdown",
            "expired_cursor",
            "stale_descriptor",
            "cancelled",
            "internal"
          ]
        },
        {
          "type": "string"
        }
      ]
    },
    "Category": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "caller",
            "state",
            "auth",
            "capacity",
            "fault"
          ]
        },
        {
          "type": "string"
        }
      ]
    },
    "ErrorEffect": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "none",
            "unknown",
            "partial"
          ]
        },
        {
          "type": "string"
        }
      ]
    },
    "FieldError": {
      "type": "object",
      "properties": {
        "pointer": {
          "type": "string"
        },
        "field_id": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "pointer",
        "code",
        "message"
      ],
      "description": "One entry of `field_errors`: a JSON Pointer, an optional stable field id, a code and a message.\n\nClause: HC section 11, SF-2."
    },
    "SessionRef": {
      "type": "object",
      "properties": {
        "hub_id": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        }
      },
      "required": [
        "hub_id",
        "session_id"
      ],
      "description": "A session identity: `{hub_id, session_id}`.\n\nClause: HC P5."
    },
    "UpdateResult": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string"
        }
      },
      "required": [
        "version"
      ],
      "description": "`result` of a `hub.update` operation.\n\nClause: HC A.7b."
    },
    "BulkPackagesResult": {
      "type": "object",
      "properties": {
        "packages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PackageOutcome"
          }
        }
      },
      "required": [
        "packages"
      ],
      "description": "`result` of `hub.upgrade_packages` and `hub.rollback_packages`.\n\nClause: HC A.7b."
    },
    "PackageOutcome": {
      "type": "object",
      "properties": {
        "package": {
          "type": "string"
        },
        "state": {
          "type": "string",
          "description": "`succeeded` or `failed`."
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "package",
        "state"
      ],
      "description": "One package outcome of a bulk package operation.\n\nClause: HC A.7b."
    },
    "PackageInstallResult": {
      "type": "object",
      "properties": {
        "package": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "package",
        "version"
      ],
      "description": "`result` of `package.install`: the package key and the admitted manifest version, on every end that admitted a package.\n\nClause: HC A.7b, HC A6-1."
    },
    "PackageUpgradeResult": {
      "type": "object",
      "properties": {
        "package": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "resolved_commit": {
          "type": "string"
        }
      },
      "required": [
        "package",
        "version",
        "resolved_commit"
      ],
      "description": "`result` of `package.upgrade`.\n\nClause: HC A.7b."
    },
    "PackageRollbackResult": {
      "type": "object",
      "properties": {
        "package": {
          "type": "string"
        },
        "ref": {
          "type": "string"
        },
        "resolved_commit": {
          "type": "string"
        }
      },
      "required": [
        "package",
        "ref",
        "resolved_commit"
      ],
      "description": "`result` of `package.rollback`.\n\nClause: HC A.7b."
    },
    "RescanResult": {
      "type": "object",
      "properties": {
        "found": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "found",
        "removed"
      ],
      "description": "`result` of `spawn_target.rescan_packages`: the instances found and removed.\n\nClause: HC A.7b, A2 part 1."
    },
    "IssuePairingArgs": {
      "type": "object",
      "properties": {
        "ttl_seconds": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "description": "Arguments of `issue_pairing`.\n\nClause: HC PR-0, A.9."
    },
    "IssuePairingResult": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string"
        },
        "qr_text": {
          "type": "string"
        },
        "expires_at": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "url",
        "qr_text",
        "expires_at"
      ],
      "description": "The result of `issue_pairing`. `expires_at` is Unix seconds (PR-7b).\n\nClause: HC PR-0, A.9."
    },
    "DiagnosticsResult": {
      "type": "object",
      "properties": {
        "report": true
      },
      "required": [
        "report"
      ],
      "description": "The result of `diagnostics`: one opaque value, never parsed by a client (P3).\n\nClause: HC A.9, P3."
    },
    "SwapPreflightArgs": {
      "type": "object",
      "properties": {
        "target_worker_protocol": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0,
          "maximum": 65535
        }
      },
      "required": [
        "target_worker_protocol"
      ],
      "description": "Arguments of `swap_preflight`.\n\nClause: HC A.9."
    },
    "SwapPreflightResult": {
      "type": "object",
      "properties": {
        "unadoptable": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Unadoptable"
          }
        },
        "unknown": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/UnknownProtocol"
          }
        }
      },
      "required": [
        "unadoptable",
        "unknown"
      ],
      "description": "The result of `swap_preflight`.\n\nClause: HC A.9."
    },
    "Unadoptable": {
      "type": "object",
      "properties": {
        "session": {
          "$ref": "#/$defs/SessionRef"
        },
        "worker_protocol": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0,
          "maximum": 65535
        }
      },
      "required": [
        "session",
        "worker_protocol"
      ],
      "description": "A session whose worker a Hub of the target protocol could not adopt.\n\nClause: HC A.9 (`swap_preflight`), Core AD-4."
    },
    "UnknownProtocol": {
      "type": "object",
      "properties": {
        "session": {
          "$ref": "#/$defs/SessionRef"
        }
      },
      "required": [
        "session"
      ],
      "description": "A session whose worker protocol is unknown.\n\nClause: HC A.9 (`swap_preflight`)."
    },
    "SwapArgs": {
      "type": "object",
      "properties": {
        "target_worker_protocol": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0,
          "maximum": 65535
        },
        "drop_unadoptable": {
          "type": "boolean"
        }
      },
      "required": [
        "target_worker_protocol"
      ],
      "description": "Arguments of `swap` and `swap_preflight`. `target_worker_protocol` is a u16 (H-26).\n\nClause: HC A.9, A2 H-26."
    },
    "PreviewPackageUpgradesResult": {
      "type": "object",
      "properties": {
        "previews": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PackagePreview"
          }
        },
        "ambiguous": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Ambiguity"
          }
        },
        "breaking": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BreakingEntry"
          }
        }
      },
      "required": [
        "previews",
        "ambiguous",
        "breaking"
      ],
      "description": "The result of `hub.preview_package_upgrades`. `breaking` is the list for the whole set.\n\nClause: HC A.9, HC A7-1."
    },
    "PackagePreview": {
      "type": "object",
      "properties": {
        "package": {
          "type": "string"
        },
        "old_commit": {
          "type": "string"
        },
        "new_commit": {
          "type": "string"
        },
        "old_hash": {
          "type": "string"
        },
        "new_hash": {
          "type": "string"
        },
        "changed_files": true,
        "manifest_diff": true,
        "grant_diff": true,
        "breaking": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BreakingEntry"
          },
          "description": "Always present; empty when nothing breaks (HC A7-1)."
        }
      },
      "required": [
        "package",
        "old_commit",
        "new_commit",
        "old_hash",
        "new_hash",
        "changed_files",
        "manifest_diff",
        "grant_diff",
        "breaking"
      ],
      "description": "One preview of `hub.preview_package_upgrades`: the package, and the `preview_upgrade` result.\n\nClause: HC A.9."
    },
    "BreakingEntry": {
      "type": "object",
      "properties": {
        "consumer": {
          "type": "string"
        },
        "interface": {
          "type": "string"
        },
        "range": {
          "type": "string"
        },
        "interface_version": {
          "type": "string"
        }
      },
      "required": [
        "consumer",
        "interface",
        "range",
        "interface_version"
      ],
      "description": "One breaking pair of an upgrade preview: a consumer requirement whose declared `range` does not contain the new `interface_version`.\n\nClause: HC A7-1, HP A8-3."
    },
    "Ambiguity": {
      "type": "object",
      "properties": {
        "consumer": {
          "type": "string"
        },
        "interface": {
          "type": "string"
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "consumer",
        "interface",
        "candidates"
      ],
      "description": "An ambiguous requirement and its candidate providers.\n\nClause: HC A.9 (`preview_package_upgrades`)."
    },
    "UpgradePackagesArgs": {
      "type": "object",
      "properties": {
        "bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ConsumerBinding"
          }
        },
        "accept_breaking": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ConsumerInterface"
          }
        }
      },
      "description": "Arguments of `hub.upgrade_packages`.\n\nClause: HC A.9."
    },
    "ConsumerBinding": {
      "type": "object",
      "properties": {
        "consumer": {
          "type": "string"
        },
        "interface": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        }
      },
      "required": [
        "consumer",
        "interface",
        "provider"
      ],
      "description": "A `{ consumer, interface, provider }` binding of a whole-set upgrade.\n\nClause: HC A.9 (`upgrade_packages`)."
    },
    "ConsumerInterface": {
      "type": "object",
      "properties": {
        "consumer": {
          "type": "string"
        },
        "interface": {
          "type": "string"
        }
      },
      "required": [
        "consumer",
        "interface"
      ],
      "description": "A `{ consumer, interface }` pair.\n\nClause: HC A.9 (`upgrade`, `upgrade_packages`)."
    },
    "ReloadConfigResult": {
      "type": "object",
      "properties": {
        "applied": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "restart_required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "applied",
        "restart_required"
      ],
      "description": "The result of `reload_config`.\n\nClause: HC CF-1, A2 part 1."
    },
    "Software": {
      "type": "object",
      "properties": {
        "revision": {
          "type": "string"
        },
        "channel": {
          "$ref": "#/$defs/SoftwareChannel"
        }
      },
      "required": [
        "revision",
        "channel"
      ],
      "description": "`software{revision, channel}`: the commit sha for `dev`, the version for `release`.\n\nClause: HC section 6 (`hub`)."
    },
    "SoftwareChannel": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "dev",
            "release"
          ]
        },
        {
          "type": "string"
        }
      ]
    },
    "Components": {
      "type": "object",
      "properties": {
        "hub": {
          "$ref": "#/$defs/Component"
        },
        "worker": {
          "$ref": "#/$defs/Component"
        },
        "plugin_hosts": {
          "$ref": "#/$defs/Component"
        },
        "mcp_bridge": {
          "$ref": "#/$defs/Component"
        }
      },
      "required": [
        "hub",
        "worker",
        "plugin_hosts",
        "mcp_bridge"
      ],
      "description": "`components: { hub, worker, plugin_hosts, mcp_bridge }`.\n\nClause: HC section 6 (`hub`)."
    },
    "Component": {
      "type": "object",
      "properties": {
        "channel": {
          "$ref": "#/$defs/SoftwareChannel"
        },
        "commit": {
          "type": "string"
        },
        "checkout": {
          "type": "string",
          "description": "An absolute path, only for a `dev` build, shown to operators only."
        },
        "running": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RunningIdentity"
          }
        }
      },
      "required": [
        "channel",
        "commit"
      ],
      "description": "The installed identity of one component.\n\nClause: HC section 6 (`hub` `components`)."
    },
    "RunningIdentity": {
      "type": "object",
      "properties": {
        "channel": {
          "$ref": "#/$defs/SoftwareChannel"
        },
        "commit": {
          "type": "string"
        },
        "count": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "count"
      ],
      "description": "A live process identity that is not known to equal the installed one. `channel` and `commit` are absent when unknown.\n\nClause: HC section 6 (`hub` `components`)."
    },
    "UpdateStatus": {
      "type": "object",
      "properties": {
        "state": {
          "$ref": "#/$defs/UpdateState"
        },
        "available": {
          "$ref": "#/$defs/AvailableUpdate"
        }
      },
      "required": [
        "state"
      ],
      "description": "`update` of the `hub` row.\n\nClause: HC A2 H-3."
    },
    "UpdateState": {
      "anyOf": [
        {
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "idle",
                "checking",
                "available",
                "downloading",
                "installing",
                "other"
              ]
            },
            {
              "type": "object",
              "properties": {
                "failed": {
                  "$ref": "#/$defs/ReasonData"
                }
              },
              "required": [
                "failed"
              ],
              "additionalProperties": false
            }
          ],
          "description": "`update.state` of the `hub` row.\n\nClause: HC A2 H-3."
        },
        {
          "type": "string",
          "not": {
            "enum": [
              "idle",
              "checking",
              "available",
              "downloading",
              "installing",
              "failed"
            ]
          }
        },
        {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 1,
          "propertyNames": {
            "not": {
              "enum": [
                "idle",
                "checking",
                "available",
                "downloading",
                "installing",
                "failed"
              ]
            }
          },
          "additionalProperties": {
            "type": "object"
          }
        }
      ]
    },
    "HubRunState": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "starting",
            "recovering",
            "ready"
          ]
        },
        {
          "type": "string"
        }
      ]
    }
  }
}

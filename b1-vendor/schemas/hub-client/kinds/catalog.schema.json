{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "refreshed_at": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CatalogEntry"
      }
    }
  },
  "required": [
    "id",
    "url",
    "entries"
  ],
  "description": "The `catalog` row. Its content is untrusted data and never runs.\n\nClause: HC section 6 (`catalog`), A2 (CLI OI-9: exactly these fields).",
  "x-kind": "catalog",
  "x-schema-version": "1.0",
  "x-verbs": {
    "list": {
      "effect": "read",
      "reasons": [],
      "clause": "VB-1"
    },
    "get": {
      "effect": "read",
      "reasons": [],
      "clause": "VB-2"
    },
    "watch": {
      "effect": "read",
      "reasons": [],
      "clause": "WT-1"
    },
    "create": {
      "effect": "committed",
      "permission": "catalog.manage",
      "args": "CatalogCreateArgs",
      "reasons": [
        "invalid_arguments:url_not_https",
        "conflict"
      ],
      "clause": "A.7, A.9, A.9b"
    },
    "delete": {
      "effect": "committed",
      "permission": "catalog.manage",
      "reasons": [],
      "clause": "A.7"
    }
  },
  "x-actions": {
    "refresh": {
      "effect": "accepted",
      "durable_operation": false,
      "permission": "catalog.manage",
      "reasons": [],
      "args": "Empty",
      "result": "Receipt",
      "clause": "A.7, A.9"
    }
  },
  "$defs": {
    "CatalogCreateArgs": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "description": "Arguments of `create(catalog)`.\n\nClause: HC A.9."
    },
    "Empty": {
      "type": "object",
      "description": "The empty arguments or result: `{}`.\n\nClause: HC A.9."
    },
    "Receipt": {
      "type": "object",
      "properties": {
        "operation": {
          "$ref": "#/$defs/OperationRow"
        }
      },
      "required": [
        "operation"
      ],
      "description": "The result of an `accepted` action: the full `operation` row at admission.\n\nClause: HC A.7b, EN-7."
    },
    "OperationRow": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "description": "Non-exhaustive: an unknown kind is shown as \"other\" and the client waits for `terminal`."
        },
        "state": {
          "$ref": "#/$defs/OperationState"
        },
        "terminal": {
          "type": "boolean",
          "description": "Whether the state is final."
        },
        "progress": {
          "$ref": "#/$defs/Progress"
        },
        "result": {
          "description": "The per-kind result of A.7b."
        },
        "error": {
          "$ref": "#/$defs/Error"
        }
      },
      "required": [
        "id",
        "kind",
        "state",
        "terminal"
      ],
      "description": "The wire form of `OperationRow`. The reader checks the `result` of a known kind after it reads the members (A.7b).",
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "spawn"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "result": {
                "$ref": "#/$defs/SessionRef"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "hub.update"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "result": {
                "$ref": "#/$defs/UpdateResult"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "hub.upgrade_packages"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "result": {
                "$ref": "#/$defs/BulkPackagesResult"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "hub.rollback_packages"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "result": {
                "$ref": "#/$defs/BulkPackagesResult"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "package.install"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "result": {
                "$ref": "#/$defs/PackageInstallResult"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "package.upgrade"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "result": {
                "$ref": "#/$defs/PackageUpgradeResult"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "package.rollback"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "result": {
                "$ref": "#/$defs/PackageRollbackResult"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "spawn_target.rescan_packages"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "result": {
                "$ref": "#/$defs/RescanResult"
              }
            }
          }
        }
      ]
    },
    "OperationState": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 1,
          "propertyNames": {
            "enum": [
              "failed",
              "abandoned",
              "cancelled",
              "unknown"
            ]
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "reason"
            ]
          }
        },
        {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 1,
          "propertyNames": {
            "not": {
              "enum": [
                "failed",
                "abandoned",
                "cancelled",
                "unknown"
              ]
            }
          },
          "additionalProperties": {
            "type": "object"
          }
        }
      ]
    },
    "Progress": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string"
        },
        "fraction": {
          "type": "number",
          "format": "double",
          "minimum": 0.0,
          "maximum": 1.0
        }
      },
      "required": [
        "message"
      ],
      "description": "`progress` of a generic operation: `{ message, fraction? }`, `fraction` in 0..1.\n\nClause: HC A.7b."
    },
    "Error": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "category": {
          "$ref": "#/$defs/Category"
        },
        "retryable": {
          "type": "boolean"
        },
        "effect": {
          "description": "Present on every error that answers a mutating request.",
          "$ref": "#/$defs/ErrorEffect"
        },
        "message": {
          "type": "string"
        },
        "reason": {
          "type": "string",
          "description": "A kind-specific sub-code, listed in the kind's `describe`."
        },
        "detail": {
          "type": "object",
          "additionalProperties": true,
          "description": "The data that the contract names next to a code (`sessions`, `candidates`, `interface`, `range`, `key`)."
        },
        "field_errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FieldError"
          }
        },
        "retry_after_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "code",
        "category",
        "retryable",
        "message"
      ],
      "description": "The error object of a `res`, a tool result and an operation.\n\nClause: HC section 11, A.1b (`detail`), EN-3b."
    },
    "ErrorCode": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "invalid_arguments",
            "not_found",
            "unsupported",
            "conflict",
            "wrong_state",
            "permission_denied",
            "too_many_requests",
            "busy",
            "response_too_large",
            "plugin_failed",
            "remote_hub_unsupported",
            "hub_shutdown",
            "expired_cursor",
            "stale_descriptor",
            "cancelled",
            "internal"
          ]
        },
        {
          "type": "string"
        }
      ]
    },
    "Category": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "caller",
            "state",
            "auth",
            "capacity",
            "fault"
          ]
        },
        {
          "type": "string"
        }
      ]
    },
    "ErrorEffect": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "none",
            "unknown",
            "partial"
          ]
        },
        {
          "type": "string"
        }
      ]
    },
    "FieldError": {
      "type": "object",
      "properties": {
        "pointer": {
          "type": "string"
        },
        "field_id": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "pointer",
        "code",
        "message"
      ],
      "description": "One entry of `field_errors`: a JSON Pointer, an optional stable field id, a code and a message.\n\nClause: HC section 11, SF-2."
    },
    "SessionRef": {
      "type": "object",
      "properties": {
        "hub_id": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        }
      },
      "required": [
        "hub_id",
        "session_id"
      ],
      "description": "A session identity: `{hub_id, session_id}`.\n\nClause: HC P5."
    },
    "UpdateResult": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string"
        }
      },
      "required": [
        "version"
      ],
      "description": "`result` of a `hub.update` operation.\n\nClause: HC A.7b."
    },
    "BulkPackagesResult": {
      "type": "object",
      "properties": {
        "packages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PackageOutcome"
          }
        }
      },
      "required": [
        "packages"
      ],
      "description": "`result` of `hub.upgrade_packages` and `hub.rollback_packages`.\n\nClause: HC A.7b."
    },
    "PackageOutcome": {
      "type": "object",
      "properties": {
        "package": {
          "type": "string"
        },
        "state": {
          "type": "string",
          "description": "`succeeded` or `failed`."
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "package",
        "state"
      ],
      "description": "One package outcome of a bulk package operation.\n\nClause: HC A.7b."
    },
    "PackageInstallResult": {
      "type": "object",
      "properties": {
        "package": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "package",
        "version"
      ],
      "description": "`result` of `package.install`: the package key and the admitted manifest version, on every end that admitted a package.\n\nClause: HC A.7b, HC A6-1."
    },
    "PackageUpgradeResult": {
      "type": "object",
      "properties": {
        "package": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "resolved_commit": {
          "type": "string"
        }
      },
      "required": [
        "package",
        "version",
        "resolved_commit"
      ],
      "description": "`result` of `package.upgrade`.\n\nClause: HC A.7b."
    },
    "PackageRollbackResult": {
      "type": "object",
      "properties": {
        "package": {
          "type": "string"
        },
        "ref": {
          "type": "string"
        },
        "resolved_commit": {
          "type": "string"
        }
      },
      "required": [
        "package",
        "ref",
        "resolved_commit"
      ],
      "description": "`result` of `package.rollback`.\n\nClause: HC A.7b."
    },
    "RescanResult": {
      "type": "object",
      "properties": {
        "found": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "found",
        "removed"
      ],
      "description": "`result` of `spawn_target.rescan_packages`: the instances found and removed.\n\nClause: HC A.7b, A2 part 1."
    },
    "CatalogEntry": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/PackageKind"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/GitSource"
        },
        "status": {
          "$ref": "#/$defs/EntryStatus"
        }
      },
      "required": [
        "id",
        "kind",
        "name",
        "description",
        "source",
        "status"
      ],
      "description": "One catalog entry. Two entries may name the same `url` and `ref` with different `path`s (HP PK-7).\n\nClause: HC section 6 (`catalog`), A1."
    },
    "PackageKind": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "plugin",
            "agent_definition",
            "accessory"
          ]
        },
        {
          "type": "string"
        }
      ]
    },
    "GitSource": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string"
        },
        "ref": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "description": "A git source: the URL, an optional ref and an optional package root inside the repository.\n\nClause: HC A1 (`package` `source`), PKC-1."
    },
    "EntryStatus": {
      "anyOf": [
        {
          "$ref": "#/$defs/AvailableTag"
        },
        {
          "$ref": "#/$defs/PackageStatus"
        }
      ],
      "description": "The status of a catalog entry: `available`, or the status of the installed package.\n\nClause: HC section 6 (`catalog`)."
    },
    "AvailableTag": {
      "type": "string",
      "enum": [
        "available"
      ],
      "description": "The word `available`.\n\nClause: HC section 6 (`catalog`)."
    },
    "PackageStatus": {
      "anyOf": [
        {
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "installed",
                "outdated",
                "errored",
                "live",
                "pinned",
                "staged",
                "other"
              ]
            },
            {
              "type": "object",
              "properties": {
                "degraded": {
                  "$ref": "#/$defs/DegradedData"
                }
              },
              "required": [
                "degraded"
              ],
              "additionalProperties": false
            }
          ],
          "description": "`package.status`, the install lifecycle (HP PM-10).\n\nClause: HC section 6 (`package`)."
        },
        {
          "type": "string",
          "not": {
            "enum": [
              "installed",
              "outdated",
              "errored",
              "live",
              "pinned",
              "staged",
              "degraded"
            ]
          }
        },
        {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 1,
          "propertyNames": {
            "not": {
              "enum": [
                "installed",
                "outdated",
                "errored",
                "live",
                "pinned",
                "staged",
                "degraded"
              ]
            }
          },
          "additionalProperties": {
            "type": "object"
          }
        }
      ]
    },
    "DegradedData": {
      "type": "object",
      "properties": {
        "interface": {
          "type": "string"
        }
      },
      "required": [
        "interface"
      ],
      "description": "`degraded { interface }` data.\n\nClause: HC section 6 (`package` `status`), HP PD-6."
    }
  }
}

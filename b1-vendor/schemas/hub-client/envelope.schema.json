{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Frame",
  "description": "Any frame of the control stream, in either direction.\n\nClause: HC EN-1, EN-2.",
  "anyOf": [
    {
      "$ref": "#/$defs/ClientFrame"
    },
    {
      "$ref": "#/$defs/ServerFrame"
    }
  ],
  "$defs": {
    "ClientFrame": {
      "description": "The frames of a client. An unknown `type` is a protocol error and closes the connection (EN-6).\n\nClause: HC EN-1, EN-6.",
      "oneOf": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/Hello"
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "hello"
                }
              },
              "required": [
                "type"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/Req"
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "req"
                }
              },
              "required": [
                "type"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/Cancel"
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "cancel"
                }
              },
              "required": [
                "type"
              ]
            }
          ]
        }
      ]
    },
    "VersionRange": {
      "description": "The protocol versions that a client supports.\n\nClause: HC HS-1, HS-2.",
      "type": "object",
      "properties": {
        "min": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0,
          "maximum": 65535
        },
        "max": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0,
          "maximum": 65535
        }
      },
      "required": [
        "min",
        "max"
      ]
    },
    "ClientInfo": {
      "description": "The client's name and version.\n\nClause: HC HS-1.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ]
    },
    "Hello": {
      "description": "The first envelope frame of a client.\n\nClause: HC HS-1.",
      "type": "object",
      "properties": {
        "protocol": {
          "description": "`botster-hub`.",
          "type": "string"
        },
        "versions": {
          "$ref": "#/$defs/VersionRange"
        },
        "client": {
          "$ref": "#/$defs/ClientInfo"
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "terminal_formats": {
          "description": "The route formats that the client can decode, in preference order.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "protocol",
        "versions",
        "client",
        "features",
        "terminal_formats"
      ]
    },
    "RequestId": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|1844674407370955[0-0][0-9]{3}|18446744073709551[0-5][0-9]{2}|184467440737095516[0-0][0-9]{1}|1844674407370955161[0-4][0-9]{0}|18446744073709551615)$"
    },
    "Verb": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "describe",
            "list",
            "get",
            "watch",
            "unwatch",
            "create",
            "update",
            "delete",
            "invoke"
          ]
        },
        {
          "type": "string"
        }
      ]
    },
    "Req": {
      "description": "A request frame. `action` is required when `verb` is `invoke` and absent for every other verb (A4 EN-1a); that rule is checked by `Req::check`.\n\nClause: HC EN-1, A4 EN-1a, EN-8a.",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/RequestId"
        },
        "verb": {
          "$ref": "#/$defs/Verb"
        },
        "kind": {
          "type": "string"
        },
        "target": {
          "description": "A resource id where the verb needs one (for `unwatch`, the watch id).",
          "type": "string"
        },
        "action": {
          "description": "The action name, the key of `describe` `actions` (DS-1). Only with `verb: invoke`.",
          "type": "string"
        },
        "args": true,
        "idempotency_key": {
          "type": "string"
        },
        "operation_id": {
          "type": "string"
        },
        "descriptor_id": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "verb",
        "kind"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "verb": {
                "const": "invoke"
              }
            },
            "required": [
              "verb"
            ]
          },
          "then": {
            "required": [
              "action"
            ]
          },
          "else": {
            "not": {
              "required": [
                "action"
              ]
            }
          }
        }
      ]
    },
    "Cancel": {
      "description": "`cancel { id }`: best effort, and the request still gets one `res`.\n\nClause: HC EN-1, EN-3b.",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/RequestId"
        }
      },
      "required": [
        "id"
      ]
    },
    "ServerFrame": {
      "description": "The frames of the Hub. An unknown `type` is a protocol error (EN-6).\n\nClause: HC EN-2, EN-6.",
      "oneOf": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/Welcome"
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "welcome"
                }
              },
              "required": [
                "type"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/Res"
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "res"
                }
              },
              "required": [
                "type"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/WatchFrame"
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "watch"
                }
              },
              "required": [
                "type"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/EventFrame"
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "event"
                }
              },
              "required": [
                "type"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/Close"
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "close"
                }
              },
              "required": [
                "type"
              ]
            }
          ]
        }
      ]
    },
    "Limits": {
      "description": "The numbers of `welcome`. A client uses only these values. `max_chunk_bytes` bounds the chunk payload, without the `flags` byte,\non every DataChannel, the route channels included (TR-3, A8-3).\n\nClause: HC HS-3, BD-3, TR-3, A8-3.",
      "type": "object",
      "properties": {
        "max_frame_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "max_chunk_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "max_outstanding": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "max_watches": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "route_connect_seconds": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "idempotency_window_seconds": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cursor_idle_seconds": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "operation_retention_seconds": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "max_paste_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "max_file_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "query_client_deadline_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "max_frame_bytes",
        "max_chunk_bytes",
        "max_outstanding",
        "max_watches",
        "route_connect_seconds",
        "idempotency_window_seconds",
        "cursor_idle_seconds",
        "operation_retention_seconds",
        "max_paste_bytes",
        "max_file_bytes",
        "query_client_deadline_ms"
      ]
    },
    "Welcome": {
      "description": "The Hub's answer to `hello`.\n\nClause: HC HS-3, HS-5.",
      "type": "object",
      "properties": {
        "hub_id": {
          "type": "string"
        },
        "incarnation": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0,
          "maximum": 65535
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "terminal_format": {
          "description": "Advisory: the route format is chosen per route at attach (TS-1). Absent when no listed format is supported now.",
          "type": "string"
        },
        "limits": {
          "$ref": "#/$defs/Limits"
        }
      },
      "required": [
        "hub_id",
        "incarnation",
        "version",
        "features",
        "limits"
      ]
    },
    "Error": {
      "description": "The error object of a `res`, a tool result and an operation.\n\nClause: HC section 11, A.1b (`detail`), EN-3b.",
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "category": {
          "$ref": "#/$defs/Category"
        },
        "retryable": {
          "type": "boolean"
        },
        "effect": {
          "description": "Present on every error that answers a mutating request.",
          "$ref": "#/$defs/ErrorEffect"
        },
        "message": {
          "type": "string"
        },
        "reason": {
          "description": "A kind-specific sub-code, listed in the kind's `describe`.",
          "type": "string"
        },
        "detail": {
          "description": "The data that the contract names next to a code (`sessions`, `candidates`, `interface`, `range`, `key`).",
          "type": "object",
          "additionalProperties": true
        },
        "field_errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FieldError"
          }
        },
        "retry_after_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "code",
        "category",
        "retryable",
        "message"
      ]
    },
    "ErrorCode": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "invalid_arguments",
            "not_found",
            "unsupported",
            "conflict",
            "wrong_state",
            "permission_denied",
            "too_many_requests",
            "busy",
            "response_too_large",
            "plugin_failed",
            "remote_hub_unsupported",
            "hub_shutdown",
            "expired_cursor",
            "stale_descriptor",
            "cancelled",
            "internal"
          ]
        },
        {
          "type": "string"
        }
      ]
    },
    "Category": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "caller",
            "state",
            "auth",
            "capacity",
            "fault"
          ]
        },
        {
          "type": "string"
        }
      ]
    },
    "ErrorEffect": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "none",
            "unknown",
            "partial"
          ]
        },
        {
          "type": "string"
        }
      ]
    },
    "FieldError": {
      "description": "One entry of `field_errors`: a JSON Pointer, an optional stable field id, a code and a message.\n\nClause: HC section 11, SF-2.",
      "type": "object",
      "properties": {
        "pointer": {
          "type": "string"
        },
        "field_id": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "pointer",
        "code",
        "message"
      ]
    },
    "Res": {
      "description": "`res { id, ok } | res { id, err }`. A frame with both or neither is refused.\n\nClause: HC EN-2, EN-3.",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/RequestId"
        },
        "ok": true,
        "err": {
          "$ref": "#/$defs/Error"
        }
      },
      "required": [
        "id"
      ],
      "oneOf": [
        {
          "properties": {
            "ok": {
              "not": {
                "type": "null"
              }
            }
          },
          "required": [
            "ok"
          ],
          "not": {
            "required": [
              "err"
            ]
          }
        },
        {
          "required": [
            "err"
          ],
          "not": {
            "required": [
              "ok"
            ]
          }
        }
      ]
    },
    "SnapshotReason": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "overflow",
            "source_reset",
            "owner_reloaded"
          ]
        },
        {
          "type": "string"
        }
      ]
    },
    "Change": {
      "description": "One change of a delta or a batch.\n\nClause: HC WT-2, WT-3.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "value": true,
            "frame": {
              "type": "string",
              "const": "upsert"
            }
          },
          "required": [
            "frame",
            "id",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "patch": true,
            "frame": {
              "type": "string",
              "const": "patch"
            }
          },
          "required": [
            "frame",
            "id",
            "patch"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "frame": {
              "type": "string",
              "const": "remove"
            }
          },
          "required": [
            "frame",
            "id"
          ]
        }
      ]
    },
    "WatchClosedReason": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "owner_unloaded",
            "owner_failed",
            "kind_removed",
            "permission_revoked",
            "item_too_large"
          ]
        },
        {
          "type": "string"
        }
      ]
    },
    "WatchFrame": {
      "description": "The frames of one watch. Frames of one watch are ordered by the transport and carry no sequence number (WT-2).\n\nClause: HC WT-1 to WT-5, EN-2.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "watch_id": {
              "type": "string"
            },
            "reason": {
              "$ref": "#/$defs/SnapshotReason"
            },
            "frame": {
              "type": "string",
              "const": "snapshot_begin"
            }
          },
          "required": [
            "frame",
            "watch_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "watch_id": {
              "type": "string"
            },
            "items": {
              "type": "array",
              "items": true
            },
            "frame": {
              "type": "string",
              "const": "snapshot_items"
            }
          },
          "required": [
            "frame",
            "watch_id",
            "items"
          ]
        },
        {
          "type": "object",
          "properties": {
            "watch_id": {
              "type": "string"
            },
            "frame": {
              "type": "string",
              "const": "snapshot_end"
            }
          },
          "required": [
            "frame",
            "watch_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "watch_id": {
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "value": true,
            "frame": {
              "type": "string",
              "const": "upsert"
            }
          },
          "required": [
            "frame",
            "watch_id",
            "id",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "watch_id": {
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "patch": true,
            "frame": {
              "type": "string",
              "const": "patch"
            }
          },
          "required": [
            "frame",
            "watch_id",
            "id",
            "patch"
          ]
        },
        {
          "type": "object",
          "properties": {
            "watch_id": {
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "frame": {
              "type": "string",
              "const": "remove"
            }
          },
          "required": [
            "frame",
            "watch_id",
            "id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "watch_id": {
              "type": "string"
            },
            "frame": {
              "type": "string",
              "const": "batch_begin"
            }
          },
          "required": [
            "frame",
            "watch_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "watch_id": {
              "type": "string"
            },
            "changes": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Change"
              }
            },
            "frame": {
              "type": "string",
              "const": "batch_items"
            }
          },
          "required": [
            "frame",
            "watch_id",
            "changes"
          ]
        },
        {
          "type": "object",
          "properties": {
            "watch_id": {
              "type": "string"
            },
            "frame": {
              "type": "string",
              "const": "batch_end"
            }
          },
          "required": [
            "frame",
            "watch_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "watch_id": {
              "type": "string"
            },
            "reason": {
              "$ref": "#/$defs/WatchClosedReason"
            },
            "frame": {
              "type": "string",
              "const": "watch_closed"
            }
          },
          "required": [
            "frame",
            "watch_id",
            "reason"
          ]
        }
      ]
    },
    "EventGap": {
      "description": "The loss marker, at the position of the first lost copy. `count` and `lost_bytes` are separate exact counters.\n\nClause: HC EV-4.",
      "type": "object",
      "properties": {
        "frame": {
          "$ref": "#/$defs/GapTag"
        },
        "stream_id": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "subject": true,
        "count": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "lost_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "recovery": {
          "$ref": "#/$defs/Recovery"
        },
        "state_read": {
          "description": "Only with `recovery: state`.",
          "$ref": "#/$defs/StateRead"
        },
        "aggregated": {
          "description": "The per-unit counts of an aggregated gap (HP EV-12 owns the shape)."
        }
      },
      "required": [
        "frame",
        "stream_id",
        "owner",
        "name",
        "count",
        "recovery"
      ]
    },
    "GapTag": {
      "description": "The tag of an `event_gap` frame.\n\nClause: HC EV-4.",
      "type": "string",
      "enum": [
        "gap"
      ]
    },
    "Recovery": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "state",
            "unavailable",
            "partial"
          ]
        },
        {
          "type": "string"
        }
      ]
    },
    "StateRead": {
      "description": "The exact read-only read that recovers state after a gap. A descriptor never creates authority.\n\nClause: HC EV-4.",
      "type": "object",
      "properties": {
        "surface": {
          "type": "string"
        },
        "arguments": {
          "type": "object",
          "additionalProperties": true
        },
        "reference": {
          "type": "object",
          "additionalProperties": true
        },
        "grant": {
          "type": "string"
        }
      },
      "required": [
        "surface",
        "grant"
      ]
    },
    "Event": {
      "description": "An event on a stream.\n\nClause: HC EV-1, EV-2.",
      "type": "object",
      "properties": {

{
  "id": "conf::ts_3_framing",
  "contract": "codec",
  "clause": "TS-3",
  "subject": "worker",
  "requires": {
    "controls": [
      "pty_input"
    ]
  },
  "setup": {
    "worker": {
      "max_frame_bytes": 512,
      "max_screen_frame_bytes": 8192
    }
  },
  "steps": [
    {
      "route_attach": {
        "history": "screen",
        "route_features": [],
        "writable": true,
        "answers_queries": true
      }
    },
    {
      "expect": {
        "frame": "attached",
        "terminal_format": {
          "$type": "string"
        }
      },
      "on": "r1",
      "because": "Codec TS-1"
    },
    {
      "expect": {
        "frame": "baseline_begin",
        "rows": {
          "$type": "integer"
        },
        "cols": {
          "$type": "integer"
        },
        "modes": {
          "$type": "object"
        }
      },
      "on": "r1",
      "because": "Codec TS-4"
    },
    {
      "expect": {
        "frame": "screen",
        "payload": {
          "$any": true
        }
      },
      "on": "r1",
      "because": "Codec TS-4"
    },
    {
      "expect_eventually": {
        "frame": "baseline_end",
        "history": "not_requested"
      },
      "ignore": [
        {
          "frame": "history",
          "payload": {
            "$any": true
          }
        }
      ],
      "on": "r1",
      "because": [
        "Codec TS-1",
        "Codec TS-4"
      ]
    },
    {
      "expect": {
        "frame": "live"
      },
      "on": "r1",
      "because": "Codec TS-4b"
    },
    {
      "route_send_wire": {
        "bytes_hex": "0000"
      }
    },
    {
      "route_send_wire": {
        "bytes_hex": "000e8300000000"
      }
    },
    {
      "route_send_wire": {
        "bytes_hex": "0000000168656c6c6f"
      }
    },
    {
      "route_expect_pty": [
        {
          "hex": "68656c6c6f"
        }
      ],
      "because": [
        "Codec TS-3",
        "Codec BP-2"
      ]
    },
    {
      "route_send_raw": {
        "bytes_hex": ""
      }
    },
    {
      "route_expect_pty": [
        {
          "hex": "68656c6c6f"
        },
        {
          "hex": ""
        }
      ],
      "because": [
        "Codec TS-3",
        "Codec BP-2"
      ]
    },
    {
      "route_send_raw": {
        "bytes_hex": ""
      }
    },
    {
      "expect_eventually": {
        "frame": "route_closed",
        "reason": {
          "protocol_error": {
            "code": "frame_too_large"
          }
        }
      },
      "on": "r1",
      "because": [
        "Codec TS-3",
        "Codec A.1"
      ]
    },
    {
      "expect_closed": null,
      "on": "r1",
      "because": "Codec A.1"
    }
  ]
}

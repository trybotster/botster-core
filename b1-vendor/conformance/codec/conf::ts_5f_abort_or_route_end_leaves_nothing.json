{
  "id": "conf::ts_5f_abort_or_route_end_leaves_nothing",
  "contract": "codec",
  "clause": "TS-5f",
  "subject": "worker",
  "requires": {
    "controls": [
      "client_close",
      "fail_file_write",
      "fs_list",
      "pty_input"
    ]
  },
  "steps": [
    {
      "route_attach": {
        "history": "screen",
        "route_features": [],
        "writable": true,
        "answers_queries": true
      }
    },
    {
      "expect": {
        "frame": "attached",
        "terminal_format": {
          "$type": "string"
        }
      },
      "on": "r1",
      "because": "Codec TS-1"
    },
    {
      "expect": {
        "frame": "baseline_begin",
        "rows": {
          "$type": "integer"
        },
        "cols": {
          "$type": "integer"
        },
        "modes": {
          "$type": "object"
        }
      },
      "on": "r1",
      "because": "Codec TS-4"
    },
    {
      "expect": {
        "frame": "screen",
        "payload": {
          "$any": true
        }
      },
      "on": "r1",
      "because": "Codec TS-4"
    },
    {
      "expect_eventually": {
        "frame": "baseline_end",
        "history": "not_requested"
      },
      "ignore": [
        {
          "frame": "history",
          "payload": {
            "$any": true
          }
        }
      ],
      "on": "r1",
      "because": [
        "Codec TS-1",
        "Codec TS-4"
      ]
    },
    {
      "expect": {
        "frame": "live"
      },
      "on": "r1",
      "because": "Codec TS-4b"
    },
    {
      "route_attach": {
        "history": "screen",
        "route_features": [],
        "writable": true,
        "answers_queries": true
      },
      "route": "r2"
    },
    {
      "expect": {
        "frame": "attached",
        "terminal_format": {
          "$type": "string"
        }
      },
      "on": "r2",
      "because": "Codec TS-1"
    },
    {
      "expect": {
        "frame": "baseline_begin",
        "rows": {
          "$type": "integer"
        },
        "cols": {
          "$type": "integer"
        },
        "modes": {
          "$type": "object"
        }
      },
      "on": "r2",
      "because": "Codec TS-4"
    },
    {
      "expect": {
        "frame": "screen",
        "payload": {
          "$any": true
        }
      },
      "on": "r2",
      "because": "Codec TS-4"
    },
    {
      "expect_eventually": {
        "frame": "baseline_end",
        "history": "not_requested"
      },
      "ignore": [
        {
          "frame": "history",
          "payload": {
            "$any": true
          }
        }
      ],
      "on": "r2",
      "because": [
        "Codec TS-1",
        "Codec TS-4"
      ]
    },
    {
      "expect": {
        "frame": "live"
      },
      "on": "r2",
      "because": "Codec TS-4b"
    },
    {
      "route_send": {
        "frame": "input",
        "kind": "file_begin",
        "op": "1",
        "name": "a.txt"
      }
    },
    {
      "route_send": {
        "frame": "file_chunk",
        "op": "1",
        "bytes": {
          "$bytes_hex": "7061727469616c"
        }
      }
    },
    {
      "route_send": {
        "frame": "input",
        "kind": "file_abort",
        "op": "1"
      }
    },
    {
      "expect_quiet_until": {
        "$one_of": [
          {
            "frame": "input_done"
          },
          {
            "frame": "input_refused",
            "reason": {
              "$one_of": [
                "not_ready",
                "not_writable",
                "too_large",
                "mode_precondition_failed",
                "failed",
                "session_ended",
                "write_failed",
                "already_replied",
                "query_expired",
                "wrong_route",
                {
                  "unsupported": {
                    "what": {
                      "$any": true
                    }
                  }
                }
              ]
            }
          }
        ]
      },
      "barrier": {
        "route_send": {
          "frame": "input",
          "kind": "reply_terminal_query",
          "op": "999",
          "query_id": "none",
          "reply": "decline"
        }
      },
      "until": {
        "frame": "input_refused",
        "op": "999",
        "reason": "unknown_query"
      },
      "on": "r1",
      "because": [
        "Codec TS-5b",
        "Codec A.5"
      ]
    },
    {
      "control": {
        "op": "fs_list"
      },
      "expect": {
        "files": []
      },
      "because": "Codec TS-5f"
    },
    {
      "route_send": {
        "frame": "input",
        "kind": "file_begin",
        "op": "2",
        "name": "b.txt"
      },
      "route": "r2"
    },
    {
      "route_send": {
        "frame": "file_chunk",
        "op": "2",
        "bytes": {
          "$bytes_hex": "7061727469616c"
        }
      },
      "route": "r2"
    },
    {
      "control": {
        "op": "client_close"
      },
      "route": "r2"
    },
    {
      "expect_closed": null,
      "on": "r2",
      "because": "Codec TS-10"
    },
    {
      "control": {
        "op": "fs_list"
      },
      "expect": {
        "files": []
      },
      "because": "Codec TS-5f"
    },
    {
      "route_expect_pty": [],
      "because": "Codec TS-5f"
    },
    {
      "control": {
        "op": "fail_file_write",
        "on": true
      }
    },
    {
      "route_send": {
        "frame": "input",
        "kind": "file_begin",
        "op": "3",
        "name": "c.txt"
      }
    },
    {
      "route_send": {
        "frame": "file_chunk",
        "op": "3",
        "bytes": {
          "$bytes_hex": "64617461"
        }
      }
    },
    {
      "route_send": {
        "frame": "input",
        "kind": "file_commit",
        "op": "3"
      }
    },
    {
      "expect_eventually": {
        "frame": "input_refused",
        "reason": "write_failed",
        "op": "3"
      },
      "ignore": [
        {
          "frame": "modes"
        },
        {
          "frame": "output"
        },
        {
          "frame": "output_deflate"
        }
      ],
      "on": "r1",
      "because": "Codec TS-5f"
    },
    {
      "route_expect_pty": [],
      "because": "Codec TS-5f"
    }
  ]
}

{
  "id": "conf::ts_6_tie_by_receive_order",
  "contract": "codec",
  "clause": "TS-6",
  "subject": "worker",
  "requires": {
    "controls": [
      "effective_size"
    ]
  },
  "steps": [
    {
      "route_attach": {
        "history": "screen",
        "route_features": [],
        "writable": true,
        "answers_queries": true
      }
    },
    {
      "expect": {
        "frame": "attached",
        "terminal_format": {
          "$type": "string"
        }
      },
      "on": "r1",
      "because": "Codec TS-1"
    },
    {
      "expect": {
        "frame": "baseline_begin",
        "rows": {
          "$type": "integer"
        },
        "cols": {
          "$type": "integer"
        },
        "modes": {
          "$type": "object"
        }
      },
      "on": "r1",
      "because": "Codec TS-4"
    },
    {
      "expect": {
        "frame": "screen",
        "payload": {
          "$any": true
        }
      },
      "on": "r1",
      "because": "Codec TS-4"
    },
    {
      "expect_eventually": {
        "frame": "baseline_end",
        "history": "not_requested"
      },
      "ignore": [
        {
          "frame": "history",
          "payload": {
            "$any": true
          }
        }
      ],
      "on": "r1",
      "because": [
        "Codec TS-1",
        "Codec TS-4"
      ]
    },
    {
      "expect": {
        "frame": "live"
      },
      "on": "r1",
      "because": "Codec TS-4b"
    },
    {
      "route_attach": {
        "history": "screen",
        "route_features": [],
        "writable": true,
        "answers_queries": true
      },
      "route": "r2"
    },
    {
      "expect": {
        "frame": "attached",
        "terminal_format": {
          "$type": "string"
        }
      },
      "on": "r2",
      "because": "Codec TS-1"
    },
    {
      "expect": {
        "frame": "baseline_begin",
        "rows": {
          "$type": "integer"
        },
        "cols": {
          "$type": "integer"
        },
        "modes": {
          "$type": "object"
        }
      },
      "on": "r2",
      "because": "Codec TS-4"
    },
    {
      "expect": {
        "frame": "screen",
        "payload": {
          "$any": true
        }
      },
      "on": "r2",
      "because": "Codec TS-4"
    },
    {
      "expect_eventually": {
        "frame": "baseline_end",
        "history": "not_requested"
      },
      "ignore": [
        {
          "frame": "history",
          "payload": {
            "$any": true
          }
        }
      ],
      "on": "r2",
      "because": [
        "Codec TS-1",
        "Codec TS-4"
      ]
    },
    {
      "expect": {
        "frame": "live"
      },
      "on": "r2",
      "because": "Codec TS-4b"
    },
    {
      "route_attach": {
        "history": "screen",
        "route_features": [],
        "writable": true,
        "answers_queries": true
      },
      "route": "r3"
    },
    {
      "expect": {
        "frame": "attached",
        "terminal_format": {
          "$type": "string"
        }
      },
      "on": "r3",
      "because": "Codec TS-1"
    },
    {
      "expect": {
        "frame": "baseline_begin",
        "rows": {
          "$type": "integer"
        },
        "cols": {
          "$type": "integer"
        },
        "modes": {
          "$type": "object"
        }
      },
      "on": "r3",
      "because": "Codec TS-4"
    },
    {
      "expect": {
        "frame": "screen",
        "payload": {
          "$any": true
        }
      },
      "on": "r3",
      "because": "Codec TS-4"
    },
    {
      "expect_eventually": {
        "frame": "baseline_end",
        "history": "not_requested"
      },
      "ignore": [
        {
          "frame": "history",
          "payload": {
            "$any": true
          }
        }
      ],
      "on": "r3",
      "because": [
        "Codec TS-1",
        "Codec TS-4"
      ]
    },
    {
      "expect": {
        "frame": "live"
      },
      "on": "r3",
      "because": "Codec TS-4b"
    },
    {
      "route_send": {
        "frame": "input",
        "kind": "resize",
        "op": "1",
        "rows": 30,
        "cols": 100
      }
    },
    {
      "route_send": {
        "frame": "input",
        "kind": "resize",
        "op": "1",
        "rows": 40,
        "cols": 120
      },
      "route": "r2"
    },
    {
      "route_send": {
        "frame": "bytes",
        "op": "2",
        "bytes": {
          "$bytes_hex": "78"
        }
      },
      "route": "r3"
    },
    {
      "control": {
        "op": "effective_size"
      },
      "expect": {
        "rows": 40,
        "cols": 120
      },
      "because": "Codec TS-6"
    }
  ]
}

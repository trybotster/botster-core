{
  "id": "conf::tr_3_chunking",
  "contract": "codec",
  "clause": "TR-3",
  "subject": "worker",
  "requires": {
    "controls": [
      "pty_input",
      "pty_output"
    ]
  },
  "setup": {
    "worker": {
      "framing": "chunked",
      "max_chunk_bytes": 7
    }
  },
  "steps": [
    {
      "route_attach": {
        "history": "screen",
        "route_features": [],
        "writable": true,
        "answers_queries": true
      }
    },
    {
      "expect": {
        "frame": "attached",
        "terminal_format": {
          "$type": "string"
        }
      },
      "on": "r1",
      "because": "Codec TS-1"
    },
    {
      "expect": {
        "frame": "baseline_begin",
        "rows": {
          "$type": "integer"
        },
        "cols": {
          "$type": "integer"
        },
        "modes": {
          "$type": "object"
        }
      },
      "on": "r1",
      "because": "Codec TS-4"
    },
    {
      "expect": {
        "frame": "screen",
        "payload": {
          "$any": true
        }
      },
      "on": "r1",
      "because": "Codec TS-4"
    },
    {
      "expect_eventually": {
        "frame": "baseline_end",
        "history": "not_requested"
      },
      "ignore": [
        {
          "frame": "history",
          "payload": {
            "$any": true
          }
        }
      ],
      "on": "r1",
      "because": [
        "Codec TS-1",
        "Codec TS-4"
      ]
    },
    {
      "expect": {
        "frame": "live"
      },
      "on": "r1",
      "because": "Codec TS-4b"
    },
    {
      "route_attach": {
        "history": "screen",
        "route_features": [],
        "writable": true,
        "answers_queries": true
      },
      "route": "r2"
    },
    {
      "expect": {
        "frame": "attached",
        "terminal_format": {
          "$type": "string"
        }
      },
      "on": "r2",
      "because": "Codec TS-1"
    },
    {
      "expect": {
        "frame": "baseline_begin",
        "rows": {
          "$type": "integer"
        },
        "cols": {
          "$type": "integer"
        },
        "modes": {
          "$type": "object"
        }
      },
      "on": "r2",
      "because": "Codec TS-4"
    },
    {
      "expect": {
        "frame": "screen",
        "payload": {
          "$any": true
        }
      },
      "on": "r2",
      "because": "Codec TS-4"
    },
    {
      "expect_eventually": {
        "frame": "baseline_end",
        "history": "not_requested"
      },
      "ignore": [
        {
          "frame": "history",
          "payload": {
            "$any": true
          }
        }
      ],
      "on": "r2",
      "because": [
        "Codec TS-1",
        "Codec TS-4"
      ]
    },
    {
      "expect": {
        "frame": "live"
      },
      "on": "r2",
      "because": "Codec TS-4b"
    },
    {
      "route_send_wire": {
        "bytes_hex": "008300000000"
      }
    },
    {
      "route_send_wire": {
        "bytes_hex": "000000000168"
      }
    },
    {
      "route_send_wire": {
        "bytes_hex": "01656c6c6f"
      }
    },
    {
      "route_expect_pty": [
        {
          "hex": "68656c6c6f"
        }
      ],
      "because": [
        "Codec TR-3",
        "Codec BP-2"
      ]
    },
    {
      "control": {
        "op": "pty_output",
        "bytes_hex": ""
      }
    },
    {
      "route_expect_output": {
        "bytes_hex": ""
      },
      "because": [
        "Codec BP-2",
        "Codec TR-3"
      ]
    },
    {
      "route_expect_output": {
        "bytes_hex": ""
      },
      "route": "r2",
      "because": [
        "Codec BP-2",
        "Codec TR-3"
      ]
    },
    {
      "route_send_wire": {
        "bytes_hex": "0283000000000000000168656c6c6f"
      },
      "route": "r2"
    },
    {
      "expect": {
        "frame": "route_closed",
        "reason": {
          "protocol_error": {
            "code": "malformed_frame"
          }
        }
      },
      "on": "r2",
      "because": [
        "Codec TR-3",
        "Codec A.1"
      ]
    },
    {
      "expect_closed": null,
      "on": "r2",
      "because": "Codec A.1"
    },
    {
      "route_attach": {
        "history": "screen",
        "route_features": [],
        "writable": true,
        "answers_queries": true
      },
      "route": "r3"
    },
    {
      "expect": {
        "frame": "attached",
        "terminal_format": {
          "$type": "string"
        }
      },
      "on": "r3",
      "because": "Codec TS-1"
    },
    {
      "expect": {
        "frame": "baseline_begin",
        "rows": {
          "$type": "integer"
        },
        "cols": {
          "$type": "integer"
        },
        "modes": {
          "$type": "object"
        }
      },
      "on": "r3",
      "because": "Codec TS-4"
    },
    {
      "expect": {
        "frame": "screen",
        "payload": {
          "$any": true
        }
      },
      "on": "r3",
      "because": "Codec TS-4"
    },
    {
      "expect_eventually": {
        "frame": "baseline_end",
        "history": "not_requested"
      },
      "ignore": [
        {
          "frame": "history",
          "payload": {
            "$any": true
          }
        }
      ],
      "on": "r3",
      "because": [
        "Codec TS-1",
        "Codec TS-4"
      ]
    },
    {
      "expect": {
        "frame": "live"
      },
      "on": "r3",
      "because": "Codec TS-4b"
    },
    {
      "route_send_wire": {
        "bytes_hex": "0183000000000000000168656c6c6f"
      },
      "route": "r3"
    },
    {
      "expect": {
        "frame": "route_closed",
        "reason": {
          "protocol_error": {
            "code": "frame_too_large"
          }
        }
      },
      "on": "r3",
      "because": [
        "Codec TR-3",
        "Codec A.1"
      ]
    },
    {
      "expect_closed": null,
      "on": "r3",
      "because": "Codec A.1"
    },
    {
      "route_expect_pty": [
        {
          "hex": "68656c6c6f"
        }
      ],
      "because": [
        "Codec TR-3",
        "Codec BP-2"
      ]
    }
  ]
}

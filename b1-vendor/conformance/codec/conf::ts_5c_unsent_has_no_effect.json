{
  "id": "conf::ts_5c_unsent_has_no_effect",
  "contract": "codec",
  "clause": "TS-5c",
  "subject": "worker",
  "requires": {
    "controls": [
      "client_close",
      "pty_input"
    ]
  },
  "steps": [
    {
      "route_attach": {
        "history": "screen",
        "route_features": [],
        "writable": true,
        "answers_queries": true
      }
    },
    {
      "expect": {
        "frame": "attached",
        "terminal_format": {
          "$type": "string"
        }
      },
      "on": "r1",
      "because": "Codec TS-1"
    },
    {
      "expect": {
        "frame": "baseline_begin",
        "rows": {
          "$type": "integer"
        },
        "cols": {
          "$type": "integer"
        },
        "modes": {
          "$type": "object"
        }
      },
      "on": "r1",
      "because": "Codec TS-4"
    },
    {
      "expect": {
        "frame": "screen",
        "payload": {
          "$any": true
        }
      },
      "on": "r1",
      "because": "Codec TS-4"
    },
    {
      "expect_eventually": {
        "frame": "baseline_end",
        "history": "not_requested"
      },
      "ignore": [
        {
          "frame": "history",
          "payload": {
            "$any": true
          }
        }
      ],
      "on": "r1",
      "because": [
        "Codec TS-1",
        "Codec TS-4"
      ]
    },
    {
      "expect": {
        "frame": "live"
      },
      "on": "r1",
      "because": "Codec TS-4b"
    },
    {
      "route_expect_pty": [],
      "because": "Codec TS-5c"
    },
    {
      "route_send_wire": {
        "bytes_hex": "0000002083"
      }
    },
    {
      "control": {
        "op": "client_close"
      },
      "route": "r1"
    },
    {
      "expect_closed": {
        "ended": "transport_lost"
      },
      "on": "r1",
      "because": "Codec TS-9"
    },
    {
      "route_expect_pty": [],
      "because": "Codec TS-5c"
    }
  ]
}

{
  "id": "conf::bp_2_output_bytes_identical_to_pty",
  "contract": "codec",
  "clause": "BP-2",
  "subject": "worker",
  "requires": {
    "controls": [
      "pty_output"
    ]
  },
  "steps": [
    {
      "route_attach": {
        "history": "screen",
        "route_features": [],
        "writable": true,
        "answers_queries": true
      }
    },
    {
      "expect": {
        "frame": "attached",
        "terminal_format": {
          "$type": "string"
        }

{
  "id": "conf::bp_3_data_frames_are_raw",
  "contract": "codec",
  "clause": "BP-3",
  "subject": "worker",
  "requires": {
    "controls": [
      "pty_input",
      "pty_output"
    ]
  },
  "steps": [
    {
      "route_attach": {
        "history": "screen",
        "route_features": [],
        "writable": true,
        "answers_queries": true
      }
    },
    {
      "expect": {
        "frame": "attached",
        "terminal_format": {
          "$type": "string"
        }
      },
      "on": "r1",
      "because": "Codec TS-1"
    },
    {
      "expect": {
        "frame": "baseline_begin",
        "rows": {
          "$type": "integer"
        },
        "cols": {
          "$type": "integer"
        },
        "modes": {
          "$type": "object"
        }
      },
      "on": "r1",
      "because": "Codec TS-4"
    },
    {
      "expect": {
        "frame": "screen",
        "payload": {
          "$any": true
        }
      },
      "on": "r1",
      "because": "Codec TS-4"
    },
    {
      "expect_eventually": {
        "frame": "baseline_end",
        "history": "not_requested"
      },
      "ignore": [
        {
          "frame": "history",
          "payload": {
            "$any": true
          }
        }
      ],
      "on": "r1",
      "because": [
        "Codec TS-1",
        "Codec TS-4"
      ]
    },
    {
      "expect": {
        "frame": "live"
      },
      "on": "r1",
      "because": "Codec TS-4b"
    },
    {
      "route_send_raw": {
        "bytes_hex": "830000000000000001fffe00"
      }
    },
    {
      "route_send_raw": {
        "bytes_hex": "84000000000000000268c3a9"
      }
    },
    {
      "route_send": {
        "frame": "input",
        "kind": "paste_begin",
        "op": "3"
      }
    },
    {
      "route_send_raw": {
        "bytes_hex": "8200000000000000037b7d"
      }
    },
    {
      "route_send": {
        "frame": "input",
        "kind": "paste_commit",
        "op": "3"
      }
    },
    {
      "control": {
        "op": "pty_output",
        "bytes_hex": "fffe007b7d"
      }
    },
    {
      "route_expect_output": {
        "bytes_hex": "fffe007b7d"
      },
      "because": "Codec BP-2"
    },
    {
      "route_expect_pty": [
        {
          "hex": "fffe00"
        },
        {
          "hex": "68c3a9"
        },
        {
          "written_by_op": "3"
        }
      ],
      "because": [
        "Codec BP-2",
        "Codec BP-3"
      ]
    },
    {
      "expect_quiet_until": {
        "$one_of": [
          {
            "frame": "input_done"
          },
          {
            "frame": "input_refused",
            "reason": {
              "$one_of": [
                "not_ready",
                "not_writable",
                "too_large",
                "mode_precondition_failed",
                "failed",
                "session_ended",
                "write_failed",
                "already_replied",
                "query_expired",
                "wrong_route",
                {
                  "unsupported": {
                    "what": {
                      "$any": true
                    }
                  }
                }
              ]
            }
          }
        ]
      },
      "barrier": {
        "route_send": {
          "frame": "input",
          "kind": "reply_terminal_query",
          "op": "999",
          "query_id": "none",
          "reply": "decline"
        }
      },
      "until": {
        "frame": "input_refused",
        "op": "999",
        "reason": "unknown_query"
      },
      "on": "r1",
      "because": [
        "Codec TS-5b",
        "Codec A.5"
      ]
    }
  ],
  "setup": {
    "worker": {
      "script": {
        "writes": {
          "paste": "5041535445"
        }
      }
    }
  }
}

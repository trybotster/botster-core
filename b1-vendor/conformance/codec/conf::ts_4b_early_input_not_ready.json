        "Codec TS-5b"
      ]
    },
    {
      "route_send": {
        "frame": "bytes",
        "op": "6",
        "bytes": {
          "$bytes_hex": "6c617465"
        }
      }
    },
    {
      "route_expect_pty": [
        {
          "hex": "6c617465"
        }

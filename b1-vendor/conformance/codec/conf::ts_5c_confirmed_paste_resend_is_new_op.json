{
  "id": "conf::ts_5c_confirmed_paste_resend_is_new_op",
  "contract": "codec",
  "clause": "TS-5c",
  "subject": "worker",
  "requires": {
    "controls": [
      "pty_input"
    ]
  },
  "steps": [
    {
      "route_attach": {
        "history": "screen",
        "route_features": [],
        "writable": true,
        "answers_queries": true
      }
    },
    {
      "expect": {
        "frame": "attached",
        "terminal_format": {
          "$type": "string"
        }
      },
      "on": "r1",
      "because": "Codec TS-1"
    },
    {
      "expect": {
        "frame": "baseline_begin",
        "rows": {
          "$type": "integer"
        },
        "cols": {
          "$type": "integer"
        },
        "modes": {
          "$type": "object"
        }
      },
      "on": "r1",
      "because": "Codec TS-4"
    },
    {
      "expect": {
        "frame": "screen",
        "payload": {
          "$any": true
        }
      },
      "on": "r1",
      "because": "Codec TS-4"
    },
    {
      "expect_eventually": {
        "frame": "baseline_end",
        "history": "not_requested"
      },
      "ignore": [
        {
          "frame": "history",
          "payload": {
            "$any": true
          }
        }
      ],
      "on": "r1",
      "because": [
        "Codec TS-1",
        "Codec TS-4"
      ]
    },
    {
      "expect": {
        "frame": "live"
      },
      "on": "r1",
      "because": "Codec TS-4b"
    },
    {
      "route_send": {
        "frame": "input",
        "kind": "paste_begin",
        "op": "1",
        "require_bracketed": true
      }
    },
    {
      "route_send": {
        "frame": "paste_chunk",
        "op": "1",
        "bytes": {
          "$bytes_hex": "610a62"
        }
      }
    },
    {
      "route_send": {
        "frame": "input",
        "kind": "paste_commit",
        "op": "1"
      }
    },
    {
      "expect_eventually": {
        "frame": "input_refused",
        "reason": "mode_precondition_failed",
        "op": "1"
      },
      "ignore": [
        {
          "frame": "modes"
        },
        {
          "frame": "output"
        },
        {
          "frame": "output_deflate"
        }
      ],
      "on": "r1",
      "because": "Codec TS-5e"
    },
    {
      "route_expect_pty": [],
      "because": "Codec TS-5e"
    },
    {
      "route_send": {
        "frame": "input",
        "kind": "paste_begin",
        "op": "2",
        "require_bracketed": false
      }
    },
    {
      "route_send": {
        "frame": "paste_chunk",
        "op": "2",
        "bytes": {
          "$bytes_hex": "610a62"
        }
      }
    },
    {
      "route_send": {
        "frame": "input",
        "kind": "paste_commit",
        "op": "2"
      }
    },
    {
      "route_expect_pty": [
        {
          "written_by_op": "2"
        }
      ],
      "because": [
        "Codec TS-5c",
        "Codec TS-5d"
      ]
    },
    {
      "expect_quiet_until": {
        "$one_of": [
          {
            "frame": "input_done"
          },
          {
            "frame": "input_refused",
            "reason": {
              "$one_of": [
                "not_ready",
                "not_writable",
                "too_large",
                "mode_precondition_failed",
                "failed",
                "session_ended",
                "write_failed",
                "already_replied",
                "query_expired",
                "wrong_route",
                {
                  "unsupported": {
                    "what": {
                      "$any": true
                    }
                  }
                }
              ]
            }
          }
        ]
      },
      "barrier": {
        "route_send": {
          "frame": "input",
          "kind": "reply_terminal_query",
          "op": "999",
          "query_id": "none",
          "reply": "decline"
        }
      },
      "until": {
        "frame": "input_refused",
        "op": "999",
        "reason": "unknown_query"
      },
      "on": "r1",
      "because": [
        "Codec TS-5b",
        "Codec A.5"
      ]
    }
  ],
  "setup": {
    "worker": {
      "script": {
        "writes": {
          "paste": "5041535445"
        }
      }
    }
  }
}

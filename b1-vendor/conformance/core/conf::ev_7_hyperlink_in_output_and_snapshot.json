                    "$type": "u64"
                  }
                }
              }
            }
          }
        }
      },
      "because": "Core ST-6"
    },
    {
      "control": {
        "op": "oracle_hyperlinks",
        "capture": "$cid"
      },
      "bind_fields": {
        "uris": "$u_cap"
      }
    },
    {
      "check": {
        "contains": [
          "$u_cap",
          "https://example.test/a"
        ]
      },
      "because": [
        "Core EV-7",
        "Core ST-6b"
      ]
    },

    {
      "route_expect_output": {
        "bytes_hex": "1b5d383b3b68747470733a2f2f6578616d706c652e746573742f61076c696e6b1b5d383b3b07"
      },
      "because": [
        "Core EV-7",
        "Core OU-12"
      ]

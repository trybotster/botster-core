        {
          "frame": "history",
          "payload": {
            "$any": true
          }
        }
      ],
      "on": "r1",
      "because": "Core OU-9"
    },
    {
      "expect": {
        "frame": "live"
      },
      "on": "r1",
      "because": "Core OU-9"
    },
    {
      "begin": {
        "op": {
          "WriteInput": {
            "session": "s1",
            "payload": {
              "bytes": {
                "bytes": {
                  "$bytes_hex": "31"
                }
              }
            }
          }
        }
      },
      "bind": "$t_s1_1"
    },
    {
      "pump_collect": {
        "events": [
          {
            "Completed": {
              "op": "$t_s1_1",
              "result": {
                "ok": {
                  "input": {
                    "outcome": {
                      "$any": true
                    }
                  }
                }
              }
            }
          },
          {
            "Activity": {
              "id": "s1",
              "source": "Output"
            }
          }
        ]
      },
      "because": [
        "Core EV-7"
      ]

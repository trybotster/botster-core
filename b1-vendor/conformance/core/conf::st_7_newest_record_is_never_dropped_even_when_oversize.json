{
  "id": "conf::st_7_newest_record_is_never_dropped_even_when_oversize",
  "contract": "core",
  "clause": "ST-7",
  "subject": "core",
  "setup": {
    "limits": {
      "input_events_bytes": 1280,
      "input_event_payload_bytes": 4096
    }
  },
  "fake": "structural",
  "ruling": "R-12",
  "steps": [
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s1",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ],
              "size": {
                "rows": 10,
                "cols": 40
              }
            }
          }
        }
      },
      "bind": "$c_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$c_s1",
            "result": {
              "ok": {
                "record": {
                  "id": "s1",
                  "state": "Created"
                }
              }
            }
          }
        }
      },
      "because": "Core LC-3"
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "s1"
          }
        }
      },
      "bind": "$s_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$s_s1",
            "result": {
              "ok": {
                "record": {
                  "id": "s1",
                  "state": "Running"
                }
              }
            }
          }
        }
      },
      "because": "Core A2-1"
    },
    {
      "begin": {
        "op": {
          "WriteInput": {
            "session": "s1",
            "payload": {
              "text": {
                "text": ""
              }
            }
          }
        }
      },
      "bind": "$w1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$w1",
            "result": {
              "ok": {
                "input": {
                  "outcome": {
                    "$any": true
                  }
                }
              }
            }
          }
        }
      },
      "because": "Core IN-2"
    },
    {
      "begin": {
        "op": {
          "ReadFacts": {
            "session": "s1"
          }
        }
      },
      "bind": "$f"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$f",
            "result": {
              "ok": {
                "facts": {
                  "input": {
                    "input_records": [
                      {
                        "record": {
                          "source": "Host",
                          "kind": "text",
                          "state": "pending",
                          "at": {
                            "$type": "u64"
                          },
                          "payload_truncated": true,
                          "cursor": "$c1"
                        }
                      },
                      {
                        "status_update": {
                          "updates": "$c1",
                          "cursor": "$u1",
                          "state": "written"
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      },
      "because": "Core ST-7"
    }
  ]
}

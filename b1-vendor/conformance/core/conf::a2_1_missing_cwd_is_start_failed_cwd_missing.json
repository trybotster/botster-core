{
  "id": "conf::a2_1_missing_cwd_is_start_failed_cwd_missing",
  "contract": "core",
  "clause": "A2-1",
  "subject": "core",
  "steps": [
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s1",
            "request": {
              "cwd": "/botster-core-p1-no-such-dir",
              "program": [
                {
                  "hold": {}
                }
              ]
            }
          }
        }
      },
      "bind": "$c_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$c_s1",
            "result": {
              "ok": {
                "record": {
                  "id": "s1",
                  "state": "Created"
                }
              }
            }
          }
        }
      },
      "because": "Core A2-1"
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "s1"
          }
        }
      },
      "bind": "$s_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$s_s1",
            "result": {
              "err": {
                "code": {
                  "StartFailed": "CwdMissing"
                }
              }
            }
          }
        }
      },
      "because": [
        "Core A2-1",
        "Core LC-4"
      ]
    },
    {
      "call": {
        "method": "get",
        "args": {
          "id": "s1"
        }
      },
      "expect": {
        "state": {
          "$one_of": [
            {
              "Exited": {
                "$any": true
              }
            },
            {
              "Lost": {
                "$any": true
              }
            }
          ]
        }
      },
      "because": [
        "Core LC-4"
      ]
    }
  ]
}

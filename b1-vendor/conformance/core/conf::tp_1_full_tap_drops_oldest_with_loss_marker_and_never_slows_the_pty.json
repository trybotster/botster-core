{
  "id": "conf::tp_1_full_tap_drops_oldest_with_loss_marker_and_never_slows_the_pty",
  "contract": "core",
  "clause": "TP-1",
  "subject": "core",
  "setup": {
    "limits": {
      "tap_chunk_bytes": 4096,
      "tap_queue_bytes": 4096
    }
  },
  "fake": "structural",
  "ruling": "R-12",
  "steps": [
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s1",
            "request": {
              "program": [
                {
                  "print_after_input": {
                    "match_hex": "31",
                    "bytes_hex": ""
                  }
                },
                {
                  "print_after_input": {
                    "match_hex": "32",
                    "bytes_hex": ""
                  }
                },
                {
                  "print_after_input": {
                    "match_hex": "33",
                    "bytes_hex": ""
                  }
                },
                {
                  "hold": {}
                }
              ]
            }
          }
        }
      },
      "bind": "$c_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$c_s1",
            "result": {
              "ok": {
                "record": {
                  "id": "s1",
                  "state": "Created"
                }
              }
            }
          }
        }
      },
      "because": "Core LC-3"
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "s1"
          }
        }
      },
      "bind": "$s_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$s_s1",
            "result": {
              "ok": {
                "record": {
                  "id": "s1",
                  "state": "Running"
                }
              }
            }
          }
        }
      },
      "because": "Core A2-1"
    },
    {
      "begin": {
        "op": {
          "SetOutputTap": {
            "session": "s1",
            "enabled": true
          }
        }
      },
      "bind": "$on"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$on",
            "result": {
              "ok": "unit"
            }
          }
        }
      },
      "because": "Core TP-1"
    },
    {
      "begin": {
        "op": {
          "WriteInput": {
            "session": "s1",
            "payload": {
              "bytes": {
                "bytes": {
                  "$bytes_hex": "31"
                }
              }
            }
          }
        }
      },
      "bind": "$t_s1_1"
    },
    {
      "pump_collect": {
        "events": [
          {
            "Completed": {
              "op": "$t_s1_1",
              "result": {
                "ok": {
                  "input": {
                    "outcome": {
                      "$any": true
                    }
                  }
                }
              }
            }
          },
          {
            "Activity": {
              "id": "s1",
              "source": "Output"
            }
          }
        ]
      },
      "because": "Core TP-1"
    },
    {
      "begin": {
        "op": {
          "WriteInput": {
            "session": "s1",
            "payload": {
              "bytes": {
                "bytes": {
                  "$bytes_hex": "32"
                }
              }
            }
          }
        }
      },
      "bind": "$t_s1_2"
    },
    {
      "pump_collect": {
        "events": [
          {
            "Completed": {
              "op": "$t_s1_2",
              "result": {
                "ok": {
                  "input": {
                    "outcome": {
                      "$any": true
                    }
                  }
                }
              }
            }
          },
          {
            "Activity": {
              "id": "s1",
              "source": "Output"
            }
          }
        ]
      },
      "because": "Core TP-1"
    },
    {
      "begin": {
        "op": {
          "WriteInput": {
            "session": "s1",
            "payload": {
              "bytes": {
                "bytes": {
                  "$bytes_hex": "33"
                }
              }
            }
          }
        }
      },
      "bind": "$t_s1_3"
    },
    {
      "pump_collect": {
        "events": [
          {
            "Completed": {
              "op": "$t_s1_3",
              "result": {
                "ok": {
                  "input": {
                    "outcome": {
                      "$any": true
                    }
                  }
                }
              }
            }
          },
          {
            "Activity": {
              "id": "s1",
              "source": "Output"
            }
          }
        ]
      },
      "because": "Core TP-1"
    },
    {
      "begin": {
        "op": {
          "WriteInput": {
            "session": "s1",
            "payload": {
              "bytes": {
                "bytes": {
                  "$bytes_hex": "7a"
                }
              }
            }
          }
        }
      },
      "bind": "$z"
    },
    {
      "pump_collect": {
        "events": [
          {
            "Completed": {
              "op": "$z",
              "result": {
                "ok": {
                  "input": {
                    "outcome": {
                      "$any": true
                    }
                  }
                }
              }
            }
          },
          {
            "EventsLost": {
              "id": "s1",
              "kinds": "$k",
              "tap_dropped_bytes": "$dm"
            }
          }
        ]
      },
      "because": [
        "Core TP-1",
        "Core A2-4"
      ]
    },
    {
      "check": {
        "subset_of": [
          [
            "Tap"
          ],
          "$k"
        ]
      },
      "because": "Core TP-1"
    },
    {
      "check": {
        "lt": [
          0,
          "$dm"
        ]
      },
      "because": "Core TP-1"
    },
    {
      "tap_drain": {
        "session": "s1",
        "accounted": 6144
      },
      "bind_fields": {
        "bytes": "$tb",
        "dropped": "$d"
      },
      "because": "Core TP-1"
    },
    {
      "check": {
        "lt": [
          0,
          "$d"
        ]
      },
      "because": "Core TP-1"
    },
    {
      "let": {
        "$kept": {
          "sub": [
            6144,
            "$d"
          ]
        }
      }
    },
    {
      "check": {
        "hex_len_eq": [
          "$tb",
          "$kept"
        ]
      },
      "because": "Core TP-1"
    },
    {
      "check": {
        "hex_ends_with": [
          {
            "$bytes_hex": ""
          },
          "$tb"
        ]
      },
      "because": "Core TP-1"
    }
  ]
}

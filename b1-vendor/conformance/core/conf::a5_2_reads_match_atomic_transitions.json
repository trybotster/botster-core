{
  "id": "conf::a5_2_reads_match_atomic_transitions",
  "contract": "core",
  "clause": "A5-2",
  "subject": "core",
  "requires": {
    "controls": [
      "scheduler_hold",
      "scheduler_release"
    ]
  },
  "fake": "structural",
  "ruling": "R-12",
  "steps": [
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s1",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ]
            }
          }
        }
      },
      "bind": "$c_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$c_s1",
            "result": {
              "ok": {
                "record": {
                  "id": "s1",
                  "state": "Created"
                }
              }
            }
          }
        }
      },
      "because": "Core LC-3"
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "s1"
          }
        }
      },
      "bind": "$s_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$s_s1",
            "result": {
              "ok": {
                "record": {
                  "id": "s1",
                  "state": "Running"
                }
              }
            }
          }
        }
      },
      "because": "Core A2-1"
    },
    {
      "begin": {
        "op": {
          "Stop": {
            "id": "s1"
          }
        }
      },
      "bind": "$a"
    },
    {
      "control": {
        "op": "scheduler_hold",
        "for_op": "$a"
      },
      "because": "Core A5-2"
    },
    {
      "pump_idle": {}
    },
    {
      "call": {
        "method": "get",
        "args": {
          "id": "s1"
        }
      },
      "expect": {
        "state": {
          "$one_of": [
            "Running",
            "Stopping"
          ]
        }
      },
      "because": [
        "Core A5-2",
        "Core EV-5"
      ]
    },
    {
      "poll_events": {
        "max": 64
      },
      "expect": [],
      "because": [
        "Core A5-2",
        "Core EV-5"
      ]
    },
    {
      "control": {
        "op": "scheduler_release",
        "for_op": "$a"
      },
      "because": "Core A5-2"
    },
    {
      "pump_idle": {}
    },
    {
      "call": {
        "method": "get",
        "args": {
          "id": "s1"
        }
      },
      "bind_fields": {
        "state": "$st"
      },
      "because": [
        "Core A5-2",
        "Core EV-5"
      ]
    },
    {
      "expect_eventually": {
        "SessionState": {
          "id": "s1",
          "state": "$st"
        }
      },
      "ignore": [
        {
          "$any": true
        }
      ],
      "because": [
        "Core A5-2",
        "Core EV-5"
      ]
    }
  ]
}

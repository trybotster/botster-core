{
  "id": "conf::in_10_guard_ignores_its_own_admission",
  "contract": "core",
  "clause": "IN-10",
  "subject": "core",
  "steps": [
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s1",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ]
            }
          }
        }
      },
      "bind": "$c_s1"
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "s1"
          }
        }
      },
      "bind": "$s_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$s_s1",
            "result": {}
          }
        }
      },
      "because": "Core LC-3"
    },
    {
      "pump": {}
    },
    {
      "call": {
        "method": "terminal_state",
        "args": {
          "id": "s1"
        }
      },
      "expect": {
        "input_rev": {
          "client": "$a",
          "host": "$h"
        },
        "model_rev": "$m"
      },
      "because": "Core ST-4"
    },
    {
      "begin": {
        "op": {
          "WriteInput": {
            "session": "s1",
            "payload": {
              "bytes": {
                "bytes": {
                  "$bytes_hex": "61"
                }
              }
            },
            "guard": {
              "input": {
                "source_class": "Host",
                "rev": "$h"
              }
            }
          }
        }
      },
      "bind": "$w1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$w1",
            "result": {
              "ok": {
                "input": {
                  "outcome": "Written",
                  "payload_bytes_written": 1,
                  "pty_bytes_written": 1
                }
              }
            }
          }
        }
      },
      "because": [
        "Core IN-10"
      ]
    },
    {
      "begin": {
        "op": {
          "WriteInput": {
            "session": "s1",
            "payload": {
              "bytes": {
                "bytes": {
                  "$bytes_hex": "62"
                }
              }
            },
            "guard": {
              "input": {
                "source_class": "Host",
                "rev": "$h"
              }
            }
          }
        }
      },
      "bind": "$w2"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$w2",
            "result": {
              "ok": {
                "input": {
                  "outcome": {
                    "NotWritten": "Stale"
                  },
                  "payload_bytes_written": 0,
                  "pty_bytes_written": 0
                }
              }
            }
          }
        }
      },
      "because": [
        "Core IN-10"
      ]
    }
  ]
}

{
  "id": "conf::ev_8_replies_never_split_a_paste_and_keep_query_order",
  "contract": "core",
  "clause": "EV-8",
  "subject": "core",
  "requires": {
    "controls": [
      "edges_quiet",
      "pty_accept",
      "pty_input",
      "pty_output"
    ]
  },
  "fake": "structural",
  "ruling": "R-12",
  "steps": [
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s1",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ]
            }
          }
        }
      },
      "bind": "$c_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$c_s1",
            "result": {
              "ok": {
                "record": {
                  "id": "s1",
                  "state": "Created"
                }
              }
            }
          }
        }
      },
      "because": "Core LC-3"
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "s1"
          }
        }
      },
      "bind": "$s_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$s_s1",
            "result": {
              "ok": {
                "record": {
                  "id": "s1",
                  "state": "Running"
                }
              }
            }
          }
        }
      },
      "because": "Core A2-1"
    },
    {
      "attach_route": {
        "route": "r1",
        "session": "s1",
        "client": "c1",
        "options": {
          "history": "none",
          "answers_queries": true,
          "query_deadline": 60000
        }
      },
      "because": "Core OU-1"
    },
    {
      "expect": {
        "frame": "attached",
        "terminal_format": {
          "$type": "string"
        }
      },
      "because": "Core OU-9",
      "on": "r1"
    },
    {
      "expect": {
        "frame": "baseline_begin",
        "rows": {
          "$type": "integer"
        },
        "cols": {
          "$type": "integer"
        },
        "modes": {
          "$type": "object"
        }
      },
      "because": "Core OU-9",
      "on": "r1"
    },
    {
      "expect": {
        "frame": "screen",
        "payload": {
          "$any": true
        }
      },
      "because": "Core OU-9",
      "on": "r1"
    },
    {
      "expect_eventually": {
        "frame": "baseline_end",
        "history": "not_requested"
      },
      "because": "Core OU-9",
      "ignore": [
        {
          "frame": "history",
          "payload": {
            "$any": true
          }
        }
      ],
      "on": "r1"
    },
    {
      "expect": {
        "frame": "live"
      },
      "because": "Core OU-9",
      "on": "r1"
    },
    {
      "control": {
        "op": "pty_accept",
        "session": "s1",
        "bytes": 10
      }
    },
    {
      "route_send": {
        "frame": "input",
        "kind": "paste_begin",
        "op": "5"
      }
    },
    {
      "route_send": {
        "frame": "paste_chunk",
        "op": "5",
        "bytes": {
          "$bytes_hex": "62626262626262626262626262626262626262626262626262626262626262626262626262626262"
        }
      }
    },
    {
      "route_send": {
        "frame": "input",
        "kind": "paste_commit",
        "op": "5"
      }
    },
    {
      "control": {
        "op": "pty_output",
        "session": "s1",
        "bytes_hex": "1b5b63"
      }
    },
    {
      "await_quiet": {}
    },
    {
      "expect_eventually": {
        "frame": "terminal_query",
        "query_id": "$q1"
      },
      "because": [
        "Core EV-8",
        "Core DP-3"
      ],
      "ignore": [
        {
          "$any": true
        }
      ],
      "on": "r1"
    },
    {
      "control": {
        "op": "pty_output",
        "session": "s1",
        "bytes_hex": "1b5b63"
      }
    },
    {
      "await_quiet": {}
    },
    {
      "expect_eventually": {
        "frame": "terminal_query",
        "query_id": "$q2"
      },
      "because": [
        "Core EV-8",
        "Core DP-3"
      ],
      "ignore": [
        {
          "$any": true
        }
      ],
      "on": "r1"
    },
    {
      "route_send": {
        "frame": "input",
        "kind": "reply_terminal_query",
        "op": "6",
        "query_id": "$q1",
        "reply": {
          "encoded": {
            "bytes_base64": "G1s/NjJj"
          }
        }
      },
      "route": "r1"
    },
    {
      "route_send": {
        "frame": "input",
        "kind": "reply_terminal_query",
        "op": "7",
        "query_id": "$q2",
        "reply": {
          "encoded": {
            "bytes_base64": "G1s/MTsyYw=="
          }
        }
      },
      "route": "r1"
    },
    {
      "control": {
        "op": "pty_accept",
        "session": "s1",
        "bytes": 1000
      }
    },
    {
      "let": {
        "$wl0": {
          "hex_len": [
            "1b5b3f363263",
            0
          ]
        }
      }
    },
    {
      "let": {
        "$wl1": {
          "hex_len": [
            "1b5b3f313b3263",
            0
          ]
        }
      }
    },
    {
      "let": {
        "$ws1": {
          "add": [
            "$wl0",
            "$wl1"
          ]
        }
      }
    },
    {
      "let": {
        "$wx": {
          "add": [
            "$ws1",
            40
          ]
        }
      }
    },
    {
      "await_pty": {
        "session": "s1",
        "min_bytes": "$wx"
      }
    },
    {
      "await_quiet": {}
    },
    {
      "route_expect_pty": [
        {
          "written_by_op": "5",
          "contains": [
            {
              "hex": "62626262626262626262626262626262626262626262626262626262626262626262626262626262"
            }
          ]
        },
        {
          "hex": "1b5b3f363263"
        },
        {
          "hex": "1b5b3f313b3263"
        }
      ],
      "because": [
        "Core EV-8",
        "Core AM-2"
      ]
    }
  ]
}

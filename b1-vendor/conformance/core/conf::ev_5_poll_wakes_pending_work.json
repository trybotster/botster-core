{
  "id": "conf::ev_5_poll_wakes_pending_work",
  "contract": "core",
  "clause": "EV-5",
  "subject": "core",
  "requires": {
    "controls": [
      "edges_quiet",
      "parked_work",
      "payload_alive"
    ]
  },
  "setup": {
    "limits": {
      "max_sessions": 2,
      "mandatory_events": 2
    }
  },
  "fake": "structural",
  "ruling": "R-12",
  "steps": [
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s1",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ]
            }
          }
        }
      },
      "bind": "$c_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$c_s1",
            "result": {
              "ok": {
                "record": {
                  "id": "s1",
                  "state": "Created"
                }
              }
            }
          }
        }
      },
      "because": "Core LC-3"
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "s1"
          }
        }
      },
      "bind": "$s_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$s_s1",
            "result": {
              "ok": {
                "record": {
                  "id": "s1",
                  "state": "Running"
                }
              }
            }
          }
        }
      },
      "because": "Core A2-1"
    },
    {
      "drain": {}
    },
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s2",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ]
            }
          }
        }
      },
      "bind": "$c_s2"
    },
    {
      "pump_idle": {}
    },
    {
      "begin": {
        "op": {
          "Stop": {
            "id": "s1"
          }
        }
      },
      "bind": "$p1"
    },
    {
      "await_control": {
        "control": {
          "op": "payload_alive",
          "session": "s1"
        },
        "expect": {
          "alive": false
        }
      }
    },
    {
      "await_control": {
        "control": {
          "op": "parked_work",
          "session": "s1"
        },
        "expect": {
          "parked": true
        }
      },
      "because": [
        "Core EV-5",
        "Core TM-6"
      ]
    },
    {
      "await_quiet": {}
    },
    {
      "wait_wake": {
        "timeout_ms": 0
      },
      "expect": {
        "$one_of": [
          "Woken",
          "TimedOut"
        ]
      },
      "because": [
        "Core EV-5",
        "Core TM-6"
      ]
    },
    {
      "pump": {},
      "expect": {
        "more": false,
        "events_posted": 0
      },
      "because": [
        "Core TH-2",
        "Core EV-5",
        "Core TM-6"
      ]
    },
    {
      "poll_all": {}
    },
    {
      "wait_wake": {
        "timeout_ms": 0
      },
      "expect": "Woken",
      "because": [
        "Core EV-5",
        "Core TM-6"
      ]
    },
    {
      "await_quiet": {}
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$p1",
            "result": {
              "ok": {
                "end": {
                  "Exited": {
                    "$any": true
                  }
                }
              }
            }
          }
        }
      },
      "because": [
        "Core EV-5"
      ]
    }
  ]
}

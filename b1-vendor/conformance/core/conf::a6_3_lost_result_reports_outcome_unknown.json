{
  "id": "conf::a6_3_lost_result_reports_outcome_unknown",
  "contract": "core",
  "clause": "A6-3",
  "subject": "core",
  "requires": {
    "controls": [
      "break_control",
      "edges_quiet",
      "fs_directory",
      "fs_list",
      "held_reports",
      "hold_worker_report",
      "payload_alive",
      "pty_input",
      "pty_output",
      "release_worker_report"
    ]
  },
  "fake": "structural",
  "ruling": "R-12",
  "steps": [
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s1",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ]
            }
          }
        }
      },
      "bind": "$c_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$c_s1",
            "result": {
              "ok": {
                "record": {
                  "id": "s1",
                  "state": "Created"
                }
              }
            }
          }
        }
      },
      "because": "Core LC-3"
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "s1"
          }
        }
      },
      "bind": "$s_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$s_s1",
            "result": {
              "ok": {
                "record": {
                  "id": "s1",
                  "state": "Running"
                }
              }
            }
          }
        }
      },
      "because": "Core A2-1"
    },
    {
      "control": {
        "op": "fs_directory"
      },
      "bind_fields": {
        "path": "$dir",
        "name_max": "$name_max"
      }
    },
    {
      "attach_route": {
        "route": "r1",
        "session": "s1",
        "client": "c1",
        "options": {
          "history": "none",
          "file_directory": "$dir"
        }
      },
      "because": "Core OU-1"
    },
    {
      "expect": {
        "frame": "attached",
        "terminal_format": {
          "$type": "string"
        }
      },
      "because": "Core OU-9",
      "on": "r1"
    },
    {
      "expect": {
        "frame": "baseline_begin",
        "rows": {
          "$type": "integer"
        },
        "cols": {
          "$type": "integer"
        },
        "modes": {
          "$type": "object"
        }
      },
      "because": "Core OU-9",
      "on": "r1"
    },
    {
      "expect": {
        "frame": "screen",
        "payload": {
          "$any": true
        }
      },
      "because": "Core OU-9",
      "on": "r1"
    },
    {
      "expect_eventually": {
        "frame": "baseline_end",
        "history": "not_requested"
      },
      "because": "Core OU-9",
      "ignore": [
        {
          "frame": "history",
          "payload": {
            "$any": true
          }
        }
      ],
      "on": "r1"
    },
    {
      "expect": {
        "frame": "live"
      },
      "because": "Core OU-9",
      "on": "r1"
    },
    {
      "route_send": {
        "frame": "input",
        "kind": "file_begin",
        "op": "1",
        "name": "a.txt"
      }
    },
    {
      "route_send": {
        "frame": "file_chunk",
        "op": "1",
        "bytes": {
          "$bytes_hex": "6161"
        }
      }
    },
    {
      "route_send": {
        "frame": "input",
        "kind": "file_commit",
        "op": "1"
      }
    },
    {
      "expect_eventually": {
        "frame": "input_done",
        "op": "1",
        "written_bytes": "$wb1",
        "path": "$p1"
      },
      "because": [
        "Core A6-3",
        "Core LC-7",
        "Core DP-5b"
      ],
      "ignore": [
        {
          "frame": "modes"
        },
        {
          "frame": "output"
        },
        {
          "frame": "output_deflate"
        }
      ],
      "on": "r1"
    },
    {
      "begin": {
        "op": {
          "Stop": {
            "id": "s1"
          }
        }
      },
      "bind": "$stp"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$stp",
            "result": {
              "ok": {
                "end": {
                  "$any": true
                }
              }
            }
          }
        }
      },
      "because": [
        "Core LC-5",
        "Core A2-1"
      ]
    },
    {
      "await_control": {
        "control": {
          "op": "payload_alive",
          "session": "s1"
        },
        "expect": {
          "alive": false
        }
      },
      "because": [
        "Core LC-5",
        "Core A12-1"
      ]
    },
    {
      "control": {
        "op": "hold_worker_report",
        "session": "s1"
      }
    },
    {
      "begin": {
        "op": {
          "Remove": {
            "id": "s1"
          }
        }
      },
      "bind": "$rm"
    },
    {
      "await_control": {
        "control": {
          "op": "held_reports",
          "session": "s1"
        },
        "expect": {
          "count": {
            "$between": [
              1,
              1000
            ]
          }
        }
      }
    },
    {
      "control": {
        "op": "fs_list",
        "path": "$dir"
      },
      "expect": {
        "count": 0
      },
      "because": [
        "Core A12-1",
        "Core A6-3",
        "Core LC-7"
      ]
    },
    {
      "control": {
        "op": "break_control",
        "session": "s1"
      }
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$rm",
            "result": {
              "ok": {
                "remove_report": {
                  "uploads": {
                    "not_deleted": {
                      "reason": "outcome_unknown",
                      "paths": {
                        "$absent": true
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "because": [
        "Core A12-1",
        "Core A6-3",
        "Core LC-7"
      ]
    },
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s1",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ]
            }
          }
        }
      },
      "bind": "$again"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$again",
            "result": {
              "ok": {
                "record": {
                  "id": "s1",
                  "state": "Created"
                }
              }
            }
          }
        }
      },
      "because": [
        "Core A6-3",
        "Core LC-7"
      ]
    }
  ]
}

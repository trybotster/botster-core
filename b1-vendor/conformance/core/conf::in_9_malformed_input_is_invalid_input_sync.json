{
  "id": "conf::in_9_malformed_input_is_invalid_input_sync",
  "contract": "core",
  "clause": "IN-9",
  "subject": "core",
  "steps": [
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s1",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ],
              "fake": {
                "writes": {
                  "key": "61",
                  "mouse": "4d",
                  "focus_in": "49",
                  "focus_out": "4f",
                  "paste": "1b5b3230307e68656c6c6f1b5b3230317e"
                },
                "admission": {
                  "key": 12,
                  "mouse": 12,
                  "focus": 3,
                  "paste": 64
                }
              }
            }
          }
        }
      },
      "bind": "$c_s1"
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "s1"
          }
        }
      },
      "bind": "$s_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$s_s1",
            "result": {}
          }
        }
      },
      "because": "Core LC-3"
    },
    {
      "begin": {
        "op": {
          "WriteInput": {
            "session": "s1",
            "payload": {
              "mouse": {
                "action": "wheel",
                "button": "wheel_up",
                "row": 0,
                "col": 0,
                "mods": [],
                "notches": 0
              }
            }
          }
        }
      },
      "bind": "$x",
      "expect_error": {
        "code": {
          "InvalidInput": {}
        }
      },
      "because": [
        "Core 9.3",
        "Core 5.1A"
      ]
    },
    {
      "begin": {
        "op": {
          "WriteInput": {
            "session": "s1",
            "payload": {
              "mouse": {
                "action": "press",
                "button": "left",
                "row": 0,
                "col": 0,
                "mods": [],
                "notches": 2
              }
            }
          }
        }
      },
      "bind": "$x",
      "expect_error": {
        "code": {
          "InvalidInput": {}
        }
      },
      "because": [
        "Core 9.3",
        "Core 5.1A"
      ]
    },
    {
      "begin": {
        "op": {
          "WriteInput": {
            "session": "s1",
            "payload": {
              "mouse": {
                "action": "wheel",
                "button": "left",
                "row": 0,
                "col": 0,
                "mods": []
              }
            }
          }
        }
      },
      "bind": "$x",
      "expect_error": {
        "code": {
          "InvalidInput": {}
        }
      },
      "because": [
        "Core 9.3",
        "Core 5.1A"
      ]
    },
    {
      "begin": {
        "op": {
          "WriteInput": {
            "session": "s1",
            "payload": {
              "key": {
                "key": {
                  "char": "a"
                },
                "mods": [],
                "event": "press",
                "text": "a",
                "shifted_key": {
                  "char": "A"
                }
              }
            }
          }
        }
      },
      "bind": "$x",
      "expect_error": {
        "code": {
          "InvalidInput": {}
        }
      },
      "because": [
        "Core 9.3",
        "Core 5.1A"
      ]
    },
    {
      "pump": {}
    },
    {
      "poll_events": {
        "max": 64
      },
      "expect": [],
      "because": "Core 9.3"
    }
  ]
}

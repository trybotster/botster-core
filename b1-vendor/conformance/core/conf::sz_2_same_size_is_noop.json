{
  "id": "conf::sz_2_same_size_is_noop",
  "contract": "core",
  "clause": "SZ-2",
  "subject": "core",
  "steps": [
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s1",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ]
            }
          }
        }
      },
      "bind": "$c_s1"
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "s1"
          }
        }
      },
      "bind": "$s_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$s_s1",
            "result": {}
          }
        }
      },
      "because": "Core LC-3"
    },
    {
      "begin": {
        "op": {
          "Resize": {
            "session": "s1",
            "size": {
              "rows": 24,
              "cols": 80
            }
          }
        }
      },
      "bind": "$z"
    },
    {
      "pump": {}
    },
    {
      "poll_events": {
        "max": 64
      },
      "expect": [
        {
          "Completed": {
            "op": "$z",
            "result": {
              "ok": {
                "resize": {
                  "Applied": {
                    "actual": {
                      "rows": 24,
                      "cols": 80
                    }
                  }
                }
              }
            }
          }
        }
      ],
      "because": [
        "Core SZ-2"
      ]
    },
    {
      "begin": {
        "op": {
          "Resize": {
            "session": "s1",
            "size": {
              "rows": 30,
              "cols": 100
            }
          }
        }
      },
      "bind": "$z2"
    },
    {
      "expect_quiet_until": {
        "SizeChanged": {
          "size": {
            "rows": 24,
            "cols": 80
          }
        }
      },
      "barrier": {
        "pump": {}
      },
      "until": {
        "Completed": {
          "op": "$z2",
          "result": {
            "ok": {
              "resize": {
                "Applied": {
                  "actual": {
                    "rows": 30,
                    "cols": 100
                  }
                }
              }
            }
          }
        }
      },
      "because": "Core SZ-2"
    }
  ]
}

        "op": "service_connect",
        "service": "1111111111111111111111111111111111111111111111111111111111111111",
        "epoch": 1,
        "lanes": [
          0
        ]
      }
    },
    {
      "control": {
        "op": "service_send_frame",
        "service": "1111111111111111111111111111111111111111111111111111111111111111",
        "lane": 0,
        "type": 1,
        "payload_hex": "a1"
      }
    },
    {
      "await_quiet": {}
    },
    {
      "await_quiet": {}
    },
    {
      "expect_quiet_until": {
        "ServiceState": {
          "id": "1111111111111111111111111111111111111111111111111111111111111111",
          "state": {
            "Reconnected": {
              "epoch": {
                "$any": true
              }
            }
          }
        }
      },
      "barrier": {
        "begin": {
          "op": {
            "Create": {
              "session": "fence1",
              "request": {
                "program": [
                  {
                    "hold": {}
                  }
                ]
              }
            }
          }
        },
        "bind": "$bar1"
      },
      "until": {
        "Completed": {
          "op": "$bar1",
          "result": {
            "ok": {
              "record": {
                "id": "fence1",
                "state": "Created"
              }
            }
          }
        }
      },
      "because": [
        "Core SV-6"
      ]
    },
    {
      "call": {
        "method": "service_send",
        "args": {
          "id": "1111111111111111111111111111111111111111111111111111111111111111",
          "lane": 0,
          "type": 1,
          "payload_hex": "aa"

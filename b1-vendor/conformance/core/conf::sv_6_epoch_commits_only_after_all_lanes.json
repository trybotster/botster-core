    },
    {
      "call": {
        "method": "service_recv",
        "args": {
          "id": "1111111111111111111111111111111111111111111111111111111111111111",
          "lane": 0
        }
      },
      "expect": {
        "ok": null
      },
      "because": [
        "Core SV-6"
      ]
    },
    {
      "control": {
        "op": "service_connect",
        "service": "1111111111111111111111111111111111111111111111111111111111111111",
        "epoch": 1,
        "lanes": [
          1
        ]
      }
    },
    {
      "pump_until": {
        "event": {
          "ServiceState": {
            "id": "1111111111111111111111111111111111111111111111111111111111111111",
            "state": {
              "Reconnected": {
                "epoch": 1
              }
            }
          }
        }
      },
      "because": [
        "Core SV-6"
      ]
    },
    {
      "call": {
        "method": "service_send",
        "args": {
          "id": "1111111111111111111111111111111111111111111111111111111111111111",
          "lane": 0,
          "type": 1,
          "payload_hex": "aa"
        }
      },
      "expect": {
        "ok": null
      },
      "because": [
        "Core SV-6"
      ]

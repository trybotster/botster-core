    {
      "pump_collect": {
        "events": [
          {
            "Completed": {
              "op": "$o1",
              "result": {
                "ok": {
                  "spawn": {
                    "applied": {
                      "$type": "array"
                    },
                    "unsupported": {
                      "$type": "array"
                    }
                  }
                }
              }
            }
          },
          {
            "ServiceState": {
              "id": "1111111111111111111111111111111111111111111111111111111111111111",
              "state": "Started"
            }

{
  "id": "conf::tm_1_deadlines_use_monotonic",
  "contract": "core",
  "clause": "TM-1",
  "subject": "core",
  "requires": {
    "features": [
      "silence"
    ],
    "controls": [
      "pty_output"
    ]
  },
  "fake": "structural",
  "ruling": "R-12",
  "steps": [
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s1",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ]
            }
          }
        }
      },
      "bind": "$c_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$c_s1",
            "result": {
              "ok": {
                "record": {
                  "id": "s1",
                  "state": "Created"
                }
              }
            }
          }
        }
      },
      "because": "Core LC-3"
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "s1"
          }
        }
      },
      "bind": "$s_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$s_s1",
            "result": {
              "ok": {
                "record": {
                  "id": "s1",
                  "state": "Running"
                }
              }
            }
          }
        }
      },
      "because": "Core A2-1"
    },
    {
      "drain": {}
    },
    {
      "advance_clock": {
        "unix": 7000
      }
    },
    {
      "control": {
        "op": "pty_output",
        "session": "s1",
        "bytes_hex": "78"
      }
    },
    {
      "pump_until": {
        "event": {
          "Activity": {
            "id": "s1",
            "source": "Output",
            "at": 7000
          }
        }
      },
      "because": [
        "Core 6.2",
        "Core TM-1"
      ]
    },
    {
      "call": {
        "method": "set_silence_threshold",
        "args": {
          "id": "s1",
          "ms": 1000
        }
      }
    },
    {
      "drain": {}
    },
    {
      "call": {
        "method": "terminal_state",
        "args": {
          "id": "s1"
        }
      },
      "expect": {
        "last_output_at": 7000
      },
      "because": [
        "Core ST-4",
        "Core TM-1"
      ]
    },
    {
      "advance_clock": {
        "unix": 1
      }
    },
    {
      "expect_quiet_until": {
        "Silent": {
          "id": "s1"
        }
      },
      "barrier": {
        "begin": {
          "op": {
            "UpdateMetadata": {
              "id": "s1",
              "labels": {
                "b": "1"
              }
            }
          }
        },
        "bind": "$bar_s1"
      },
      "until": {
        "Completed": {
          "op": "$bar_s1",
          "result": {
            "ok": "unit"
          }
        }
      },
      "because": [
        "Core TM-1",
        "Core TM-4"
      ]
    },
    {
      "advance_clock": {
        "unix": 9000000000000
      }
    },
    {
      "expect_quiet_until": {
        "Silent": {
          "id": "s1"
        }
      },
      "barrier": {
        "begin": {
          "op": {
            "UpdateMetadata": {
              "id": "s1",
              "labels": {
                "b": "1"
              }
            }
          }
        },
        "bind": "$bar_s1"
      },
      "until": {
        "Completed": {
          "op": "$bar_s1",
          "result": {
            "ok": "unit"
          }
        }
      },
      "because": [
        "Core TM-1",
        "Core TM-4"
      ]
    },
    {
      "advance_clock": {
        "ms": 1000
      }
    },
    {
      "pump_until": {
        "event": {
          "Silent": {
            "id": "s1",
            "since": {
              "$type": "integer"
            }
          }
        }
      },
      "because": [
        "Core TM-1",
        "Core TM-4"
      ]
    }
  ]
}

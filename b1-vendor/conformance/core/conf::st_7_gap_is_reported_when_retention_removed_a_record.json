{
  "id": "conf::st_7_gap_is_reported_when_retention_removed_a_record",
  "contract": "core",
  "clause": "ST-7",
  "subject": "core",
  "setup": {
    "limits": {
      "input_events_kept": 2
    }
  },
  "fake": "structural",
  "ruling": "R-12",
  "steps": [
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s1",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ],
              "size": {
                "rows": 10,
                "cols": 40
              }
            }
          }
        }
      },
      "bind": "$c_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$c_s1",
            "result": {
              "ok": {
                "record": {
                  "id": "s1",
                  "state": "Created"
                }
              }
            }
          }
        }
      },
      "because": "Core LC-3"
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "s1"
          }
        }
      },
      "bind": "$s_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$s_s1",
            "result": {
              "ok": {
                "record": {
                  "id": "s1",
                  "state": "Running"
                }
              }
            }
          }
        }
      },
      "because": "Core A2-1"
    },
    {
      "begin": {
        "op": {
          "WriteInput": {
            "session": "s1",
            "payload": {
              "bytes": {
                "bytes": {
                  "$bytes_hex": "31"
                }
              }
            }
          }
        }
      },
      "bind": "$w1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$w1",
            "result": {
              "ok": {
                "input": {
                  "outcome": {
                    "$any": true
                  }
                }
              }
            }
          }
        }
      },
      "because": "Core IN-2"
    },
    {
      "begin": {
        "op": {
          "ReadFacts": {
            "session": "s1"
          }
        }
      },
      "bind": "$f1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$f1",
            "result": {
              "ok": {
                "facts": {
                  "input": {
                    "next_cursor": "$n1"
                  }
                }
              }
            }
          }
        }
      },
      "because": "Core ST-7"
    },
    {
      "begin": {
        "op": {
          "WriteInput": {
            "session": "s1",
            "payload": {
              "bytes": {
                "bytes": {
                  "$bytes_hex": "32"
                }
              }
            }
          }
        }
      },
      "bind": "$w2"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$w2",
            "result": {
              "ok": {
                "input": {
                  "outcome": {
                    "$any": true
                  }
                }
              }
            }
          }
        }
      },
      "because": "Core IN-2"
    },
    {
      "begin": {
        "op": {
          "WriteInput": {
            "session": "s1",
            "payload": {
              "bytes": {
                "bytes": {
                  "$bytes_hex": "33"
                }
              }
            }
          }
        }
      },
      "bind": "$w3"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$w3",
            "result": {
              "ok": {
                "input": {
                  "outcome": {
                    "$any": true
                  }
                }
              }
            }
          }
        }
      },
      "because": "Core IN-2"
    },
    {
      "begin": {
        "op": {
          "ReadFacts": {
            "session": "s1",
            "after": "$n1"
          }
        }
      },
      "bind": "$f2"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$f2",
            "result": {
              "ok": {
                "facts": {
                  "input": {
                    "gap": true,
                    "input_records": {
                      "$array": {
                        "each": {
                          "$any": true
                        },
                        "max": 2
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "because": "Core ST-7"
    }
  ]
}

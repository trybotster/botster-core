{
  "id": "conf::in_6_cancel_reports_progress",
  "contract": "core",
  "clause": "IN-6",
  "subject": "core",
  "requires": {
    "controls": [
      "pty_blocked",
      "pty_queued",
      "pty_input"
    ]
  },
  "fake": "structural",
  "ruling": "R-74",
  "steps": [
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s1",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ]
            }
          }
        }
      },
      "bind": "$c_s1"
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "s1"
          }
        }
      },
      "bind": "$s_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$s_s1",
            "result": {}
          }
        }
      },
      "because": "Core LC-3"
    },
    {
      "control": {
        "op": "pty_blocked",
        "session": "s1",
        "on": true,
        "kernel_bytes": 1
      }
    },
    {
      "let": {
        "$fill": {
          "repeat": [
            "61",
            40960
          ]
        }
      }
    },
    {
      "begin": {
        "op": {
          "WriteInput": {
            "session": "s1",
            "payload": {
              "bytes": {
                "bytes": {
                  "$bytes_hex": "$fill"
                }
              }
            }
          }
        }
      },
      "bind": "$w"
    },
    {
      "await_control": {
        "control": {
          "op": "pty_queued",
          "session": "s1"
        },
        "expect": {
          "bytes": {
            "$between": [
              1,
              40960
            ]
          }
        }
      }
    },
    {
      "call": {
        "method": "cancel",
        "args": {
          "op": "$w"
        }
      },
      "expect": "Admitted",
      "because": "Core IN-6"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$w",
            "result": {
              "ok": {
                "input": {
                  "outcome": {
                    "$one_of": [
                      "Partial",
                      "Cancelled"
                    ]
                  },
                  "payload_bytes_written": "$p",
                  "pty_bytes_written": "$q"
                }
              }
            }
          }
        }
      },
      "because": "Core IN-6"
    },
    {
      "control": {
        "op": "pty_blocked",
        "session": "s1",
        "on": false
      }
    },
    {
      "await_pty": {
        "session": "s1",
        "min_bytes": "$p"
      }
    },
    {
      "control": {
        "op": "pty_input",
        "session": "s1"
      },
      "expect": {
        "bytes": "$log"
      },
      "because": "Core IN-6"
    },
    {
      "check": {
        "hex_len_eq": [
          "$log",
          "$p"
        ]
      },
      "because": "Core IN-6"
    },
    {
      "check": {
        "eq": [
          "$p",
          "$q"
        ]
      },
      "because": "Core IN-6"
    }
  ]
}

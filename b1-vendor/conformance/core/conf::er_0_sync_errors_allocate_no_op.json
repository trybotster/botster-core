{
  "id": "conf::er_0_sync_errors_allocate_no_op",
  "contract": "core",
  "clause": "ER-0",
  "subject": "core",
  "setup": {
    "limits": {
      "pending_ops": 1
    }
  },
  "steps": [
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s1",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ]
            }
          }
        }
      },
      "bind": "$c"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$c",
            "result": {}
          }
        }
      },
      "because": "Core ER-0"
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "s9"
          }
        }
      },
      "bind": "$x",
      "expect_error": {
        "code": "UnknownSession"
      },
      "because": "Core ER-0"
    },
    {
      "expect_quiet_until": {
        "$one_of": [
          {
            "SessionState": {
              "id": "s9"
            }
          },
          {
            "Completed": {
              "result": {
                "err": {
                  "code": "UnknownSession"
                }
              }
            }
          }
        ]
      },
      "barrier": {
        "begin": {
          "op": {
            "Create": {
              "session": "s2",
              "request": {
                "program": [
                  {
                    "hold": {}
                  }
                ]
              }
            }
          }
        },
        "bind": "$c2"
      },
      "until": {
        "Completed": {
          "op": "$c2",
          "result": {}
        }
      },
      "because": [
        "Core ER-0",
        "Core OR-1"
      ]
    }
  ]
}

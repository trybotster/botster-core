    },
    {
      "await_quiet": {}
    },
    {
      "pump_collect": {
        "events": [
          {
            "SessionState": {
              "id": "s1",
              "state": "Created"
            }
          },
          {
            "SessionState": {
              "id": "s1",
              "state": "Starting"
            }
          },
          {
            "SessionState": {
              "id": "s1",
              "state": "Running"

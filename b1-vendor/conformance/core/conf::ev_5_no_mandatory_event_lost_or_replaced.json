                    "state": "Created"
                  }
                }
              }
            }
          },
          {
            "Completed": {
              "op": "$s_s1",
              "result": {
                "ok": {
                  "record": {
                    "id": "s1",
                    "state": "Running"
                  }
                }
              }
            }
          }
        ]
      },
      "because": [
        "Core EV-5",
        "Core OR-2"
      ]
    },
    {
      "begin": {
        "op": {
          "Stop": {
            "id": "s1"
          }
        }
      },
      "bind": "$p"

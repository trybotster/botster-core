{
  "id": "conf::lc_2_data_dir_is_exclusive",
  "contract": "core",
  "clause": "LC-2",
  "subject": "core",
  "setup": {
    "open": false
  },
  "steps": [
    {
      "data_dir": "d"
    },
    {
      "open": {
        "as": "a",
        "data_dir": "d"
      }
    },
    {
      "open": {
        "as": "b",
        "data_dir": "d"
      },
      "expect_error": {
        "code": "DataDirInUse"
      },
      "because": "Core LC-2"
    },
    {
      "call": {
        "method": "list",
        "handle": "a"
      },
      "expect": [],
      "because": "Core LC-2"
    },
    {
      "drop": {
        "handle": "a"
      }
    },
    {
      "open": {
        "as": "c",
        "data_dir": "d"
      }
    }
  ]
}

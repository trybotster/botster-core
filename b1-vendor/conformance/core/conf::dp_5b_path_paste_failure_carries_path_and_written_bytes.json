{
  "id": "conf::dp_5b_path_paste_failure_carries_path_and_written_bytes",
  "contract": "core",
  "clause": "DP-5b",
  "subject": "core",
  "requires": {
    "controls": [
      "edges_quiet",
      "fs_directory",
      "fs_list",
      "payload_alive",
      "pty_blocked",
      "pty_input",
      "pty_output"
    ]
  },
  "fake": "structural",
  "ruling": "R-12",
  "steps": [
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s1",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ]
            }
          }
        }
      },
      "bind": "$c_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$c_s1",
            "result": {
              "ok": {
                "record": {
                  "id": "s1",
                  "state": "Created"
                }
              }
            }
          }
        }
      },
      "because": "Core LC-3"
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "s1"
          }
        }
      },
      "bind": "$s_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$s_s1",
            "result": {
              "ok": {
                "record": {
                  "id": "s1",
                  "state": "Running"
                }
              }
            }
          }
        }
      },
      "because": "Core A2-1"
    },
    {
      "control": {
        "op": "fs_directory"
      },
      "bind_fields": {
        "path": "$dir",
        "name_max": "$name_max"
      }
    },
    {
      "attach_route": {
        "route": "r1",
        "session": "s1",
        "client": "c1",
        "options": {
          "history": "none",
          "file_directory": "$dir"
        }
      },
      "because": "Core OU-1"
    },
    {
      "expect": {
        "frame": "attached",
        "terminal_format": {
          "$type": "string"
        }
      },
      "because": "Core OU-9",
      "on": "r1"
    },
    {
      "expect": {
        "frame": "baseline_begin",
        "rows": {
          "$type": "integer"
        },
        "cols": {
          "$type": "integer"
        },
        "modes": {
          "$type": "object"
        }
      },
      "because": "Core OU-9",
      "on": "r1"
    },
    {
      "expect": {
        "frame": "screen",
        "payload": {
          "$any": true
        }
      },
      "because": "Core OU-9",
      "on": "r1"
    },
    {
      "expect_eventually": {
        "frame": "baseline_end",
        "history": "not_requested"
      },
      "because": "Core OU-9",
      "ignore": [
        {
          "frame": "history",
          "payload": {
            "$any": true
          }
        }
      ],
      "on": "r1"
    },
    {
      "expect": {
        "frame": "live"
      },
      "because": "Core OU-9",
      "on": "r1"
    },
    {
      "control": {
        "op": "pty_blocked",
        "session": "s1",
        "on": true
      }
    },
    {
      "route_send": {
        "frame": "input",
        "kind": "file_begin",
        "op": "1",
        "name": "gone.txt"
      }
    },
    {
      "route_send": {
        "frame": "file_chunk",
        "op": "1",
        "bytes": {
          "$bytes_hex": ""
        }
      }
    },
    {
      "route_send": {
        "frame": "input",
        "kind": "file_commit",
        "op": "1"
      }
    },
    {
      "await_quiet": {}
    },
    {
      "control": {
        "op": "fs_list",
        "path": "$dir"
      },
      "expect": {
        "files": [
          {
            "path": "$p1",
            "size": 500
          }
        ]
      },
      "because": [
        "Core DP-5b"
      ]
    },
    {
      "control": {
        "op": "pty_input",
        "session": "s1"
      },
      "expect": {
        "bytes": {
          "$bytes_hex": ""
        }
      },
      "because": [
        "Core DP-5b"
      ]
    },
    {
      "begin": {
        "op": {
          "Signal": {
            "id": "s1",
            "sig": "kill"
          }
        }
      },
      "bind": "$kill"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$kill",
            "result": {
              "ok": "unit"
            }
          }
        }
      },
      "because": [
        "Core A2-1",
        "Core LC-5"
      ]
    },
    {
      "await_control": {
        "control": {
          "op": "payload_alive",
          "session": "s1"
        },
        "expect": {
          "alive": false
        }
      },
      "because": [
        "Core LC-5",
        "Core A2-1"
      ]
    },
    {
      "control": {
        "op": "pty_blocked",
        "session": "s1",
        "on": false
      }
    },
    {
      "expect_eventually": {
        "frame": "input_refused",
        "op": "1",
        "reason": {
          "$one_of": [
            "session_ended",
            "failed"
          ]
        },
        "path": "$p1",
        "written_bytes": {
          "$one_of": [
            {
              "$absent": true
            },
            0
          ]
        }
      },
      "because": [
        "Core DP-5b",
        "Core IN-2"
      ],
      "ignore": [
        {
          "frame": "modes"
        },
        {
          "frame": "output"
        },
        {
          "frame": "output_deflate"
        }
      ],
      "on": "r1"
    },
    {
      "control": {
        "op": "fs_list",
        "path": "$dir"
      },
      "expect": {
        "files": [
          {
            "path": "$p1",
            "size": 500
          }
        ]
      },
      "because": [
        "Core DP-5b"
      ]
    },
    {
      "await_quiet": {}
    },
    {
      "control": {
        "op": "pty_input",
        "session": "s1"
      },
      "bind_fields": {
        "bytes": "$in"
      }
    },
    {
      "control": {
        "op": "pty_input",
        "session": "s1"
      },
      "expect": {
        "bytes": {
          "$bytes_hex": ""
        }
      },
      "because": [
        "Core DP-5b",
        "Core IN-2"
      ]
    },
    {
      "control": {
        "op": "fs_list",
        "path": "$dir"
      },
      "expect": {
        "files": [
          {
            "path": "$p1",
            "path_space_hex": "$psh"
          }
        ]
      },
      "because": [
        "Core DP-5b"
      ]
    },
    {
      "check": {
        "hex_prefix": [
          "$in",
          "$psh"
        ]
      },
      "because": [
        "Core DP-5b"
      ]
    }
  ]
}

{
  "id": "conf::lc_7_remove_running_is_wrong_state",
  "contract": "core",
  "clause": "LC-7",
  "subject": "core",
  "steps": [
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s1",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ]
            }
          }
        }
      },
      "bind": "$c_s1"
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "s1"
          }
        }
      },
      "bind": "$s_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$s_s1",
            "result": {}
          }
        }
      },
      "because": "Core LC-3"
    },
    {
      "begin": {
        "op": {
          "Remove": {
            "id": "s1"
          }
        }
      },
      "bind": "$r",
      "expect_error": {
        "code": "WrongState"
      },
      "because": [
        "Core LC-7",
        "Core ER-0"

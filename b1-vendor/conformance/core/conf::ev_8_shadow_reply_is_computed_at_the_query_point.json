{
  "id": "conf::ev_8_shadow_reply_is_computed_at_the_query_point",
  "contract": "core",
  "clause": "EV-8",
  "subject": "core",
  "requires": {
    "controls": [
      "edges_quiet",
      "oracle_query_reply",
      "pty_input",
      "pty_output"
    ]
  },
  "fake": "structural",
  "ruling": "R-12",
  "steps": [
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s1",
            "request": {
              "program": [
                {
                  "hold": {}
                }
              ]
            }
          }
        }
      },
      "bind": "$c_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$c_s1",
            "result": {
              "ok": {
                "record": {
                  "id": "s1",
                  "state": "Created"
                }
              }
            }
          }
        }
      },
      "because": "Core LC-3"
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "s1"
          }
        }
      },
      "bind": "$s_s1"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$s_s1",
            "result": {
              "ok": {
                "record": {
                  "id": "s1",
                  "state": "Running"
                }
              }
            }
          }
        }
      },
      "because": "Core A2-1"
    },
    {
      "attach_route": {
        "route": "r1",
        "session": "s1",
        "client": "c1",
        "options": {
          "history": "none",
          "answers_queries": true,
          "query_deadline": 300
        }
      },
      "because": "Core OU-1"
    },
    {
      "expect": {
        "frame": "attached",
        "terminal_format": {
          "$type": "string"
        }
      },
      "because": "Core OU-9",
      "on": "r1"
    },
    {
      "expect": {
        "frame": "baseline_begin",
        "rows": {
          "$type": "integer"
        },
        "cols": {
          "$type": "integer"
        },
        "modes": {
          "$type": "object"
        }
      },
      "because": "Core OU-9",
      "on": "r1"
    },
    {
      "expect": {
        "frame": "screen",
        "payload": {
          "$any": true
        }
      },
      "because": "Core OU-9",
      "on": "r1"
    },
    {
      "expect_eventually": {
        "frame": "baseline_end",
        "history": "not_requested"
      },
      "because": "Core OU-9",
      "ignore": [
        {
          "frame": "history",
          "payload": {
            "$any": true
          }
        }
      ],
      "on": "r1"
    },
    {
      "expect": {
        "frame": "live"
      },
      "because": "Core OU-9",
      "on": "r1"
    },
    {
      "control": {
        "op": "oracle_query_reply",
        "session": "s1",
        "request_hex": "1b5b366e",
        "prefix_hex": "6162"
      },
      "bind": "$or_sh"
    },
    {
      "let": {
        "$ans_sh": {
          "field": [
            "$or_sh",
            "answerable"
          ]
        }
      }
    },
    {
      "assume": {
        "eq": [
          "$ans_sh",
          true
        ]
      },
      "because": [
        "Core EV-8"
      ]
    },
    {
      "let": {
        "$sh": {
          "field": [
            "$or_sh",
            "reply_hex"
          ]
        }
      }
    },
    {
      "control": {
        "op": "oracle_query_reply",
        "session": "s1",
        "request_hex": "1b5b366e",
        "prefix_hex": "61620d0a0a0a636364"
      },
      "bind": "$or_later"
    },
    {
      "let": {
        "$ans_later": {
          "field": [
            "$or_later",
            "answerable"
          ]
        }
      }
    },
    {
      "assume": {
        "eq": [
          "$ans_later",
          true
        ]
      },
      "because": [
        "Core EV-8"
      ]
    },
    {
      "let": {
        "$later": {
          "field": [
            "$or_later",
            "reply_hex"
          ]
        }
      }
    },
    {
      "assume": {
        "ne": [
          "$sh",
          "$later"
        ]
      },
      "because": [
        "Core EV-8"
      ]
    },
    {
      "control": {
        "op": "pty_output",
        "session": "s1",
        "bytes_hex": "61621b5b366e0d0a0a0a636364"
      }
    },
    {
      "await_quiet": {}
    },
    {
      "expect_eventually": {
        "frame": "terminal_query",
        "query_id": "$q"
      },
      "because": [
        "Core EV-8",
        "Core DP-3"
      ],
      "ignore": [
        {
          "$any": true
        }
      ],
      "on": "r1"
    },
    {
      "real_wait": {
        "ms": 1200
      }
    },
    {
      "await_quiet": {}
    },
    {
      "control": {
        "op": "pty_input",
        "session": "s1"
      },
      "bind_fields": {
        "bytes": "$in"
      }
    },
    {
      "let": {
        "$n_sh": {
          "hex_len": [
            "$sh",
            0
          ]
        }
      }
    },
    {
      "check": {
        "hex_prefix": [
          "$sh",
          "$in"
        ]
      },
      "because": [
        "Core EV-8",
        "Core ST-3"
      ]
    },
    {
      "check": {
        "hex_len_eq": [
          "$in",
          "$n_sh"
        ]
      },
      "because": [
        "Core EV-8",
        "Core ST-3"
      ]
    }
  ]
}

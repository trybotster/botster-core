{
  "id": "conf::lc_4_start_failure_is_typed",
  "contract": "core",
  "clause": "LC-4",
  "subject": "core",
  "steps": [
    {
      "begin": {
        "op": {
          "Create": {
            "session": "s1",
            "request": {
              "cwd": "/botster-no-such-cwd",
              "program": [
                {
                  "hold": {}
                }
              ]
            }
          }
        }
      },
      "bind": "$c"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$c",
            "result": {}
          }
        }
      },
      "because": "Core LC-3"
    },
    {
      "begin": {
        "op": {
          "Start": {
            "id": "s1"
          }
        }
      },
      "bind": "$s"
    },
    {
      "expect_eventually": {
        "SessionState": {
          "id": "s1",
          "state": {
            "$one_of": [
              {
                "Exited": {
                  "$any": true
                }
              },
              {
                "Lost": {
                  "$any": true
                }
              }
            ]
          }
        }
      },
      "because": "Core LC-4",
      "ignore": [
        {
          "SessionState": {
            "id": "s1",
            "state": "Starting"
          }
        }
      ]
    },
    {
      "expect": {
        "Completed": {
          "op": "$s",
          "result": {
            "err": {
              "code": {
                "StartFailed": "CwdMissing"
              }
            }
          }
        }
      },
      "because": [
        "Core LC-4",
        "Core A2-1",
        "Core OR-2"
      ]
    },
    {
      "call": {
        "method": "get",
        "args": {
          "id": "s1"
        }
      },
      "expect": {
        "state": {
          "$one_of": [
            {
              "Exited": {
                "$any": true
              }
            },
            {
              "Lost": {
                "$any": true
              }
            }
          ]
        }
      },
      "because": "Core LC-4"
    }
  ]
}

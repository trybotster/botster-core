{
  "id": "conf::er_service_limit",
  "contract": "core",
  "clause": "ER-0",
  "subject": "core",
  "setup": {
    "limits": {
      "max_services": 1
    }
  },
  "steps": [
    {
      "begin": {
        "op": {
          "SpawnService": {
            "service_id": "0101010101010101010101010101010101010101010101010101010101010101"
          }
        }
      },
      "bind": "$a"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$a",
            "result": {}
          }
        }
      },
      "because": "Core SV-1"
    },
    {
      "begin": {
        "op": {
          "SpawnService": {
            "service_id": "0202020202020202020202020202020202020202020202020202020202020202"
          }
        }
      },
      "bind": "$b",
      "expect_error": {
        "code": "ServiceLimit"
      },
      "because": "Core ER-0"
    },
    {
      "begin": {
        "op": {
          "StopService": {
            "id": "0101010101010101010101010101010101010101010101010101010101010101"
          }
        }
      },
      "bind": "$st"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$st",
            "result": {}
          }
        }
      },
      "because": "Core SV-9"
    },
    {
      "begin": {
        "op": {
          "RemoveService": {
            "id": "0101010101010101010101010101010101010101010101010101010101010101"
          }
        }
      },
      "bind": "$rm"
    },
    {
      "pump_until": {
        "event": {
          "ServiceState": {
            "id": "0101010101010101010101010101010101010101010101010101010101010101",
            "state": "Released"
          }
        }
      },
      "because": "Core ER-0"
    },
    {
      "begin": {
        "op": {
          "SpawnService": {
            "service_id": "0202020202020202020202020202020202020202020202020202020202020202"
          }
        }
      },
      "bind": "$b"
    },
    {
      "pump_until": {
        "event": {
          "Completed": {
            "op": "$b",
            "result": {}
          }
        }
      },
      "because": "Core ER-0"
    }
  ]
}

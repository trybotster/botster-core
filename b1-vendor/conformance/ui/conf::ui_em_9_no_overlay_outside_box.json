{
  "id": "conf::ui_em_9_no_overlay_outside_box",
  "contract": "ui",
  "clause": "UI-EM-9",
  "subject": "client",
  "setup": {
    "admission": {
      "kinds": {
        "botster-graph.node": {
          "projection_allowlist": [
            "/label",
            "/count"
          ],
          "owner": "botster-graph"
        }
      },
      "handlers": {
        "drop": {
          "schema": {
            "type": "object"
          }
        }
      },
      "package": "botster-graph",
      "views": []
    },
    "app_origin": "https://app.example.test"
  },
  "steps": [
    {
      "client_load": {
        "document": {
          "ui_contract_view": "1.4",
          "id": "graph",
          "title": "Graph",
          "requires": [
            "ui_embed"
          ],
          "root": {
            "type": "stack",
            "id": "root",
            "direction": "column",
            "children": [
              {
                "type": "actions",
                "id": "tools",
                "items": [
                  {
                    "id": "act_drop",
                    "label": "Drop",
                    "handler": "drop",
                    "confirm": {
                      "message": "Drop it?",
                      "tone": "danger"
                    }
                  }
                ]
              },
              {
                "type": "embed",
                "id": "page",
                "title": "Knowledge graph",
                "page": {
                  "asset": {
                    "name": "graph"
                  }
                },
                "empty": {
                  "title": "No page"
                },
                "error": {
                  "title": "Page unavailable"
                },
                "channel": {
                  "from_page": [
                    {
                      "type": "drop",
                      "invoke": "act_drop"
                    }
                  ]
                }
              }
            ]
          }
        },
        "capabilities": {
          "ui_contract_view": [
            "1.4"
          ],
          "features": [
            "ui_embed",
            "embed"
          ]
        }
      }
    },
    {
      "client_expect": {
        "observation": {
          "request_sent": {
            "action": "open_asset",
            "count": 1,
            "target": "botster-graph",
            "args": {
              "name": "graph"
            }
          }
        },
        "because": "UI UI-EM-7"
      }
    },
    {
      "client_act": {
        "action": {
          "hub_result": {
            "request": 1,
            "ok": {
              "url": "https://assets.example.test:7443/botster-graph/ast_1?t=TOKEN_SENTINEL_1",
              "expires_at": 1790840000001
            }
          }
        }
      }
    },
    {
      "client_act": {
        "action": {
          "frame_load": {}
        },
        "node_id": "page"
      }
    },
    {
      "client_expect": {
        "observation": {
          "frame": {
            "loaded": true,
            "confined_to_box": true,
            "bordered": true
          }
        },
        "because": "UI UI-EM-9",
        "node_id": "page"
      }
    },
    {
      "client_act": {
        "action": {
          "page_message": {
            "via": "port",
            "type": "drop",
            "payload": {}
          }
        }
      }
    },
    {
      "client_expect": {
        "observation": {
          "dialog": {
            "kind": "confirm",
            "inside_frame": false
          }
        },
        "because": "UI UI-EM-9",
        "node_id": "act_drop"
      }
    }
  ]
}

{
  "id": "conf::ui_em_12_guarantee_text_is_narrow",
  "contract": "ui",
  "clause": "UI-EM-12",
  "subject": "client",
  "setup": {
    "admission": {
      "kinds": {
        "botster-graph.node": {
          "projection_allowlist": [
            "/label",
            "/count"
          ],
          "owner": "botster-graph"
        }
      },
      "handlers": {},
      "package": "botster-graph",
      "views": []
    },
    "app_origin": "https://app.example.test"
  },
  "steps": [
    {
      "client_load": {
        "document": {
          "ui_contract_view": "1.4",
          "id": "graph",
          "title": "Graph",
          "requires": [
            "ui_embed"
          ],
          "root": {
            "type": "embed",
            "id": "page",
            "title": "Knowledge graph",
            "page": {
              "asset": {
                "name": "graph"
              }
            },
            "empty": {
              "title": "No page"
            },
            "error": {
              "title": "Page unavailable"
            },
            "channel": {
              "to_page": [
                {
                  "type": "rows",
                  "source": {
                    "kind": "botster-graph.node"
                  },
                  "fields": [
                    "/label",
                    "/count"
                  ],
                  "on": "change"
                }
              ]
            }
          }
        },
        "capabilities": {
          "ui_contract_view": [
            "1.4"
          ],
          "features": [
            "ui_embed",
            "embed"
          ]
        },
        "kind_snapshots": {
          "botster-graph.node": {
            "baseline": true,
            "rows": [
              {
                "id": "n1",
                "label": "A"
              }
            ]
          }
        }
      }
    },
    {
      "client_expect": {
        "observation": {
          "request_sent": {
            "action": "open_asset",
            "count": 1,
            "target": "botster-graph",
            "args": {
              "name": "graph"
            }
          }
        },
        "because": "UI UI-EM-7"
      }
    },
    {
      "client_act": {
        "action": {
          "hub_result": {
            "request": 1,
            "ok": {
              "url": "https://assets.example.test:7443/botster-graph/ast_1?t=TOKEN_SENTINEL_1",
              "expires_at": 1790840000001
            }
          }
        }
      }
    },
    {
      "client_act": {
        "action": {
          "frame_load": {}
        }
      }
    },
    {
      "client_expect": {
        "observation": {
          "channel": "open"
        },
        "because": "UI UI-EM-5",
        "node_id": "page"
      }
    },
    {
      "client_expect": {
        "observation": {
          "frame": {
            "loaded": true,
            "src_origin": "distinct_from_app"
          }
        },
        "because": "UI UI-EM-11",
        "node_id": "page"
      }
    },
    {
      "client_expect": {
        "observation": {
          "frame": {
            "loaded": true,
            "carries_app_credentials": false
          }
        },
        "because": "UI UI-EM-12",
        "node_id": "page"
      }
    },
    {
      "client_act": {
        "action": {
          "frame_load": {}
        },
        "node_id": "page"
      }
    },
    {
      "client_expect": {
        "observation": {
          "channel": "closed"
        },
        "because": "UI UI-EM-12",
        "node_id": "page"
      }
    }
  ]
}

            "/id",
            "/name"
          ]
        }
      },
      "handlers": {
        "restart": {
          "schema": {
            "type": "object",
            "required": [
              "workspace_id"
            ],
            "properties": {
              "workspace_id": {
                "type": "string"
              }
            }
          }
        }
      },
      "package": "pkg",
      "views": [
        "ops"
      ],
      "features": [
        "ui_1_1",
        "ui_embed",
        "ui_1_3",
        "ui_1_4"
      ]
    }
  },
  "steps": [
    {
      "client_load": {
        "document": {
          "ui_contract_view": "1.4",

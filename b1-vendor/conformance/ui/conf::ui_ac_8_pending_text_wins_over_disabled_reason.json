              }
            ]
          }
        },
        "kind_snapshots": {
          "ws": {
            "baseline": true,
            "rows": [
              {
                "id": "w1",
                "name": "Alpha"
              }
            ]
          }
        },
        "local_state": {
          "selections": {
            "sel_ws": "w1"
          }
        },
        "capabilities": {
          "ui_contract_view": [
            "1.4"
          ],
          "features": [
            "ui_1_3"
          ]
        }
      }
    },
    {
      "client_act": {
        "action": {
          "activate": {}
        },
        "node_id": "go"
      }
    },
    {
      "client_act": {
        "action": {
          "hub_result": {
            "request": 1,
            "ok": {
              "operation": {
                "id": "op1"
              }
            }
          }
        }
      }
    },
    {
      "client_act": {
        "action": {
          "hub_rows": {
            "kind": "operation",
            "baseline": true,
            "rows": [
              {
                "id": "op1",
                "kind": "safe_write",
                "state": "typing",
                "terminal": false
              }
            ]
          }
        }
      }
    },
    {
      "client_act": {
        "action": {
          "hub_rows": {
            "kind": "ws",
            "baseline": true,
            "rows": []
          }
        }
      }
    },
    {
      "client_expect": {
        "observation": {
          "disabled": true
        },
        "because": "UI UI-AC-8",
        "node_id": "go"
      }
    },
    {
      "client_expect": {
        "observation": {
          "shows_pending_text": true
        },
        "because": "UI UI-AC-8",
        "node_id": "go"
      }

{
  "id": "conf::ui_em_7_foreign_asset_not_found",
  "contract": "ui",
  "clause": "UI-EM-7",
  "subject": "hub",
  "setup": {
    "hub": {
      "assets_origin": "https://assets.example.test:7443",
      "packages": [
        {
          "key": "botster-graph",
          "state": "enabled",
          "assets": [
            {
              "name": "graph",
              "asset_id": "ast_graph_1",
              "content_type": "text/html"
            }
          ]
        },
        {
          "key": "botster-other",
          "state": "enabled",
          "assets": [
            {
              "name": "secret",
              "asset_id": "ast_other_1",
              "content_type": "text/html"
            }
          ]
        }
      ]
    }
  },
  "steps": [
    {
      "connect": {
        "as": "c1"
      }
    },
    {
      "send": {
        "type": "hello",
        "protocol": "botster-hub",
        "versions": {
          "min": 1,
          "max": 2
        },
        "client": {
          "name": "conf",
          "version": "0"
        },
        "features": [],
        "terminal_formats": [
          "ghostsnp/2+raw"
        ]
      },
      "on": "c1"
    },
    {
      "expect": {
        "type": "welcome",
        "hub_id": {
          "$type": "string"
        },
        "incarnation": {
          "$type": "string"
        },
        "limits": {
          "$type": "object"
        }
      },
      "on": "c1",
      "because": "HC HS-3"
    },
    {
      "send": {
        "type": "req",
        "id": "1",
        "verb": "invoke",
        "kind": "package",
        "action": "open_asset",
        "args": {
          "asset_id": "ast_other_1"
        },
        "target": "botster-graph"
      },
      "on": "c1"
    },
    {
      "expect": {
        "type": "res",
        "id": "1",
        "err": {
          "code": "not_found"
        }
      },
      "on": "c1",
      "because": [
        "UI UI-EM-7",
        "HC A.9"
      ]
    }
  ]
}

{
  "id": "conf::ui_em_13_retired_on_revocation",
  "contract": "ui",
  "clause": "UI-EM-13",
  "subject": "client",
  "setup": {
    "admission": {
      "kinds": {
        "botster-graph.node": {
          "projection_allowlist": [
            "/label",
            "/count"
          ],
          "owner": "botster-graph"
        }
      },
      "handlers": {},
      "package": "botster-graph",
      "views": []
    },
    "app_origin": "https://app.example.test"
  },
  "steps": [
    {
      "client_load": {
        "document": {
          "ui_contract_view": "1.4",
          "id": "graph",
          "title": "Graph",
          "requires": [
            "ui_embed"
          ],
          "root": {
            "type": "stack",
            "id": "root",
            "direction": "column",
            "children": [
              {
                "type": "list",
                "id": "nodes",
                "source": {
                  "kind": "botster-graph.node"
                },
                "selects": "sel_node",
                "item": {
                  "fields": [
                    {
                      "id": "node_label",
                      "path": "/label"
                    }
                  ]
                },
                "empty": {
                  "title": "No nodes"
                },
                "error": {
                  "title": "Nodes unavailable"
                }
              },
              {
                "type": "embed",
                "id": "page",
                "title": "Knowledge graph",
                "page": {
                  "asset": {
                    "name": "graph"
                  }
                },
                "empty": {
                  "title": "No page"
                },
                "error": {
                  "title": "Page unavailable"
                },
                "channel": {
                  "from_page": [
                    {
                      "type": "pick",
                      "select": "sel_node"
                    }
                  ]
                }
              }
            ]
          },
          "selections": [
            {
              "id": "sel_node"
            }
          ]
        },
        "capabilities": {
          "ui_contract_view": [
            "1.4"
          ],
          "features": [
            "ui_embed",
            "embed"
          ]
        },
        "kind_snapshots": {
          "botster-graph.node": {
            "baseline": true,
            "rows": [
              {
                "id": "n1",
                "label": "A"
              }
            ]
          }
        }
      }
    },
    {
      "client_expect": {
        "observation": {
          "request_sent": {
            "action": "open_asset",
            "count": 1,
            "target": "botster-graph",
            "args": {
              "name": "graph"
            }
          }
        },
        "because": "UI UI-EM-7"
      }
    },
    {
      "client_act": {
        "action": {
          "hub_result": {
            "request": 1,
            "ok": {
              "url": "https://assets.example.test:7443/botster-graph/ast_1?t=TOKEN_SENTINEL_1",
              "expires_at": 1790840000001
            }
          }
        }
      }
    },
    {
      "client_act": {
        "action": {
          "frame_load": {}
        }
      }
    },
    {
      "client_expect": {
        "observation": {
          "channel": "open"
        },
        "because": "UI UI-EM-5",
        "node_id": "page"
      }
    },
    {
      "client_act": {
        "action": {
          "view_event": {
            "event": "revoked"
          }
        },
        "node_id": "page"
      }
    },
    {
      "client_expect": {
        "observation": {
          "channel": "closed"
        },
        "because": "UI UI-EM-13",
        "node_id": "page"
      }
    },
    {
      "client_act": {
        "action": {
          "page_message": {
            "via": "port",
            "type": "pick",
            "payload": {
              "row_key": "n1"
            }
          }
        }
      }
    },
    {
      "client_expect": {
        "observation": {
          "message_dropped": true
        },
        "because": "UI UI-EM-13",
        "node_id": "page"
      }
    },
    {
      "client_expect": {
        "observation": {
          "slot": {
            "slot": "sel_node"
          }
        },
        "because": "UI UI-EM-13"
      }
    },
    {
      "client_expect": {
        "observation": {
          "error_state": {
            "reload": true
          }
        },
        "because": "UI UI-EM-13",
        "node_id": "page"
      }
    }
  ]
}

                      }
                    }
                  }
                ]
              },
              {
                "type": "form",
                "id": "fm",
                "action": "go",
                "schema": {
                  "type": "object",
                  "properties": {
                    "s": {
                      "type": "string"
                    }
                  }
                }
              },
              {
                "type": "status_badge",

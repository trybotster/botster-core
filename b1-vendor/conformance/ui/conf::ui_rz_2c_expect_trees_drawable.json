        "document": {
          "ui_contract_view": "1.4",
          "id": "v2",
          "title": "T",
          "root": {
            "type": "stack",
            "id": "root",
            "direction": "column",
            "children": [
              {
                "type": "actions",
                "id": "acts",
                "items": [
                  {
                    "id": "go",
                    "label": "Go",
                    "handler": "h2_go",
                    "args_schema": {
                      "type": "object",
                      "properties": {
                        "a": {
                          "type": "string",
                          "ui": {
                            "group": "g"
                          }
                        },
                        "o": {
                          "type": "string",
                          "ui": {
                            "options_source": {
                              "kind": "k",
                              "value_field": "/id",
                              "label_field": "/id"
                            }
                          }
                        }
                      }
                    },
                    "confirm": {
                      "message": "Sure?",
                      "tone": "neutral"
                    }
                  }

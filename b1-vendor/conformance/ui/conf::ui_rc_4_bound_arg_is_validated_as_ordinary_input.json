{
  "id": "conf::ui_rc_4_bound_arg_is_validated_as_ordinary_input",
  "contract": "ui",
  "clause": "UI-RC-4",
  "subject": "hub",
  "requires": {
    "controls": [
      "dispatch_log"
    ]
  },
  "setup": {
    "hub": {
      "packages": [
        {
          "key": "botster-workspaces",
          "state": "enabled",
          "ui_actions": [
            {
              "action": "rename",
              "kind": "botster-workspaces.workspace",
              "args_schema": {
                "type": "object",
                "required": [
                  "workspace_id",
                  "name"
                ],
                "properties": {
                  "workspace_id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          ],
          "kinds": [
            {
              "kind": "botster-workspaces.workspace",
              "rows": [
                {
                  "id": "w1"
                }
              ],
              "actions": {
                "rename": {
                  "effect": "committed",
                  "result": {}
                }
              }
            }
          ]
        }
      ]
    }
  },
  "steps": [
    {
      "connect": {
        "as": "c1"
      }
    },
    {
      "send": {
        "type": "hello",
        "protocol": "botster-hub",
        "versions": {
          "min": 1,
          "max": 2
        },
        "client": {
          "name": "conf",
          "version": "0"
        },
        "features": [],
        "terminal_formats": [
          "ghostsnp/2+raw"
        ]
      },
      "on": "c1"
    },
    {
      "expect": {
        "type": "welcome",
        "hub_id": {
          "$type": "string"
        },
        "incarnation": {
          "$type": "string"
        },
        "limits": {
          "$type": "object"
        }
      },
      "on": "c1",
      "because": "HC HS-3"
    },
    {
      "send": {
        "type": "req",
        "id": "9",
        "verb": "list",
        "kind": "kind",
        "args": {
          "filter": {
            "kind": "botster-workspaces.workspace"
          }
        }
      },
      "on": "c1"
    },
    {
      "expect": {
        "type": "res",
        "id": "9",
        "ok": {
          "items": [
            {
              "descriptor_id": "$d"
            }
          ]
        }
      },
      "on": "c1",
      "because": "HC DS-6"
    },
    {
      "send": {
        "type": "req",
        "id": "1",
        "verb": "invoke",
        "kind": "botster-workspaces.workspace",
        "action": "rename",
        "args": {
          "workspace_id": 5,
          "name": "Beta"
        },
        "target": "w1",
        "descriptor_id": "$d"
      },
      "on": "c1"
    },
    {
      "expect": {
        "type": "res",
        "id": "1",
        "err": {
          "code": "invalid_arguments"
        }
      },
      "on": "c1",
      "because": [
        "UI UI-RC-4",
        "HC DS-2"
      ]
    },
    {
      "control": {
        "op": "dispatch_log"
      },
      "expect": {
        "dispatched": []
      },
      "because": "UI UI-RC-4"
    },
    {
      "send": {
        "type": "req",
        "id": "2",
        "verb": "invoke",
        "kind": "botster-workspaces.workspace",
        "action": "rename",
        "args": {
          "workspace_id": "w9",
          "name": "Beta"
        },
        "target": "w1",
        "descriptor_id": "$d"
      },
      "on": "c1"
    },
    {
      "expect": {
        "type": "res",
        "id": "2",
        "ok": {
          "$any": true
        }
      },
      "on": "c1",
      "because": "UI UI-RC-4"
    }
  ]
}

        "HC DS-6"
      ]
    },
    {
      "send": {
        "type": "req",
        "id": "2",
        "verb": "invoke",
        "kind": "session",
        "action": "acme.sync",
        "args": {},
        "target": "s1",
        "descriptor_id": "$d"
      },
      "on": "c1"
    },
    {
      "expect": {
        "type": "res",
        "id": "2",
        "ok": {
          "$any": true
        }
      },
      "on": "c1",
      "because": "HC EN-1a"
    },
    {
      "send": {
        "type": "req",
        "id": "3",
        "verb": "invoke",
        "kind": "session",
        "action": "sync",
        "args": {},
        "target": "s1",
        "descriptor_id": "$d"
      },
      "on": "c1"
    },
    {
      "expect": {
        "type": "res",
        "id": "3",
        "err": {
          "code": "unsupported"
        }
      },
      "on": "c1",
      "because": "HC EN-1a"
    }
  ]

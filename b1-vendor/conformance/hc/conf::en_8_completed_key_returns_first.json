{
  "id": "conf::en_8_completed_key_returns_first",
  "contract": "hc",
  "clause": "EN-8",
  "subject": "hub",
  "requires": {
    "controls": [
      "drop_response"
    ]
  },
  "setup": {
    "fixture": "base"
  },
  "steps": [
    {
      "connect": {
        "as": "c1"
      }
    },
    {
      "send": {
        "type": "hello",
        "protocol": "botster-hub",
        "versions": {
          "min": 1,
          "max": 2
        },
        "client": {
          "name": "conf",
          "version": "0"
        },
        "features": [],
        "terminal_formats": [
          "ghostsnp/2+raw"
        ]
      },
      "on": "c1"
    },
    {
      "expect": {
        "type": "welcome",
        "hub_id": {
          "$type": "string"
        },
        "incarnation": {
          "$type": "string"
        },
        "limits": {
          "$type": "object"
        }
      },
      "on": "c1",
      "because": "HC HS-3"
    },
    {
      "send": {
        "type": "req",
        "id": "1",
        "verb": "create",
        "kind": "spawn_target",
        "args": {
          "label": "once",
          "path": "/p/once",
          "kind": "directory"
        },
        "idempotency_key": "k1"
      },
      "on": "c1"
    },
    {
      "expect": {
        "type": "res",
        "id": "1",
        "ok": "$r"
      },
      "on": "c1",
      "because": "HC EN-8"
    },
    {
      "send": {
        "type": "req",
        "id": "2",
        "verb": "create",
        "kind": "spawn_target",
        "args": {
          "label": "once",
          "path": "/p/once",
          "kind": "directory"
        },
        "idempotency_key": "k1"
      },
      "on": "c1"
    },
    {
      "expect": {
        "type": "res",
        "id": "2",
        "ok": "$r"
      },
      "on": "c1",
      "because": "HC EN-8"
    },
    {
      "send": {
        "type": "req",
        "id": "3",
        "verb": "list",
        "kind": "spawn_target",
        "args": {
          "filter": {
            "label": "once"
          }
        }
      },
      "on": "c1"
    },
    {
      "expect": {
        "type": "res",
        "id": "3",
        "ok": {
          "items": [
            {
              "label": "once"
            }
          ]
        }
      },
      "on": "c1",
      "because": "HC EN-8"
    },
    {
      "control": {
        "op": "drop_response",
        "count": 1
      }
    },
    {
      "send": {
        "type": "req",
        "id": "4",
        "verb": "create",
        "kind": "spawn_target",
        "args": {
          "label": "lost",
          "path": "/p/lost",
          "kind": "directory"
        },
        "idempotency_key": "k5"
      },
      "on": "c1"
    },
    {
      "connect": {
        "as": "c2"
      }
    },
    {
      "send": {
        "type": "hello",
        "protocol": "botster-hub",
        "versions": {
          "min": 1,
          "max": 2
        },
        "client": {
          "name": "conf",
          "version": "0"
        },
        "features": [],
        "terminal_formats": [
          "ghostsnp/2+raw"
        ]
      },
      "on": "c2"
    },
    {
      "expect": {
        "type": "welcome",
        "hub_id": {
          "$type": "string"
        },
        "incarnation": {
          "$type": "string"
        },
        "limits": {
          "$type": "object"
        }
      },
      "on": "c2",
      "because": "HC HS-3"
    },
    {
      "send": {
        "type": "req",
        "id": "5",
        "verb": "create",
        "kind": "spawn_target",
        "args": {
          "label": "lost",
          "path": "/p/lost",
          "kind": "directory"
        },
        "idempotency_key": "k5"
      },
      "on": "c2"
    },
    {
      "expect": {
        "type": "res",
        "id": "5",
        "ok": {
          "label": "lost"
        }
      },
      "on": "c2",
      "because": "HC EN-8"
    },
    {
      "send": {
        "type": "req",
        "id": "6",
        "verb": "list",
        "kind": "spawn_target",
        "args": {
          "filter": {
            "label": "lost"
          }
        }
      },
      "on": "c2"
    },
    {
      "expect": {
        "type": "res",
        "id": "6",
        "ok": {
          "items": [
            {
              "label": "lost"
            }
          ]
        }
      },
      "on": "c2",
      "because": "HC EN-8"
    }
  ]
}

        "client": {
          "name": "conf",
          "version": "0"
        },
        "features": [],
        "terminal_formats": [
          "ghostsnp/2+raw"
        ]
      },
      "on": "c1"
    },
    {
      "expect": {
        "type": "welcome",
        "hub_id": {
          "$type": "string"
        },
        "incarnation": {
          "$type": "string"
        },
        "limits": {
          "$type": "object"
        }
      },
      "on": "c1",
      "because": "HC HS-3"
    },
    {
      "send": {
        "type": "req",
        "id": "1",
        "verb": "invoke",
        "kind": "session",
        "action": "stop",
        "args": {},
        "target": "s1"
      },
      "on": "c1"
    },
    {
      "expect": {
        "type": "res",
        "id": "1",
        "ok": {
          "operation": {
            "id": "$op",
            "kind": {
              "$type": "string"
            },
            "terminal": false
          }
        }
      },
      "on": "c1",
      "because": [
        "HC EN-7",
        "HC A.7b"
      ]
    },
    {
      "send": {
        "type": "req",
        "id": "2",
        "verb": "get",
        "kind": "operation",
        "target": "$op"
      },
      "on": "c1"
    },
    {
      "expect": {
        "type": "res",
        "id": "2",

{
  "id": "conf::en_7_accepted_returns_operation",
  "contract": "hc",
  "clause": "EN-7",
  "subject": "hub",
  "setup": {
    "fixture": "base"
  },
  "steps": [
    {
      "connect": {
        "as": "c1"
      }
    },
    {

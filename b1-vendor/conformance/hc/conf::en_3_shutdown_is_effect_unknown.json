{
  "id": "conf::en_3_shutdown_is_effect_unknown",
  "contract": "hc",
  "clause": "EN-3",
  "subject": "hub",
  "requires": {
    "controls": [
      "hold_completion",
      "shutdown_now"
    ]
  },
  "setup": {
    "fixture": "base"
  },
  "steps": [
    {
      "connect": {
        "as": "c1"
      }
    },
    {
      "send": {
        "type": "hello",
        "protocol": "botster-hub",
        "versions": {
          "min": 1,
          "max": 2
        },
        "client": {
          "name": "conf",
          "version": "0"
        },
        "features": [],
        "terminal_formats": [
          "ghostsnp/2+raw"
        ]
      },
      "on": "c1"
    },
    {
      "expect": {
        "type": "welcome",
        "hub_id": {
          "$type": "string"
        },
        "incarnation": {
          "$type": "string"
        },
        "limits": {
          "$type": "object"
        }
      },
      "on": "c1",
      "because": "HC HS-3"
    },
    {
      "control": {
        "op": "hold_completion",
        "count": 1
      }
    },
    {
      "send": {
        "type": "req",
        "id": "1",
        "verb": "create",
        "kind": "spawn_target",
        "args": {
          "label": "held",
          "path": "/p/held",
          "kind": "directory"
        }
      },
      "on": "c1"
    },
    {
      "control": {
        "op": "shutdown_now"
      }
    },
    {
      "expect": {
        "type": "res",
        "id": "1",
        "err": {
          "code": "hub_shutdown",
          "effect": "unknown"
        }
      },
      "on": "c1",
      "because": "HC EN-3"
    },
    {
      "expect": {
        "type": "close",
        "reason": {
          "hub_shutdown": {
            "lock_released": true
          }
        }
      },
      "on": "c1",
      "because": [
        "HC EN-3",
        "HC HS-9"
      ]
    },
    {
      "expect_closed": null,
      "on": "c1",
      "because": "HC HS-9"
    }
  ]
}

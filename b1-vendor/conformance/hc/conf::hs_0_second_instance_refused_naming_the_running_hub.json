{
  "id": "conf::hs_0_second_instance_refused_naming_the_running_hub",
  "contract": "hc",
  "clause": "HS-0",
  "subject": "hub",
  "requires": {
    "controls": [
      "hub_up"
    ]
  },
  "setup": {
    "start": false,
    "hub": {
      "socket_path": "/run/botster/hub.sock"
    }
  },
  "steps": [
    {
      "control": {
        "op": "hub_up"
      },
      "expect": {
        "state": "ready"
      },
      "because": "HC HS-0"
    },
    {
      "control": {
        "op": "hub_up"
      },
      "expect": {
        "state": "failed",
        "code": "lock_held",
        "exit_nonzero": true,
        "names_running_binary": true,
        "names_software": true
      },
      "because": "HC HS-0"
    }
  ]
}

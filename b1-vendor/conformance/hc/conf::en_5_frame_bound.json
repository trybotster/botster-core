{
  "id": "conf::en_5_frame_bound",
  "contract": "hc",
  "clause": "EN-5",
  "subject": "hub",
  "setup": {
    "fixture": "base",
    "hub": {
      "limits": {
        "max_frame_bytes": 512
      },
      "rows": {
        "session": [
          {
            "id": "fat",
            "hub_id": "hub-1",
            "label": "",
            "state": "running",
            "lifecycle_class": "current",
            "exit": {},
            "size": {
              "rows": 24,
              "cols": 80
            },
            "session_type": {
              "id": "shell",
              "source": "device"
            },
            "traits": [],

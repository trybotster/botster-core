{
  "id": "conf::ds_1_describe_shape",
  "contract": "hc",
  "clause": "DS-1",
  "subject": "hub",
  "setup": {
    "fixture": "base"
  },
  "steps": [
    {
      "connect": {
        "as": "c1"
      }
    },
    {
      "send": {
        "type": "hello",
        "protocol": "botster-hub",
        "versions": {
          "min": 1,
          "max": 2
        },
        "client": {
          "name": "conf",
          "version": "0"
        },
        "features": [],
        "terminal_formats": [
          "ghostsnp/2+raw"
        ]
      },
      "on": "c1"
    },
    {
      "expect": {
        "type": "welcome",
        "hub_id": {
          "$type": "string"
        },
        "incarnation": {
          "$type": "string"
        },
        "limits": {
          "$type": "object"
        }
      },
      "on": "c1",
      "because": "HC HS-3"
    },
    {
      "send": {
        "type": "req",
        "id": "1",
        "verb": "describe",
        "kind": "kind"
      },
      "on": "c1"
    },
    {
      "expect": {
        "type": "res",
        "id": "1",
        "ok": {
          "$schema": "hc/DescribeResult"
        }
      },
      "on": "c1",
      "because": "HC DS-1"
    },
    {
      "send": {
        "type": "req",
        "id": "2",
        "verb": "list",
        "kind": "kind",
        "args": {
          "filter": {
            "kind": "session"
          }
        }
      },
      "on": "c1"
    },
    {
      "expect": {
        "type": "res",
        "id": "2",
        "ok": {
          "items": [
            {
              "kind": "session",
              "owner": "hub",
              "watchable": true,
              "durable": true,
              "descriptor_id": {
                "$type": "string"
              },
              "schema_version": {
                "$type": "string"
              },
              "verbs": {
                "list": {
                  "effect": "read"
                },
                "get": {
                  "effect": "read"
                }
              },
              "actions": {
                "attach": {
                  "effect": "immediate"
                }
              }
            }
          ]
        }
      },
      "on": "c1",
      "because": "HC DS-1"
    }
  ]
}

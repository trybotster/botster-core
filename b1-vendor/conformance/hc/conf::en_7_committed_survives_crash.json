{
  "id": "conf::en_7_committed_survives_crash",
  "contract": "hc",
  "clause": "EN-7",
  "subject": "hub",
  "requires": {
    "controls": [
      "crash"
    ]
  },
  "setup": {
    "fixture": "base"
  },
  "steps": [
    {
      "connect": {
        "as": "c1"
      }
    },
    {
      "send": {
        "type": "hello",
        "protocol": "botster-hub",
        "versions": {
          "min": 1,
          "max": 2
        },
        "client": {
          "name": "conf",
          "version": "0"
        },
        "features": [],
        "terminal_formats": [
          "ghostsnp/2+raw"
        ]
      },
      "on": "c1"
    },
    {
      "expect": {
        "type": "welcome",
        "hub_id": {
          "$type": "string"
        },
        "incarnation": {
          "$type": "string"
        },
        "limits": {
          "$type": "object"
        }
      },
      "on": "c1",
      "because": "HC HS-3"
    },
    {
      "send": {
        "type": "req",
        "id": "1",
        "verb": "create",
        "kind": "spawn_target",
        "args": {
          "label": "durable",
          "path": "/p/durable",
          "kind": "directory",
          "id": "td"
        }
      },
      "on": "c1"
    },
    {
      "expect": {
        "type": "res",
        "id": "1",
        "ok": {
          "id": "td"
        }
      },
      "on": "c1",
      "because": "HC EN-7"
    },
    {
      "control": {
        "op": "crash"
      }
    },
    {
      "connect": {
        "as": "c2"
      }
    },
    {
      "send": {
        "type": "hello",
        "protocol": "botster-hub",
        "versions": {
          "min": 1,
          "max": 2
        },
        "client": {
          "name": "conf",
          "version": "0"
        },
        "features": [],
        "terminal_formats": [
          "ghostsnp/2+raw"
        ]
      },
      "on": "c2"
    },
    {
      "expect": {
        "type": "welcome",
        "hub_id": {
          "$type": "string"
        },
        "incarnation": {
          "$type": "string"
        },
        "limits": {
          "$type": "object"
        }
      },
      "on": "c2",
      "because": "HC HS-3"
    },
    {
      "send": {
        "type": "req",
        "id": "2",
        "verb": "get",
        "kind": "spawn_target",
        "target": "td"
      },
      "on": "c2"
    },
    {
      "expect": {
        "type": "res",
        "id": "2",
        "ok": {
          "id": "td",
          "label": "durable"
        }
      },
      "on": "c2",
      "because": "HC EN-7"
    }
  ]
}

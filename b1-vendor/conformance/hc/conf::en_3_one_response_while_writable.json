{
  "id": "conf::en_3_one_response_while_writable",
  "contract": "hc",
  "clause": "EN-3",
  "subject": "hub",
  "setup": {
    "fixture": "base"
  },
  "steps": [
    {
      "connect": {
        "as": "c1"
      }
    },
    {
      "send": {
        "type": "hello",
        "protocol": "botster-hub",
        "versions": {
          "min": 1,
          "max": 2
        },
        "client": {
          "name": "conf",
          "version": "0"
        },
        "features": [],
        "terminal_formats": [
          "ghostsnp/2+raw"
        ]
      },
      "on": "c1"
    },
    {
      "expect": {
        "type": "welcome",
        "hub_id": {
          "$type": "string"
        },
        "incarnation": {
          "$type": "string"
        },
        "limits": {
          "$type": "object"
        }
      },
      "on": "c1",
      "because": "HC HS-3"
    },
    {
      "send": {
        "type": "req",
        "id": "1",
        "verb": "get",
        "kind": "session",
        "target": "s1"
      },
      "on": "c1"
    },
    {
      "send": {
        "type": "req",
        "id": "2",
        "verb": "get",
        "kind": "session",
        "target": "s2"
      },
      "on": "c1"
    },
    {
      "send": {
        "type": "req",
        "id": "3",
        "verb": "get",
        "kind": "session",
        "target": "s3"
      },
      "on": "c1"
    },
    {
      "expect_set": [
        {
          "type": "res",
          "id": "1"
        },
        {
          "type": "res",
          "id": "2"
        },
        {
          "type": "res",
          "id": "3"
        }
      ],
      "on": "c1",
      "because": "HC EN-3"
    },
    {
      "expect_quiet_until": {
        "type": "res",
        "id": {
          "$one_of": [
            "1",
            "2",
            "3"
          ]
        }
      },
      "barrier": {
        "send": {
          "type": "req",
          "id": "4",
          "verb": "get",
          "kind": "session",
          "target": "s1"
        },
        "on": "c1"
      },
      "until": {
        "type": "res",
        "id": "4"
      },
      "on": "c1",
      "because": "HC EN-3"
    }
  ]
}

{
  "id": "conf::ds_6_disabled_action_listed_with_reasons",
  "contract": "hc",
  "clause": "DS-6",
  "subject": "hub",
  "setup": {
    "fixture": "base",
    "hub": {
      "denied": [
        "hub.diagnostics"
      ]
    }
  },
  "steps": [
    {
      "connect": {
        "as": "c1"
      }
    },
    {
      "send": {
        "type": "hello",
        "protocol": "botster-hub",
        "versions": {
          "min": 1,
          "max": 2
        },
        "client": {
          "name": "conf",
          "version": "0"
        },
        "features": [],
        "terminal_formats": [
          "ghostsnp/2+raw"
        ]
      },
      "on": "c1"
    },
    {
      "expect": {
        "type": "welcome",
        "hub_id": {
          "$type": "string"
        },
        "incarnation": {
          "$type": "string"
        },
        "limits": {
          "$type": "object"
        }
      },
      "on": "c1",
      "because": "HC HS-3"
    },
    {
      "send": {
        "type": "req",
        "id": "1",
        "verb": "list",
        "kind": "kind",
        "args": {
          "filter": {
            "kind": "hub"
          }
        }
      },
      "on": "c1"
    },
    {
      "expect": {
        "type": "res",

{
  "id": "conf::hs_5_new_incarnation_invalidates_cursors",
  "contract": "hc",
  "clause": "HS-5",
  "subject": "hub",
  "requires": {
    "controls": [
      "crash"
    ]
  },
  "setup": {
    "fixture": "base"
  },
  "steps": [
    {
      "connect": {
        "as": "c1"
      }
    },
    {
      "send": {
        "type": "hello",
        "protocol": "botster-hub",
        "versions": {
          "min": 1,
          "max": 2
        },
        "client": {
          "name": "conf",
          "version": "0"
        },
        "features": [],
        "terminal_formats": [
          "ghostsnp/2+raw"
        ]
      },
      "on": "c1"
    },
    {
      "expect": {
        "type": "welcome",
        "hub_id": {
          "$type": "string"
        },
        "incarnation": {
          "$type": "string"
        },
        "limits": {
          "$type": "object"
        }
      },
      "on": "c1",
      "because": "HC HS-3"
    },
    {
      "send": {
        "type": "req",
        "id": "1",
        "verb": "list",
        "kind": "spawn_target",
        "args": {
          "limit": 2
        }
      },
      "on": "c1"
    },
    {
      "expect": {
        "type": "res",
        "id": "1",
        "ok": {
          "items": [
            {},
            {}
          ],
          "next_cursor": "$cur"
        }
      },
      "on": "c1",
      "because": "HC VB-1"
    },
    {
      "control": {
        "op": "crash"
      }
    },
    {
      "connect": {
        "as": "c2"
      }
    },
    {
      "send": {
        "type": "hello",
        "protocol": "botster-hub",
        "versions": {
          "min": 1,
          "max": 2
        },
        "client": {
          "name": "conf",
          "version": "0"
        },
        "features": [],
        "terminal_formats": [
          "ghostsnp/2+raw"
        ]
      },
      "on": "c2"
    },
    {
      "expect": {
        "type": "welcome",
        "hub_id": {
          "$type": "string"
        },
        "incarnation": {
          "$type": "string"
        },
        "limits": {
          "$type": "object"
        }
      },
      "on": "c2",
      "because": "HC HS-3"
    },
    {
      "send": {
        "type": "req",
        "id": "2",
        "verb": "list",
        "kind": "spawn_target",
        "args": {
          "cursor": "$cur"
        }
      },
      "on": "c2"
    },
    {
      "expect": {
        "type": "res",
        "id": "2",
        "err": {
          "code": "expired_cursor"
        }
      },
      "on": "c2",
      "because": "HC HS-5"
    }
  ]
}

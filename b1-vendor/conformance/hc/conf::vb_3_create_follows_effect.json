{
  "id": "conf::vb_3_create_follows_effect",
  "contract": "hc",
  "clause": "VB-3",
  "subject": "hub",
  "setup": {
    "fixture": "base"
  },
  "steps": [
    {
      "connect": {
        "as": "c1"
      }
    },
    {
      "send": {
        "type": "hello",
        "protocol": "botster-hub",
        "versions": {
          "min": 1,
          "max": 2
        },
        "client": {
          "name": "conf",
          "version": "0"
        },
        "features": [],
        "terminal_formats": [
          "ghostsnp/2+raw"
        ]
      },
      "on": "c1"
    },
    {
      "expect": {
        "type": "welcome",
        "hub_id": {
          "$type": "string"
        },
        "incarnation": {
          "$type": "string"
        },
        "limits": {
          "$type": "object"
        }
      },
      "on": "c1",
      "because": "HC HS-3"
    },
    {
      "send": {
        "type": "req",
        "id": "1",
        "verb": "create",
        "kind": "spawn_target",
        "args": {
          "label": "made",
          "path": "/p/made",
          "kind": "directory",
          "id": "tm"
        }
      },
      "on": "c1"
    },
    {
      "expect": {
        "type": "res",
        "id": "1",
        "ok": {
          "id": "tm",
          "label": "made"
        }
      },
      "on": "c1",
      "because": [
        "HC VB-3",
        "HC A.7"
      ]
    },
    {
      "send": {
        "type": "req",
        "id": "2",
        "verb": "create",
        "kind": "session",
        "args": {
          "command": {
            "argv": [
              "sh"
            ]
          }
        }
      },
      "on": "c1"
    },
    {
      "expect": {
        "type": "res",
        "id": "2",
        "ok": {
          "operation_id": {
            "$type": "string"
          },
          "session": {
            "session_id": {
              "$type": "string"
            }
          },
          "state": "starting"
        }
      },
      "on": "c1",
      "because": [
        "HC VB-3",
        "HC A.9"
      ]
    }
  ]
}

{
  "id": "conf::en_8_create_without_key_conflicts",
  "contract": "hc",
  "clause": "EN-8",
  "subject": "hub",
  "setup": {
    "fixture": "base"
  },
  "steps": [
    {
      "connect": {
        "as": "c1"
      }
    },
    {
      "send": {
        "type": "hello",
        "protocol": "botster-hub",
        "versions": {
          "min": 1,
          "max": 2
        },
        "client": {
          "name": "conf",
          "version": "0"
        },
        "features": [],
        "terminal_formats": [
          "ghostsnp/2+raw"
        ]
      },
      "on": "c1"
    },
    {
      "expect": {
        "type": "welcome",
        "hub_id": {
          "$type": "string"
        },
        "incarnation": {
          "$type": "string"
        },
        "limits": {
          "$type": "object"
        }
      },
      "on": "c1",
      "because": "HC HS-3"
    },
    {
      "send": {
        "type": "req",
        "id": "1",
        "verb": "create",
        "kind": "spawn_target",
        "args": {
          "label": "dup",
          "path": "/p/dup",
          "kind": "directory",
          "id": "tdup"
        }
      },
      "on": "c1"
    },
    {
      "expect": {
        "type": "res",
        "id": "1",
        "ok": {
          "id": "tdup"
        }
      },
      "on": "c1",
      "because": "HC VB-3"
    },
    {
      "send": {
        "type": "req",
        "id": "2",
        "verb": "create",
        "kind": "spawn_target",
        "args": {
          "label": "dup",
          "path": "/p/dup",
          "kind": "directory",
          "id": "tdup"
        }
      },
      "on": "c1"
    },
    {
      "expect": {
        "type": "res",
        "id": "2",
        "err": {
          "code": "conflict"
        }
      },
      "on": "c1",
      "because": "HC EN-8"
    }
  ]

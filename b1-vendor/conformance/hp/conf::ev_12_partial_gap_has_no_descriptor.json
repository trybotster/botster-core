{
 "id": "conf::ev_12_partial_gap_has_no_descriptor",
 "contract": "hp",
 "clause": "EV-12",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "invoke",
   "raise_hub_event"
  ]
 },
 "setup": {
  "given": "the session s1 exists and is the only session; the plugin holds events_hub and session_read",
  "limits": {
   "event_queue_high": 1,
   "loss_ledger_entries": 1
  },
  "grants": [
   {
    "surface": "events",
    "scope": "events_hub"
   },
   {
    "surface": "session_actions",
    "scope": "session_read"
   }
  ]
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      },
      {
       "id": "he",
       "kind": "event",
       "descriptor": {}
      },
      {
       "id": "hg",
       "kind": "event_gap",
       "descriptor": {}
      }
     ],
     "events": {
      "subscribed": [
       {
        "handler_id": "he",
        "pattern": {
         "owner": "hub",
         "name": "*"
        }
       }
      ],
      "gap_handler": "hg"
     }
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "invoke",
    "handler": "h1"
   },
   "bind": {
    "t": "/ticket"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "handler": "h1"
    }
   },
   "because": "HP IV-1"
  },
  {
   "control": {
    "op": "raise_hub_event",
    "name": "session.ended",
    "subject": {
     "hub_id": "hub-1",
     "session_id": "s1"
    },
    "payload": {
     "session": {
      "hub_id": "hub-1",
      "session_id": "s1"
     },
     "state": "ended"
    }
   }
  },
  {
   "control": {
    "op": "raise_hub_event",
    "name": "session.ended",
    "subject": {
     "hub_id": "hub-1",
     "session_id": "s1"
    },
    "payload": {
     "session": {
      "hub_id": "hub-1",
      "session_id": "s1"
     },
     "state": "ended"
    }
   }
  },
  {
   "control": {
    "op": "raise_hub_event",
    "name": "session.lost",
    "subject": {
     "hub_id": "hub-1",
     "session_id": "s1"
    },
    "payload": {
     "session": {
      "hub_id": "hub-1",
      "session_id": "s1"
     },
     "state": "ended"
    }
   }
  },
  {
   "control": {
    "op": "raise_hub_event",
    "name": "session.lost",
    "subject": {
     "hub_id": "hub-1",
     "session_id": "s1"
    },
    "payload": {
     "session": {
      "hub_id": "hub-1",
      "session_id": "s1"
     },
     "state": "ended"
    }
   }
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$c1",
     "handler": "he",
     "origin": "event",
     "payload": {
      "owner": "hub",
      "name": "session.ended",
      "priority": "high"
     }
    }
   },
   "because": "HP EV-12"
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$c1",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$g",
     "handler": "hg",
     "origin": "event_gap",
     "payload": {
      "owner": "hub",
      "name": "*",
      "count": 3,
      "aggregated": true,
      "recovery": "partial",
      "state_read": {
       "$absent": true
      }
     }
    }
   },
   "because": [
    "HP EV-12",
    "HP EV-13"
   ]
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$g",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  }
 ]
}

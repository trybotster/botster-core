{
 "id": "conf::mp_4_double_underscore_in_key_server_or_direct_tool_refused",
 "contract": "hp",
 "clause": "MP-4",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "admit_manifest",
   "status"
  ]
 },
 "setup": {
  "given": "a manifest names the plugin a__b; another declares the server id s__x; a plugin registers the direct tool x__y",
  "plugins": {
   "demo": {
    "grants": [
     {
      "surface": "mcp",
      "scope": "mcp_proxy"
     },
     {
      "surface": "mcp",
      "scope": "mcp_proxy_stdio"
     },
     {
      "surface": "net",
      "scope": "net",
      "allow": [
       "https://mcp.example"
      ]
     }
    ],
    "mcp_servers": [],
    "entry": "the plugin declares the MCP servers in its manifest (MP-1)"
   }
  }
 },
 "steps": [
  {
   "control": {
    "op": "admit_manifest",
    "file": "botster-plugin.json",
    "content": {
     "botster_plugin_api": 1,
     "name": "a__b",
     "version": "1.0.0",
     "entrypoints": {
      "service": {
       "lua": "main.lua"
      }
     }
    }
   },
   "expect": {
    "error": {
     "$type": "object"
    }
   },
   "because": "HP MP-4"
  },
  {
   "control": {
    "op": "admit_manifest",
    "file": "botster-plugin.json",
    "content": {
     "botster_plugin_api": 1,
     "name": "demo",
     "version": "1.0.0",
     "entrypoints": {
      "service": {
       "lua": "main.lua"
      }
     },
     "capabilities": [
      {
       "surface": "mcp",
       "scope": "mcp_proxy"
      },
      {
       "surface": "mcp",
       "scope": "mcp_proxy_stdio"
      }
     ],
     "mcp_servers": [
      {
       "id": "s__x",
       "transport": "stdio",
       "command": "mcp-server",
       "args": [
        "--x"
       ],
       "env": {
        "A": "1"
       }
      }
     ]
    }
   },
   "expect": {
    "error": {
     "kind": "invalid_request",
     "detail": {
      "code": "manifest_bad_mcp_server"
     }
    }
   },
   "because": "HP MP-1"
  },
  {
   "control": {
    "op": "admit_manifest",
    "file": "botster-plugin.json",
    "content": {
     "botster_plugin_api": 1,
     "name": "demo",
     "version": "1.0.0",
     "entrypoints": {
      "service": {
       "lua": "main.lua"
      }
     },
     "capabilities": [
      {
       "surface": "mcp",
       "scope": "mcp_proxy"
      },
      {
       "surface": "mcp",
       "scope": "mcp_proxy_stdio"
      }
     ],
     "mcp_servers": [
      {
       "id": "sx",
       "transport": "stdio",
       "command": "mcp-server",
       "args": [
        "--x"
       ],
       "env": {
        "A": "1"
       }
      }
     ]
    }
   },
   "expect": {
    "error": {
     "$absent": true
    }
   },
   "because": "HP MP-4"
  },
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      }
     ],
     "tools": [
      {
       "name": "x__y",
       "description": "d",
       "input_schema": {},
       "handler": "h1"
      }
     ]
    }
   }
  },
  {
   "control": {
    "op": "status"
   },
   "expect": {
    "state": "load_failed"
   },
   "because": "HP MT-1"
  }
 ]
}

{
 "id": "conf::wp_4_deliver_backpressured",
 "contract": "hp",
 "clause": "WP-4",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "hold_relay_ingress",
   "invoke",
   "release_relay_ingress"
  ]
 },
 "setup": {
  "given": "the plugin holds relay_signaling and registers the relay handler rl; the Hub mints relay ids; a client is connecting; the Hub's inward relay path is held",
  "limits": {
   "ingress_queue": 1
  },
  "grants": [
   {
    "surface": "web_origin"
   },
   {
    "surface": "relay",
    "scope": "relay_signaling"
   }
  ]
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      },
      {
       "id": "op",
       "kind": "operation",
       "descriptor": {}
      },
      {
       "id": "he",
       "kind": "event",
       "descriptor": {}
      },
      {
       "id": "hg",
       "kind": "event_gap",
       "descriptor": {}
      },
      {
       "id": "rl",
       "kind": "relay",
       "descriptor": {}
      }
     ],
     "operations": {
      "subscribed": "op"
     },
     "events": {
      "subscribed": [
       {
        "handler_id": "he",
        "pattern": {
         "owner": "net",
         "name": "ws.*"
        }
       }
      ],
      "gap_handler": "hg"
     }
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "invoke",
    "handler": "h1"
   },
   "bind": {
    "t": "/ticket"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "handler": "h1"
    }
   },
   "because": "HP IV-1"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 1,
     "call": "relay.open",
     "context": {
      "request": "$r"
     },
     "args": {}
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 1,
     "result": {
      "ok": true,
      "value": {
       "relay_id": "$r1"
      }
     },
     "effect": "committed"
    }
   },
   "because": "HP WP-4"
  },
  {
   "control": {
    "op": "hold_relay_ingress"
   }
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 2,
     "call": "relay.deliver",
     "context": {
      "request": "$r"
     },
     "args": {
      "relay_id": "$r1",
      "envelope_b64": "AAEC"
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 2,
     "result": {
      "ok": true,
      "value": {
       "status": "accepted"
      }
     },
     "effect": "committed"
    }
   },
   "because": [
    "HP WP-4",
    "HP A2-18"
   ]
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 3,
     "call": "relay.deliver",
     "context": {
      "request": "$r"
     },
     "args": {
      "relay_id": "$r1",
      "envelope_b64": "AAEC"
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 3,
     "result": {
      "ok": false,
      "error": {
       "kind": "backpressured"
      }
     },
     "effect": "none"
    }
   },
   "because": "HP WP-4"
  },
  {
   "control": {
    "op": "release_relay_ingress"
   }
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  }
 ]
}

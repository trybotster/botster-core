{
 "id": "conf::mp_1_stdio_needs_its_own_scope",
 "contract": "hp",
 "clause": "MP-1",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "admit_manifest"
  ]
 },
 "setup": {
  "given": "a manifest declares a stdio server; one version holds mcp_proxy only and one holds mcp_proxy and mcp_proxy_stdio",
  "plugins": {
   "demo": {
    "grants": [
     {
      "surface": "mcp",
      "scope": "mcp_proxy"
     },
     {
      "surface": "mcp",
      "scope": "mcp_proxy_stdio"
     },
     {
      "surface": "net",
      "scope": "net",
      "allow": [
       "https://mcp.example"
      ]
     }
    ],
    "mcp_servers": [],
    "entry": "the plugin declares the MCP servers in its manifest (MP-1)"
   }
  }
 },
 "steps": [
  {
   "control": {
    "op": "admit_manifest",
    "file": "botster-plugin.json",
    "content": {
     "botster_plugin_api": 1,
     "name": "demo",
     "version": "1.0.0",
     "entrypoints": {
      "service": {
       "lua": "main.lua"
      }
     },
     "capabilities": [
      {
       "surface": "mcp",
       "scope": "mcp_proxy"
      }
     ],
     "mcp_servers": [
      {
       "id": "s",
       "transport": "stdio",
       "command": "mcp-server",
       "args": [
        "--x"
       ],
       "env": {
        "A": "1"
       }
      }
     ]
    }
   },
   "expect": {
    "error": {
     "$type": "object"
    }
   },
   "because": "HP MP-1"
  },
  {
   "control": {
    "op": "admit_manifest",
    "file": "botster-plugin.json",
    "content": {
     "botster_plugin_api": 1,
     "name": "demo",
     "version": "1.0.0",
     "entrypoints": {
      "service": {
       "lua": "main.lua"
      }
     },
     "capabilities": [
      {
       "surface": "mcp",
       "scope": "mcp_proxy"
      },
      {
       "surface": "mcp",
       "scope": "mcp_proxy_stdio"
      }
     ],
     "mcp_servers": [
      {
       "id": "s",
       "transport": "stdio",
       "command": "mcp-server",
       "args": [
        "--x"
       ],
       "env": {
        "A": "1"
       }
      }
     ]
    }
   },
   "expect": {
    "error": {
     "$absent": true
    },
    "approvals": {
     "mcp_proxy_stdio": "run local MCP server commands"
    }
   },
   "because": "HP MP-1"
  }
 ]
}

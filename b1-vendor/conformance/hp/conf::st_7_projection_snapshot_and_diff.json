{
 "id": "conf::st_7_projection_snapshot_and_diff",
 "contract": "hp",
 "clause": "ST-7",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "entity_diffs",
   "entity_snapshot",
   "invoke",
   "settle"
  ]
 },
 "setup": {
  "given": "the manifest binds collection c to the entity family ticket with the field allowlist [title]"
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      }
     ]
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "invoke",
    "handler": "h1"
   },
   "bind": {
    "t": "/ticket"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "handler": "h1"
    }
   },
   "because": "HP IV-1"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 1,
     "call": "store.put",
     "context": {
      "request": "$r"
     },
     "args": {
      "collection": "c",
      "id": "a",
      "doc": {
       "title": "t",
       "secret": "s"
      }
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 1,
     "result": {
      "ok": true,
      "value": {
       "revision": "$ra"
      }
     },
     "effect": "committed"
    }
   },
   "because": "HP ST-7"
  },
  {
   "control": {
    "op": "entity_snapshot",
    "family": "ticket"
   },
   "expect": {
    "entities": [
     {
      "id": "a",
      "fields": {
       "title": "t",
       "secret": {
        "$absent": true
       }
      }
     }
    ]
   },
   "because": "HP ST-7"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 2,
     "call": "store.put",
     "context": {
      "request": "$r"
     },
     "args": {
      "collection": "c",
      "id": "a",
      "doc": {
       "title": "u",
       "secret": "s2"
      },
      "expected_revision": "$ra"
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 2,
     "result": {
      "ok": true
     },
     "effect": "committed"
    }
   },
   "because": "HP ST-7"
  },
  {
   "control": {
    "op": "entity_diffs",
    "family": "ticket"
   },
   "expect": {
    "diffs": [
     {
      "id": "a",
      "fields": {
       "title": "u",
       "secret": {
        "$absent": true
       }
      }
     }
    ]
   },
   "because": "HP ST-7"
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  },
  {
   "expect_quiet_until": {
    "lane": "invoke",
    "type": "Invoke"
   },
   "barrier": {
    "control": {
     "op": "settle"
    }
   },
   "until": {
    "settled": true
   },
   "because": "HP ST-7"
  }
 ]
}

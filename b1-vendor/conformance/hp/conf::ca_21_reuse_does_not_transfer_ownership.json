{
 "id": "conf::ca_21_reuse_does_not_transfer_ownership",
 "contract": "hp",
 "clause": "CA-21",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "await_operation",
   "await_session",
   "invoke",
   "load_plugin"
  ]
 },

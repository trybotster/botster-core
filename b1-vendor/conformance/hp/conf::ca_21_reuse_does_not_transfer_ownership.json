    "grants": [
     {
      "surface": "session_actions",
      "scope": "worktree_delete"
     },
     {
      "surface": "session_actions",
      "scope": "session_type_managed_git_spawn"
     },
     {
      "surface": "session_actions",
      "scope": "session_stop"
     }
    ]
   },
   "b": {
    "grants": [
     {
      "surface": "session_actions",
      "scope": "worktree_delete"
     },
     {
      "surface": "session_actions",
      "scope": "session_type_managed_git_spawn"
     },
     {
      "surface": "session_actions",
      "scope": "session_stop"
     }
    ]
   }
  }
 },
 "steps": [

{
 "id": "conf::md_1_result_after_calls",
 "contract": "hp",
 "clause": "MD-1",
 "subject": "plugin_host",
 "requires": {
  "controls": [
   "settle"
  ]
 },
 "setup": {
  "fixture": "host_calls"
 },
 "steps": [
  {
   "send_frame": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "$ref": "hello",
     "epoch": 7
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "epoch": 7
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": 7
    }
   }
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "$ref": "invoke",
     "epoch": 7,
     "request_id": 5,
     "handler": "h1"
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "epoch": 7,
     "call_id": "$c1",
     "context": {
      "request": 5
     },
     "call": "store.get"
    }
   },
   "because": "HP MD-1"
  },
  {
   "expect_quiet_until": {
    "lane": "invoke",
    "type": "Result"
   },
   "barrier": {
    "control": {
     "op": "settle"
    }
   },
   "until": {
    "settled": true
   },
   "because": "HP MD-1"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": 7,
     "call_id": "$c1",
     "result": {
      "ok": true,
      "value": {
       "doc": {
        "v": 1
       },
       "revision": "r1"
      }
     },
     "effect": "none"
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "epoch": 7,
     "call_id": "$c2",
     "context": {
      "request": 5
     },
     "call": "hub.identity"
    }
   },
   "because": "HP MD-1"
  },
  {
   "expect_quiet_until": {
    "lane": "invoke",
    "type": "Result"
   },
   "barrier": {
    "control": {
     "op": "settle"
    }
   },
   "until": {
    "settled": true
   },
   "because": "HP MD-1"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": 7,
     "call_id": "$c2",
     "result": {
      "ok": true,
      "value": {
       "hub_id": "hub-1",
       "display_name": "hub"
      }
     },
     "effect": "none"
    }
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": 7,
     "request_id": 5,
     "result": {
      "ok": true
     }
    }
   },
   "because": "HP MD-1"
  }
 ]
}

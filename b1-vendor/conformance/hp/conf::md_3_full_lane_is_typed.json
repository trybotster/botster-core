{
 "id": "conf::md_3_full_lane_is_typed",
 "contract": "hp",
 "clause": "MD-3",
 "subject": "plugin_hub",
 "requires": {
  "controls": [
   "hold_lane",
   "release_lane",
   "received"
  ]
 },
 "setup": {
  "limits": {
   "lanes": {
    "control": {
     "frames": 8,
     "bytes": 65536
    },
    "invoke": {
     "frames": 8,
     "bytes": 65536
    },
    "call": {
     "frames": 8,
     "bytes": 65536
    },
    "bulk": {
     "frames": 2,
     "bytes": 65536
    }
   }
  },
  "calls": {
   "log.write": [
    {
     "result": {
      "ok": true,
      "value": {
       "seq": 1
      }
     }
    }
   ]
  }
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e"
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "hold_lane",
    "lane": "bulk"
   }
  },
  {
   "send_frame": {
    "lane": "bulk",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 1,
     "call": "log.write",
     "context": "autonomous",
     "args": {
      "level": "info",
      "message": "m"
     }
    }
   }
  },
  {
   "send_frame": {
    "lane": "bulk",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 2,
     "call": "log.write",
     "context": "autonomous",
     "args": {
      "level": "info",
      "message": "m"
     }
    }
   }
  },
  {
   "send_frame": {
    "lane": "bulk",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 3,
     "call": "log.write",
     "context": "autonomous",
     "args": {
      "level": "info",
      "message": "m"
     }
    }
   },
   "expect_error": {
    "kind": "backpressured"
   },
   "because": "HP MD-3"
  },
  {
   "control": {
    "op": "release_lane",
    "lane": "bulk"
   }
  },
  {
   "send_frame": {
    "lane": "bulk",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 4,
     "call": "log.write",
     "context": "autonomous",
     "args": {
      "level": "info",
      "message": "m"
     }
    }
   }
  },
  {
   "control": {
    "op": "received",
    "lane": "bulk"
   },
   "expect": [
    {
     "type": "HostCall",
     "id": 1
    },
    {
     "type": "HostCall",
     "id": 2
    },
    {
     "type": "HostCall",
     "id": 4
    }
   ],
   "because": "HP MD-3"
  }
 ]
}

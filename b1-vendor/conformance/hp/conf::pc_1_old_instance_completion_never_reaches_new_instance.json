{
 "id": "conf::pc_1_old_instance_completion_never_reaches_new_instance",
 "contract": "hp",
 "clause": "PC-1",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "await_operation",
   "invoke",
   "load_plugin",
   "service_connected",
   "settle"
  ]
 },
 "setup": {
  "given": "demo subscribes to operation completions; demo calls b, then demo crashes and restarts as a new instance; b then answers the old call",
  "plugins": {
   "demo": {
    "grants": [
     {
      "surface": "plugins",
      "scope": "plugin_call:b"
     }
    ],
    "requires": [
     {
      "interface": "x.echo",
      "provider": "b",
      "tools": [
       "echo"
      ]
     }
    ]
   },
   "b": {
    "grants": []
   }
  }
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      },
      {
       "id": "op",
       "kind": "operation",
       "descriptor": {}
      }
     ],
     "operations": {
      "subscribed": "op"
     }
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "invoke",
    "handler": "h1"
   },
   "bind": {
    "t": "/ticket"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "handler": "h1"
    }
   },
   "because": "HP IV-1"
  },
  {
   "control": {
    "op": "load_plugin",
    "plugin_key": "b",
    "as": "b"
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e_b"
    }
   },
   "on": "b",
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e_b",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      }
     ],
     "tools": [
      {
       "name": "echo",
       "description": "d",
       "input_schema": {
        "type": "object"
       },
       "handler": "h1",
       "callable_by": [
        "plugins"
       ]
      }
     ]
    }
   },
   "conn": "b"
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e_b"
    }
   },
   "on": "b",
   "because": "HP HS-2"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 1,
     "call": "plugins.call",
     "context": {
      "request": "$r"
     },
     "args": {
      "interface": "x.echo",
      "tool": "echo",
      "args": {
       "n": 4
      }
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 1,
     "result": {
      "ok": true,
      "value": {
       "operation_id": "$op",
       "kind": "plugin_call",
       "state": "queued",
       "terminal": false
      }
     },
     "effect": "committed"
    }
   },
   "because": "HP PC-1"
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e_b",
     "request_id": "$rb",
     "handler": "h1",
     "caller": {
      "kind": "plugin",
      "plugin_key": {
       "$type": "string"
      },
      "instance": {
       "$type": "string"
      }
     },
     "payload": {
      "n": 4
     }
    }
   },
   "on": "b",
   "because": "HP PC-1"
  },
  {
   "close_channel": {}
  },
  {
   "control": {
    "op": "service_connected"
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e2"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e2",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      },
      {
       "id": "op",
       "kind": "operation",
       "descriptor": {}
      }
     ],
     "operations": {
      "subscribed": "op"
     }
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e2"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "invoke",
    "handler": "h1"
   },
   "bind": {
    "t2": "/ticket"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e2",
     "request_id": "$r2",
     "handler": "h1"
    }
   },
   "because": "HP IV-1"
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e_b",
     "request_id": "$rb",
     "result": {
      "ok": true,
      "value": {
       "late": true
      }
     }
    }
   },
   "conn": "b"
  },
  {
   "control": {
    "op": "await_operation",
    "operation_id": "$op",
    "terminal": true
   }
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e2",
     "call_id": 2,
     "call": "operations.get",
     "context": {
      "request": "$r2"
     },
     "args": {
      "operation_id": "$op"
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e2",
     "call_id": 2,
     "result": {
      "ok": true,
      "value": {
       "operation_id": "$op",
       "kind": "plugin_call",
       "state": {
        "$one_of": [
         "done",
         "cancelled",
         "failed"
        ]
       },
       "terminal": true
      }
     },
     "effect": "none"
    }
   },
   "because": "HP PC-1"
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e2",
     "request_id": "$r2",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  },
  {
   "expect_quiet_until": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "handler": "op"
    }
   },
   "on": "main",
   "barrier": {
    "control": {
     "op": "settle",
     "conn": "main"
    }
   },
   "until": {
    "settled": true
   },
   "because": "HP PC-1"
  }
 ]
}

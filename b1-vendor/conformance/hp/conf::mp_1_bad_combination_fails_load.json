{
 "id": "conf::mp_1_bad_combination_fails_load",
 "contract": "hp",
 "clause": "MP-1",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "admit_manifest"
  ]
 },
 "setup": {
  "given": "four manifests declare a stdio server with no command, an http server with no url, a stdio server with a url and no command, and an http server with a command and no url",
  "plugins": {
   "demo": {
    "grants": [
     {
      "surface": "mcp",
      "scope": "mcp_proxy"
     },
     {
      "surface": "mcp",
      "scope": "mcp_proxy_stdio"
     },
     {
      "surface": "net",
      "scope": "net",
      "allow": [
       "https://mcp.example"
      ]
     }
    ],
    "mcp_servers": [],
    "entry": "the plugin declares the MCP servers in its manifest (MP-1)"
   }
  }
 },
 "steps": [
  {
   "control": {
    "op": "admit_manifest",
    "file": "botster-plugin.json",
    "content": {
     "botster_plugin_api": 1,
     "name": "demo",
     "version": "1.0.0",
     "entrypoints": {
      "service": {
       "lua": "main.lua"
      }
     },
     "capabilities": [
      {
       "surface": "mcp",
       "scope": "mcp_proxy"
      },
      {
       "surface": "mcp",
       "scope": "mcp_proxy_stdio"
      }
     ],
     "mcp_servers": [
      {
       "id": "s",
       "transport": "stdio"
      }
     ]
    }
   },
   "expect": {
    "error": {
     "kind": "invalid_request",
     "detail": {
      "code": "manifest_bad_mcp_server"
     }
    }
   },
   "because": "HP MP-1"
  },
  {
   "control": {

{
 "id": "conf::ca_16_notification_survives_plugin_restart_via_get",
 "contract": "hp",
 "clause": "CA-16",
 "subject": "plugin_hub",
 "requires": {
  "controls": [
   "invoke",
   "service_connected"
  ]
 },
 "setup": {
  "given": "the operation op1 reached installed while the plugin was down",
  "calls": {
   "session_types.spawn": [
    {
     "result": {
      "ok": true,
      "value": {
       "operation_id": "op1",
       "kind": "spawn",
       "session": {
        "hub_id": "hub-1",
        "session_id": "s1"
       },
       "state": "starting",
       "terminal": false
      }
     },
     "effect": "committed"
    }
   ],
   "operations.get": [
    {
     "result": {
      "ok": true,
      "value": {
       "operation_id": "op1",
       "kind": "spawn",
       "state": "installed",
       "terminal": true,
       "session": {
        "hub_id": "hub-1",
        "session_id": "s1"
       }
      }
     },
     "effect": "none"
    }
   ]
  }
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      },
      {
       "id": "op",
       "kind": "operation",
       "descriptor": {}
      }
     ],
     "operations": {
      "subscribed": "op"
     }
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "invoke",
    "handler": "h1"
   },
   "bind": {
    "t": "/ticket"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "handler": "h1"
    }
   },
   "because": "HP IV-1"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 1,
     "call": "session_types.spawn",
     "context": {
      "request": "$r"
     },
     "args": {
      "session_type_id": "dev",
      "target_id": "t1"
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 1,
     "result": {
      "ok": true,
      "value": {
       "operation_id": "$op",
       "state": "starting"
      }
     },
     "effect": "committed"
    }
   },
   "because": "HP CA-16"
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  },
  {
   "close_channel": {}
  },
  {
   "control": {
    "op": "service_connected"
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e2"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e2",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      },
      {
       "id": "op",
       "kind": "operation",
       "descriptor": {}
      }
     ],
     "operations": {
      "subscribed": "op"
     }
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e2"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "invoke",
    "handler": "h1"
   },
   "bind": {
    "t2": "/ticket"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e2",
     "request_id": "$r2",
     "handler": "h1"
    }
   },
   "because": "HP IV-1"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e2",
     "call_id": 2,
     "call": "operations.get",
     "context": {
      "request": "$r2"
     },
     "args": {
      "operation_id": "$op"
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e2",
     "call_id": 2,
     "result": {
      "ok": true,
      "value": {
       "state": "installed",
       "terminal": true
      }
     },
     "effect": "none"
    }
   },
   "because": "HP CA-16"
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e2",
     "request_id": "$r2",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  }
 ]
}

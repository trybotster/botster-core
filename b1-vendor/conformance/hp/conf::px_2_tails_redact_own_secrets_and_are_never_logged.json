{
 "id": "conf::px_2_tails_redact_own_secrets_and_are_never_logged",
 "contract": "hp",
 "clause": "PX-2",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "hub_log",
   "invoke"
  ]
 },
 "setup": {
  "given": "the plugin's secret value is hunter2; the command prints the public marker OUTPUT-7731, a space and the secret to stdout and to stderr; the marker is built by the command, so no argv holds it",
  "grants": [
   {
    "surface": "session_actions",
    "scope": "process_run"
   }
  ]
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      },
      {
       "id": "op",
       "kind": "operation",
       "descriptor": {}
      }
     ],
     "operations": {
      "subscribed": "op"
     }
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "invoke",
    "handler": "h1"
   },
   "bind": {
    "t": "/ticket"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "handler": "h1"
    }
   },
   "because": "HP IV-1"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 1,
     "call": "process.run",
     "context": {
      "request": "$r"
     },
     "args": {
      "argv": [
       "sh",
       "-c",
       "printf '%s%s %s' OUT PUT-7731 \"$TOKEN\"; printf '%s%s %s' OUT PUT-7731 \"$TOKEN\" >&2"
      ],
      "env": {
       "TOKEN": "{{secret:token}}"
      },
      "timeout_ms": 5000,
      "stdout_tail_bytes": 1024,
      "stderr_tail_bytes": 1024
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 1,
     "result": {
      "ok": true,
      "value": {
       "operation_id": "$op"
      }
     },
     "effect": "committed"
    }
   },
   "because": "HP PX-1"
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$rn",
     "handler": "op",
     "payload": {
      "operation_id": "$op",
      "state": "done",
      "terminal": true,
      "stdout_tail_b64": {
       "$not": {
        "$one_of": [
         {
          "$not": {
           "$b64": {
            "$starts_with": "OUTPUT-7731"
           }
          }
         },
         {
          "$b64": {
           "$contains": "hunter2"
          }
         }
        ]
       }
      },
      "stderr_tail_b64": {
       "$not": {
        "$one_of": [
         {
          "$not": {
           "$b64": {
            "$starts_with": "OUTPUT-7731"
           }
          }
         },
         {
          "$b64": {
           "$contains": "hunter2"
          }
         }
        ]
       }
      }
     },
     "origin": "operation"
    }
   },
   "because": "HP PX-2"
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$rn",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  },
  {
   "control": {
    "op": "invoke",
    "handler": "h1"
   },
   "bind": {
    "t3": "/ticket"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$r3",
     "handler": "h1"
    }
   },
   "because": "HP IV-1"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 2,
     "call": "operations.get",
     "context": {
      "request": "$r3"
     },
     "args": {
      "operation_id": "$op"
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 2,
     "result": {
      "ok": true,
      "value": {
       "stdout_tail_b64": {
        "$not": {
         "$one_of": [
          {
           "$not": {
            "$b64": {
             "$starts_with": "OUTPUT-7731"
            }
           }
          },
          {
           "$b64": {
            "$contains": "hunter2"
           }
          }
         ]
        }
       },
       "stderr_tail_b64": {
        "$not": {
         "$one_of": [
          {
           "$not": {
            "$b64": {
             "$starts_with": "OUTPUT-7731"
            }
           }
          },
          {
           "$b64": {
            "$contains": "hunter2"
           }
          }
         ]
        }
       }
      }
     },
     "effect": "none"
    }
   },
   "because": "HP PX-2"
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$r3",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  },
  {
   "control": {
    "op": "hub_log"
   },
   "expect": {
    "text": {
     "$not": {
      "$one_of": [
       {
        "$contains": "hunter2"
       },
       {
        "$contains": "OUTPUT-7731"
       }
      ]
     }
    }
   },
   "because": "HP PX-2"
  }
 ]
}

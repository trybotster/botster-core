{
 "id": "conf::ev_2_pattern_wider_than_grant_refused_at_load",
 "contract": "hp",
 "clause": "EV-2",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "diagnostics",
   "load_plugin",
   "published",
   "status"
  ]
 },
 "setup": {
  "given": "the plugin holds events_plugin:b; c holds events_terminal (own sessions only)"
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      },
      {
       "id": "he",
       "kind": "event",
       "descriptor": {}
      },
      {
       "id": "hg",
       "kind": "event_gap",
       "descriptor": {}
      }
     ],
     "events": {
      "subscribed": [
       {
        "handler_id": "he",
        "pattern": {
         "owner": "*",
         "name": "*"
        }
       }
      ],
      "gap_handler": "hg"
     }
    }
   }
  },
  {
   "control": {
    "op": "status"
   },
   "expect": {
    "state": "load_failed"
   },
   "because": "HP EV-2"
  },
  {
   "control": {
    "op": "diagnostics"
   },
   "expect": {
    "load_error": {
     "kind": "capability_denied"
    }
   },
   "because": "HP EV-2"
  },
  {
   "control": {
    "op": "published"
   },
   "expect": {
    "subscriptions": []
   },
   "because": "HP EV-2"
  },
  {
   "control": {
    "op": "load_plugin",
    "plugin_key": "c",
    "as": "c"
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e_c"
    }
   },
   "on": "c",
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e_c",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      },
      {
       "id": "he",
       "kind": "event",
       "descriptor": {}
      },
      {
       "id": "hg",
       "kind": "event_gap",
       "descriptor": {}
      }
     ],
     "events": {
      "subscribed": [
       {
        "handler_id": "he",
        "pattern": {
         "owner": "terminal",
         "name": "title"
        },
        "subjects": "any"
       }
      ],
      "gap_handler": "hg"
     }
    }
   },
   "conn": "c"
  },
  {
   "control": {
    "op": "status",
    "plugin": "c"
   },
   "expect": {
    "state": "load_failed"
   },
   "because": "HP EV-2"
  },
  {
   "control": {
    "op": "diagnostics",
    "plugin": "c"
   },
   "expect": {
    "load_error": {
     "kind": "capability_denied"
    }
   },
   "because": "HP EV-2"
  },
  {
   "control": {
    "op": "published",
    "plugin": "c"
   },
   "expect": {
    "subscriptions": [],
    "handlers": []
   },
   "because": "HP EV-2"
  }
 ]
}

{
 "id": "conf::pc_3_depth_bounded",
 "contract": "hp",
 "clause": "PC-3",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "invoke",
   "load_plugin",
   "settle"
  ]
 },
 "setup": {
  "given": "plugin_call_depth is 1; demo's handler calls b (depth 1) and b's handler calls c (depth 2); the chain is valid in every other respect",
  "limits": {
   "plugin_call_depth": 1
  },
  "plugins": {
   "demo": {
    "grants": [
     {
      "surface": "plugins",
      "scope": "plugin_call:b"
     }
    ],
    "requires": [
     {
      "interface": "x.echo",
      "provider": "b",
      "tools": [
       "echo"
      ]
     }
    ]
   },
   "b": {
    "grants": [
     {
      "surface": "plugins",
      "scope": "plugin_call:c"
     }
    ],
    "requires": [
     {
      "interface": "z.echo",
      "provider": "c",
      "tools": [
       "echo"
      ]
     }
    ]
   },
   "c": {
    "grants": [],
    "requires": []
   }
  }
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      }
     ]
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "invoke",
    "handler": "h1"
   },
   "bind": {
    "t": "/ticket"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "handler": "h1"
    }
   },
   "because": "HP IV-1"
  },
  {
   "control": {
    "op": "load_plugin",
    "plugin_key": "b",
    "as": "b"
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e_b"
    }
   },
   "on": "b",
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e_b",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      }
     ],
     "tools": [
      {
       "name": "echo",
       "description": "d",
       "input_schema": {
        "type": "object"
       },
       "handler": "h1",
       "callable_by": [
        "plugins"
       ]
      }
     ]
    }
   },
   "conn": "b"
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e_b"
    }
   },
   "on": "b",
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "load_plugin",
    "plugin_key": "c",
    "as": "c"
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e_c"
    }
   },
   "on": "c",
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e_c",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      }
     ],
     "tools": [
      {
       "name": "echo",
       "description": "d",
       "input_schema": {
        "type": "object"
       },
       "handler": "h1",
       "callable_by": [
        "plugins"
       ]
      }
     ]
    }
   },
   "conn": "c"
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e_c"
    }
   },
   "on": "c",
   "because": "HP HS-2"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 1,
     "call": "plugins.call",
     "context": {
      "request": "$r"
     },
     "args": {
      "interface": "x.echo",
      "tool": "echo",
      "args": {}
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 1,
     "result": {
      "ok": true,
      "value": {
       "operation_id": "$op1",
       "kind": "plugin_call",
       "state": "queued",
       "terminal": false
      }
     },
     "effect": "committed"
    }
   },
   "because": "HP PC-1"
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e_b",
     "request_id": "$rb",
     "handler": "h1",
     "caller": {
      "kind": "plugin",
      "plugin_key": {
       "$type": "string"
      },
      "instance": {
       "$type": "string"
      }
     },
     "payload": {}
    }
   },
   "on": "b",
   "because": "HP PC-1"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e_b",
     "call_id": 1,
     "call": "plugins.call",
     "context": {
      "request": "$rb"
     },
     "args": {
      "interface": "z.echo",
      "tool": "echo",
      "args": {}
     }
    }
   },
   "conn": "b"
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e_b",
     "call_id": 1,
     "result": {
      "ok": false,
      "error": {
       "kind": {
        "$type": "string"
       }
      }
     },
     "effect": "none"
    }
   },
   "on": "b",
   "because": "HP PC-3"
  },
  {
   "expect_quiet_until": {
    "lane": "invoke",
    "type": "Invoke"
   },
   "on": "c",
   "barrier": {
    "control": {
     "op": "settle",
     "conn": "c"
    }
   },
   "until": {
    "settled": true
   },
   "because": "HP PC-3"
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  }
 ]
}

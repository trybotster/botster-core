{
 "id": "conf::ev_14_tap_needs_its_own_scope",
 "contract": "hp",
 "clause": "EV-14",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "diagnostics",
   "published",
   "status"
  ]
 },
 "setup": {
  "given": "the session s1 is spawned by the plugin; the plugin holds events_terminal; the plugin holds no session_output:read",
  "grants": [
   {
    "surface": "events",
    "scope": "events_terminal"
   }
  ]
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      },
      {
       "id": "he",
       "kind": "event",
       "descriptor": {}
      },
      {
       "id": "hg",
       "kind": "event_gap",
       "descriptor": {}
      }
     ],
     "events": {
      "subscribed": [
       {
        "handler_id": "he",
        "pattern": {
         "owner": "terminal",
         "name": "output"
        }
       }
      ],
      "gap_handler": "hg"
     }
    }
   }
  },
  {
   "control": {
    "op": "status"
   },
   "expect": {
    "state": "load_failed"
   },
   "because": "HP EV-14"
  },
  {
   "control": {
    "op": "diagnostics"
   },
   "expect": {
    "load_error": {
     "kind": "capability_denied"
    }
   },
   "because": "HP EV-14"
  },
  {
   "control": {
    "op": "published"
   },
   "expect": {
    "subscriptions": []
   },
   "because": "HP EV-14"
  }
 ]
}

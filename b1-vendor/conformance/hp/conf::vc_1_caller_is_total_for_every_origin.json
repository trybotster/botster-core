{
 "id": "conf::vc_1_caller_is_total_for_every_origin",
 "contract": "hp",
 "clause": "VC-1",
 "subject": "plugin_hub",
 "requires": {
  "controls": [
   "invoke"
  ]
 },
 "setup": {
  "proofs": {
   "op_socket": {
    "kind": "operator"
   },
   "op_rtc": {
    "kind": "operator",
    "credential_id": "cred-1"
   },
   "tok_s1": {
    "kind": "session",
    "session": {
     "hub_id": "hub-1",
     "session_id": "s1"
    }
   }
  },
  "given": "an operator on the Unix socket (no credential id), an operator with WebRTC credential cred-1, and a session s1 with a valid bearer token"
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      }
     ]
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "invoke",
    "handler": "h1",
    "kind": "timer",
    "origin": "timer"
   },
   "bind": {
    "t1": "/ticket"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$r1",
     "handler": "h1",
     "caller": {
      "kind": "system"
     }
    }
   },
   "because": "HP VC-1"
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$r1",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  },
  {
   "control": {
    "op": "invoke",
    "handler": "h1",
    "kind": "event",
    "origin": "event",
    "source": {
     "kind": "hub",
     "instance": "i-hub"
    }
   },
   "bind": {
    "t2": "/ticket"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$r2",
     "handler": "h1",
     "caller": {
      "kind": "system"
     }
    }
   },
   "because": "HP VC-1"
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$r2",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  },
  {
   "control": {
    "op": "invoke",
    "handler": "h1",
    "kind": "store_watch",
    "origin": "store_watch"
   },
   "bind": {
    "t3": "/ticket"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$r3",
     "handler": "h1",
     "caller": {
      "kind": {
       "$one_of": [
        "operator",
        "plugin",
        "session",
        "system"
       ]
      }
     }
    }
   },
   "because": "HP VC-1"
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$r3",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  },
  {
   "control": {
    "op": "invoke",
    "handler": "h1",
    "kind": "mcp_tool",
    "origin": "mcp_tool",
    "proof": "op_socket"
   },
   "bind": {
    "t4": "/ticket"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$r4",
     "handler": "h1",
     "caller": {
      "kind": {
       "$one_of": [
        "operator",
        "plugin",
        "session",
        "system"
       ]
      }
     }
    }
   },
   "because": "HP VC-1"
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$r4",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  },
  {
   "control": {
    "op": "invoke",
    "handler": "h1",
    "kind": "ui_action",
    "origin": "ui_action",
    "proof": "tok_s1"
   },
   "bind": {
    "t5": "/ticket"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$r5",
     "handler": "h1",
     "caller": {
      "kind": {
       "$one_of": [
        "operator",
        "plugin",
        "session",
        "system"
       ]
      }
     }
    }
   },
   "because": "HP VC-1"
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$r5",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  }
 ]
}

{
 "id": "conf::nt_8_bootstrap_has_no_network",
 "contract": "hp",
 "clause": "NT-8",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "net_seen",
   "net_world"
  ]
 },
 "setup": {
  "given": "the plugin holds net with allow [https://api.example]; the outside world is scripted by net_world",
  "grants": [
   {
    "surface": "net",
    "scope": "net",
    "allow": [
     "https://api.example"
    ]
   }
  ]
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "control": {
    "op": "net_world",
    "endpoints": [
     {
      "origin": "https://api.example",
      "addresses": [
       "203.0.113.5"
      ],
      "answers": [
       {
        "status": 200,
        "body_b64": "b2s="
       }
      ]
     }
    ]
   }
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 1,
     "call": "http.request",
     "context": "bootstrap",
     "args": {
      "method": "GET",
      "url": "https://api.example/x",
      "timeout_ms": 1000
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 1,
     "result": {
      "ok": false,
      "error": {
       "kind": "failed",
       "detail": {
        "code": "wrong_context"
       }
      }
     },
     "effect": "none"
    }
   },
   "because": [
    "HP NT-8",
    "HP HS-7"
   ]
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 2,
     "call": "ws.open",
     "context": "bootstrap",
     "args": {
      "url": "wss://ws.example/s"
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 2,
     "result": {
      "ok": false,
      "error": {
       "kind": "failed",
       "detail": {
        "code": "wrong_context"
       }
      }
     },
     "effect": "none"
    }
   },
   "because": [
    "HP NT-8",
    "HP HS-7"
   ]
  },
  {
   "control": {
    "op": "net_seen"
   },
   "expect": {
    "requests": {
     "$array": {
      "max": 0
     }
    },
    "connects": {
     "$array": {
      "max": 0
     }
    }
   },
   "because": "HP NT-8"
  }
 ]
}

{
 "id": "conf::pm_1_package_has_one_source",
 "contract": "hp",
 "clause": "PM-1",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "await_package",
   "client_read",
   "client_verb",
   "local_dir",
   "script_git"
  ]
 },
 "setup": {
  "given": "demo is installed from a git url; the operator then installs a local directory that holds a package of the same name",
  "plugins": {
   "demo": {
    "grants": []
   }
  }
 },
 "steps": [
  {
   "control": {
    "op": "script_git",
    "url": "https://git.example/a.git",
    "refs": {
     "v1": {
      "commit": "1111111111111111111111111111111111111111",
      "files": {
       "botster-plugin.json": {
        "json": {
         "botster_plugin_api": 1,
         "name": "demo",
         "version": "1.0.0",
         "entrypoints": {
          "service": {
           "lua": "main.lua"
          }
         }
        }
       },
       "main.lua": {
        "text": "-- v1.0.0\n"
       }
      }
     }
    }
   }
  },
  {
   "control": {
    "op": "local_dir",
    "name": "d1",
    "files": {
     "botster-plugin.json": {
      "json": {
       "botster_plugin_api": 1,
       "name": "demo",
       "version": "1.0.0",
       "entrypoints": {
        "service": {
         "lua": "main.lua"
        }
       }
      }
     },
     "main.lua": {
      "text": "-- v1.0.0\n"
     }
    }
   },
   "bind": {
    "p": "/path"
   }
  },
  {
   "control": {
    "op": "client_verb",
    "kind": "package",
    "verb": "create",
    "args": {
     "source": {
      "kind": "git",
      "url": "https://git.example/a.git",
      "ref": "v1"
     }
    }
   },
   "expect": {
    "accepted": {
     "operation_id": {
      "$type": "string"
     }
    }
   },
   "because": "HP PM-5"
  },
  {
   "control": {
    "op": "await_package",
    "package": "demo",
    "settled": true
   },
   "because": "HP PM-5"
  },
  {
   "control": {
    "op": "client_verb",
    "kind": "package",
    "verb": "create",
    "args": {
     "source": {
      "kind": "local",
      "path": "$p"
     }
    }
   },
   "expect": {
    "error": {
     "$type": "object"
    }
   },
   "because": "HP PM-1"
  },
  {
   "control": {
    "op": "client_read",
    "kind": "package",
    "id": "demo"
   },
   "expect": {
    "source": {
     "kind": "git",
     "url": "https://git.example/a.git"
    }
   },
   "because": "HP PM-1"
  }
 ]
}

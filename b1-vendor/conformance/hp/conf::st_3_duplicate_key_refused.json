     "args": {
      "ops": [
       {
        "op": "put",
        "collection": "c",
        "id": "a",
        "doc": {
         "n": 1
        }
       },
       {
        "op": "put",
        "collection": "c",
        "id": "a",
        "doc": {
         "n": 2
        }
       }
      ]
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 1,
     "result": {
      "ok": false,
      "error": {
       "kind": "invalid_request"
      }

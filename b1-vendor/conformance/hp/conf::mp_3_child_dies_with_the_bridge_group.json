{
 "id": "conf::mp_3_child_dies_with_the_bridge_group",
 "contract": "hp",
 "clause": "MP-3",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "await_mcp_server",
   "child_alive",
   "script_mcp",
   "unload"
  ]
 },
 "setup": {
  "given": "the stdio server runs as a real child of the bridge in the bridge's process group; the plugin is then unloaded",
  "plugins": {
   "demo": {
    "grants": [
     {
      "surface": "mcp",
      "scope": "mcp_proxy"
     },
     {
      "surface": "mcp",
      "scope": "mcp_proxy_stdio"
     },
     {
      "surface": "net",
      "scope": "net",
      "allow": [
       "https://mcp.example"
      ]
     }
    ],
    "mcp_servers": [
     {
      "id": "s",
      "transport": "stdio",
      "command": "mcp-server",
      "args": [
       "--x"
      ],
      "env": {
       "A": "1"
      }
     }
    ],
    "entry": "the plugin declares the MCP servers in its manifest (MP-1)"
   }
  }
 },
 "steps": [
  {
   "control": {
    "op": "script_mcp",
    "plugin": "demo",
    "server": "s",
    "transport": "stdio",
    "tools": [
     {
      "name": "echo",
      "description": "echo tool",
      "inputSchema": {
       "type": "object",
       "properties": {
        "n": {
         "type": "integer"
        }
       }
      },
      "behavior": {
       "kind": "echo"
      }
     }
    ]
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      }
     ]
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "await_mcp_server",
    "plugin": "demo",
    "server": "s",
    "state": "available"
   }
  },
  {
   "control": {
    "op": "child_alive",
    "plugin": "demo",
    "server": "s"
   },
   "expect": {
    "alive": true
   },
   "because": "HP MP-3"
  },
  {
   "control": {
    "op": "unload"
   }
  },
  {
   "control": {
    "op": "child_alive",
    "plugin": "demo",
    "server": "s"
   },
   "expect": {
    "alive": false
   },
   "because": "HP MP-3"
  }
 ]
}

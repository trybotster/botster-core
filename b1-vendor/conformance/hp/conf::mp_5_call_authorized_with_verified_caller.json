{
 "id": "conf::mp_5_call_authorized_with_verified_caller",
 "contract": "hp",
 "clause": "MP-5",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "await_mcp_server",
   "mcp_call",
   "mcp_response",
   "mcp_server_log",
   "script_mcp"
  ]
 },
 "setup": {
  "given": "a session caller and the operator each call the proxied tool",
  "plugins": {
   "demo": {
    "grants": [
     {
      "surface": "mcp",
      "scope": "mcp_proxy"
     },
     {
      "surface": "mcp",
      "scope": "mcp_proxy_stdio"
     },
     {
      "surface": "net",
      "scope": "net",
      "allow": [
       "https://mcp.example"
      ]
     }
    ],
    "mcp_servers": [
     {
      "id": "s",
      "transport": "stdio",
      "command": "mcp-server",
      "args": [
       "--x"
      ],
      "env": {
       "A": "1"
      }
     }
    ],
    "entry": "the plugin declares the MCP servers in its manifest (MP-1)"
   }
  }
 },
 "steps": [
  {
   "control": {
    "op": "script_mcp",
    "plugin": "demo",
    "server": "s",
    "transport": "stdio",
    "tools": [
     {
      "name": "echo",
      "description": "echo tool",
      "inputSchema": {
       "type": "object",
       "properties": {
        "n": {
         "type": "integer"
        }
       }
      },
      "behavior": {
       "kind": "echo"
      }
     }
    ]
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      }
     ]
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "await_mcp_server",
    "plugin": "demo",
    "server": "s",
    "state": "available"
   }
  },
  {
   "control": {
    "op": "mcp_call",
    "tool": "demo__s__echo",
    "arguments": {
     "n": 1
    },
    "client": {
     "token_of_session": {
      "hub_id": "hub-1",
      "session_id": "s1"
     }
    }
   },
   "bind": {
    "tk1": "/ticket"
   },
   "because": "HP MP-5"
  },
  {
   "control": {
    "op": "mcp_response",
    "ticket": "$tk1"
   },
   "expect": {
    "is_error": false
   },
   "because": "HP MP-5"
  },
  {
   "control": {
    "op": "mcp_call",
    "tool": "demo__s__echo",
    "arguments": {
     "n": 2
    }
   },
   "bind": {
    "tk2": "/ticket"
   },
   "because": "HP MP-5"
  },
  {
   "control": {
    "op": "mcp_response",
    "ticket": "$tk2"
   },
   "expect": {
    "is_error": false
   },
   "because": "HP MP-5"
  },
  {
   "control": {
    "op": "mcp_server_log",
    "plugin": "demo",
    "server": "s"
   },
   "expect": {
    "messages": {
     "$array": {
      "each": {
       "dir": {
        "$type": "string"
       }
      },
      "min": 1
     }
    }
   },
   "because": "HP MP-5"
  },
  {
   "control": {
    "op": "mcp_server_log",
    "plugin": "demo",
    "server": "s"
   },
   "expect": {
    "calls": [
     {
      "params": {
       "name": "echo",
       "_meta": {
        "botster/caller": {
         "kind": "session",
         "session": {
          "hub_id": "hub-1",
          "session_id": "s1"
         }
        }
       }
      }
     },
     {
      "params": {
       "name": "echo",
       "_meta": {
        "botster/caller": {
         "kind": "operator"
        }
       }
      }
     }
    ]
   },
   "because": "HP MP-5"
  }
 ]
}

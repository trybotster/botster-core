{
 "id": "conf::ca_15_worktree_optional_at_accept",
 "contract": "hp",
 "clause": "CA-15",
 "subject": "plugin_hub",
 "requires": {
  "controls": [
   "invoke"
  ]
 },
 "setup": {
  "given": "the worktree is created after the launch is accepted",
  "calls": {
   "session_types.ensure_worktree_and_spawn": [
    {
     "result": {
      "ok": true,
      "value": {
       "operation_id": "op1",
       "kind": "spawn",
       "session": {
        "hub_id": "hub-1",
        "session_id": "s1"
       },
       "state": "starting",
       "terminal": false
      }
     },
     "effect": "committed"
    }
   ],
   "operations.get": [
    {
     "result": {
      "ok": true,
      "value": {
       "operation_id": "op1",
       "kind": "spawn",
       "state": "installed",
       "terminal": true,
       "session": {
        "hub_id": "hub-1",
        "session_id": "s1"
       },
       "worktree": {
        "worktree_id": "w9",
        "target_id": "t1",
        "label": "w",
        "path": "wt/w9",
        "status": "ready",
        "metadata": {}
       }
      }
     },
     "effect": "none"
    }
   ]
  }
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      }
     ]
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "invoke",
    "handler": "h1"
   },
   "bind": {
    "t": "/ticket"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "handler": "h1"
    }
   },
   "because": "HP IV-1"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 1,
     "call": "session_types.ensure_worktree_and_spawn",
     "context": {
      "request": "$r"
     },
     "args": {
      "session_type_id": "dev",
      "target_id": "t1",
      "worktree": {
       "branch": "feat"
      }
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 1,
     "result": {
      "ok": true,
      "value": {
       "operation_id": "$op",
       "session": {
        "hub_id": "$h",
        "session_id": "$sid"
       },
       "state": "starting",
       "terminal": false
      }
     },
     "effect": "committed"
    }
   },
   "because": "HP CA-15"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 2,
     "call": "operations.get",
     "context": {
      "request": "$r"
     },
     "args": {
      "operation_id": "$op"
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 2,
     "result": {
      "ok": true,
      "value": {
       "terminal": true,
       "worktree": {
        "worktree_id": {
         "$type": "string"
        }
       }
      }
     },
     "effect": "none"
    }
   },
   "because": "HP CA-15"
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  }
 ]
}

{
 "id": "conf::px_3_concurrency_bounded",
 "contract": "hp",
 "clause": "PX-3",
 "subject": "plugin_hub",
 "requires": {
  "controls": [
   "invoke"
  ]
 },
 "setup": {
  "given": "one command runs; process_concurrent is 1",
  "limits": {
   "process_concurrent": 1
  },
  "calls": {
   "process.run": [
    {
     "result": {
      "ok": true,
      "value": {
       "operation_id": "op1",
       "kind": "process",
       "state": "queued",
       "terminal": false
      }
     },
     "effect": "committed"
    },
    {
     "result": {
      "ok": false,
      "error": {
       "kind": "backpressured",
       "message": "backpressured",
       "retryable": false
      }
     },
     "effect": "none"
    }
   ]
  }
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      }
     ]
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "invoke",
    "handler": "h1"
   },
   "bind": {
    "t": "/ticket"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "handler": "h1"
    }
   },
   "because": "HP IV-1"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 1,
     "call": "process.run",
     "context": {
      "request": "$r"
     },
     "args": {
      "argv": [
       "sleep",
       "5"
      ],
      "timeout_ms": 10000
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 1,
     "result": {
      "ok": true,
      "value": {
       "state": "queued"
      }
     },
     "effect": "committed"
    }
   },
   "because": "HP PX-1"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 2,
     "call": "process.run",
     "context": {
      "request": "$r"
     },
     "args": {
      "argv": [
       "sleep",
       "5"
      ],
      "timeout_ms": 10000
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 2,
     "result": {
      "ok": false
     },
     "effect": "none"
    }
   },
   "because": "HP PX-3"
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  }
 ]
}

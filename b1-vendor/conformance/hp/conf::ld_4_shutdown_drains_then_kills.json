{
 "id": "conf::ld_4_shutdown_drains_then_kills",
 "contract": "hp",
 "clause": "LD-4",
 "subject": "plugin_hub",
 "requires": {
  "controls": [
   "invoke",
   "unload",
   "status",
   "settle"
  ]
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      }
     ]
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "invoke",
    "handler": "h1"
   },
   "bind": {
    "t": "/ticket"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "handler": "h1"
    }
   },
   "because": "HP IV-1"
  },
  {
   "control": {
    "op": "unload"
   }
  },
  {
   "control": {
    "op": "invoke",
    "handler": "h1"
   },
   "bind": {
    "t2": "/ticket"
   }
  },
  {
   "expect_quiet_until": {
    "lane": "control",
    "type": "Shutdown"
   },
   "barrier": {
    "control": {
     "op": "settle"
    }
   },
   "until": {
    "settled": true
   },
   "because": "HP LD-4"
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Shutdown",
    "payload": {
     "epoch": "$e",
     "deadline_ms": "$d"
    }
   },
   "because": "HP LD-4"
  },
  {
   "expect_quiet_until": {
    "lane": "invoke",
    "type": "Invoke"
   },
   "barrier": {
    "control": {
     "op": "settle"
    }
   },
   "until": {
    "settled": true
   },
   "because": "HP LD-4"
  },
  {
   "advance_clock": {
    "ms": "$d"
   }
  },
  {
   "expect_closed": null,
   "because": "HP LD-4"
  },
  {
   "control": {
    "op": "status"
   },
   "expect": {
    "state": "unloaded"
   },
   "because": "HP LD-4"
  }
 ]
}

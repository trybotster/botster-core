{
 "id": "conf::md_4_stale_epoch_dropped",
 "contract": "hp",
 "clause": "MD-4",
 "subject": "plugin_hub",
 "requires": {
  "controls": [
   "invoke",
   "completions",
   "counters",
   "settle"
  ]
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      }
     ]
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "invoke",
    "handler": "h1"
   },
   "bind": {
    "t": "/ticket"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "handler": "h1"
    }
   },
   "because": "HP IV-1"
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "999999999999",
     "request_id": "$r",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "999999999999",
     "call_id": 31,
     "call": "hub.identity",
     "context": {
      "request": "$r"
     },
     "args": {}
    }
   }
  },
  {
   "expect_quiet_until": {
    "type": "HostResult"
   },
   "barrier": {
    "control": {
     "op": "settle"
    }
   },
   "until": {
    "settled": true
   },
   "because": "HP MD-4"
  },
  {
   "control": {
    "op": "completions"
   },
   "expect": [],
   "because": "HP MD-4"
  },
  {
   "control": {
    "op": "counters"
   },
   "expect": {
    "stale_dropped": 2
   },
   "because": "HP MD-4"
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  },
  {
   "control": {
    "op": "completions"
   },
   "expect": [
    {
     "ticket": "$t",
     "answer": {
      "ok": true
     }
    }
   ],
   "because": "HP MD-4"
  }
 ],
 "setup": {
  "calls": {
   "hub.identity": [
    {
     "result": {
      "ok": true,
      "value": {
       "hub_id": "hub-1",
       "display_name": "hub"
      }
     }
    }
   ]
  }
 }
}

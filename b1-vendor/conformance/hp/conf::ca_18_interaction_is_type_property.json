{
 "id": "conf::ca_18_interaction_is_type_property",
 "contract": "hp",
 "clause": "CA-18",
 "subject": "plugin_hub",
 "requires": {
  "controls": [
   "invoke"
  ]
 },
 "setup": {
  "given": "the session type gate declares interaction noninteractive",
  "calls": {
   "session_types.show": [
    {
     "result": {
      "ok": true,
      "value": {
       "definition": {
        "id": "gate",
        "source": "device",
        "label": "g",
        "description": "d",
        "editable": false,
        "targets": [],
        "interaction": "noninteractive",
        "presentation": "hidden"
       }
      }
     },
     "effect": "none"
    }
   ],
   "session_types.spawn": [
    {
     "result": {
      "ok": false,
      "error": {
       "kind": "invalid_request",
       "message": "invalid_request",
       "retryable": false
      }
     },
     "effect": "none"
    },
    {
     "result": {
      "ok": true,
      "value": {
       "operation_id": "op1",
       "kind": "spawn",
       "session": {
        "hub_id": "hub-1",
        "session_id": "s1"
       },
       "state": "starting",
       "terminal": false
      }
     },
     "effect": "committed"
    }
   ],
   "sessions.get": [
    {
     "result": {
      "ok": true,
      "value": {
       "id": "s1",
       "hub_id": "hub-1",
       "label": "l",
       "state": "starting",
       "lifecycle_class": "current",
       "exit": {},
       "size": {
        "rows": 24,
        "cols": 80
       },
       "session_type": {
        "id": "t",
        "source": "device"
       },
       "traits": [],
       "restartable": false,
       "activity": "idle",
       "presentation": "default",
       "metadata": {},
       "interaction": "noninteractive"
      }
     },
     "effect": "none"
    }
   ]
  }
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      }
     ]
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "invoke",
    "handler": "h1"
   },
   "bind": {
    "t": "/ticket"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "handler": "h1"
    }
   },
   "because": "HP IV-1"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 1,
     "call": "session_types.show",
     "context": {
      "request": "$r"
     },
     "args": {
      "target_id": "t1",
      "session_type_id": "gate"
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 1,
     "result": {
      "ok": true,
      "value": {
       "definition": {
        "interaction": "noninteractive"
       }
      }
     },
     "effect": "none"
    }
   },
   "because": "HP CA-18"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 2,
     "call": "session_types.spawn",
     "context": {
      "request": "$r"
     },
     "args": {
      "session_type_id": "gate",
      "target_id": "t1",
      "interaction": "interactive"
     }
    }
   },
   "violates_args": "CA-18: the caller never chooses the interaction class"
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 2,
     "result": {
      "ok": false,
      "error": {
       "kind": "invalid_request"
      }
     },
     "effect": "none"
    }
   },
   "because": "HP CA-18"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 3,
     "call": "session_types.spawn",
     "context": {
      "request": "$r"
     },
     "args": {
      "session_type_id": "gate",
      "target_id": "t1"
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 3,
     "result": {
      "ok": true,
      "value": {
       "operation_id": "$op",
       "session": {
        "hub_id": "$h",
        "session_id": "$sid"
       },
       "state": "starting",
       "terminal": false
      }
     },
     "effect": "committed"
    }
   },
   "because": "HP CA-18"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 4,
     "call": "sessions.get",
     "context": {
      "request": "$r"
     },
     "args": {
      "session": {
       "hub_id": "$h",
       "session_id": "$sid"
      }
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 4,
     "result": {
      "ok": true,
      "value": {
       "interaction": "noninteractive"
      }
     },
     "effect": "none"
    }
   },
   "because": "HP CA-18"
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  }
 ]
}

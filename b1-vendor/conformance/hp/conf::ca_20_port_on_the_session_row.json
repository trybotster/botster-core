{
 "id": "conf::ca_20_port_on_the_session_row",
 "contract": "hp",
 "clause": "CA-20",
 "subject": "plugin_hub",
 "requires": {
  "controls": [
   "invoke"
  ]
 },
 "setup": {
  "given": "the session type dev allocates a port; the type plain does not; session_port_range is [20000, 20100]",
  "calls": {
   "session_types.spawn": [
    {
     "result": {
      "ok": true,
      "value": {
       "operation_id": "op1",
       "kind": "spawn",
       "session": {
        "hub_id": "hub-1",
        "session_id": "s1"
       },
       "state": "starting",
       "terminal": false
      }
     },
     "effect": "committed"
    },
    {
     "result": {
      "ok": true,
      "value": {
       "operation_id": "op2",
       "kind": "spawn",
       "session": {
        "hub_id": "hub-1",
        "session_id": "s2"
       },
       "state": "starting",
       "terminal": false
      }
     },
     "effect": "committed"
    }
   ],
   "sessions.get": [
    {
     "result": {
      "ok": true,
      "value": {
       "id": "s1",
       "hub_id": "hub-1",
       "label": "l",
       "state": "running",
       "lifecycle_class": "current",
       "exit": {},
       "size": {
        "rows": 24,
        "cols": 80
       },
       "session_type": {
        "id": "t",
        "source": "device"
       },
       "traits": [],
       "restartable": false,
       "activity": "idle",
       "presentation": "default",
       "metadata": {},
       "port": 20001
      }
     },
     "effect": "none"
    },
    {
     "result": {
      "ok": true,
      "value": {
       "id": "s2",
       "hub_id": "hub-1",
       "label": "l",
       "state": "running",
       "lifecycle_class": "current",
       "exit": {},
       "size": {
        "rows": 24,
        "cols": 80
       },
       "session_type": {
        "id": "t",
        "source": "device"
       },
       "traits": [],
       "restartable": false,
       "activity": "idle",
       "presentation": "default",
       "metadata": {}
      }
     },
     "effect": "none"
    }
   ]
  }
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      }
     ]
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "invoke",
    "handler": "h1"
   },
   "bind": {
    "t": "/ticket"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "handler": "h1"
    }
   },
   "because": "HP IV-1"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 1,
     "call": "session_types.spawn",
     "context": {
      "request": "$r"
     },
     "args": {
      "session_type_id": "dev",
      "target_id": "t1"
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 1,
     "result": {
      "ok": true,
      "value": {
       "session": {
        "hub_id": "$h",
        "session_id": "$s1"
       }
      }
     },
     "effect": "committed"
    }
   },
   "because": "HP CA-20"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 2,
     "call": "session_types.spawn",
     "context": {
      "request": "$r"
     },
     "args": {
      "session_type_id": "plain",
      "target_id": "t1"
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 2,
     "result": {
      "ok": true,
      "value": {
       "session": {
        "hub_id": "$h",
        "session_id": "$s2"
       }
      }
     },
     "effect": "committed"
    }
   },
   "because": "HP CA-20"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 3,
     "call": "sessions.get",
     "context": {
      "request": "$r"
     },
     "args": {
      "session": {
       "hub_id": "$h",
       "session_id": "$s1"
      }
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 3,
     "result": {
      "ok": true,
      "value": {
       "port": {
        "$between": [
         20000,
         20100
        ]
       }
      }
     },
     "effect": "none"
    }
   },
   "because": "HP CA-20"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 4,
     "call": "sessions.get",
     "context": {
      "request": "$r"
     },
     "args": {
      "session": {
       "hub_id": "$h",
       "session_id": "$s2"
      }
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 4,
     "result": {
      "ok": true,
      "value": {
       "port": {
        "$absent": true
       }
      }
     },
     "effect": "none"
    }
   },
   "because": "HP CA-20"
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  }
 ]
}

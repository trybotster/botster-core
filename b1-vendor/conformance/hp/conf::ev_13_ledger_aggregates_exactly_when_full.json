{
 "id": "conf::ev_13_ledger_aggregates_exactly_when_full",
 "contract": "hp",
 "clause": "EV-13",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "emit_events",
   "invoke"
  ]
 },
 "setup": {
  "given": "six distinct names of the owner hub reach a normal queue of one copy while the handler h1 runs; the ledger holds four entries",
  "limits": {
   "event_queue_normal": 1,
   "loss_ledger_entries": 4
  }
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      },
      {
       "id": "he",
       "kind": "event",
       "descriptor": {}
      },
      {
       "id": "hg",
       "kind": "event_gap",
       "descriptor": {}
      }
     ],
     "events": {
      "subscribed": [
       {
        "handler_id": "he",
        "pattern": {
         "owner": "hub",
         "name": "*"
        }
       }
      ],
      "gap_handler": "hg"
     }
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "invoke",
    "handler": "h1"
   },
   "bind": {
    "t": "/ticket"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "handler": "h1"
    }
   },
   "because": "HP IV-1"
  },
  {
   "control": {
    "op": "emit_events",
    "emitters": [
     {
      "owner": "hub",
      "name": "n1",
      "count": 1
     }
    ]
   }
  },
  {
   "control": {
    "op": "emit_events",
    "emitters": [
     {
      "owner": "hub",
      "name": "n2",
      "count": 1
     }
    ]
   }
  },
  {
   "control": {
    "op": "emit_events",
    "emitters": [
     {
      "owner": "hub",
      "name": "n3",
      "count": 1
     }
    ]
   }
  },
  {
   "control": {
    "op": "emit_events",
    "emitters": [
     {
      "owner": "hub",
      "name": "n4",
      "count": 1
     }
    ]
   }
  },
  {
   "control": {
    "op": "emit_events",
    "emitters": [
     {
      "owner": "hub",
      "name": "n5",
      "count": 1
     }
    ]
   }
  },
  {
   "control": {
    "op": "emit_events",
    "emitters": [
     {
      "owner": "hub",
      "name": "n6",
      "count": 1
     }
    ]
   }
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$g",
     "handler": "hg",
     "origin": "event_gap",
     "payload": {
      "owner": "hub",
      "name": "*",
      "count": 5,
      "aggregated": true
     }
    }
   },
   "because": "HP EV-13"
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$g",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$c6",
     "handler": "he",
     "origin": "event",
     "payload": {
      "owner": "hub",
      "name": "n6"
     }
    }
   },
   "because": "HP EV-13"
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$c6",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  }
 ]
}

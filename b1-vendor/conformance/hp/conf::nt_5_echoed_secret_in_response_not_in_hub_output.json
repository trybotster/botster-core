{
 "id": "conf::nt_5_echoed_secret_in_response_not_in_hub_output",
 "contract": "hp",
 "clause": "NT-5",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "await_operation",
   "hub_output",
   "invoke",
   "net_world"
  ]
 },
 "setup": {
  "given": "the plugin holds net with allow [https://api.example] and declares the secret bot_token (the operator set the value s3cret-TOKEN); the outside world is scripted by net_world; the endpoint echoes the request header X-Token in its response body",
  "grants": [
   {
    "surface": "net",
    "scope": "net",
    "allow": [
     "https://api.example"
    ]
   }
  ]
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      },
      {
       "id": "op",
       "kind": "operation",
       "descriptor": {}
      },
      {
       "id": "he",
       "kind": "event",
       "descriptor": {}
      },
      {
       "id": "hg",
       "kind": "event_gap",
       "descriptor": {}
      }
     ],
     "operations": {
      "subscribed": "op"
     }
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "invoke",
    "handler": "h1"
   },
   "bind": {
    "t": "/ticket"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "handler": "h1"
    }
   },
   "because": "HP IV-1"
  },
  {
   "control": {
    "op": "net_world",
    "endpoints": [
     {
      "origin": "https://api.example",
      "addresses": [
       "203.0.113.5"
      ],
      "answers": [
       {
        "status": 200,
        "echo_header": "X-Token"
       }
      ]
     }
    ]
   }
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 1,
     "call": "http.request",
     "context": {
      "request": "$r"
     },
     "args": {
      "method": "GET",
      "url": "https://api.example/x",
      "timeout_ms": 1000,
      "headers": [
       [
        "X-Token",
        "{{secret:bot_token}}"
       ]
      ]
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 1,
     "result": {
      "ok": true,
      "value": {
       "operation_id": "$op26",
       "kind": "http",
       "state": "queued",
       "terminal": false
      }
     },
     "effect": "committed"
    }
   },
   "because": "HP NT-5"
  },
  {
   "control": {
    "op": "await_operation",
    "operation_id": "$op26",
    "terminal": true
   }
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 2,
     "call": "operations.get",
     "context": {
      "request": "$r"
     },
     "args": {
      "operation_id": "$op26"
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 2,
     "result": {
      "ok": true,
      "value": {
       "operation_id": "$op26",
       "kind": "http",
       "state": "done",
       "terminal": true,
       "status": 200,
       "body_b64": {
        "$b64": {
         "$contains": "s3cret-TOKEN"
        }
       }
      }
     },
     "effect": "none"
    }
   },
   "because": "HP NT-5"
  },
  {
   "control": {
    "op": "hub_output"
   },
   "expect": {
    "log": {
     "$not": {
      "$contains": "s3cret-TOKEN"
     }
    },
    "events": {
     "$not": {
      "$contains": "s3cret-TOKEN"
     }
    },
    "receipts": {
     "$not": {
      "$contains": "s3cret-TOKEN"
     }
    },
    "errors": {
     "$not": {
      "$contains": "s3cret-TOKEN"
     }
    },
    "call_results": {
     "$not": {
      "$contains": "s3cret-TOKEN"
     }
    }
   },
   "because": "HP NT-5"
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  }
 ]
}

{
 "id": "conf::vc_3_old_token_refused_after_restart",
 "contract": "hp",
 "clause": "VC-3",
 "subject": "plugin_hub",
 "requires": {
  "controls": [
   "invoke"
  ]
 },
 "setup": {
  "proofs": {
   "tok_run1": {
    "kind": "session",
    "session": {
     "hub_id": "hub-1",
     "session_id": "s1"
    }
   }
  },
  "given": "session s1 runs with token tok_run1; the control restart_session restarts it as a new run with token tok_run2; end_session ends the run",
  "controls": {
   "restart_session": {
    "revoke": [
     "tok_run1"
    ],
    "grant": {
     "tok_run2": {
      "kind": "session",
      "session": {
       "hub_id": "hub-1",
       "session_id": "s1"
      }
     }
    }
   },
   "end_session": {
    "revoke": [
     "tok_run2"
    ]
   }
  }
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      }
     ]
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "invoke",
    "handler": "h1",
    "proof": "tok_run1"
   },
   "bind": {
    "t1": "/ticket"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$r1",
     "handler": "h1",
     "caller": {
      "kind": "session",
      "session": {
       "session_id": "s1"
      }
     }
    }
   },
   "because": "HP VC-3"
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$r1",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  },
  {
   "control": {
    "op": "restart_session"
   }
  },
  {
   "control": {
    "op": "invoke",
    "handler": "h1",
    "proof": "tok_run1"
   },
   "bind": {
    "t2": "/ticket"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$r2",
     "handler": "h1",
     "caller": {
      "kind": "system"
     }
    }
   },
   "because": "HP VC-3"
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$r2",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  },
  {
   "control": {
    "op": "invoke",
    "handler": "h1",
    "proof": "tok_run2"
   },
   "bind": {
    "t3": "/ticket"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$r3",
     "handler": "h1",
     "caller": {
      "kind": "session",
      "session": {
       "session_id": "s1"
      }
     }
    }
   },
   "because": "HP VC-3"
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$r3",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  },
  {
   "control": {
    "op": "end_session"
   }
  },
  {
   "control": {
    "op": "invoke",
    "handler": "h1",
    "proof": "tok_run2"
   },
   "bind": {
    "t4": "/ticket"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$r4",
     "handler": "h1",
     "caller": {
      "kind": "system"
     }
    }
   },
   "because": "HP VC-3"
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$r4",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  }
 ]
}

{
 "id": "conf::as_1_quota_bounded",
 "contract": "hp",
 "clause": "AS-1",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "invoke"
  ]
 },
 "setup": {
  "given": "asset_bytes_max is 64, asset_store_bytes is 100 and asset_count_max is 3; each refusal below exceeds one bound only; the package of demo declares the embed view view (permission embed.view, action refresh) and the viewer holds embed.view",
  "limits": {
   "asset_bytes_max": 64,
   "asset_count_max": 3,
   "asset_store_bytes": 100
  },
  "plugins": {
   "demo": {
    "grants": [
     {
      "surface": "assets"
     }
    ],
    "views": [
     {
      "key": "view",
      "kind": "embed",
      "permission": "embed.view",
      "actions": [
       {
        "id": "refresh",
        "handler": "h1"
       }
      ]
     }
    ]
   }
  }
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      }
     ]
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "invoke",
    "handler": "h1"
   },
   "bind": {
    "t": "/ticket"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "handler": "h1"
    }
   },
   "because": "HP IV-1"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 1,
     "call": "assets.publish",
     "context": {
      "request": "$r"
     },
     "args": {
      "name": "over-asset",
      "content_type": "text/html",
      "bytes_b64": "eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHg="
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 1,
     "result": {
      "ok": false,
      "error": {
       "kind": "quota_exceeded"
      }
     },
     "effect": "none"
    }
   },
   "because": "HP AS-1"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 2,
     "call": "assets.publish",
     "context": {
      "request": "$r"
     },
     "args": {
      "name": "one",
      "content_type": "text/html",
      "bytes_b64": "eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4"
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 2,
     "result": {
      "ok": true,
      "value": {
       "asset_id": "$a1"
      }
     },
     "effect": "committed"
    }
   },
   "because": "HP AS-1"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 3,
     "call": "assets.publish",
     "context": {
      "request": "$r"
     },
     "args": {
      "name": "over-store",
      "content_type": "text/html",
      "bytes_b64": "eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4"
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 3,
     "result": {
      "ok": false,
      "error": {
       "kind": "quota_exceeded"
      }
     },
     "effect": "none"
    }
   },
   "because": "HP AS-1"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 4,
     "call": "assets.publish",
     "context": {
      "request": "$r"
     },
     "args": {
      "name": "two",
      "content_type": "text/html",
      "bytes_b64": "eA=="
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 4,
     "result": {
      "ok": true,
      "value": {
       "asset_id": "$a2"
      }
     },
     "effect": "committed"
    }
   },
   "because": "HP AS-1"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 5,
     "call": "assets.publish",
     "context": {
      "request": "$r"
     },
     "args": {
      "name": "three",
      "content_type": "text/html",
      "bytes_b64": "eA=="
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 5,
     "result": {
      "ok": true,
      "value": {
       "asset_id": "$a3"
      }
     },
     "effect": "committed"
    }
   },
   "because": "HP AS-1"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 6,
     "call": "assets.publish",
     "context": {
      "request": "$r"
     },
     "args": {
      "name": "over-count",
      "content_type": "text/html",
      "bytes_b64": "eA=="
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 6,
     "result": {
      "ok": false,
      "error": {
       "kind": "quota_exceeded"
      }
     },
     "effect": "none"

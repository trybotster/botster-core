{
 "id": "conf::hs_5_ready_deadline",
 "contract": "hp",
 "clause": "HS-5",
 "subject": "plugin_hub",
 "requires": {
  "controls": [
   "status"
  ]
 },
 "setup": {
  "limits": {
   "startup": 500
  }
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "advance_clock": {
    "ms": 499
   }
  },
  {
   "control": {
    "op": "status"
   },
   "expect": {
    "state": "loading"
   },
   "because": "HP HS-5"
  },
  {
   "advance_clock": {
    "ms": 1
   }
  },
  {
   "expect_closed": null,
   "because": "HP HS-5"
  },
  {
   "control": {
    "op": "status"
   },
   "expect": {
    "state": "load_failed",
    "code": "startup_timeout"
   },
   "because": "HP HS-5"
  }
 ]
}

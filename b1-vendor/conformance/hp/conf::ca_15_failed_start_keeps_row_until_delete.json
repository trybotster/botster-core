      "value": {
       "operation_id": "op1",
       "kind": "spawn",
       "session": {
        "hub_id": "hub-1",
        "session_id": "s1"
       },
       "state": "starting",
       "terminal": false
      }
     },
     "effect": "committed"
    }
   ],
   "sessions.get": [
    {
     "result": {
      "ok": true,
      "value": {
       "id": "s1",
       "hub_id": "hub-1",
       "label": "l",
       "state": "ended",
       "lifecycle_class": "ended",
       "exit": {},
       "size": {
        "rows": 24,
        "cols": 80

        "source": "device"
       },
       "traits": [],
       "restartable": false,
       "activity": "idle",
       "presentation": "default",
       "metadata": {},
       "failure_reason": "start_failed"
      }
     },
     "effect": "none"
    },
    {
     "result": {
      "ok": false,
      "error": {
       "kind": "not_found",
       "message": "not_found",
       "retryable": false
      }
     },
     "effect": "none"
    }
   ],
   "sessions.delete": [
    {
     "result": {
      "ok": true,
      "value": {}
     },
     "effect": "committed"
    }
   ]
  }
 },
 "steps": [
  {

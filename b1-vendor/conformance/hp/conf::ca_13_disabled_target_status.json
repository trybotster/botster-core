{
 "id": "conf::ca_13_disabled_target_status",
 "contract": "hp",
 "clause": "CA-13",
 "subject": "plugin_hub",
 "requires": {
  "controls": [
   "invoke"
  ]
 },
 "setup": {
  "given": "the target t2 exists and is disabled",
  "calls": {
   "spawn_targets.list": [
    {
     "result": {
      "ok": true,
      "value": {
       "targets": [
        {
         "id": "t2",
         "label": "two",
         "enabled": false,
         "kind": "directory",
         "root": "two",
         "metadata": {}
        }
       ]
      }
     },
     "effect": "none"
    }
   ],
   "spawn_targets.validate": [
    {
     "result": {
      "ok": true,
      "value": {
       "ok": false,
       "status": "disabled"
      }
     },
     "effect": "none"
    },
    {
     "result": {
      "ok": true,
      "value": {
       "ok": true,
       "status": "ok"
      }
     },
     "effect": "none"
    }
   ]
  }
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      }
     ]
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "invoke",
    "handler": "h1"
   },
   "bind": {
    "t": "/ticket"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "handler": "h1"
    }
   },
   "because": "HP IV-1"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 1,
     "call": "spawn_targets.list",
     "context": {
      "request": "$r"
     },
     "args": {}
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 1,
     "result": {
      "ok": true,
      "value": {
       "targets": [
        {
         "id": "t2",
         "enabled": false
        }
       ]
      }
     },
     "effect": "none"
    }
   },
   "because": "HP CA-13"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 2,
     "call": "spawn_targets.validate",
     "context": {
      "request": "$r"
     },
     "args": {
      "target_id": "t2"
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 2,
     "result": {
      "ok": true,
      "value": {
       "ok": false,
       "status": "disabled"
      }
     },
     "effect": "none"
    }
   },
   "because": "HP CA-13"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 3,
     "call": "spawn_targets.validate",
     "context": {
      "request": "$r"
     },
     "args": {
      "target_id": "t1"
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 3,
     "result": {
      "ok": true,
      "value": {
       "ok": true,
       "status": "ok"
      }
     },
     "effect": "none"
    }
   },
   "because": "HP CA-13"
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  }
 ]
}

{
 "id": "conf::nt_10_unload_mid_request_cancels_and_leaks_nothing",
 "contract": "hp",
 "clause": "NT-10",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "hub_output",
   "invoke",
   "lane_transcript",
   "net_cancelled",
   "net_release",
   "net_seen",
   "net_state",
   "net_world",
   "set_secret",
   "settle",
   "unload"
  ]
 },
 "setup": {
  "given": "the Telegram-shaped long poll is pending in the scripted edge when the plugin is unloaded",
  "plugins": {
   "demo": {
    "grants": [
     {
      "surface": "net",
      "scope": "net",
      "allow": [
       "https://api.telegram.test"
      ]
     },
     {
      "surface": "secrets"
     }
    ],
    "secrets": [
     {
      "name": "bot_token"
     }
    ]
   }
  }
 },
 "steps": [
  {
   "control": {
    "op": "set_secret",
    "plugin": "demo",
    "name": "bot_token",
    "value": "bot123:SECRET"
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      },
      {
       "id": "op",
       "kind": "operation",
       "descriptor": {}
      }
     ],
     "operations": {
      "subscribed": "op"
     }
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "invoke",
    "handler": "h1"
   },
   "bind": {
    "t": "/ticket"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "handler": "h1"
    }
   },
   "because": "HP IV-1"
  },
  {
   "control": {
    "op": "net_world",
    "endpoints": [
     {
      "origin": "https://api.telegram.test",
      "addresses": [
       "203.0.113.20"
      ],
      "answers": [
       {
        "status": 200,
        "body_b64": "eyJvayI6dHJ1ZSwicmVzdWx0IjpbeyJ1cGRhdGVfaWQiOjEsIm1lc3NhZ2UiOnsidGV4dCI6ImhpIn19XX0=",
        "hold": true
       }
      ]
     }
    ]
   }
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 1,
     "call": "http.request",
     "context": {
      "request": "$r"
     },
     "args": {
      "method": "GET",
      "url": "https://api.telegram.test/bot{{secret:bot_token}}/getUpdates?timeout=30",
      "timeout_ms": 35000
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 1,
     "result": {
      "ok": true,
      "value": {
       "operation_id": "$o1",
       "kind": "http",
       "state": "queued",
       "terminal": false
      }
     },
     "effect": "committed"
    }
   },
   "because": "HP NT-10"
  },
  {
   "control": {
    "op": "net_state",
    "plugin": "demo"
   },
   "expect": {
    "open_requests": 1
   },
   "because": "HP NT-10"
  },
  {
   "control": {
    "op": "unload"
   }
  },
  {
   "control": {
    "op": "net_cancelled",
    "origin": "https://api.telegram.test"
   },
   "expect": {
    "cancelled": 1
   },
   "because": "HP NT-10"
  },
  {
   "control": {
    "op": "net_state",
    "plugin": "demo"
   },
   "expect": {
    "open_requests": 0,
    "open_sockets": 0
   },
   "because": "HP NT-10"
  },
  {
   "control": {
    "op": "net_release",
    "origin": "https://api.telegram.test"
   }
  },
  {
   "control": {
    "op": "settle"
   }
  },
  {
   "control": {
    "op": "lane_transcript",
    "plugin": "demo"
   },
   "expect": {
    "text": {
     "$not": {
      "$contains": "\"handler\":\"op\""
     }
    }
   },
   "because": "HP NT-10"
  },
  {
   "control": {
    "op": "net_seen"
   },
   "expect": {
    "plugin_sockets": 0
   },
   "because": "HP NT-10"
  },
  {
   "control": {
    "op": "hub_output"
   },
   "expect": {
    "log": {
     "$not": {
      "$contains": "bot123:SECRET"
     }
    },
    "events": {
     "$not": {
      "$contains": "bot123:SECRET"
     }
    },
    "receipts": {
     "$not": {
      "$contains": "bot123:SECRET"
     }
    },
    "errors": {
     "$not": {
      "$contains": "bot123:SECRET"
     }
    },
    "call_results": {
     "$not": {
      "$contains": "bot123:SECRET"
     }
    }
   },
   "because": "HP NT-10"
  }
 ]
}

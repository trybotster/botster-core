{
 "id": "conf::mt_2_name_collision_fails_load",
 "contract": "hp",
 "clause": "MT-2",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "load_plugin",
   "mcp_list",
   "status"
  ]
 },
 "setup": {
  "given": "demo (loaded first) registers the tool _echo, exposed as demo___echo; the plugin demo_ then registers the tool echo, which is exposed as demo___echo too (delimiters do not make names unique)",
  "plugins": {
   "demo": {
    "grants": [
     {
      "surface": "mcp"
     }
    ]
   },
   "demo_": {
    "grants": [
     {
      "surface": "mcp"
     }
    ]
   }
  }
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      },
      {
       "id": "p1",
       "kind": "mcp_prompt",
       "descriptor": {}
      },
      {
       "id": "r1",
       "kind": "mcp_resource",
       "descriptor": {}
      }
     ],
     "tools": [
      {
       "name": "_echo",
       "description": "d",
       "input_schema": {
        "type": "object",
        "required": [
         "n"
        ],
        "properties": {
         "n": {
          "type": "integer"
         }
        },
        "additionalProperties": true
       },
       "handler": "h1"
      }
     ],
     "prompts": [],
     "resources": []
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "mcp_list",
    "kind": "tools",
    "plugin": "demo"
   },
   "expect": {
    "items": [
     {
      "name": "demo___echo"
     }
    ]
   },
   "because": "HP MT-2"
  },
  {
   "control": {
    "op": "load_plugin",
    "plugin_key": "demo_",
    "as": "d2"
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e_d2"
    }
   },
   "on": "d2",
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e_d2",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      }
     ],
     "tools": [
      {
       "name": "echo",
       "description": "d",
       "input_schema": {},
       "handler": "h1"
      }
     ]
    }
   },
   "conn": "d2"
  },
  {
   "control": {
    "op": "status",
    "plugin": "demo_"
   },
   "expect": {
    "state": "load_failed",
    "error": {
     "kind": "conflict",
     "detail": {
      "name": "demo___echo"
     }
    }
   },
   "because": "HP MT-2"
  },
  {
   "control": {
    "op": "mcp_list",
    "kind": "tools",
    "plugin": "demo_"
   },
   "expect": {
    "items": []
   },
   "because": "HP MT-2"
  },
  {
   "control": {
    "op": "mcp_list",
    "kind": "tools",
    "plugin": "demo"
   },
   "expect": {
    "items": [
     {
      "name": "demo___echo"
     }
    ]
   },
   "because": "HP MT-2"
  }
 ]
}

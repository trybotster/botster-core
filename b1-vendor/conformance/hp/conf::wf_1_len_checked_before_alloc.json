{
 "id": "conf::wf_1_len_checked_before_alloc",
 "contract": "hp",
 "clause": "WF-1",
 "subject": "plugin_hub",
 "requires": {
  "controls": [
   "counters"
  ]
 },
 "setup": {
  "limits": {
   "frame_bytes": 4096
  },
  "calls": {
   "log.write": [
    {
     "result": {
      "ok": true,
      "value": {
       "seq": 1
      }
     }
    }
   ]
  }
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e"
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "send_frame_raw": {
    "lane": 3,
    "type": 32,
    "payload_text": "{\"epoch\":{{e}},\"call_id\":1,\"context\":\"autonomous\",\"call\":\"log.write\",\"args\":{\"level\":\"info\",\"message\":\"\"},\"max_result_bytes\":1000}"
   }
  },
  {
   "expect": {
    "lane": "bulk",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 1,
     "result": {
      "ok": true
     }
    }
   },
   "because": "HP WF-1"
  },
  {
   "send_wire": {
    "bytes_hex": "0110"
   }
  },
  {
   "send_wire": {
    "bytes_hex": ""
   }
  },
  {
   "expect_closed": null,
   "because": [
    "HP WF-1",
    "HP MD-2"
   ]
  },
  {
   "control": {
    "op": "counters"
   },
   "expect": {
    "refused_frame_bytes_buffered": 0
   },
   "because": "HP WF-1"
  }
 ]
}

{
 "id": "conf::mt_1_register_tool_prompt_resource",
 "contract": "hp",
 "clause": "MT-1",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "mcp_list"
  ]
 },
 "setup": {
  "given": "demo holds the mcp surface and registers one tool, one prompt and one resource in Ready",
  "plugins": {
   "demo": {
    "grants": [
     {
      "surface": "mcp"
     }
    ]
   }
  }
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      },
      {
       "id": "p1",
       "kind": "mcp_prompt",
       "descriptor": {}
      },
      {
       "id": "r1",
       "kind": "mcp_resource",
       "descriptor": {}
      }
     ],
     "tools": [
      {
       "name": "echo",
       "description": "d",
       "input_schema": {
        "type": "object",
        "required": [
         "n"
        ],
        "properties": {
         "n": {
          "type": "integer"
         }
        },
        "additionalProperties": true
       },
       "handler": "h1"
      }
     ],
     "prompts": [
      {
       "name": "greet",
       "description": "greeting prompt",
       "arguments": [],
       "handler": "p1"
      }
     ],
     "resources": [
      {
       "uri_template": "demo://doc/{id}",
       "name": "doc",
       "mime_type": "text/plain",
       "handler": "r1"
      }
     ]
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "mcp_list",
    "kind": "tools",
    "plugin": "demo"
   },
   "expect": {
    "items": [
     {
      "name": "demo__echo",
      "description": "d"
     }
    ]
   },
   "because": "HP MT-1"
  },
  {
   "control": {
    "op": "mcp_list",
    "kind": "prompts",
    "plugin": "demo"
   },
   "expect": {
    "items": [
     {
      "description": "greeting prompt"
     }
    ]
   },
   "because": "HP MT-1"
  },
  {
   "control": {
    "op": "mcp_list",
    "kind": "resources",
    "plugin": "demo"
   },
   "expect": {
    "items": [
     {
      "name": "doc"
     }
    ]
   },
   "because": "HP MT-1"
  }
 ]
}

{
 "id": "conf::st_9_fsync_before_ack",
 "contract": "hp",
 "clause": "ST-9",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "hold_commits",
   "invoke",
   "release_commits",
   "settle"
  ]
 },
 "setup": {
  "given": "the commit is held at the point where the write would be synced; hold_commits and release_commits mark it"
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      }
     ]
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "invoke",
    "handler": "h1"
   },
   "bind": {
    "t": "/ticket"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "handler": "h1"
    }
   },
   "because": "HP IV-1"
  },
  {
   "control": {
    "op": "hold_commits"
   }
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 1,
     "call": "store.put",
     "context": {
      "request": "$r"
     },
     "args": {
      "collection": "c",
      "id": "a",
      "doc": {
       "v": 1
      }
     }
    }
   }
  },
  {
   "expect_quiet_until": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "call_id": 1
    }
   },
   "barrier": {
    "control": {
     "op": "settle"
    }
   },
   "until": {
    "settled": true
   },
   "because": "HP ST-9"
  },
  {
   "control": {
    "op": "release_commits"
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 1,
     "result": {
      "ok": true,
      "value": {
       "revision": {
        "$type": "string"
       }
      }
     },
     "effect": "committed"
    }
   },
   "because": "HP ST-9"
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  }
 ]
}

{
 "id": "conf::ev_6_session_family_baseline_then_deltas",
 "contract": "hp",
 "clause": "EV-6",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "session_change"
  ]
 },
 "setup": {
  "given": "the session s1 exists and is the only session; the plugin holds events_hub and session_read",
  "grants": [
   {
    "surface": "events",
    "scope": "events_hub"
   },
   {
    "surface": "session_actions",
    "scope": "session_read"
   }
  ]
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      },
      {
       "id": "he",
       "kind": "event",
       "descriptor": {}
      },
      {
       "id": "hg",
       "kind": "event_gap",
       "descriptor": {}
      }
     ],
     "events": {
      "subscribed": [
       {
        "handler_id": "he",
        "pattern": {
         "owner": "hub",
         "name": "session_family"
        }
       }
      ],
      "gap_handler": "hg"
     }
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "expect_eventually": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "handler": "he",
     "origin": "event",
     "payload": {
      "owner": "hub",
      "name": "session_family",
      "payload": {
       "frame": "snapshot_begin"
      }
     }
    }
   },
   "ignore": [],
   "ack": {
    "send_frame": {
     "lane": "invoke",
     "type": "Result",
     "payload": {
      "epoch": "$e",
      "request_id": {
       "$item": "/payload/request_id"
      },
      "result": {
       "ok": true,
       "value": {}
      }
     }
    }
   },
   "because": [
    "HP EV-6",
    "HP A2-28"
   ]
  },
  {
   "expect_eventually": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "handler": "he",
     "origin": "event",
     "payload": {
      "owner": "hub",
      "name": "session_family",
      "payload": {
       "frame": "snapshot_chunk",
       "sessions": {
        "$array": {
         "each": {
          "id": "s1"
         },
         "min": 1,
         "max": 1
        }
       }
      }
     }
    }
   },
   "ignore": [
    {
     "lane": "invoke",
     "type": "Invoke",
     "payload": {
      "handler": "he",
      "origin": "event",
      "payload": {
       "owner": "hub",
       "name": "session_family",
       "payload": {
        "frame": "snapshot_chunk",
        "sessions": {
         "$array": {
          "max": 0
         }
        }
       }
      }
     }
    }
   ],
   "ack": {
    "send_frame": {
     "lane": "invoke",
     "type": "Result",
     "payload": {
      "epoch": "$e",
      "request_id": {
       "$item": "/payload/request_id"
      },
      "result": {
       "ok": true,
       "value": {}
      }
     }
    }
   },
   "because": [
    "HP EV-6",
    "HP A2-28"
   ]
  },
  {
   "expect_eventually": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "handler": "he",
     "origin": "event",
     "payload": {
      "owner": "hub",
      "name": "session_family",
      "payload": {
       "frame": "snapshot_end"
      }
     }
    }
   },
   "ignore": [
    {
     "lane": "invoke",
     "type": "Invoke",
     "payload": {
      "handler": "he",
      "origin": "event",
      "payload": {
       "owner": "hub",
       "name": "session_family",
       "payload": {
        "frame": "snapshot_chunk",
        "sessions": {
         "$array": {
          "max": 0
         }
        }
       }
      }
     }
    }
   ],
   "ack": {
    "send_frame": {
     "lane": "invoke",
     "type": "Result",
     "payload": {
      "epoch": "$e",
      "request_id": {
       "$item": "/payload/request_id"
      },
      "result": {
       "ok": true,
       "value": {}
      }
     }
    }
   },
   "because": [
    "HP EV-6",
    "HP A2-28"
   ]
  },
  {
   "control": {
    "op": "session_change",
    "session": {
     "hub_id": "hub-1",
     "session_id": "s1"
    },
    "label": "renamed"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$d1",
     "handler": "he",
     "origin": "event",
     "payload": {
      "owner": "hub",
      "name": "session_family",
      "payload": {
       "frame": "delta",
       "op": "upsert",
       "session": {
        "id": "s1",
        "label": "renamed"
       },
       "session_id": "s1"
      }
     }
    }
   },
   "because": [
    "HP EV-6",
    "HP A2-28"
   ]
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$d1",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  }
 ]
}

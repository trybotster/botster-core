{
 "id": "conf::mp_6_timeout_after_dispatch_is_effect_unknown",
 "contract": "hp",
 "clause": "MP-6",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "await_mcp_server",
   "mcp_call",
   "mcp_response",
   "mcp_server_log",
   "script_mcp"
  ]
 },
 "setup": {
  "given": "the deadline passes after the request was sent; another call is refused before dispatch because the server is unavailable",
  "limits": {
   "mcp_proxy_call_deadline_ms": 100
  },
  "plugins": {
   "demo": {
    "grants": [
     {
      "surface": "mcp",
      "scope": "mcp_proxy"
     },
     {
      "surface": "mcp",
      "scope": "mcp_proxy_stdio"
     },
     {
      "surface": "net",
      "scope": "net",
      "allow": [
       "https://mcp.example"
      ]
     }
    ],
    "mcp_servers": [
     {
      "id": "s",
      "transport": "stdio",
      "command": "mcp-server",
      "args": [
       "--x"
      ],
      "env": {
       "A": "1"
      }
     },
     {
      "id": "u",
      "transport": "stdio",
      "command": "mcp-server",
      "args": [
       "--x"
      ],
      "env": {
       "A": "1"
      }
     }
    ],
    "entry": "the plugin declares the MCP servers in its manifest (MP-1)"
   }
  }
 },
 "steps": [
  {
   "control": {
    "op": "script_mcp",
    "plugin": "demo",
    "server": "s",
    "transport": "stdio",
    "tools": [
     {
      "name": "slow",
      "description": "slow tool",
      "inputSchema": {
       "type": "object"
      },
      "behavior": {
       "kind": "hang"
      }
     }
    ]
   }
  },
  {
   "control": {
    "op": "script_mcp",
    "plugin": "demo",
    "server": "u",
    "transport": "stdio",
    "tools": [
     {
      "name": "echo",
      "description": "echo tool",
      "inputSchema": {
       "type": "object",
       "properties": {
        "n": {
         "type": "integer"
        }
       }
      },
      "behavior": {
       "kind": "echo"
      }
     }
    ],
    "protocol_version": "2024-11-05"
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      }
     ]
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "await_mcp_server",
    "plugin": "demo",
    "server": "s",
    "state": "available"
   }
  },
  {
   "control": {
    "op": "await_mcp_server",
    "plugin": "demo",
    "server": "u",
    "state": "unavailable"
   }
  },
  {
   "control": {
    "op": "mcp_call",
    "tool": "demo__s__slow",
    "arguments": {}
   },
   "bind": {
    "tk1": "/ticket"
   },
   "because": "HP MP-6"
  },
  {
   "control": {
    "op": "mcp_server_log",
    "plugin": "demo",
    "server": "s"
   },
   "expect": {
    "calls": [
     {
      "params": {
       "name": "slow"
      }
     }
    ]
   },
   "because": "HP MP-6"
  },
  {
   "advance_clock": {
    "ms": 100
   }
  },
  {
   "control": {
    "op": "mcp_response",
    "ticket": "$tk1"
   },
   "expect": {
    "is_error": true,
    "error": {
     "kind": {
      "$one_of": [
       "cancelled",
       "timed_out"
      ]
     },
     "effect": "unknown"
    }
   },
   "because": "HP MP-6"
  },
  {
   "control": {
    "op": "mcp_call",
    "tool": "demo__u__echo",
    "arguments": {}
   },
   "bind": {
    "tk2": "/ticket"
   },
   "because": "HP MP-6"
  },
  {
   "control": {
    "op": "mcp_response",
    "ticket": "$tk2"
   },
   "expect": {
    "is_error": true,
    "error": {
     "kind": {
      "$one_of": [
       "not_found",
       "unavailable"
      ]
     }
    }
   },
   "because": "HP MP-6"
  }
 ]
}

{
 "id": "conf::ca_9_sink_never_blocks",
 "contract": "hp",
 "clause": "CA-9",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "invoke",
   "stall_log_sink"
  ]
 },
 "setup": {
  "given": "the Hub log sink is stalled for the whole transcript"
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      }
     ]
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "invoke",
    "handler": "h1"
   },
   "bind": {
    "t": "/ticket"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "handler": "h1"
    }
   },
   "because": "HP IV-1"
  },
  {
   "control": {
    "op": "stall_log_sink"
   }
  },
  {
   "send_frame": {
    "lane": "bulk",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 1,
     "call": "log.write",
     "context": {
      "request": "$r"
     },
     "args": {
      "level": "info",
      "message": "m1"
     }
    }
   }
  },
  {
   "expect": {
    "lane": "bulk",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 1,
     "result": {
      "ok": true,
      "value": {
       "seq": {
        "$type": "integer"
       }
      }
     }
    }
   },
   "because": "HP CA-9"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 2,
     "call": "hub.identity",
     "context": {
      "request": "$r"
     },
     "args": {}
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 2,
     "result": {
      "ok": true,
      "value": {
       "hub_id": {
        "$type": "string"
       }
      }
     }
    }
   },
   "because": "HP CA-9"
  },
  {
   "send_frame": {
    "lane": "bulk",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 3,
     "call": "log.write",
     "context": {
      "request": "$r"
     },
     "args": {
      "level": "info",
      "message": "m2"
     }
    }
   }
  },
  {
   "expect": {
    "lane": "bulk",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 3,
     "result": {
      "ok": true,
      "value": {
       "seq": {
        "$type": "integer"
       }
      }
     }
    }
   },
   "because": "HP CA-9"
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  }
 ]
}

{
 "id": "conf::ev_13_normal_unkeyed_drops_oldest_with_count",
 "contract": "hp",
 "clause": "EV-13",
 "subject": "plugin_hub",
 "requires": {
  "controls": [
   "emit_events",
   "invoke"
  ]
 },
 "setup": {
  "limits": {
   "event_queue_normal": 3
  }
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      },
      {
       "id": "he",
       "kind": "event",
       "descriptor": {}
      },
      {
       "id": "hg",
       "kind": "event_gap",
       "descriptor": {}
      }
     ],
     "events": {
      "subscribed": [
       {
        "handler_id": "he",
        "pattern": {
         "owner": "hub",
         "name": "x"
        }
       }
      ],
      "gap_handler": "hg"
     }
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "invoke",
    "handler": "h1"
   },
   "bind": {
    "t": "/ticket"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "handler": "h1"
    }
   },
   "because": "HP IV-1"
  },
  {
   "control": {
    "op": "emit_events",
    "emitters": [
     {
      "owner": "hub",
      "name": "x",
      "count": 4
     }
    ]
   }
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$g",
     "handler": "hg",
     "origin": "event_gap",
     "payload": {
      "owner": "hub",
      "name": "x",
      "count": 1
     }
    }
   },
   "because": "HP EV-13"
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$g",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$c2",
     "handler": "he",
     "origin": "event",
     "payload": {
      "owner": "hub",
      "name": "x",
      "payload": {
       "seq": 2
      }
     }
    }
   },
   "because": "HP EV-13"
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$c2",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$c3",
     "handler": "he",
     "origin": "event",
     "payload": {
      "owner": "hub",
      "name": "x",
      "payload": {
       "seq": 3
      }
     }
    }
   },
   "because": "HP EV-13"
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$c3",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$c4",
     "handler": "he",
     "origin": "event",
     "payload": {
      "owner": "hub",
      "name": "x",
      "payload": {
       "seq": 4
      }
     }
    }
   },
   "because": "HP EV-13"
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$c4",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  }
 ]
}

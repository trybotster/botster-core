{
 "id": "conf::pm_2_refresh_only_when_asked",
 "contract": "hp",
 "clause": "PM-2",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "await_catalog",
   "client_verb",
   "edge_requests",
   "script_catalog"
  ]
 },
 "setup": {
  "given": "the operator adds a catalog, a long time passes, and the operator then refreshes it twice; the catalog answers the second request with 304",
  "plugins": {
   "demo": {
    "grants": []
   }
  }
 },
 "steps": [
  {
   "control": {
    "op": "script_catalog",
    "url": "https://catalog.example/k1.json",
    "document": {
     "catalog_version": 1,
     "entries": []
    },
    "etag": "e1"
   }
  },
  {
   "control": {
    "op": "client_verb",
    "kind": "catalog",
    "verb": "create",
    "args": {
     "url": "https://catalog.example/k1.json"
    }
   },
   "expect": {
    "committed": true
   },
   "because": "HP PM-2"
  },
  {
   "control": {
    "op": "edge_requests",
    "edge": "catalog"
   },
   "bind": {
    "m": "/mark"
   }
  },
  {
   "advance_clock": {
    "ms": 86400000
   }
  },
  {
   "control": {
    "op": "edge_requests",
    "edge": "catalog",
    "since": "$m"
   },
   "expect": {
    "requests": []
   },
   "because": "HP PM-2"
  },
  {
   "control": {
    "op": "client_verb",
    "kind": "catalog",
    "verb": "invoke",
    "id": "https://catalog.example/k1.json",
    "args": {
     "action": "refresh"
    }
   },
   "expect": {
    "accepted": {
     "operation_id": {
      "$type": "string"
     }
    }
   },
   "because": "HP PM-2"
  },
  {
   "control": {
    "op": "await_catalog",
    "catalog": "https://catalog.example/k1.json",
    "settled": true
   }
  },
  {
   "control": {
    "op": "edge_requests",
    "edge": "catalog"
   },
   "bind": {
    "m2": "/mark"
   }
  },
  {
   "control": {
    "op": "client_verb",
    "kind": "catalog",
    "verb": "invoke",
    "id": "https://catalog.example/k1.json",
    "args": {
     "action": "refresh"
    }
   },
   "expect": {
    "accepted": {
     "operation_id": {
      "$type": "string"
     }
    }
   },
   "because": "HP PM-2"
  },
  {
   "control": {
    "op": "await_catalog",
    "catalog": "https://catalog.example/k1.json",
    "settled": true
   }
  },
  {
   "control": {
    "op": "edge_requests",
    "edge": "catalog",
    "since": "$m2"
   },
   "expect": {
    "requests": [
     {
      "headers": {
       "if-none-match": "e1"
      }
     }
    ]
   },
   "because": "HP PM-2"
  }
 ]
}

{
 "id": "conf::tr_1_unlisted_host_refused",
 "contract": "hp",
 "clause": "TR-1",
 "subject": "plugin_hub",
 "requires": {
  "controls": [
   "load_plugin",
   "status",
   "settle"
  ]
 },
 "setup": {
  "shipped_hosts": [
   "/hub/hosts/lua"
  ],
  "trusted_hosts": [
   {
    "path": "/opt/hosts/js",
    "digest": "sha256:aa11"
   }
  ],
  "given": "the Hub ships the host /hub/hosts/lua; the operator's trusted-host list holds /opt/hosts/js with digest sha256:aa11"
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "control": {
    "op": "load_plugin",
    "plugin_key": "p2",
    "as": "p2",
    "host": {
     "path": "/opt/hosts/unknown",
     "digest": "sha256:bb22"
    }
   }
  },
  {
   "control": {
    "op": "status",
    "plugin": "p2"
   },
   "expect": {
    "state": "load_failed",
    "code": "host_not_trusted"
   },
   "because": "HP TR-1"
  },
  {
   "control": {
    "op": "load_plugin",
    "plugin_key": "p3",
    "as": "p3",
    "host": {
     "path": "/opt/hosts/js",
     "digest": "sha256:changed"
    }
   }
  },
  {
   "control": {
    "op": "status",
    "plugin": "p3"
   },
   "expect": {
    "state": "load_failed",
    "code": "host_not_trusted"
   },
   "because": "HP TR-1"
  },
  {
   "expect_quiet_until": {
    "type": "Hello"
   },
   "barrier": {
    "control": {
     "op": "settle",
     "conn": "p2"
    }
   },
   "until": {
    "settled": true
   },
   "because": "HP TR-1",
   "on": "p2"
  }
 ]
}

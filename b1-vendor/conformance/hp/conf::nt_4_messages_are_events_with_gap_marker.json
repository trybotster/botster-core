{
 "id": "conf::nt_4_messages_are_events_with_gap_marker",
 "contract": "hp",
 "clause": "NT-4",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "await_operation",
   "invoke",
   "net_push",
   "net_world"
  ]
 },
 "setup": {
  "given": "the plugin holds net with allow [https://ws.example] and subscribes to net/ws.* with the gap handler hg; the outside world accepts the WebSocket wss://ws.example/s",
  "limits": {
   "event_queue_normal": 2
  },
  "grants": [
   {
    "surface": "net",
    "scope": "net",
    "allow": [
     "https://ws.example"
    ]
   }
  ]
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      },
      {
       "id": "op",
       "kind": "operation",
       "descriptor": {}
      },
      {
       "id": "he",
       "kind": "event",
       "descriptor": {}
      },
      {
       "id": "hg",
       "kind": "event_gap",
       "descriptor": {}
      }
     ],
     "operations": {
      "subscribed": "op"
     },
     "events": {
      "subscribed": [
       {
        "handler_id": "he",
        "pattern": {
         "owner": "net",
         "name": "ws.*"
        }
       }
      ],
      "gap_handler": "hg"
     }
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "invoke",
    "handler": "h1"
   },
   "bind": {
    "t": "/ticket"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "handler": "h1"
    }
   },
   "because": "HP IV-1"
  },
  {
   "control": {
    "op": "net_world",
    "endpoints": [
     {
      "origin": "https://ws.example",
      "addresses": [
       "203.0.113.20"
      ],
      "ws": {
       "accept": true
      }
     }
    ]
   }
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 1,
     "call": "ws.open",
     "context": {
      "request": "$r"
     },
     "args": {
      "url": "wss://ws.example/s"
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 1,
     "result": {
      "ok": true,
      "value": {
       "operation_id": "$op10",
       "kind": "ws",
       "state": "queued",
       "terminal": false
      }
     },
     "effect": "committed"
    }
   },
   "because": "HP NT-4"
  },
  {
   "control": {
    "op": "await_operation",
    "operation_id": "$op10",
    "terminal": true
   }
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 2,
     "call": "operations.get",
     "context": {
      "request": "$r"
     },
     "args": {
      "operation_id": "$op10"
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 2,
     "result": {
      "ok": true,
      "value": {
       "operation_id": "$op10",
       "kind": "ws",
       "state": "open",
       "terminal": true,
       "ws_id": "$w"
      }
     },
     "effect": "none"
    }
   },
   "because": "HP NT-4"
  },
  {
   "control": {
    "op": "net_push",
    "origin": "https://ws.example",
    "text": "m0"
   }
  },
  {
   "control": {
    "op": "net_push",
    "origin": "https://ws.example",
    "text": "m1"
   }
  },
  {
   "control": {
    "op": "net_push",
    "origin": "https://ws.example",
    "text": "m2"
   }
  },
  {
   "control": {
    "op": "net_push",
    "origin": "https://ws.example",
    "text": "m3"
   }
  },
  {
   "control": {
    "op": "net_push",
    "origin": "https://ws.example",
    "text": "m4"
   }
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$g",
     "handler": "hg",
     "origin": "event_gap",
     "payload": {
      "owner": "net",
      "name": "ws.message",
      "count": 3
     }
    }
   },
   "because": [
    "HP NT-4",
    "HP EV-13"
   ]
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$g",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$m3",
     "handler": "he",
     "origin": "event",
     "payload": {
      "owner": "net",
      "name": "ws.message",
      "priority": "normal",
      "payload": {
       "ws_id": "$w",
       "text": "m3"
      },
      "source": {
       "kind": "hub",
       "instance": {
        "$type": "string"
       }
      }
     }
    }
   },
   "because": [
    "HP NT-4",
    "HP EV-13"
   ]
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$m3",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$m4",
     "handler": "he",
     "origin": "event",
     "payload": {
      "owner": "net",
      "name": "ws.message",
      "priority": "normal",
      "payload": {
       "ws_id": "$w",
       "text": "m4"
      }
     }
    }
   },
   "because": [
    "HP NT-4",
    "HP EV-13"
   ]
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$m4",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  }
 ]
}

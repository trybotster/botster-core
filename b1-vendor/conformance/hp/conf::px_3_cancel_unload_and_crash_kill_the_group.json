{
 "id": "conf::px_3_cancel_unload_and_crash_kill_the_group",
 "contract": "hp",
 "clause": "PX-3",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "await_operation",
   "invoke",
   "process_group_alive",
   "service_connected",
   "unload"
  ]
 },
 "setup": {
  "given": "three commands sleep 60 s: one is cancelled, one outlives a plugin crash, one outlives an unload",
  "grants": [
   {
    "surface": "session_actions",
    "scope": "process_run"
   }
  ]
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      },
      {
       "id": "op",
       "kind": "operation",
       "descriptor": {}
      }
     ],
     "operations": {
      "subscribed": "op"
     }
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "invoke",
    "handler": "h1"
   },
   "bind": {
    "t": "/ticket"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "handler": "h1"
    }
   },
   "because": "HP IV-1"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 1,
     "call": "process.run",
     "context": {
      "request": "$r"
     },
     "args": {
      "argv": [
       "sleep",
       "60"
      ],
      "timeout_ms": 60000
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 1,
     "result": {
      "ok": true,
      "value": {
       "operation_id": "$op1",
       "kind": "process",
       "state": "queued",
       "terminal": false
      }
     },
     "effect": "committed"
    }
   },
   "because": "HP PX-1"
  },
  {
   "control": {
    "op": "await_operation",
    "operation_id": "$op1",
    "state": "running"
   }
  },
  {
   "control": {
    "op": "process_group_alive",
    "operation_id": "$op1"
   },
   "expect": {
    "alive": true
   },
   "because": "HP PX-3"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 2,
     "call": "operations.cancel",
     "context": {
      "request": "$r"
     },
     "args": {
      "operation_id": "$op1"
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 2,
     "result": {
      "ok": true,
      "value": {
       "kind": "process",
       "operation_id": "$op1"
      }
     },
     "effect": "committed"
    }
   },
   "because": "HP CA-17"
  },
  {
   "control": {
    "op": "await_operation",
    "operation_id": "$op1",
    "terminal": true
   }
  },
  {
   "control": {
    "op": "process_group_alive",
    "operation_id": "$op1"
   },
   "expect": {
    "alive": false
   },
   "because": "HP PX-3"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 3,
     "call": "process.run",
     "context": {
      "request": "$r"
     },
     "args": {
      "argv": [
       "sleep",
       "60"
      ],
      "timeout_ms": 60000
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 3,
     "result": {
      "ok": true,
      "value": {
       "operation_id": "$op2",
       "kind": "process",
       "state": "queued",
       "terminal": false
      }
     },
     "effect": "committed"
    }
   },
   "because": "HP PX-1"
  },
  {
   "control": {
    "op": "await_operation",
    "operation_id": "$op2",
    "state": "running"
   }
  },
  {
   "control": {
    "op": "process_group_alive",
    "operation_id": "$op2"
   },
   "expect": {
    "alive": true
   },
   "because": "HP PX-3"
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  },
  {
   "close_channel": {}
  },
  {
   "control": {
    "op": "service_connected"
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e2"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e2",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      },
      {
       "id": "op",
       "kind": "operation",
       "descriptor": {}
      }
     ],
     "operations": {
      "subscribed": "op"
     }
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e2"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "await_operation",
    "operation_id": "$op2",
    "terminal": true
   }
  },
  {
   "control": {
    "op": "process_group_alive",
    "operation_id": "$op2"
   },
   "expect": {
    "alive": false
   },
   "because": "HP PX-3"
  },
  {
   "control": {
    "op": "invoke",
    "handler": "h1"
   },
   "bind": {
    "t2": "/ticket"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e2",
     "request_id": "$r2",
     "handler": "h1"
    }
   },
   "because": "HP IV-1"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e2",
     "call_id": 4,
     "call": "process.run",
     "context": {
      "request": "$r2"
     },
     "args": {
      "argv": [
       "sleep",
       "60"
      ],
      "timeout_ms": 60000
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e2",
     "call_id": 4,
     "result": {
      "ok": true,
      "value": {
       "operation_id": "$op3",
       "kind": "process",
       "state": "queued",
       "terminal": false
      }
     },
     "effect": "committed"
    }
   },
   "because": "HP PX-1"
  },
  {
   "control": {
    "op": "await_operation",
    "operation_id": "$op3",
    "state": "running"
   }
  },
  {
   "control": {
    "op": "process_group_alive",
    "operation_id": "$op3"
   },
   "expect": {
    "alive": true
   },
   "because": "HP PX-3"
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e2",
     "request_id": "$r2",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  },
  {
   "control": {
    "op": "unload"
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Shutdown"
   },
   "because": "HP LD-4"
  },
  {
   "close_channel": {}
  },
  {
   "control": {
    "op": "await_operation",
    "operation_id": "$op3",
    "terminal": true
   }
  },
  {
   "control": {
    "op": "process_group_alive",
    "operation_id": "$op3"
   },
   "expect": {
    "alive": false
   },
   "because": "HP PX-3"
  }
 ]
}

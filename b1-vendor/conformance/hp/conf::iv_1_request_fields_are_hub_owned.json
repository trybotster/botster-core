{
 "id": "conf::iv_1_request_fields_are_hub_owned",
 "contract": "hp",
 "clause": "IV-1",
 "subject": "plugin_host",
 "setup": {
  "fixture": "host_echo"
 },
 "steps": [
  {
   "send_frame": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "$ref": "hello",
     "epoch": 7
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "epoch": 7
    }
   },

{
 "id": "conf::cr_3_restart_once_then_quarantine",
 "contract": "hp",
 "clause": "CR-3",
 "subject": "plugin_hub",
 "requires": {
  "controls": [
   "status",
   "service_connected",
   "load_plugin"
  ]
 },
 "setup": {
  "limits": {
   "restart_window": 1000
  }
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      }
     ]
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "close_channel": {}
  },
  {
   "control": {
    "op": "status"
   },
   "expect": {
    "state": "restarting",
    "restart_requested": 1
   },
   "because": "HP CR-3"
  },
  {
   "control": {
    "op": "service_connected"
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e2",
     "resumed": false
    }
   },
   "because": "HP CR-3"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e2",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      }
     ]
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e2"
    }
   },
   "because": "HP CR-3"
  },
  {
   "close_channel": {}
  },
  {
   "control": {
    "op": "status"
   },
   "expect": {
    "state": "quarantined",
    "restart_requested": 1
   },
   "because": "HP CR-3"
  },
  {
   "control": {
    "op": "load_plugin",
    "plugin_key": "p2",
    "as": "p2"
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e3"
    }
   },
   "because": "HP HS-1",
   "on": "p2"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e3"
    }
   },
   "conn": "p2"
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e3"
    }
   },
   "because": "HP HS-2",
   "on": "p2"
  },
  {
   "close_channel": {},
   "conn": "p2"
  },
  {
   "control": {
    "op": "status",
    "plugin": "p2"
   },
   "expect": {
    "state": "restarting",
    "restart_requested": 1
   },
   "because": "HP CR-3"
  },
  {
   "control": {
    "op": "service_connected",
    "plugin": "p2"
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e4"
    }
   },
   "because": "HP CR-3",
   "on": "p2"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e4"
    }
   },
   "conn": "p2"
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e4"
    }
   },
   "because": "HP CR-3",
   "on": "p2"
  },
  {
   "advance_clock": {
    "ms": 1000
   }
  },
  {
   "close_channel": {},
   "conn": "p2"
  },
  {
   "control": {
    "op": "status",
    "plugin": "p2"
   },
   "expect": {
    "state": "restarting",
    "restart_requested": 2
   },
   "because": "HP CR-3"
  }
 ]
}

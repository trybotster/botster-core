{
 "id": "conf::cr_5_lost_is_fresh_start",
 "contract": "hp",
 "clause": "CR-5",
 "subject": "plugin_hub",
 "requires": {
  "controls": [
   "hub_restart",
   "service_lost",
   "service_connected",
   "status"
  ]
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      }
     ]
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "hub_restart"
   }
  },
  {
   "control": {
    "op": "service_lost"
   }
  },
  {
   "control": {
    "op": "status"
   },
   "expect": {
    "state": "starting"
   },
   "because": "HP CR-5"
  },
  {
   "control": {
    "op": "service_connected"
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e2",
     "resumed": false
    }
   },
   "because": "HP CR-5"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e2",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      }
     ]
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e2"
    }
   },
   "because": "HP HS-2"
  }
 ]
}

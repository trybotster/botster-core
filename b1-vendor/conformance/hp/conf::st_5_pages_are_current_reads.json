  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 1,
     "call": "store.put",
     "context": {
      "request": "$r"
     },
     "args": {
      "collection": "c",
      "id": "a",
      "doc": {
       "n": 1
      }
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 1,
     "result": {
      "ok": true,
      "value": {
       "revision": "$ra"
      }
     },
     "effect": "committed"
    }
   },
   "because": "HP ST-5"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 2,
     "call": "store.put",
     "context": {
      "request": "$r"
     },
     "args": {
      "collection": "c",
      "id": "b",
      "doc": {
       "n": 2
      }
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 2,
     "result": {
      "ok": true,
      "value": {
       "revision": "$rb"
      }
     },
     "effect": "committed"
    }
   },
   "because": "HP ST-5"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 3,
     "call": "store.put",
     "context": {
      "request": "$r"
     },
     "args": {
      "collection": "c",
      "id": "c",
      "doc": {
       "n": 3
      }
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 3,
     "result": {
      "ok": true,
      "value": {
       "revision": "$rc"
      }
     },
     "effect": "committed"
    }
   },
   "because": "HP ST-5"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 4,
     "call": "store.query",
     "context": {
      "request": "$r"
     },
     "args": {
      "collection": "c",
      "index": "by_n",
      "limit": 2
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 4,
     "result": {
      "ok": true,
      "value": {
       "docs": [
        {
         "id": "a"
        },
        {
         "id": "b"
        }
       ],
       "cursor": "$cur"

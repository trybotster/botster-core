  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 5,
     "call": "store.put",
     "context": {
      "request": "$r"
     },
     "args": {
      "collection": "c",
      "id": "a",
      "doc": {
       "n": 5
      },
      "expected_revision": "$ra"
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 5,
     "result": {
      "ok": true
     },
     "effect": "committed"
    }
   },
   "because": "HP ST-5"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 6,
     "call": "store.query",
     "context": {
      "request": "$r"
     },
     "args": {
      "collection": "c",
      "index": "by_n",
      "limit": 2,
      "cursor": "$cur"
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 6,
     "result": {
      "ok": true,
      "value": {
       "docs": {
        "$one_of": [
         [
          {
           "id": "c"
          }
         ],
         [
          {
           "id": "c"
          },
          {
           "id": "a"
          }
         ]
        ]
       }
      }
     },
     "effect": "none"
    }
   },
   "because": "HP ST-5"
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  }
 ]

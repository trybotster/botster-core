{
 "id": "conf::pc_3_no_reentry",
 "contract": "hp",
 "clause": "PC-3",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "invoke",
   "load_plugin",
   "settle"
  ]
 },
 "setup": {
  "given": "demo is running a handler and has not answered it; b calls demo's tool ping",
  "plugins": {
   "demo": {
    "grants": [
     {
      "surface": "plugins",
      "scope": "plugin_call:b"
     }
    ],
    "requires": [
     {
      "interface": "x.echo",
      "provider": "b",
      "tools": [
       "echo"
      ]
     }
    ]
   },
   "b": {
    "grants": [
     {
      "surface": "plugins",
      "scope": "plugin_call:demo"
     }
    ],
    "requires": [
     {
      "interface": "y.ping",
      "provider": "demo",
      "tools": [
       "ping"
      ]
     }
    ]
   }
  }
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      }
     ],
     "tools": [
      {
       "name": "ping",
       "description": "d",
       "input_schema": {
        "type": "object"
       },
       "handler": "h1",
       "callable_by": [
        "plugins"
       ]
      }
     ]
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "invoke",
    "handler": "h1"
   },
   "bind": {
    "t": "/ticket"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "handler": "h1"
    }
   },
   "because": "HP IV-1"
  },
  {
   "control": {
    "op": "load_plugin",
    "plugin_key": "b",
    "as": "b"
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e_b"
    }
   },
   "on": "b",
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e_b",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      }
     ],
     "tools": []
    }
   },
   "conn": "b"
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e_b"
    }
   },
   "on": "b",
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "invoke",
    "plugin": "b",
    "handler": "h1"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e_b",
     "request_id": "$rb0",
     "handler": "h1"
    }
   },
   "on": "b",
   "because": "HP IV-1"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e_b",
     "call_id": 1,
     "call": "plugins.call",
     "context": {
      "request": "$rb0"
     },
     "args": {
      "interface": "y.ping",
      "tool": "ping",
      "args": {
       "n": 1
      }
     }
    }
   },
   "conn": "b"
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e_b",
     "call_id": 1,
     "result": {
      "ok": true,
      "value": {
       "operation_id": "$opb",
       "kind": "plugin_call",
       "state": "queued",
       "terminal": false
      }
     },
     "effect": "committed"
    }
   },
   "on": "b",
   "because": "HP PC-3"
  },
  {
   "expect_quiet_until": {
    "lane": "invoke",
    "type": "Invoke"
   },
   "on": "main",
   "barrier": {
    "control": {
     "op": "settle",
     "conn": "main"
    }
   },
   "until": {
    "settled": true
   },
   "because": "HP PC-3"
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$rp",
     "handler": "h1",
     "payload": {
      "n": 1
     },
     "caller": {
      "kind": "plugin"
     }
    }
   },
   "because": "HP PC-3"
  }
 ]
}

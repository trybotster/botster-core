{
 "id": "conf::vr_2_unknown_state_changing_refused",
 "contract": "hp",
 "clause": "VR-2",
 "subject": "plugin_hub",
 "requires": {
  "controls": [
   "counters",
   "settle"
  ]
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      }
     ]
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "send_frame_raw": {
    "lane": 0,
    "type": 127,
    "payload": {
     "epoch": "$e"
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Fault",
    "payload": {
     "epoch": "$e",
     "code": "unsupported_frame",
     "detail": {
      "type": 127
     }
    }
   },
   "because": "HP VR-2"
  },
  {
   "send_frame_raw": {
    "lane": 0,
    "type": 126,
    "payload": {
     "epoch": "999999999999"
    }
   }
  },
  {
   "expect_quiet_until": {
    "lane": "control",
    "type": "Fault"
   },
   "barrier": {
    "control": {
     "op": "settle"
    }
   },
   "until": {
    "settled": true
   },
   "because": [
    "HP VR-2",
    "HP MD-4"
   ]
  },
  {
   "control": {
    "op": "counters"
   },
   "expect": {
    "stale_dropped": 1
   },
   "because": "HP MD-4"
  }
 ],
 "setup": {
  "calls": {
   "log.write": [
    {
     "result": {
      "ok": true,
      "value": {
       "seq": 1
      }
     }
    }
   ]
  }
 }
}

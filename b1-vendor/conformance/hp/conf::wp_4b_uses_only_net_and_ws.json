{
 "id": "conf::wp_4b_uses_only_net_and_ws",
 "contract": "hp",
 "clause": "WP-4b",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "await_operation",
   "invoke",
   "net_world"
  ]
 },
 "setup": {
  "given": "the plugin holds net with allow [https://site.example, https://ws.site.example] and web_origin; the website accepts requests and a WebSocket",
  "grants": [
   {
    "surface": "net",
    "scope": "net",
    "allow": [
     "https://site.example",
     "https://ws.site.example"
    ]
   },
   {
    "surface": "web_origin"
   }
  ]
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      },
      {
       "id": "op",
       "kind": "operation",
       "descriptor": {}
      },
      {
       "id": "he",
       "kind": "event",
       "descriptor": {}
      },
      {
       "id": "hg",
       "kind": "event_gap",
       "descriptor": {}
      },
      {
       "id": "rl",
       "kind": "relay",
       "descriptor": {}
      }
     ],
     "operations": {
      "subscribed": "op"
     },
     "events": {
      "subscribed": [
       {
        "handler_id": "he",
        "pattern": {
         "owner": "net",
         "name": "ws.*"
        }
       }
      ],
      "gap_handler": "hg"
     }
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "invoke",
    "handler": "h1"
   },
   "bind": {
    "t": "/ticket"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "handler": "h1"
    }
   },
   "because": "HP IV-1"
  },
  {
   "control": {
    "op": "net_world",
    "endpoints": [
     {
      "origin": "https://site.example",
      "addresses": [
       "203.0.113.60"
      ],
      "answers": [
       {
        "status": 200,
        "body_b64": "bmVnb3RpYXRlZA=="
       }
      ]
     },
     {
      "origin": "https://ws.site.example",
      "addresses": [
       "203.0.113.61"
      ],
      "ws": {
       "accept": true
      }
     }
    ]
   }
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 1,
     "call": "http.request",
     "context": {
      "request": "$r"
     },
     "args": {
      "method": "POST",
      "url": "https://site.example/negotiate",
      "timeout_ms": 1000,
      "body_b64": "e30="
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 1,
     "result": {
      "ok": true,
      "value": {
       "operation_id": "$op1",
       "kind": "http",
       "state": "queued",
       "terminal": false
      }
     },
     "effect": "committed"
    }
   },
   "because": "HP WP-4b"
  },
  {
   "control": {
    "op": "await_operation",
    "operation_id": "$op1",
    "terminal": true
   }
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 2,
     "call": "operations.get",
     "context": {
      "request": "$r"
     },
     "args": {
      "operation_id": "$op1"
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 2,
     "result": {
      "ok": true,
      "value": {
       "operation_id": "$op1",
       "kind": "http",
       "state": "done",
       "terminal": true,
       "status": 200
      }
     },
     "effect": "none"
    }
   },
   "because": "HP WP-4b"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 3,
     "call": "ws.open",
     "context": {
      "request": "$r"
     },
     "args": {
      "url": "wss://ws.site.example/s"
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 3,
     "result": {
      "ok": true,
      "value": {
       "operation_id": "$op2",
       "kind": "ws",
       "state": "queued",
       "terminal": false
      }
     },
     "effect": "committed"
    }
   },
   "because": "HP WP-4b"
  },
  {
   "control": {
    "op": "await_operation",
    "operation_id": "$op2",
    "terminal": true
   }
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 4,
     "call": "web.negotiate",
     "context": {
      "request": "$r"
     },
     "args": {
      "site": "https://site.example"
     }
    }
   }
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  }
 ]
}

{
 "id": "conf::ld_9_accepted_operation_survives_the_fence",
 "contract": "hp",
 "clause": "LD-9",
 "subject": "plugin_hub",
 "requires": {
  "controls": [
   "invoke",
   "reload"
  ]
 },
 "setup": {
  "given": "the Hub accepted a durable operation before the reload and it still runs",
  "calls": {
   "operations.get": [
    {
     "result": {
      "ok": true,
      "value": {
       "operation_id": "op1",
       "kind": "spawn",
       "state": "starting",
       "terminal": false,
       "session": {
        "hub_id": "hub-1",
        "session_id": "s1"
       }
      }
     }
    }
   ]
  }
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      }
     ]
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "reload"
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e2",
     "resumed": false,
     "instance": "$i2"
    }
   },
   "because": "HP LD-3",
   "on": "cand"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e2",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      }
     ]
    }
   },
   "conn": "cand"
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e2"
    }
   },
   "because": "HP LD-3",
   "on": "cand"
  },
  {
   "expect": {
    "lane": "control",
    "type": "Shutdown",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP LD-3"
  },
  {
   "control": {
    "op": "invoke",
    "handler": "h1"
   },
   "bind": {
    "t": "/ticket"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e2",
     "request_id": "$r2"
    }
   },
   "because": "HP LD-9",
   "on": "cand"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e2",
     "call_id": 71,
     "call": "operations.get",
     "context": {
      "request": "$r2"
     },
     "args": {
      "operation_id": "op1"
     }
    }
   },
   "conn": "cand"
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e2",
     "call_id": 71,
     "result": {
      "ok": true,
      "value": {
       "operation_id": "op1",
       "state": "starting"
      }
     }
    }
   },
   "because": "HP LD-9",
   "on": "cand"
  }
 ]
}

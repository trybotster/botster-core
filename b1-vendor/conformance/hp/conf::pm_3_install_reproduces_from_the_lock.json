{
 "id": "conf::pm_3_install_reproduces_from_the_lock",
 "contract": "hp",
 "clause": "PM-3",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "await_package",
   "client_read",
   "client_verb",
   "edge_requests",
   "hub_restart",
   "package_files_wipe",
   "script_git"
  ]
 },
 "setup": {
  "given": "demo is installed from a tag; the tag then moves to another commit; the installed files are lost and the Hub restarts",
  "plugins": {
   "demo": {
    "grants": []
   }
  }
 },
 "steps": [
  {
   "control": {
    "op": "script_git",
    "url": "https://git.example/a.git",
    "refs": {
     "v1": {
      "commit": "1111111111111111111111111111111111111111",
      "files": {
       "botster-plugin.json": {
        "json": {
         "botster_plugin_api": 1,
         "name": "demo",
         "version": "1.0.0",
         "entrypoints": {
          "service": {
           "lua": "main.lua"
          }
         }
        }
       },
       "main.lua": {
        "text": "-- v1.0.0\n"
       }
      }
     }
    }
   }
  },
  {
   "control": {
    "op": "client_verb",
    "kind": "package",
    "verb": "create",
    "args": {
     "source": {
      "kind": "git",
      "url": "https://git.example/a.git",
      "ref": "v1"
     }
    }
   },
   "expect": {
    "accepted": {
     "operation_id": {
      "$type": "string"
     }
    }
   },
   "because": "HP PM-5"
  },
  {
   "control": {
    "op": "await_package",
    "package": "demo",
    "settled": true
   },
   "because": "HP PM-5"
  },
  {
   "control": {
    "op": "client_read",
    "kind": "package",
    "id": "demo"
   },
   "expect": {
    "lock": {
     "resolved_commit": "1111111111111111111111111111111111111111",
     "content_hash": {
      "$type": "string"
     }
    }
   },
   "because": "HP PM-3",
   "bind": {
    "h1": "/lock/content_hash"
   }
  },
  {
   "control": {
    "op": "script_git",
    "url": "https://git.example/a.git",
    "refs": {
     "v1": {
      "commit": "2222222222222222222222222222222222222222",
      "files": {
       "botster-plugin.json": {
        "json": {
         "botster_plugin_api": 1,
         "name": "demo",
         "version": "2.0.0",
         "entrypoints": {
          "service": {
           "lua": "main.lua"
          }
         }
        }
       },
       "main.lua": {
        "text": "-- v2.0.0\n"
       }
      }
     }
    }
   }
  },
  {
   "control": {
    "op": "edge_requests",
    "edge": "git"
   },
   "bind": {
    "m": "/mark"
   }
  },
  {
   "control": {
    "op": "package_files_wipe",
    "package": "demo"
   }
  },
  {
   "control": {
    "op": "hub_restart"
   }
  },
  {
   "control": {
    "op": "await_package",
    "package": "demo",
    "settled": true
   },
   "because": "HP PM-3"
  },
  {
   "control": {
    "op": "client_read",
    "kind": "package",
    "id": "demo"
   },
   "expect": {
    "lock": {
     "resolved_commit": "1111111111111111111111111111111111111111",
     "content_hash": "$h1"
    }
   },
   "because": "HP PM-3"
  },
  {
   "control": {
    "op": "edge_requests",
    "edge": "git",
    "since": "$m"
   },
   "expect": {
    "requests": {
     "$array": {
      "each": {
       "commit": "1111111111111111111111111111111111111111"
      }
     }
    }
   },
   "because": "HP PM-3"
  }
 ]
}

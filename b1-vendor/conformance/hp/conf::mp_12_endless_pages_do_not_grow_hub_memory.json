{
 "id": "conf::mp_12_endless_pages_do_not_grow_hub_memory",
 "contract": "hp",
 "clause": "MP-12",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "await_mcp_server",
   "mcp_list",
   "mcp_server_log",
   "mcp_server_state",
   "script_mcp"
  ]
 },
 "setup": {
  "given": "mcp_proxy_list_pages is 2; the server answers every tools/list with a next cursor, forever",
  "limits": {
   "mcp_proxy_list_pages": 2
  },
  "plugins": {
   "demo": {
    "grants": [
     {
      "surface": "mcp",
      "scope": "mcp_proxy"
     },
     {
      "surface": "mcp",
      "scope": "mcp_proxy_stdio"
     },
     {
      "surface": "net",
      "scope": "net",
      "allow": [
       "https://mcp.example"
      ]
     }
    ],
    "mcp_servers": [
     {
      "id": "s",
      "transport": "stdio",
      "command": "mcp-server",
      "args": [
       "--x"
      ],
      "env": {
       "A": "1"
      }
     }
    ],
    "entry": "the plugin declares the MCP servers in its manifest (MP-1)"
   }
  }
 },
 "steps": [
  {
   "control": {
    "op": "script_mcp",
    "plugin": "demo",
    "server": "s",
    "transport": "stdio",
    "tools": [
     {
      "name": "echo",
      "description": "echo tool",
      "inputSchema": {
       "type": "object",
       "properties": {
        "n": {
         "type": "integer"
        }
       }
      },
      "behavior": {
       "kind": "echo"
      }
     }
    ],
    "endless_pages": true
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      }
     ]
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "await_mcp_server",
    "plugin": "demo",
    "server": "s",
    "state": "unavailable"
   }
  },
  {
   "control": {
    "op": "mcp_server_state",
    "plugin": "demo",
    "server": "s"
   },
   "expect": {
    "state": "unavailable",
    "error": {
     "detail": {
      "code": "mcp_bound_exceeded"
     }
    }
   },
   "because": "HP MP-12"
  },
  {
   "control": {
    "op": "mcp_list",
    "kind": "tools",
    "plugin": "demo"
   },
   "expect": {
    "items": []
   },
   "because": "HP MP-12"
  },
  {
   "control": {
    "op": "mcp_server_log",
    "plugin": "demo",
    "server": "s"
   },
   "expect": {
    "list_requests": {
     "$between": [
      2,
      3
     ]
    }
   },
   "because": "HP MP-12",
   "bind": {
    "m": "/mark"
   }
  },
  {
   "advance_clock": {
    "ms": 3600000
   }
  },
  {
   "control": {
    "op": "mcp_server_log",
    "plugin": "demo",
    "server": "s",
    "since": "$m"
   },
   "expect": {
    "list_requests": 0
   },
   "because": "HP MP-12"
  }
 ]
}

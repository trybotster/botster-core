{
 "id": "conf::nt_5_cross_origin_redirect_drops_credentials_and_body",
 "contract": "hp",
 "clause": "NT-5",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "await_operation",
   "invoke",
   "net_seen",
   "net_world"
  ]
 },
 "setup": {
  "given": "the plugin holds net with allow [https://api.example] and declares the secret bot_token (the operator set the value s3cret-TOKEN); the outside world is scripted by net_world; the plugin holds net with allow [https://api.example, https://other.example]; api.example redirects /a to /same, /b to https://other.example/y (302) and /c to https://other.example/y (307)",
  "grants": [
   {
    "surface": "net",
    "scope": "net",
    "allow": [
     "https://api.example",
     "https://other.example"
    ]
   }
  ]
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      },
      {
       "id": "op",
       "kind": "operation",
       "descriptor": {}
      },
      {
       "id": "he",
       "kind": "event",
       "descriptor": {}
      },
      {
       "id": "hg",
       "kind": "event_gap",
       "descriptor": {}
      }
     ],
     "operations": {
      "subscribed": "op"
     }
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "invoke",
    "handler": "h1"
   },
   "bind": {
    "t": "/ticket"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "handler": "h1"
    }
   },
   "because": "HP IV-1"
  },
  {
   "control": {
    "op": "net_world",
    "endpoints": [
     {
      "origin": "https://api.example",
      "addresses": [
       "203.0.113.5"
      ],
      "answers": [
       {
        "status": 302,
        "headers": [
         [
          "location",
          "/same"
         ]
        ]
       },
       {
        "status": 200,
        "body_b64": "b2s="
       },
       {
        "status": 302,
        "headers": [
         [
          "location",
          "https://other.example/y"
         ]
        ]
       },
       {
        "status": 307,
        "headers": [
         [
          "location",
          "https://other.example/y"
         ]
        ]
       }
      ]
     },
     {
      "origin": "https://other.example",
      "addresses": [
       "203.0.113.30"
      ],
      "answers": [
       {
        "status": 200,
        "body_b64": "b2s="
       },
       {
        "status": 200,
        "body_b64": "b2s="
       }
      ]
     }
    ]
   }
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 1,
     "call": "http.request",
     "context": {
      "request": "$r"
     },
     "args": {
      "method": "POST",
      "url": "https://api.example/a",
      "timeout_ms": 1000,
      "headers": [
       [
        "Authorization",
        "Bearer abc"
       ],
       [
        "Cookie",
        "k=v"
       ],
       [
        "X-Token",
        "{{secret:bot_token}}"
       ]
      ],
      "body_b64": "Ym9keQ=="
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 1,
     "result": {
      "ok": true,
      "value": {
       "operation_id": "$op27",
       "kind": "http",
       "state": "queued",
       "terminal": false
      }
     },
     "effect": "committed"
    }
   },
   "because": "HP NT-5"
  },
  {
   "control": {
    "op": "await_operation",
    "operation_id": "$op27",
    "terminal": true
   }
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 2,
     "call": "operations.get",
     "context": {
      "request": "$r"
     },
     "args": {
      "operation_id": "$op27"
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 2,
     "result": {
      "ok": true,
      "value": {
       "operation_id": "$op27",
       "kind": "http",
       "state": "done",
       "terminal": true,
       "status": 200
      }
     },
     "effect": "none"
    }
   },
   "because": "HP NT-5"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 3,
     "call": "http.request",
     "context": {
      "request": "$r"
     },
     "args": {
      "method": "POST",
      "url": "https://api.example/b",
      "timeout_ms": 1000,
      "headers": [
       [
        "Authorization",
        "Bearer abc"
       ],
       [
        "Cookie",
        "k=v"
       ],
       [
        "X-Token",
        "{{secret:bot_token}}"
       ]
      ],
      "body_b64": "Ym9keQ=="
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 3,
     "result": {
      "ok": true,
      "value": {
       "operation_id": "$op28",
       "kind": "http",
       "state": "queued",
       "terminal": false
      }
     },
     "effect": "committed"
    }
   },
   "because": "HP NT-5"
  },
  {
   "control": {
    "op": "await_operation",
    "operation_id": "$op28",
    "terminal": true
   }
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 4,
     "call": "operations.get",
     "context": {
      "request": "$r"
     },
     "args": {
      "operation_id": "$op28"
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 4,
     "result": {
      "ok": true,
      "value": {
       "operation_id": "$op28",
       "kind": "http",
       "state": "done",
       "terminal": true,
       "status": 200
      }
     },
     "effect": "none"
    }
   },
   "because": "HP NT-5"
  },
  {
   "control": {
    "op": "net_seen",
    "path_and_query": "/same"
   },
   "expect": {
    "requests": {
     "$array": {
      "each": {
       "origin": "https://api.example",
       "header_map": {
        "authorization": "Bearer abc",
        "cookie": "k=v",
        "x-token": "s3cret-TOKEN"
       },
       "body_b64": "Ym9keQ=="
      },
      "min": 1,
      "max": 1
     }
    }
   },
   "because": "HP NT-5"
  },
  {
   "control": {
    "op": "net_seen",
    "path_and_query": "/y"
   },
   "expect": {
    "requests": {
     "$array": {
      "each": {
       "origin": "https://other.example",
       "header_map": {
        "authorization": {
         "$absent": true
        },
        "cookie": {
         "$absent": true
        },
        "x-token": {
         "$absent": true
        }
       },
       "body_b64": {
        "$one_of": [
         {
          "$absent": true
         },
         ""
        ]
       }
      },
      "min": 1,
      "max": 1
     }
    }
   },
   "because": "HP NT-5"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 5,
     "call": "http.request",
     "context": {
      "request": "$r"
     },
     "args": {
      "method": "POST",
      "url": "https://api.example/c",
      "timeout_ms": 1000,
      "headers": [
       [
        "Authorization",
        "Bearer abc"
       ],
       [
        "Cookie",
        "k=v"
       ],
       [
        "X-Token",
        "{{secret:bot_token}}"
       ]
      ],
      "body_b64": "Ym9keQ=="
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 5,
     "result": {
      "ok": true,
      "value": {
       "operation_id": "$op29",
       "kind": "http",
       "state": "queued",
       "terminal": false

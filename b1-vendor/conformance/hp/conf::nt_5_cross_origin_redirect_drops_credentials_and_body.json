  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 6,
     "call": "operations.get",
     "context": {
      "request": "$r"
     },
     "args": {
      "operation_id": "$op29"
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 6,
     "result": {
      "ok": true,
      "value": {
       "operation_id": "$op29",
       "state": "failed",
       "terminal": true,
       "error": {
        "kind": "failed",
        "detail": {
         "code": "net_connect"
        }
       }
      }
     },
     "effect": "none"
    }
   },
   "because": [
    "HP NT-5",
    "HP NT-9"
   ]
  },
  {
   "control": {
    "op": "net_seen",
    "path_and_query": "/y"
   },
   "expect": {
    "requests": {
     "$array": {

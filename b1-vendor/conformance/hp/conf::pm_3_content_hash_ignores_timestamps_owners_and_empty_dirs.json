{
 "id": "conf::pm_3_content_hash_ignores_timestamps_owners_and_empty_dirs",
 "contract": "hp",
 "clause": "PM-3",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "await_package",
   "client_read",
   "client_verb",
   "script_git"
  ]
 },
 "setup": {
  "given": "the same content is served twice with other timestamps, owners and empty directories",
  "plugins": {
   "demo": {
    "grants": []
   }
  }
 },
 "steps": [
  {
   "control": {
    "op": "script_git",
    "url": "https://git.example/a.git",
    "refs": {
     "v1": {
      "commit": "1111111111111111111111111111111111111111",
      "files": {
       "botster-plugin.json": {
        "json": {
         "botster_plugin_api": 1,
         "name": "demo",
         "version": "1.0.0",
         "entrypoints": {
          "service": {
           "lua": "main.lua"
          }
         }
        },
        "mtime": 1000,
        "uid": 1
       },
       "main.lua": {
        "text": "-- v1.0.0\n",
        "mtime": 1000,
        "uid": 1
       }
      }
     }
    }
   }
  },
  {
   "control": {
    "op": "client_verb",
    "kind": "package",
    "verb": "create",
    "args": {
     "source": {
      "kind": "git",
      "url": "https://git.example/a.git",
      "ref": "v1"
     }
    }
   },
   "expect": {
    "accepted": {
     "operation_id": {
      "$type": "string"
     }
    }
   },
   "because": "HP PM-5"
  },
  {
   "control": {
    "op": "await_package",
    "package": "demo",
    "settled": true
   },
   "because": "HP PM-5"
  },
  {
   "control": {
    "op": "client_read",
    "kind": "package",
    "id": "demo"
   },
   "expect": {
    "lock": {
     "content_hash": {
      "$type": "string"
     }
    }
   },
   "because": "HP PM-3",
   "bind": {
    "h1": "/lock/content_hash"
   }
  },
  {
   "control": {
    "op": "client_verb",
    "kind": "package",
    "verb": "delete",
    "id": "demo",
    "args": {}
   },
   "expect": {
    "accepted": {
     "operation_id": {
      "$type": "string"
     }
    }
   },
   "because": "HP PM-10"
  },
  {
   "control": {
    "op": "await_package",
    "package": "demo",
    "settled": true
   },
   "because": "HP PM-10"
  },
  {
   "control": {
    "op": "script_git",
    "url": "https://git.example/a.git",
    "refs": {
     "v1": {
      "commit": "2222222222222222222222222222222222222222",
      "files": {
       "botster-plugin.json": {
        "json": {
         "botster_plugin_api": 1,
         "name": "demo",
         "version": "1.0.0",
         "entrypoints": {
          "service": {
           "lua": "main.lua"
          }
         }
        },
        "mtime": 2000,
        "uid": 2
       },
       "main.lua": {
        "text": "-- v1.0.0\n",
        "mtime": 2000,
        "uid": 2
       }
      },
      "empty_dirs": [
       "empty",
       "a/empty"
      ]
     }
    }
   }
  },
  {
   "control": {
    "op": "client_verb",
    "kind": "package",
    "verb": "create",
    "args": {
     "source": {
      "kind": "git",
      "url": "https://git.example/a.git",
      "ref": "v1"
     }
    }
   },
   "expect": {
    "accepted": {
     "operation_id": {
      "$type": "string"
     }
    }
   },
   "because": "HP PM-5"
  },
  {
   "control": {
    "op": "await_package",
    "package": "demo",
    "settled": true
   },
   "because": "HP PM-5"
  },
  {
   "control": {
    "op": "client_read",
    "kind": "package",
    "id": "demo"
   },
   "expect": {
    "lock": {
     "content_hash": "$h1"
    }
   },
   "because": "HP PM-3"
  }
 ]
}

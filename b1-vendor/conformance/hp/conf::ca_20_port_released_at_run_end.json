{
 "id": "conf::ca_20_port_released_at_run_end",
 "contract": "hp",
 "clause": "CA-20",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "await_session",
   "invoke"
  ]
 },
 "setup": {
  "given": "the range holds one port; the session type dev allocates a port",
  "limits": {
   "session_port_range": [
    20000,
    20000
   ]
  }
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      }
     ]
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "invoke",
    "handler": "h1"
   },
   "bind": {
    "t": "/ticket"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "handler": "h1"
    }
   },
   "because": "HP IV-1"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 1,
     "call": "session_types.spawn",
     "context": {
      "request": "$r"
     },
     "args": {
      "session_type_id": "dev",
      "target_id": "t1"
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 1,
     "result": {
      "ok": true,
      "value": {
       "operation_id": "$op",
       "session": {
        "hub_id": "$h",
        "session_id": "$sid"
       },
       "state": "starting",
       "terminal": false
      }
     },
     "effect": "committed"
    }
   },
   "because": "HP CA-20"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 2,
     "call": "sessions.stop",
     "context": {
      "request": "$r"
     },
     "args": {
      "session": {
       "hub_id": "$h",
       "session_id": "$sid"
      }
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 2,
     "result": {
      "ok": true,
      "value": {
       "decision": {
        "$type": "string"
       }
      }
     },
     "effect": "committed"
    }
   },
   "because": "HP CA-20"
  },
  {
   "control": {
    "op": "await_session",
    "session": {
     "hub_id": "$h",
     "session_id": "$sid"
    },
    "state": "ended"
   }
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 3,
     "call": "sessions.restart",
     "context": {
      "request": "$r"
     },
     "args": {
      "session": {
       "hub_id": "$h",
       "session_id": "$sid"
      }
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 3,
     "result": {
      "ok": true,
      "value": {
       "state": "starting"
      }
     },
     "effect": "committed"
    }
   },
   "because": "HP CA-20"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 4,
     "call": "sessions.get",
     "context": {
      "request": "$r"
     },
     "args": {
      "session": {
       "hub_id": "$h",
       "session_id": "$sid"
      }
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 4,
     "result": {
      "ok": true,
      "value": {
       "port": {
        "$between": [
         20000,
         20100
        ]
       }
      }
     },
     "effect": "none"
    }
   },
   "because": "HP CA-20"
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  }
 ]
}

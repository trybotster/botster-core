{
 "id": "conf::ca_5_operations_get",
 "contract": "hp",
 "clause": "CA-5",
 "subject": "plugin_hub",
 "requires": {
  "controls": [
   "invoke"
  ]
 },
 "setup": {
  "given": "the process command ran 60 s and the call timed out; the operation is still running",
  "calls": {
   "process.run": [
    {
     "result": {
      "ok": true,
      "value": {
       "operation_id": "op1",
       "kind": "process",
       "state": "queued",
       "terminal": false
      }
     },
     "effect": "committed"
    }
   ],
   "operations.get": [
    {
     "result": {
      "ok": true,
      "value": {
       "operation_id": "op1",
       "kind": "process",
       "state": "running",
       "terminal": false
      }
     },
     "effect": "none"
    }
   ]
  }
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      }
     ]
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "invoke",
    "handler": "h1"
   },
   "bind": {
    "t": "/ticket"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "handler": "h1"
    }
   },
   "because": "HP IV-1"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 1,
     "call": "process.run",
     "context": {
      "request": "$r"
     },
     "args": {
      "argv": [
       "sleep",
       "60"
      ],
      "timeout_ms": 1000
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 1,
     "result": {
      "ok": true,
      "value": {
       "operation_id": "$op",
       "terminal": false
      }
     },
     "effect": "committed"
    }
   },
   "because": "HP CA-5"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 2,
     "call": "operations.get",
     "context": {
      "request": "$r"
     },
     "args": {
      "operation_id": "$op"
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 2,
     "result": {
      "ok": true,
      "value": {
       "operation_id": "$op",
       "terminal": false
      }
     },
     "effect": "none"
    }
   },
   "because": "HP CA-5"
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  }
 ]
}

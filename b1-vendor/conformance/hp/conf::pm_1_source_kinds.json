{
 "id": "conf::pm_1_source_kinds",
 "contract": "hp",
 "clause": "PM-1",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "await_catalog",
   "await_package",
   "client_read",
   "client_verb",
   "local_dir",
   "script_catalog",
   "script_git"
  ]
 },
 "setup": {
  "given": "three packages are installed by the operator: g from a git url, c from a catalog entry that resolves to a git url, l from a local directory",
  "plugins": {
   "demo": {
    "grants": []
   }
  }
 },
 "steps": [
  {
   "control": {
    "op": "script_git",
    "url": "https://git.example/a.git",
    "refs": {
     "v1": {
      "commit": "1111111111111111111111111111111111111111",
      "files": {
       "botster-plugin.json": {
        "json": {
         "botster_plugin_api": 1,
         "name": "g",
         "version": "1.0.0",
         "entrypoints": {
          "service": {
           "lua": "main.lua"
          }
         }
        }
       },
       "main.lua": {
        "text": "-- v1.0.0\n"
       }
      }
     }
    }
   }
  },
  {
   "control": {
    "op": "script_git",
    "url": "https://git.example/b.git",
    "refs": {
     "v1": {
      "commit": "2222222222222222222222222222222222222222",
      "files": {
       "botster-plugin.json": {
        "json": {
         "botster_plugin_api": 1,
         "name": "c",
         "version": "1.0.0",
         "entrypoints": {
          "service": {
           "lua": "main.lua"
          }
         }
        }
       },
       "main.lua": {
        "text": "-- v1.0.0\n"
       }
      }
     }
    }
   }
  },
  {
   "control": {
    "op": "script_catalog",
    "url": "https://catalog.example/k1.json",
    "document": {
     "catalog_version": 1,
     "entries": [
      {
       "id": "ce",
       "kind": "plugin",
       "name": "c",
       "description": "d",
       "source": {
        "url": "https://git.example/b.git",
        "ref": "v1"
       }
      }
     ]
    }
   }
  },
  {
   "control": {
    "op": "client_verb",
    "kind": "catalog",
    "verb": "create",
    "args": {
     "url": "https://catalog.example/k1.json"
    }
   },
   "expect": {
    "committed": true
   },
   "because": "HP PM-2"
  },
  {
   "control": {
    "op": "await_catalog",
    "catalog": "https://catalog.example/k1.json",
    "settled": true
   }
  },
  {
   "control": {
    "op": "local_dir",
    "name": "d1",
    "files": {
     "botster-plugin.json": {
      "json": {
       "botster_plugin_api": 1,
       "name": "l",
       "version": "1.0.0",
       "entrypoints": {
        "service": {
         "lua": "main.lua"
        }
       }
      }
     },
     "main.lua": {
      "text": "-- v1.0.0\n"
     }
    }
   },
   "bind": {
    "p": "/path"
   }
  },
  {
   "control": {
    "op": "client_verb",
    "kind": "package",
    "verb": "create",
    "args": {
     "source": {
      "kind": "git",
      "url": "https://git.example/a.git",
      "ref": "v1"
     }
    }
   },
   "expect": {
    "accepted": {
     "operation_id": {
      "$type": "string"
     }
    }
   },
   "because": "HP PM-5"
  },
  {
   "control": {
    "op": "client_verb",
    "kind": "package",
    "verb": "create",
    "args": {
     "source": {
      "kind": "catalog",
      "catalog_id": "https://catalog.example/k1.json",
      "entry_id": "ce"
     }
    }
   },
   "expect": {
    "accepted": {
     "operation_id": {
      "$type": "string"
     }
    }
   },
   "because": "HP PM-5"
  },
  {
   "control": {
    "op": "client_verb",
    "kind": "package",
    "verb": "create",
    "args": {
     "source": {
      "kind": "local",
      "path": "$p"
     }
    }
   },
   "expect": {
    "accepted": {
     "operation_id": {
      "$type": "string"
     }
    }
   },
   "because": "HP PM-5"
  },
  {
   "control": {
    "op": "await_package",
    "package": "g",
    "settled": true
   },
   "because": "HP PM-5"
  },
  {
   "control": {
    "op": "await_package",
    "package": "c",
    "settled": true
   },
   "because": "HP PM-5"
  },
  {
   "control": {
    "op": "await_package",
    "package": "l",
    "settled": true
   },
   "because": "HP PM-5"
  },
  {
   "control": {
    "op": "client_read",
    "kind": "package",
    "id": "g"
   },
   "expect": {
    "source": {
     "kind": "git",
     "url": "https://git.example/a.git",
     "ref": "v1"
    }
   },
   "because": "HP PM-1"
  },
  {
   "control": {
    "op": "client_read",
    "kind": "package",
    "id": "c"
   },
   "expect": {
    "source": {
     "kind": "git",
     "url": "https://git.example/b.git"
    }
   },
   "because": "HP PM-1"
  },
  {
   "control": {
    "op": "client_read",
    "kind": "package",
    "id": "l"
   },
   "expect": {
    "source": {
     "kind": "local",
     "path": "$p"
    }
   },
   "because": "HP PM-1"
  }
 ]
}

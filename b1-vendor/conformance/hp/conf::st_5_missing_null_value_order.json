{
 "id": "conf::st_5_missing_null_value_order",
 "contract": "hp",
 "clause": "ST-5",
 "subject": "plugin_hub",
 "requires": {
  "controls": [
   "invoke"
  ]
 },
 "setup": {
  "given": "x has no n, y has n null, z has n 0",
  "calls": {
   "store.put": [
    {
     "result": {
      "ok": true,
      "value": {
       "revision": "rz"
      }
     },
     "effect": "committed"
    },
    {
     "result": {
      "ok": true,
      "value": {
       "revision": "ry"
      }
     },
     "effect": "committed"
    },
    {
     "result": {
      "ok": true,
      "value": {
       "revision": "rx"
      }
     },
     "effect": "committed"
    }
   ],
   "store.query": [
    {
     "result": {
      "ok": true,
      "value": {
       "docs": [
        {
         "id": "x",
         "doc": {},
         "revision": "rx"
        },
        {
         "id": "y",
         "doc": {
          "n": null
         },
         "revision": "ry"
        },
        {
         "id": "z",
         "doc": {
          "n": 0
         },
         "revision": "rz"
        }
       ]
      }
     },
     "effect": "none"
    }
   ]
  }
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      }
     ]
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "invoke",
    "handler": "h1"
   },
   "bind": {
    "t": "/ticket"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "handler": "h1"
    }
   },
   "because": "HP IV-1"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 1,
     "call": "store.put",
     "context": {
      "request": "$r"
     },
     "args": {
      "collection": "c",
      "id": "z",
      "doc": {
       "n": 0
      }
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 1,
     "result": {
      "ok": true,
      "value": {
       "revision": "$rz"
      }
     },
     "effect": "committed"
    }
   },
   "because": "HP ST-5"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 2,
     "call": "store.put",
     "context": {
      "request": "$r"
     },
     "args": {
      "collection": "c",
      "id": "y",
      "doc": {
       "n": null
      }
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 2,
     "result": {
      "ok": true,
      "value": {
       "revision": "$ry"
      }
     },
     "effect": "committed"
    }
   },
   "because": "HP ST-5"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 3,
     "call": "store.put",
     "context": {
      "request": "$r"
     },
     "args": {
      "collection": "c",
      "id": "x",
      "doc": {}
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 3,
     "result": {
      "ok": true,
      "value": {
       "revision": "$rx"
      }
     },
     "effect": "committed"
    }
   },
   "because": "HP ST-5"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 4,
     "call": "store.query",
     "context": {
      "request": "$r"
     },
     "args": {
      "collection": "c",
      "index": "by_n",
      "limit": 10
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 4,
     "result": {
      "ok": true,
      "value": {
       "docs": [
        {
         "id": "x"
        },
        {
         "id": "y"
        },
        {
         "id": "z"
        }
       ]
      }
     },
     "effect": "none"
    }
   },
   "because": "HP ST-5"
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  }
 ]
}

{
 "id": "conf::ev_14_one_core_feed_per_session",
 "contract": "hp",
 "clause": "EV-14",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "core_feeds",
   "load_plugin"
  ]
 },
 "setup": {
  "given": "the session s1 is spawned by the plugin; the plugin holds events_terminal",
  "grants": [
   {
    "surface": "events",
    "scope": "events_terminal"
   }
  ]
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      },
      {
       "id": "he",
       "kind": "event",
       "descriptor": {}
      },
      {
       "id": "hg",
       "kind": "event_gap",
       "descriptor": {}
      }
     ],
     "events": {
      "subscribed": [
       {
        "handler_id": "he",
        "pattern": {
         "owner": "terminal",
         "name": "title"
        }
       }
      ],
      "gap_handler": "hg"
     }
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "load_plugin",
    "plugin_key": "b",
    "as": "b"
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e_b"
    }
   },
   "on": "b",
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e_b",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      },
      {
       "id": "he",
       "kind": "event",
       "descriptor": {}
      },
      {
       "id": "hg",
       "kind": "event_gap",
       "descriptor": {}
      }
     ],
     "events": {
      "subscribed": [
       {
        "handler_id": "he",
        "pattern": {
         "owner": "terminal",
         "name": "title"
        }
       }
      ],
      "gap_handler": "hg"
     }
    }
   },
   "conn": "b"
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e_b"
    }
   },
   "on": "b",
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "core_feeds"
   },
   "expect": {
    "feeds": {
     "$array": {
      "each": {
       "session": {
        "hub_id": "hub-1",
        "session_id": "s1"
       }
      },
      "min": 1,
      "max": 1
     }
    }
   },
   "because": "HP EV-14"
  }
 ]
}

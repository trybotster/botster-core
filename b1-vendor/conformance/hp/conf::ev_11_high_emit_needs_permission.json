{
 "id": "conf::ev_11_high_emit_needs_permission",
 "contract": "hp",
 "clause": "EV-11",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "diagnostics",
   "load_plugin",
   "status"
  ]
 },
 "setup": {
  "given": "the plugin holds no events_high; c holds events_high and declares the same event"
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      },
      {
       "id": "he",
       "kind": "event",
       "descriptor": {}
      },
      {
       "id": "hg",
       "kind": "event_gap",
       "descriptor": {}
      }
     ],
     "events": {
      "declared": [
       {
        "name": "hi",
        "payload_schema": {
         "type": "object"
        },
        "audience": [
         "plugins"
        ],
        "public": true,
        "priority": "high"
       }
      ],
      "subscribed": [],
      "gap_handler": "hg"
     }
    }
   }
  },
  {
   "control": {
    "op": "status"
   },
   "expect": {
    "state": "load_failed"
   },
   "because": "HP EV-11"
  },
  {
   "control": {
    "op": "diagnostics"
   },
   "expect": {
    "load_error": {
     "kind": "capability_denied"
    }
   },
   "because": "HP EV-11"
  },
  {
   "control": {
    "op": "load_plugin",
    "plugin_key": "c",
    "as": "c"
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e_c"
    }
   },
   "on": "c",
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e_c",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      },
      {
       "id": "he",
       "kind": "event",
       "descriptor": {}
      },
      {
       "id": "hg",
       "kind": "event_gap",
       "descriptor": {}
      }
     ],
     "events": {
      "declared": [
       {
        "name": "hi",
        "payload_schema": {
         "type": "object"
        },
        "audience": [
         "plugins"
        ],
        "public": true,
        "priority": "high"
       }
      ],
      "subscribed": [],
      "gap_handler": "hg"
     }
    }
   },
   "conn": "c"
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e_c"
    }
   },
   "on": "c",
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "status",
    "plugin": "c"
   },
   "expect": {
    "state": "loaded"
   },
   "because": "HP EV-11"
  }
 ]
}

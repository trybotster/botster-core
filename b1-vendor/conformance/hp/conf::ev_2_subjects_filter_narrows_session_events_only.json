{
 "id": "conf::ev_2_subjects_filter_narrows_session_events_only",
 "contract": "hp",
 "clause": "EV-2",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "invoke",
   "load_plugin",
   "settle",
   "terminal_feed"
  ]
 },
 "setup": {
  "given": "the session s1 is spawned by the plugin; the session s2 is spawned by another plugin; b declares the public plugins-audience event pe without a subject",
  "grants": [
   {
    "surface": "events",
    "scope": "events_terminal:any"
   },
   {
    "surface": "events",
    "scope": "events_plugin:b"
   }
  ]
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      },
      {
       "id": "he",
       "kind": "event",
       "descriptor": {}
      },
      {
       "id": "hg",
       "kind": "event_gap",
       "descriptor": {}
      },
      {
       "id": "he2",
       "kind": "event",
       "descriptor": {}
      }
     ],
     "events": {
      "subscribed": [
       {
        "handler_id": "he",
        "pattern": {
         "owner": "terminal",
         "name": "title"
        }
       },
       {
        "handler_id": "he2",
        "pattern": {
         "owner": "terminal",
         "name": "cwd"
        },
        "subjects": "any"
       },
       {
        "handler_id": "he",
        "pattern": {
         "owner": "b",
         "name": "pe"
        }
       }
      ],
      "gap_handler": "hg"
     }
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "load_plugin",
    "plugin_key": "b",
    "as": "b"
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e_b"
    }
   },
   "on": "b",
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e_b",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      },
      {
       "id": "he",
       "kind": "event",
       "descriptor": {}
      },
      {
       "id": "hg",
       "kind": "event_gap",
       "descriptor": {}
      }
     ],
     "events": {
      "declared": [
       {
        "name": "pe",
        "payload_schema": {
         "type": "object"
        },
        "audience": [
         "plugins"
        ],
        "public": true,
        "priority": "normal"
       }
      ],
      "subscribed": [],
      "gap_handler": "hg"
     }
    }
   },
   "conn": "b"
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e_b"
    }
   },
   "on": "b",
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "invoke",
    "plugin": "b",
    "handler": "h1"
   },
   "bind": {
    "t_b": "/ticket"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e_b",
     "request_id": "$r_b",
     "handler": "h1"
    }
   },
   "on": "b",
   "because": "HP IV-1"
  },
  {
   "control": {
    "op": "terminal_feed",
    "session": {
     "hub_id": "hub-1",
     "session_id": "s2"
    },
    "kind": "title",
    "text": "theirs"
   }
  },
  {
   "expect_quiet_until": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "payload": {
      "owner": "terminal",
      "name": "title"
     }
    }
   },
   "barrier": {
    "control": {
     "op": "settle"
    }
   },
   "until": {
    "settled": true
   },
   "because": "HP EV-2"
  },
  {
   "control": {
    "op": "terminal_feed",
    "session": {
     "hub_id": "hub-1",
     "session_id": "s1"
    },
    "kind": "title",
    "text": "own"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$c1",
     "handler": "he",
     "origin": "event",
     "payload": {
      "owner": "terminal",
      "name": "title",
      "subject": {
       "hub_id": "hub-1",
       "session_id": "s1"
      }
     }
    }
   },
   "because": "HP EV-2"
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$c1",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  },
  {
   "control": {
    "op": "terminal_feed",
    "session": {
     "hub_id": "hub-1",
     "session_id": "s2"
    },
    "kind": "cwd",
    "text": "/x"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$c2",
     "handler": "he2",
     "origin": "event",
     "payload": {
      "owner": "terminal",
      "name": "cwd",
      "subject": {
       "hub_id": "hub-1",
       "session_id": "s2"
      }
     }
    }
   },
   "because": "HP EV-2"
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$c2",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e_b",
     "call_id": 1,
     "call": "events.emit",
     "context": {
      "request": "$r_b"
     },
     "args": {
      "name": "pe",
      "payload": {}
     }
    }
   },
   "conn": "b"
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e_b",
     "call_id": 1,
     "result": {
      "ok": true,
      "value": {
       "status": "accepted"
      }
     },
     "effect": "committed"
    }
   },
   "on": "b",
   "because": "HP EV-1"
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$c3",
     "handler": "he",
     "origin": "event",
     "payload": {
      "owner": "b",
      "name": "pe"
     }
    }
   },
   "because": "HP EV-2"
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$c3",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e_b",
     "request_id": "$r_b",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   },
   "conn": "b"
  }
 ]
}

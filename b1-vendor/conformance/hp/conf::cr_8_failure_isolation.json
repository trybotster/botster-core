{
 "id": "conf::cr_8_failure_isolation",
 "contract": "hp",
 "clause": "CR-8",
 "subject": "plugin_hub",
 "requires": {
  "controls": [
   "status",
   "load_plugin",
   "service_connected",
   "invoke"
  ]
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      }
     ]
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "load_plugin",
    "plugin_key": "p2",
    "as": "p2"
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e2"
    }
   },
   "because": "HP HS-1",
   "on": "p2"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e2"
    }
   },
   "conn": "p2"
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e2"
    }
   },
   "because": "HP HS-2",
   "on": "p2"
  },
  {
   "close_channel": {},
   "conn": "p2"
  },
  {
   "control": {
    "op": "service_connected",
    "plugin": "p2"
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e3"
    }
   },
   "because": "HP CR-3",
   "on": "p2"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e3"
    }
   },
   "conn": "p2"
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e3"
    }
   },
   "because": "HP CR-3",
   "on": "p2"
  },
  {
   "close_channel": {},
   "conn": "p2"
  },
  {
   "control": {
    "op": "status",
    "plugin": "p2"
   },
   "expect": {
    "state": "quarantined"
   },
   "because": "HP CR-3"
  },
  {
   "control": {
    "op": "status"
   },
   "expect": {
    "state": "loaded"
   },
   "because": "HP CR-8"
  },
  {
   "control": {
    "op": "invoke",
    "handler": "h1"
   },
   "bind": {
    "t": "/ticket"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "handler": "h1"
    }
   },
   "because": "HP CR-8"
  }
 ]
}

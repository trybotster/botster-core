{
 "id": "conf::mp_9_stderr_tail_bounded_and_redacted",
 "contract": "hp",
 "clause": "MP-9",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "await_mcp_server",
   "await_mcp_stderr",
   "diagnostics",
   "script_mcp",
   "set_secret"
  ]
 },
 "setup": {
  "given": "stderr_bytes is 4096; the stdio server writes 1 MiB to stderr, including the plugin's secret value",
  "limits": {
   "stderr_bytes": 4096
  },
  "plugins": {
   "demo": {
    "grants": [
     {
      "surface": "mcp",
      "scope": "mcp_proxy"
     },
     {
      "surface": "mcp",
      "scope": "mcp_proxy_stdio"
     },
     {
      "surface": "net",
      "scope": "net",
      "allow": [
       "https://mcp.example"
      ]
     }
    ],
    "mcp_servers": [
     {
      "id": "s",
      "transport": "stdio",
      "command": "mcp-server",
      "args": [
       "--x"
      ],
      "env": {
       "A": "1"
      }
     }
    ],
    "entry": "the plugin declares the MCP servers in its manifest (MP-1)"
   }
  }
 },
 "steps": [
  {
   "control": {
    "op": "set_secret",
    "plugin": "demo",
    "name": "k",
    "value": "sekret-123"
   }
  },
  {
   "control": {
    "op": "script_mcp",
    "plugin": "demo",
    "server": "s",
    "transport": "stdio",
    "tools": [
     {
      "name": "echo",
      "description": "echo tool",
      "inputSchema": {
       "type": "object",
       "properties": {
        "n": {
         "type": "integer"
        }
       }
      },
      "behavior": {
       "kind": "echo"
      }
     }
    ],
    "stderr": {
     "bytes": 1048576,
     "contains": "sekret-123"
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      }
     ]
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "await_mcp_server",
    "plugin": "demo",
    "server": "s",
    "state": "available"
   }
  },
  {
   "control": {
    "op": "await_mcp_stderr",
    "plugin": "demo",
    "server": "s",
    "bytes": 1048576
   }
  },
  {
   "control": {
    "op": "diagnostics",
    "plugin": "demo"
   },
   "expect": {
    "stderr_tail": {
     "s": {
      "bytes": {
       "$between": [
        1,
        4096
       ]
      },
      "text": {
       "$not": {
        "$contains": "sekret-123"
       }
      }
     }
    }
   },
   "because": "HP MP-9"
  }
 ]
}

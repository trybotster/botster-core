{
 "id": "conf::as_4_reload_replaces_at_handover",
 "contract": "hp",
 "clause": "AS-4",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "invoke",
   "package_update",
   "plugin_assets",
   "reload"
  ]
 },
 "setup": {
  "given": "the assets origin is https://assets.example and the app origin is https://app.example; the package of demo stages the asset old.html and a new version stages new.html; demo has also published a page; the package of demo declares the embed view view (permission embed.view, action refresh) and the viewer holds embed.view",
  "plugins": {
   "demo": {
    "grants": [
     {
      "surface": "assets"
     }
    ],
    "views": [
     {
      "key": "view",
      "kind": "embed",
      "permission": "embed.view",
      "actions": [
       {
        "id": "refresh",
        "handler": "h1"
       }
      ]
     }
    ],
    "staged_assets": [
     {
      "name": "old.html",
      "path": "web/old.html",
      "content_type": "text/html"
     }
    ]
   }
  }
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      }
     ]
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "invoke",
    "handler": "h1"
   },
   "bind": {
    "t": "/ticket"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "handler": "h1"
    }
   },
   "because": "HP IV-1"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 1,
     "call": "assets.publish",
     "context": {
      "request": "$r"
     },
     "args": {
      "name": "live",
      "content_type": "text/html",
      "bytes_b64": "PGh0bWw+PGJvZHk+b25lPC9ib2R5PjwvaHRtbD4="
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 1,
     "result": {
      "ok": true,
      "value": {
       "asset_id": "$a1"
      }
     },
     "effect": "committed"
    }
   },
   "because": "HP AS-1"
  },
  {
   "control": {
    "op": "plugin_assets",
    "plugin": "demo"
   },
   "expect": {
    "assets": {
     "$array": {
      "each": {
       "name": {
        "$one_of": [
         "old.html",
         "live"
        ]
       }
      },
      "min": 2,
      "max": 2
     }
    }
   },
   "because": "HP AS-4"
  },
  {
   "control": {
    "op": "package_update",
    "plugin": "demo",
    "staged_assets": [
     {
      "name": "new.html",
      "path": "web/new.html",
      "content_type": "text/html"
     }
    ]
   }
  },
  {
   "control": {
    "op": "plugin_assets",
    "plugin": "demo"
   },
   "expect": {
    "assets": {
     "$array": {
      "each": {
       "name": {
        "$one_of": [
         "old.html",
         "live"
        ]
       }
      },
      "min": 2,
      "max": 2
     }
    }
   },
   "because": "HP AS-4"
  },
  {
   "control": {
    "op": "reload"
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e_c",
     "resumed": false
    }
   },
   "on": "cand",
   "because": "HP LD-3"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e_c",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      }
     ]
    }
   },
   "conn": "cand"
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e_c"
    }
   },
   "on": "cand",
   "because": "HP LD-3"
  },
  {
   "control": {
    "op": "plugin_assets",
    "plugin": "demo"
   },
   "expect": {
    "assets": {
     "$array": {
      "each": {
       "name": {
        "$one_of": [
         "new.html",
         "live"
        ]
       }
      },
      "min": 2,
      "max": 2
     }
    }
   },
   "because": "HP AS-4"
  },
  {
   "control": {
    "op": "plugin_assets",
    "plugin": "demo"
   },
   "expect": {
    "assets": {
     "$array": {
      "each": {
       "name": {
        "$not": "old.html"
       }
      },
      "min": 2,
      "max": 2
     }
    }
   },
   "because": "HP AS-4"
  }
 ]
}

{
 "id": "conf::mp_14_removed_tool_not_dispatched_after_swap",
 "contract": "hp",
 "clause": "MP-14",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "await_mcp_list",
   "await_mcp_server",
   "mcp_call",
   "mcp_response",
   "mcp_server_event",
   "mcp_server_log",
   "script_mcp"
  ]
 },
 "setup": {
  "given": "the list is [a, b]; a refresh removes a; a client then calls a",
  "plugins": {
   "demo": {
    "grants": [
     {
      "surface": "mcp",
      "scope": "mcp_proxy"
     },
     {
      "surface": "mcp",
      "scope": "mcp_proxy_stdio"
     },
     {
      "surface": "net",
      "scope": "net",
      "allow": [
       "https://mcp.example"
      ]
     }
    ],
    "mcp_servers": [
     {
      "id": "s",
      "transport": "stdio",
      "command": "mcp-server",
      "args": [
       "--x"
      ],
      "env": {
       "A": "1"
      }
     }
    ],
    "entry": "the plugin declares the MCP servers in its manifest (MP-1)"
   }
  }
 },
 "steps": [
  {
   "control": {
    "op": "script_mcp",
    "plugin": "demo",
    "server": "s",
    "transport": "stdio",
    "tools": [
     {
      "name": "a",
      "description": "echo tool",
      "inputSchema": {
       "type": "object",
       "properties": {
        "n": {
         "type": "integer"
        }
       }
      },
      "behavior": {
       "kind": "echo"
      }
     },
     {
      "name": "b",
      "description": "echo tool",
      "inputSchema": {
       "type": "object",
       "properties": {
        "n": {
         "type": "integer"
        }
       }
      },
      "behavior": {
       "kind": "echo"
      }
     }
    ]
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      }
     ]
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "await_mcp_server",
    "plugin": "demo",
    "server": "s",
    "state": "available"
   }
  },
  {
   "control": {
    "op": "mcp_server_event",
    "plugin": "demo",
    "server": "s",
    "event": "list_changed",
    "tools": [
     {
      "name": "b",
      "description": "echo tool",
      "inputSchema": {
       "type": "object",
       "properties": {
        "n": {
         "type": "integer"
        }
       }
      },
      "behavior": {
       "kind": "echo"
      }
     }
    ]
   }
  },
  {
   "control": {
    "op": "await_mcp_list",
    "plugin": "demo",
    "server": "s",
    "generation": 2
   }
  },
  {
   "control": {
    "op": "mcp_call",
    "tool": "demo__s__a",
    "arguments": {}
   },
   "bind": {
    "tk": "/ticket"
   },
   "because": "HP MP-14"
  },
  {
   "control": {
    "op": "mcp_response",
    "ticket": "$tk"
   },
   "expect": {
    "is_error": true,
    "error": {
     "kind": "not_found"
    }
   },
   "because": "HP MP-14"
  },
  {
   "control": {
    "op": "mcp_server_log",
    "plugin": "demo",
    "server": "s"
   },
   "expect": {
    "calls": []
   },
   "because": "HP MP-14"
  }
 ]
}

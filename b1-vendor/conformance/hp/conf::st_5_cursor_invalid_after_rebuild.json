    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 1,
     "result": {
      "ok": true,
      "value": {
       "docs": [
        {
         "id": "a"
        }
       ],
       "cursor": "$cur"

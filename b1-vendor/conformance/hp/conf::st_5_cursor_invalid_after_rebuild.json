  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$ec",
     "request_id": "$r2",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  }
 ]
}

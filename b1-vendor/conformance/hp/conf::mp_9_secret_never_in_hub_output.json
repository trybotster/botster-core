{
 "id": "conf::mp_9_secret_never_in_hub_output",
 "contract": "hp",
 "clause": "MP-9",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "await_mcp_server",
   "diagnostics",
   "hub_log",
   "lane_transcript",
   "mcp_call",
   "mcp_response",
   "script_mcp",
   "set_secret"
  ]
 },
 "setup": {
  "given": "a secret k is substituted into the env of a stdio server and into a header of an http server; calls succeed and one fails",
  "plugins": {
   "demo": {
    "grants": [
     {
      "surface": "mcp",
      "scope": "mcp_proxy"
     },
     {
      "surface": "mcp",
      "scope": "mcp_proxy_stdio"
     },
     {
      "surface": "net",
      "scope": "net",
      "allow": [
       "https://mcp.example"
      ]
     }
    ],
    "mcp_servers": [
     {
      "id": "s",
      "transport": "stdio",
      "command": "mcp-server",
      "args": [
       "--x"
      ],
      "env": {
       "T": "{{secret:k}}"
      }
     },
     {
      "id": "h",
      "transport": "http",
      "url": "https://mcp.example/mcp",
      "headers": {
       "x-api-key": "{{secret:k}}"
      }
     }
    ],
    "entry": "the plugin declares the MCP servers in its manifest (MP-1)"
   }
  }
 },
 "steps": [
  {
   "control": {
    "op": "set_secret",
    "plugin": "demo",
    "name": "k",
    "value": "sekret-123"
   }
  },
  {
   "control": {
    "op": "script_mcp",
    "plugin": "demo",
    "server": "s",
    "transport": "stdio",
    "tools": [
     {
      "name": "echo",
      "description": "echo tool",
      "inputSchema": {
       "type": "object",
       "properties": {
        "n": {
         "type": "integer"
        }
       }
      },
      "behavior": {
       "kind": "echo"
      }
     },
     {
      "name": "err",
      "description": "error tool",
      "inputSchema": {
       "type": "object"
      },
      "behavior": {
       "kind": "is_error",
       "content": [
        {
         "type": "text",
         "text": "server said no"
        }
       ]
      }
     }
    ]
   }
  },
  {
   "control": {
    "op": "script_mcp",
    "plugin": "demo",
    "server": "h",
    "transport": "http",
    "tools": [
     {
      "name": "echo",
      "description": "echo tool",
      "inputSchema": {
       "type": "object",
       "properties": {
        "n": {
         "type": "integer"
        }
       }
      },
      "behavior": {
       "kind": "echo"
      }
     }
    ]
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      }
     ]
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "await_mcp_server",
    "plugin": "demo",
    "server": "s",
    "state": "available"
   }
  },
  {
   "control": {
    "op": "await_mcp_server",
    "plugin": "demo",
    "server": "h",
    "state": "available"
   }
  },
  {
   "control": {
    "op": "mcp_call",
    "tool": "demo__s__echo",
    "arguments": {
     "n": 1
    }
   },
   "bind": {
    "tk1": "/ticket"
   },
   "because": "HP MP-9"
  },
  {
   "control": {
    "op": "mcp_response",
    "ticket": "$tk1"
   },
   "expect": {
    "is_error": false
   },
   "because": "HP MP-9"
  },
  {
   "control": {
    "op": "mcp_call",
    "tool": "demo__s__err",
    "arguments": {}
   },
   "bind": {
    "tk2": "/ticket"
   },
   "because": "HP MP-9"
  },
  {
   "control": {
    "op": "mcp_response",
    "ticket": "$tk2"
   },
   "expect": {
    "is_error": true
   },
   "because": "HP MP-9"
  },
  {
   "control": {
    "op": "hub_log"
   },
   "expect": {
    "text": {
     "$not": {
      "$contains": "sekret-123"
     }
    }
   },
   "because": "HP MP-9"
  },
  {
   "control": {
    "op": "diagnostics",
    "plugin": "demo"
   },
   "expect": {
    "text": {
     "$not": {
      "$contains": "sekret-123"
     }
    }
   },
   "because": "HP MP-9"
  },
  {
   "control": {
    "op": "lane_transcript",
    "plugin": "demo"
   },
   "expect": {
    "text": {
     "$not": {
      "$contains": "sekret-123"
     }
    }
   },
   "because": "HP MP-9"
  }
 ]
}

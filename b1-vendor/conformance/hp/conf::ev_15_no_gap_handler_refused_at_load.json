{
 "id": "conf::ev_15_no_gap_handler_refused_at_load",
 "contract": "hp",
 "clause": "EV-15",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "published",
   "status"
  ]
 },
 "setup": {
  "given": "the plugin holds events_hub and registers no event_gap handler",
  "grants": [
   {
    "surface": "events",
    "scope": "events_hub"
   }
  ]
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      },
      {
       "id": "he",
       "kind": "event",
       "descriptor": {}
      }
     ],
     "events": {
      "subscribed": [
       {
        "handler_id": "he",
        "pattern": {
         "owner": "hub",
         "name": "session.ended"
        }
       }
      ]
     }
    }
   }
  },
  {
   "control": {
    "op": "status"
   },
   "expect": {
    "state": "load_failed"
   },
   "because": "HP EV-15"
  },
  {
   "control": {
    "op": "published"
   },
   "expect": {
    "subscriptions": [],
    "handlers": []
   },
   "because": "HP EV-15"
  }
 ]
}

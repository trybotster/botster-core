{
 "id": "conf::pm_5_failed_step_leaves_nothing_loaded",
 "contract": "hp",
 "clause": "PM-5",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "await_package",
   "client_read",
   "client_verb",
   "execution_count",
   "mcp_list",
   "plugin_assets",
   "script_git",
   "settle"
  ]
 },
 "setup": {
  "given": "the repository holds a package whose manifest fails the static admission",
  "plugins": {
   "demo": {
    "grants": []
   }
  }
 },
 "steps": [
  {
   "control": {
    "op": "script_git",
    "url": "https://git.example/a.git",
    "refs": {
     "v1": {
      "commit": "1111111111111111111111111111111111111111",
      "files": {
       "botster-plugin.json": {
        "json": {
         "botster_plugin_api": 1,
         "name": "demo"
        }
       },
       "main.lua": {
        "text": "-- v1.0.0\n"
       }
      }
     }
    }
   }
  },
  {
   "control": {
    "op": "client_verb",
    "kind": "package",
    "verb": "create",
    "args": {
     "source": {
      "kind": "git",
      "url": "https://git.example/a.git",
      "ref": "v1"
     },
     "enable": true
    }
   },
   "expect": {
    "accepted": {
     "operation_id": {
      "$type": "string"
     }
    }
   },
   "because": "HP PM-5"
  },
  {
   "control": {
    "op": "await_package",
    "package": "demo",
    "settled": true
   },
   "because": "HP PM-5"
  },
  {
   "control": {
    "op": "client_read",
    "kind": "package",
    "id": "demo"
   },
   "expect": {
    "status": "errored"
   },
   "because": "HP PM-5"
  },
  {
   "expect_quiet_until": {
    "lane": "control",
    "type": "Hello"
   },
   "on": "main",
   "barrier": {
    "control": {
     "op": "settle",
     "conn": "main"
    }
   },
   "until": {
    "settled": true
   },
   "because": "HP PM-5"
  },
  {
   "control": {
    "op": "mcp_list",
    "kind": "tools",
    "plugin": "demo"
   },
   "expect": {
    "items": []
   },
   "because": "HP PM-5"
  },
  {
   "control": {
    "op": "plugin_assets",
    "plugin": "demo"
   },
   "expect": {
    "assets": []
   },
   "because": "HP PM-5"
  },
  {
   "control": {
    "op": "execution_count"
   },
   "expect": {
    "started": 0
   },
   "because": "HP PM-5"
  }
 ]
}

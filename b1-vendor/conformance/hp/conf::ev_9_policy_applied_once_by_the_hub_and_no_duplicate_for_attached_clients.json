{
 "id": "conf::ev_9_policy_applied_once_by_the_hub_and_no_duplicate_for_attached_clients",
 "contract": "hp",
 "clause": "EV-9",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "client_events",
   "settle",
   "terminal_feed"
  ]
 },
 "setup": {
  "given": "the session s1 is spawned by the plugin; client c1 is attached to the terminal route of s1; client c2 is connected and not attached; the session type declares no notification policy",
  "grants": [
   {
    "surface": "events",
    "scope": "events_terminal"
   }
  ]
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      },
      {
       "id": "he",
       "kind": "event",
       "descriptor": {}
      },
      {
       "id": "hg",
       "kind": "event_gap",
       "descriptor": {}
      }
     ],
     "events": {
      "subscribed": [
       {
        "handler_id": "he",
        "pattern": {
         "owner": "hub",
         "name": "session_notification"
        }
       }
      ],
      "gap_handler": "hg"
     }
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "terminal_feed",
    "session": {
     "hub_id": "hub-1",
     "session_id": "s1"
    },
    "kind": "notification",
    "source": "osc9",
    "body": "done"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$c1",
     "handler": "he",
     "origin": "event",
     "payload": {
      "owner": "hub",
      "name": "session_notification",
      "payload": {
       "session": {
        "hub_id": "hub-1",
        "session_id": "s1"
       }
      }
     }
    }
   },
   "because": "HP EV-9"
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$c1",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  },
  {
   "expect_quiet_until": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "payload": {
      "name": "session_notification"
     }
    }
   },
   "barrier": {
    "control": {
     "op": "settle"
    }
   },
   "until": {
    "settled": true
   },
   "because": "HP EV-9"
  },
  {
   "control": {
    "op": "client_events",
    "client": "c2"
   },
   "expect": {
    "events": {
     "$array": {
      "min": 1,
      "max": 1,
      "each": {
       "owner": "hub",
       "name": "session_notification"
      }
     }
    }
   },
   "because": "HP EV-9"
  },
  {
   "control": {
    "op": "client_events",
    "client": "c1"
   },
   "expect": {
    "events": {
     "$array": {
      "max": 0
     }
    }
   },
   "because": "HP EV-9"
  }
 ]
}

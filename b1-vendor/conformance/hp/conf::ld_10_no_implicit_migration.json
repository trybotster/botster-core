{
 "id": "conf::ld_10_no_implicit_migration",
 "contract": "hp",
 "clause": "LD-10",
 "subject": "plugin_hub",
 "requires": {
  "controls": [
   "invoke",
   "reload"
  ]
 },
 "setup": {
  "given": "a document written under schema_version 1; the candidate declares schema_version 2 and accepts 1",
  "calls": {
   "store.get": [
    {
     "result": {
      "ok": true,
      "value": {
       "doc": {
        "v": 1
       },
       "revision": "r1"
      }
     }
    },
    {
     "result": {
      "ok": true,
      "value": {
       "doc": {
        "v": 1
       },
       "revision": "r1"
      }
     }
    }
   ]
  }
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      }
     ]
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "reload"
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e2"
    }
   },
   "because": "HP LD-3",
   "on": "cand"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e2",
     "call_id": 101,
     "call": "store.get",
     "context": "bootstrap",
     "args": {
      "collection": "c",
      "id": "a"
     }
    }
   },
   "conn": "cand"
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e2",
     "call_id": 101,
     "result": {
      "ok": true,
      "value": {
       "doc": {
        "v": 1
       },
       "revision": "r1"
      }
     }
    }
   },
   "because": "HP LD-10",
   "on": "cand"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e2",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      }
     ]
    }
   },
   "conn": "cand"
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e2"
    }
   },
   "because": "HP LD-10",
   "on": "cand"
  },
  {
   "expect": {
    "lane": "control",
    "type": "Shutdown",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP LD-10"
  },
  {
   "control": {
    "op": "invoke",
    "handler": "h1"
   },
   "bind": {
    "t": "/ticket"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e2",
     "request_id": "$r2"
    }
   },
   "because": "HP LD-10",
   "on": "cand"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e2",
     "call_id": 102,
     "call": "store.get",
     "context": {
      "request": "$r2"
     },
     "args": {
      "collection": "c",
      "id": "a"
     }
    }
   },
   "conn": "cand"
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e2",
     "call_id": 102,
     "result": {
      "ok": true,
      "value": {
       "doc": {
        "v": 1
       },
       "revision": "r1"
      }
     }
    }
   },
   "because": "HP LD-10",
   "on": "cand"
  }
 ]
}

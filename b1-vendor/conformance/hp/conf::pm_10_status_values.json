{
 "id": "conf::pm_10_status_values",
 "contract": "hp",
 "clause": "PM-10",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "await_catalog",
   "await_package",
   "client_read",
   "client_verb",
   "local_dir",
   "script_catalog",
   "script_git"
  ]
 },
 "setup": {
  "given": "eight packages are brought into eight states: installed, available, outdated, errored, live, pinned, staged and degraded",
  "plugins": {
   "demo": {
    "grants": []
   }
  }

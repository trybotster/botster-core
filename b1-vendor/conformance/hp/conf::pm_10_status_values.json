       "botster-plugin.json": {
        "json": {
         "botster_plugin_api": 1,
         "name": "po",
         "version": "2.0.0",
         "entrypoints": {
          "service": {
           "lua": "main.lua"
          }
         }
        }
       },
       "main.lua": {
        "text": "-- v2.0.0\n"

{
 "id": "conf::nt_10_telegram_shaped_long_poll_and_send",
 "contract": "hp",
 "clause": "NT-10",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "await_operation",
   "hub_output",
   "invoke",
   "net_release",
   "net_seen",
   "net_state",
   "net_world",
   "set_secret"
  ]
 },
 "setup": {
  "given": "the plugin holds net with one allowed host and the secret bot_token (value bot123:SECRET); the scripted edge holds the long poll of getUpdates until released",
  "plugins": {
   "demo": {
    "grants": [
     {
      "surface": "net",
      "scope": "net",
      "allow": [
       "https://api.telegram.test"
      ]
     },
     {
      "surface": "secrets"
     }
    ],
    "secrets": [
     {
      "name": "bot_token"
     }
    ]
   }
  }
 },
 "steps": [
  {
   "control": {
    "op": "set_secret",
    "plugin": "demo",
    "name": "bot_token",
    "value": "bot123:SECRET"
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      },
      {
       "id": "op",
       "kind": "operation",
       "descriptor": {}
      }
     ],
     "operations": {
      "subscribed": "op"
     }
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "invoke",
    "handler": "h1"
   },
   "bind": {
    "t": "/ticket"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "handler": "h1"
    }
   },
   "because": "HP IV-1"
  },
  {
   "control": {
    "op": "net_world",
    "endpoints": [
     {
      "origin": "https://api.telegram.test",
      "addresses": [
       "203.0.113.20"
      ],
      "answers": [
       {
        "status": 200,
        "body_b64": "eyJvayI6dHJ1ZSwicmVzdWx0IjpbeyJ1cGRhdGVfaWQiOjEsIm1lc3NhZ2UiOnsidGV4dCI6ImhpIn19XX0=",
        "hold": true
       },
       {
        "status": 200,
        "body_b64": "eyJvayI6dHJ1ZX0="
       }
      ]
     }
    ]
   }
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 1,
     "call": "http.request",
     "context": {
      "request": "$r"
     },
     "args": {
      "method": "GET",
      "url": "https://api.telegram.test/bot{{secret:bot_token}}/getUpdates?timeout=30",
      "timeout_ms": 35000
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 1,
     "result": {
      "ok": true,
      "value": {
       "operation_id": "$o1",
       "kind": "http",
       "state": "queued",
       "terminal": false
      }
     },
     "effect": "committed"
    }
   },
   "because": "HP NT-10"
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  },
  {
   "control": {
    "op": "net_state",
    "plugin": "demo"
   },
   "expect": {
    "open_requests": 1
   },
   "because": "HP NT-10"
  },
  {
   "control": {
    "op": "net_release",
    "origin": "https://api.telegram.test"
   }
  },
  {
   "control": {
    "op": "await_operation",
    "operation_id": "$o1",
    "terminal": true
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$ro",
     "handler": "op",
     "origin": "operation",
     "payload": {
      "operation_id": "$o1",
      "state": "done"
     }
    }
   },
   "because": "HP CA-16"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 2,
     "call": "http.request",
     "context": {
      "request": "$ro"
     },
     "args": {
      "method": "POST",
      "url": "https://api.telegram.test/bot{{secret:bot_token}}/sendMessage",
      "timeout_ms": 5000,
      "body_b64": "eyJjaGF0X2lkIjoxLCJ0ZXh0Ijoib2sifQ=="
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 2,
     "result": {
      "ok": true,
      "value": {
       "operation_id": "$o2",
       "kind": "http",
       "state": "queued",
       "terminal": false
      }
     },
     "effect": "committed"
    }
   },
   "because": "HP NT-10"
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$ro",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  },
  {
   "control": {
    "op": "await_operation",
    "operation_id": "$o2",
    "terminal": true
   }
  },
  {
   "control": {
    "op": "net_seen",
    "path_prefix": "/bot"
   },
   "expect": {
    "requests": [
     {
      "method": "GET",
      "path_and_query": "/botbot123:SECRET/getUpdates?timeout=30"
     },
     {
      "method": "POST",
      "path_and_query": "/botbot123:SECRET/sendMessage"
     }
    ]
   },
   "because": "HP NT-10"
  },
  {
   "control": {
    "op": "hub_output"
   },
   "expect": {
    "log": {
     "$not": {
      "$contains": "bot123:SECRET"
     }
    },
    "events": {
     "$not": {
      "$contains": "bot123:SECRET"
     }
    },
    "receipts": {
     "$not": {
      "$contains": "bot123:SECRET"
     }
    },
    "errors": {
     "$not": {
      "$contains": "bot123:SECRET"
     }
    },
    "call_results": {
     "$not": {
      "$contains": "bot123:SECRET"
     }
    }
   },
   "because": "HP NT-10"
  }
 ]
}

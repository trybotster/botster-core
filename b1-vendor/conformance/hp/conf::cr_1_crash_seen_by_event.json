{
 "id": "conf::cr_1_crash_seen_by_event",
 "contract": "hp",
 "clause": "CR-1",
 "subject": "plugin_hub",
 "requires": {
  "controls": [
   "status",
   "load_plugin",
   "service_exited"
  ]
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      }
     ]
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "close_channel": {}
  },
  {
   "control": {
    "op": "status"
   },
   "expect": {
    "state": "restarting",
    "cause": {
     "lane_ended": true
    }
   },
   "because": "HP CR-1"
  },
  {
   "control": {
    "op": "load_plugin",
    "plugin_key": "p2",
    "as": "p2"
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e2"
    }
   },
   "because": "HP HS-1",
   "on": "p2"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e2"
    }
   },
   "conn": "p2"
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e2"
    }
   },
   "because": "HP HS-2",
   "on": "p2"
  },
  {
   "control": {
    "op": "service_exited",
    "plugin": "p2",
    "code": 1
   }
  },
  {
   "control": {
    "op": "status",
    "plugin": "p2"
   },
   "expect": {
    "state": "restarting",
    "cause": {
     "exit": {
      "code": 1
     }
    }
   },
   "because": "HP CR-1"
  }
 ]
}

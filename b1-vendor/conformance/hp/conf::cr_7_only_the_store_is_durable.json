{
 "id": "conf::cr_7_only_the_store_is_durable",
 "contract": "hp",
 "clause": "CR-7",
 "subject": "plugin_hub",
 "requires": {
  "controls": [
   "invoke",
   "service_connected",
   "published",
   "completions",
   "settle"
  ]
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      }
     ]
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "invoke",
    "handler": "h1"
   },
   "bind": {
    "t": "/ticket"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "handler": "h1"
    }
   },
   "because": "HP IV-1"
  },
  {
   "close_channel": {}
  },
  {
   "control": {
    "op": "service_connected"
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e2",
     "resumed": false
    }
   },
   "because": "HP CR-3"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e2"
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e2"
    }
   },
   "because": "HP HS-2"
  },
  {
   "expect_quiet_until": {
    "lane": "invoke",
    "type": "Invoke"
   },
   "barrier": {
    "control": {
     "op": "settle"
    }
   },
   "until": {
    "settled": true
   },
   "because": "HP CR-7"
  },
  {
   "control": {
    "op": "published"
   },
   "expect": {
    "handlers": []
   },
   "because": "HP CR-7"
  },
  {
   "control": {
    "op": "completions"
   },
   "expect": [
    {
     "ticket": "$t",
     "answer": {
      "ok": false,
      "error": {
       "detail": {
        "code": "plugin_crashed"
       }
      }
     }
    }
   ],
   "because": "HP CR-7"
  }
 ]
}

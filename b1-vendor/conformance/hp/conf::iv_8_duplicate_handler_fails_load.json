       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      },
      {
       "id": "h1",
       "kind": "mcp_prompt",
       "descriptor": {}
      }
     ]
    }
   }
  },
  {
   "control": {
    "op": "status"
   },
   "expect": {
    "state": "load_failed"
   },
   "because": "HP IV-8"
  },
  {
   "control": {
    "op": "published"
   },
   "expect": {
    "handlers": [],
    "tools": [],
    "prompts": [],
    "resources": [],
    "timers": [],

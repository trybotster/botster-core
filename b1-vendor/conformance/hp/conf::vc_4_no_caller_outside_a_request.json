  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 2,
     "call": "sessions.list",
     "context": "autonomous",
     "args": {}
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 2,
     "result": {
      "ok": false,
      "error": {
       "kind": "failed",
       "detail": {
        "code": "wrong_context"
       }
      }
     },
     "effect": "none"
    }
   },
   "because": [
    "HP VC-4",
    "HP CA-3"
   ]
  },
  {
   "send_frame": {
    "lane": "bulk",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 3,
     "call": "log.write",
     "context": "autonomous",
     "args": {
      "level": "info",
      "message": "m"
     }
    }
   }
  },
  {
   "expect": {
    "lane": "bulk",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 3,
     "result": {
      "ok": true
     }
    }
   },
   "because": "HP CA-3"

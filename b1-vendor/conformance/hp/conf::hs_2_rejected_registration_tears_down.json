{
 "id": "conf::hs_2_rejected_registration_tears_down",
 "contract": "hp",
 "clause": "HS-2",
 "subject": "plugin_hub",
 "requires": {
  "controls": [
   "published",
   "status"
  ]
 },
 "setup": {
  "reject_registration": "capability_missing"
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      }
     ]
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Shutdown",
    "payload": {
     "epoch": "$e",
     "reason": "capability_missing"
    }
   },
   "because": "HP HS-2"
  },
  {
   "expect_closed": null,
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "published"
   },
   "expect": {
    "handlers": [],
    "tools": [],
    "prompts": [],
    "resources": [],
    "timers": [],
    "subscriptions": [],
    "declared_events": [],
    "entity_providers": [],
    "held_subscriptions": []
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "status"
   },
   "expect": {
    "state": "load_failed"
   },
   "because": "HP HS-2"
  }
 ]
}

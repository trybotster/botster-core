{
 "id": "conf::ev_14_tap_default_own_sessions_any_needs_approval",
 "contract": "hp",
 "clause": "EV-14",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "diagnostics",
   "load_plugin",
   "published",
   "settle",
   "status",
   "terminal_feed"
  ]
 },
 "setup": {
  "given": "the session s1 is spawned by the plugin; s2 by another plugin; the plugin holds session_output:read (own) and the operator approved no :any",
  "grants": [
   {
    "surface": "events",
    "scope": "session_output:read"
   }
  ]
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      },
      {
       "id": "he",
       "kind": "event",
       "descriptor": {}
      },
      {
       "id": "hg",
       "kind": "event_gap",
       "descriptor": {}
      }
     ],
     "events": {
      "subscribed": [
       {
        "handler_id": "he",
        "pattern": {
         "owner": "terminal",
         "name": "output"
        }
       }
      ],
      "gap_handler": "hg"
     }
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "terminal_feed",
    "session": {
     "hub_id": "hub-1",
     "session_id": "s2"
    },
    "kind": "output",
    "bytes_b64": "QUJDRA=="
   }
  },
  {
   "expect_quiet_until": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "payload": {
      "owner": "terminal",
      "name": "output"
     }
    }
   },
   "barrier": {
    "control": {
     "op": "settle"
    }
   },
   "until": {
    "settled": true
   },
   "because": "HP EV-14"
  },
  {
   "control": {
    "op": "terminal_feed",
    "session": {
     "hub_id": "hub-1",
     "session_id": "s1"
    },
    "kind": "output",
    "bytes_b64": "QUJDRA=="
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$c1",
     "handler": "he",
     "origin": "event",
     "payload": {
      "owner": "terminal",
      "name": "output",
      "priority": "low",
      "payload": {
       "bytes_b64": "QUJDRA=="
      },
      "subject": {
       "hub_id": "hub-1",
       "session_id": "s1"
      }
     }
    }
   },
   "because": "HP EV-14"
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$c1",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  },
  {
   "control": {
    "op": "load_plugin",
    "plugin_key": "c",
    "as": "c"
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e_c"
    }
   },
   "on": "c",
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e_c",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      },
      {
       "id": "he",
       "kind": "event",
       "descriptor": {}
      },
      {
       "id": "hg",
       "kind": "event_gap",
       "descriptor": {}
      }
     ],
     "events": {
      "subscribed": [
       {
        "handler_id": "he",
        "pattern": {
         "owner": "terminal",
         "name": "output"
        },
        "subjects": "any"
       }
      ],
      "gap_handler": "hg"
     }
    }
   },
   "conn": "c"
  },
  {
   "control": {
    "op": "status",
    "plugin": "c"
   },
   "expect": {
    "state": "load_failed"
   },
   "because": "HP EV-14"
  },
  {
   "control": {
    "op": "diagnostics",
    "plugin": "c"
   },
   "expect": {
    "load_error": {
     "kind": "capability_denied"
    }
   },
   "because": "HP EV-14"
  },
  {
   "control": {
    "op": "published",
    "plugin": "c"
   },
   "expect": {
    "subscriptions": [],
    "handlers": []
   },
   "because": "HP EV-14"
  }
 ]
}

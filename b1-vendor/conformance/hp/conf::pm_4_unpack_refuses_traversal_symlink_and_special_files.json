{
 "id": "conf::pm_4_unpack_refuses_traversal_symlink_and_special_files",
 "contract": "hp",
 "clause": "PM-4",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "await_package",
   "client_read",
   "client_verb",
   "package_escape_probe",
   "script_git"
  ]
 },
 "setup": {
  "given": "three repositories hold a path that leaves the package directory, a link that leaves it, and a device file",
  "plugins": {
   "demo": {
    "grants": []
   }
  }
 },
 "steps": [
  {
   "control": {
    "op": "script_git",
    "url": "https://git.example/a.git",
    "refs": {
     "v1": {
      "commit": "1111111111111111111111111111111111111111",
      "files": {
       "botster-plugin.json": {
        "json": {
         "botster_plugin_api": 1,
         "name": "pt",
         "version": "1.0.0",
         "entrypoints": {
          "service": {
           "lua": "main.lua"
          }
         }
        }
       },
       "main.lua": {
        "text": "-- v1.0.0\n"
       },
       "../escape.txt": {
        "text": "x"
       }
      }
     }
    }
   }
  },
  {
   "control": {
    "op": "script_git",
    "url": "https://git.example/b.git",
    "refs": {
     "v1": {
      "commit": "2222222222222222222222222222222222222222",
      "files": {
       "botster-plugin.json": {
        "json": {
         "botster_plugin_api": 1,
         "name": "pl",
         "version": "1.0.0",
         "entrypoints": {
          "service": {
           "lua": "main.lua"
          }
         }
        }
       },
       "main.lua": {
        "text": "-- v1.0.0\n"
       },
       "out": {
        "link": "/etc/passwd"
       }
      }
     }
    }
   }
  },
  {
   "control": {
    "op": "script_git",
    "url": "https://git.example/c.git",
    "refs": {
     "v1": {
      "commit": "3333333333333333333333333333333333333333",
      "files": {
       "botster-plugin.json": {
        "json": {
         "botster_plugin_api": 1,
         "name": "pd",
         "version": "1.0.0",
         "entrypoints": {
          "service": {
           "lua": "main.lua"
          }
         }
        }
       },
       "main.lua": {
        "text": "-- v1.0.0\n"
       },
       "dev": {
        "special": "chardev"
       }
      }
     }
    }
   }
  },
  {
   "control": {
    "op": "client_verb",
    "kind": "package",
    "verb": "create",
    "args": {
     "source": {
      "kind": "git",
      "url": "https://git.example/a.git",
      "ref": "v1"
     }
    }
   },
   "expect": {
    "accepted": {
     "operation_id": {
      "$type": "string"
     }
    }
   },
   "because": "HP PM-5"
  },
  {
   "control": {
    "op": "await_package",
    "package": "pt",
    "settled": true
   },
   "because": "HP PM-4"
  },
  {
   "control": {
    "op": "client_read",
    "kind": "package",
    "id": "pt"
   },
   "expect": {
    "status": "errored"
   },
   "because": "HP PM-4"
  },
  {
   "control": {
    "op": "client_verb",
    "kind": "package",
    "verb": "create",
    "args": {
     "source": {
      "kind": "git",
      "url": "https://git.example/b.git",
      "ref": "v1"
     }
    }
   },
   "expect": {
    "accepted": {
     "operation_id": {
      "$type": "string"
     }
    }
   },
   "because": "HP PM-5"
  },
  {
   "control": {
    "op": "await_package",
    "package": "pl",
    "settled": true
   },
   "because": "HP PM-4"
  },
  {
   "control": {
    "op": "client_read",
    "kind": "package",
    "id": "pl"
   },
   "expect": {
    "status": "errored"
   },
   "because": "HP PM-4"
  },
  {
   "control": {
    "op": "client_verb",
    "kind": "package",
    "verb": "create",
    "args": {
     "source": {
      "kind": "git",
      "url": "https://git.example/c.git",
      "ref": "v1"
     }
    }
   },
   "expect": {
    "accepted": {
     "operation_id": {
      "$type": "string"
     }
    }
   },
   "because": "HP PM-5"
  },
  {
   "control": {
    "op": "await_package",
    "package": "pd",
    "settled": true
   },
   "because": "HP PM-4"
  },
  {
   "control": {
    "op": "client_read",
    "kind": "package",
    "id": "pd"
   },
   "expect": {
    "status": "errored"
   },
   "because": "HP PM-4"
  },
  {
   "control": {
    "op": "package_escape_probe",
    "package": "pt",
    "path": "../escape.txt"
   },
   "expect": {
    "exists": false
   },
   "because": "HP PM-4"
  }
 ]
}

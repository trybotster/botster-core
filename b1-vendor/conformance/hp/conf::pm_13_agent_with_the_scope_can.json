{
 "id": "conf::pm_13_agent_with_the_scope_can",
 "contract": "hp",
 "clause": "PM-13",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "await_package",
   "client_read",
   "client_verb",
   "script_git"
  ]
 },
 "setup": {
  "given": "an agent holds the scope package.manage and installs a package",
  "plugins": {
   "demo": {
    "grants": []
   }
  }
 },
 "steps": [
  {
   "control": {
    "op": "script_git",
    "url": "https://git.example/a.git",
    "refs": {
     "v1": {
      "commit": "1111111111111111111111111111111111111111",
      "files": {
       "botster-plugin.json": {
        "json": {
         "botster_plugin_api": 1,
         "name": "demo",
         "version": "1.0.0",
         "entrypoints": {
          "service": {
           "lua": "main.lua"
          }
         }
        }
       },
       "main.lua": {
        "text": "-- v1.0.0\n"
       }
      }
     }
    }
   }
  },
  {
   "control": {
    "op": "client_verb",
    "kind": "package",
    "verb": "create",
    "args": {
     "source": {
      "kind": "git",
      "url": "https://git.example/a.git",
      "ref": "v1"
     }
    },
    "as": {
     "kind": "agent",
     "scopes": [
      "package.manage"
     ]
    }
   },
   "expect": {
    "accepted": {
     "operation_id": {
      "$type": "string"
     }
    }
   },
   "because": "HP PM-5"
  },
  {
   "control": {
    "op": "await_package",
    "package": "demo",
    "settled": true
   },
   "because": "HP PM-13"
  },
  {
   "control": {
    "op": "client_read",
    "kind": "package",
    "id": "demo"
   },
   "expect": {
    "source": {
     "kind": "git",
     "url": "https://git.example/a.git"
    }
   },
   "because": "HP PM-13"
  }
 ]
}

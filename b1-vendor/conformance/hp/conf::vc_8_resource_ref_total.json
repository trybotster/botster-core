{
 "id": "conf::vc_8_resource_ref_total",
 "contract": "hp",
 "clause": "VC-8",
 "subject": "plugin_hub",
 "requires": {
  "controls": [
   "invoke"
  ]
 },
 "setup": {
  "given": "this Hub is hub-1 and runs session s1",
  "calls": {
   "sessions.get": [
    {
     "result": {
      "ok": true,
      "value": {
       "id": "s1",
       "hub_id": "hub-1",
       "label": "s1",
       "state": "running",
       "lifecycle_class": "current",
       "exit": {},
       "size": {
        "rows": 24,
        "cols": 80
       },
       "session_type": {
        "id": "st1",
        "source": "device"
       },
       "traits": [],
       "restartable": true,
       "activity": "idle",
       "presentation": "default",
       "metadata": {}
      }
     }
    },
    {
     "result": {
      "ok": false,
      "error": {
       "kind": "invalid_request",
       "message": "invalid_request",
       "retryable": false
      }
     }
    },
    {
     "result": {
      "ok": false,
      "error": {
       "kind": "invalid_request",
       "detail": {
        "code": "remote_hub_unsupported"
       },
       "message": "invalid_request",
       "retryable": false
      }
     }
    }
   ]
  }
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      }
     ]
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "invoke",
    "handler": "h1"
   },
   "bind": {
    "t": "/ticket"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "handler": "h1"
    }
   },
   "because": "HP IV-1"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 1,
     "call": "sessions.get",
     "context": {
      "request": "$r"
     },
     "args": {
      "session": {
       "hub_id": "hub-1",
       "session_id": "s1"
      }
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 1,
     "result": {
      "ok": true
     }
    }
   },
   "because": "HP VC-8"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 2,
     "call": "sessions.get",
     "context": {
      "request": "$r"
     },
     "args": {
      "session": {
       "session_id": "s1"
      }
     }
    }
   },
   "violates_args": true
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 2,
     "result": {
      "ok": false,
      "error": {
       "kind": "invalid_request"
      }
     },
     "effect": "none"
    }
   },
   "because": "HP VC-8"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 3,
     "call": "sessions.get",
     "context": {
      "request": "$r"
     },
     "args": {
      "session": {
       "hub_id": "other-hub",
       "session_id": "s1"
      }
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 3,
     "result": {
      "ok": false,
      "error": {
       "kind": "invalid_request",
       "detail": {
        "code": "remote_hub_unsupported"
       }
      }
     },
     "effect": "none"
    }
   },
   "because": "HP VC-8"
  }
 ]
}

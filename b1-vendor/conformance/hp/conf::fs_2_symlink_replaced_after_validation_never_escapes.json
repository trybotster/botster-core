{
 "id": "conf::fs_2_symlink_replaced_after_validation_never_escapes",
 "contract": "hp",
 "clause": "FS-2",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "fs_race",
   "invoke"
  ]
 },
 "setup": {
  "given": "vault/f is a regular file with the content inside; the file ../outside holds the content outside"
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      }
     ]
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "invoke",
    "handler": "h1"
   },
   "bind": {
    "t": "/ticket"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "handler": "h1"
    }
   },
   "because": "HP IV-1"
  },
  {
   "control": {
    "op": "fs_race",
    "root": "vault",
    "path": "f",
    "outside_path": "../outside"
   }
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 1,
     "call": "fs.read",
     "context": {
      "request": "$r"
     },
     "args": {
      "root": "vault",
      "path": "f"
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 1,
     "result": {
      "$one_of": [
       {
        "ok": false,
        "error": {
         "kind": "capability_denied",
         "detail": {
          "code": "fs_outside_root"
         }
        }
       },
       {
        "ok": true,
        "value": {
         "bytes_b64": "aW5zaWRl"
        }
       }
      ]
     },
     "effect": "none"
    }
   },
   "because": "HP FS-2"
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  }
 ]
}

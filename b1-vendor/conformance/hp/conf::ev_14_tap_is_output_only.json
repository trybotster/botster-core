{
 "id": "conf::ev_14_tap_is_output_only",
 "contract": "hp",
 "clause": "EV-14",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "client_input",
   "settle",
   "terminal_feed"
  ]
 },
 "setup": {
  "given": "the session s1 is spawned by the plugin; its program does not echo input",
  "grants": [
   {
    "surface": "events",
    "scope": "session_output:read"
   }
  ]
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      },
      {
       "id": "he",
       "kind": "event",
       "descriptor": {}
      },
      {
       "id": "hg",
       "kind": "event_gap",
       "descriptor": {}
      }
     ],
     "events": {
      "subscribed": [
       {
        "handler_id": "he",
        "pattern": {
         "owner": "terminal",
         "name": "output"
        }
       }
      ],
      "gap_handler": "hg"
     }
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "client_input",
    "session": {
     "hub_id": "hub-1",
     "session_id": "s1"
    },
    "text": "typed"
   }
  },
  {
   "control": {
    "op": "terminal_feed",
    "session": {
     "hub_id": "hub-1",
     "session_id": "s1"
    },
    "kind": "output",
    "bytes_b64": "b3V0"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$c1",
     "handler": "he",
     "origin": "event",
     "payload": {
      "owner": "terminal",
      "name": "output",
      "payload": {
       "bytes_b64": "b3V0"
      },
      "subject": {
       "hub_id": "hub-1",
       "session_id": "s1"
      }
     }
    }
   },
   "because": "HP EV-14"
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$c1",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  },
  {
   "expect_quiet_until": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "payload": {
      "payload": {
       "bytes_b64": {
        "$b64": {
         "$contains": "typed"
        }
       }
      }
     }
    }
   },
   "barrier": {
    "control": {
     "op": "settle"
    }
   },
   "until": {
    "settled": true
   },
   "because": "HP EV-14"
  }
 ]
}

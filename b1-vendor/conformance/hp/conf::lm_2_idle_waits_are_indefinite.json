{
 "id": "conf::lm_2_idle_waits_are_indefinite",
 "contract": "hp",
 "clause": "LM-2",
 "subject": "plugin_hub",
 "requires": {
  "controls": [
   "status",
   "completions",
   "settle"
  ]
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      }
     ]
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "advance_clock": {
    "ms": 1000000000000
   }
  },
  {
   "expect_quiet_until": {
    "type": {
     "$any": true
    }
   },
   "barrier": {
    "control": {
     "op": "settle"
    }
   },
   "until": {
    "settled": true
   },
   "because": "HP LM-2"
  },
  {
   "control": {
    "op": "status"
   },
   "expect": {
    "state": "loaded"
   },
   "because": "HP LM-2"
  },
  {
   "control": {
    "op": "completions"
   },
   "expect": [],
   "because": "HP LM-2"
  }
 ]
}

{
 "id": "conf::nt_1_no_descriptor_or_ip_reaches_plugin",
 "contract": "hp",
 "clause": "NT-1",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "await_operation",
   "invoke",
   "net_seen",
   "net_world"
  ]
 },
 "setup": {
  "given": "the plugin holds net with allow [https://api.example]; the outside world (the Hub's injected I/O edge) is scripted by net_world",
  "grants": [
   {
    "surface": "net",
    "scope": "net",
    "allow": [
     "https://api.example"
    ]
   }
  ]
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      },
      {
       "id": "op",
       "kind": "operation",
       "descriptor": {}
      },
      {
       "id": "he",
       "kind": "event",
       "descriptor": {}
      },
      {
       "id": "hg",
       "kind": "event_gap",
       "descriptor": {}
      }
     ],
     "operations": {
      "subscribed": "op"
     }
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "invoke",
    "handler": "h1"
   },
   "bind": {
    "t": "/ticket"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "handler": "h1"
    }
   },
   "because": "HP IV-1"
  },
  {
   "control": {
    "op": "net_world",
    "endpoints": [
     {
      "origin": "https://api.example",
      "addresses": [
       "203.0.113.5"
      ],
      "answers": [
       {
        "status": 200,
        "body_b64": "aGk="
       }
      ]
     }
    ]
   }
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 1,
     "call": "http.request",
     "context": {
      "request": "$r"
     },
     "args": {
      "method": "GET",
      "url": "https://api.example/x",
      "timeout_ms": 1000
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 1,
     "result": {
      "ok": true,
      "value": {
       "operation_id": "$op1",
       "kind": "http",
       "state": "queued",
       "terminal": false
      }
     },
     "effect": "committed"
    }
   },
   "because": "HP NT-3"
  },
  {
   "control": {
    "op": "await_operation",
    "operation_id": "$op1",
    "terminal": true
   }
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 2,
     "call": "operations.get",
     "context": {
      "request": "$r"
     },
     "args": {
      "operation_id": "$op1"
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 2,
     "result": {
      "ok": true,
      "value": {
       "operation_id": "$op1",
       "kind": "http",
       "state": "done",
       "terminal": true,
       "status": 200,
       "address": {
        "$absent": true
       },
       "ip": {
        "$absent": true
       },
       "fd": {
        "$absent": true
       },
       "remote_addr": {
        "$absent": true
       },
       "resolved": {
        "$absent": true
       }
      }
     },
     "effect": "none"
    }
   },
   "because": "HP NT-1"
  },
  {
   "control": {
    "op": "net_seen"
   },
   "expect": {
    "connects": {
     "$array": {
      "each": {
       "origin": "https://api.example",
       "address": "203.0.113.5"
      },
      "min": 1
     }
    },
    "plugin_sockets": 0
   },
   "because": "HP NT-1"
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  }
 ]
}

{
 "id": "conf::fs_3_rearm_delivers_changed_once",
 "contract": "hp",
 "clause": "FS-3",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "commit_burst",
   "service_connected",
   "settle"
  ]
 },
 "setup": {
  "given": "a file under docs changed while the plugin was down"
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      },
      {
       "id": "fw",
       "kind": "fs_watch",
       "descriptor": {}
      }
     ],
     "fs_watches": [
      {
       "root": "vault",
       "path": "docs",
       "handler_id": "fw"
      }
     ]
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "close_channel": {}
  },
  {
   "control": {
    "op": "commit_burst",
    "kind": "fs",
    "root": "vault",
    "path": "docs",
    "count": 1
   }
  },
  {
   "control": {
    "op": "service_connected"
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e2"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e2",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      },
      {
       "id": "fw",
       "kind": "fs_watch",
       "descriptor": {}
      }
     ],
     "fs_watches": [
      {
       "root": "vault",
       "path": "docs",
       "handler_id": "fw"
      }
     ]
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e2"
    }
   },
   "because": "HP HS-2"
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e2",
     "request_id": "$rn",
     "handler": "fw",
     "payload": {
      "root": "vault"
     },
     "origin": "fs_watch"
    }
   },
   "because": "HP FS-3"
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e2",
     "request_id": "$rn",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  },
  {
   "expect_quiet_until": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "handler": "fw"
    }
   },
   "barrier": {
    "control": {
     "op": "settle"
    }
   },
   "until": {
    "settled": true
   },
   "because": "HP FS-3"
  }
 ]
}

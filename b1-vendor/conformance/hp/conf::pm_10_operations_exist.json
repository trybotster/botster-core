{
 "id": "conf::pm_10_operations_exist",
 "contract": "hp",
 "clause": "PM-10",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "await_package",
   "client_read",
   "client_verb",
   "script_catalog",
   "script_git"
  ]
 },
 "setup": {
  "given": "the operator drives one package through every operation of PM-10 and refreshes a catalog",
  "plugins": {
   "demo": {
    "grants": []
   }
  }
 },
 "steps": [
  {
   "control": {
    "op": "script_git",
    "url": "https://git.example/a.git",
    "refs": {
     "v1": {
      "commit": "1111111111111111111111111111111111111111",
      "files": {
       "botster-plugin.json": {
        "json": {
         "botster_plugin_api": 1,
         "name": "demo",
         "version": "1.0.0",
         "entrypoints": {
          "service": {
           "lua": "main.lua"
          }
         }
        }
       },
       "main.lua": {
        "text": "-- v1.0.0\n"
       }
      }
     }
    }
   }
  },
  {
   "control": {
    "op": "client_verb",
    "kind": "package",
    "verb": "create",
    "args": {
     "source": {
      "kind": "git",
      "url": "https://git.example/a.git",
      "ref": "v1"
     }
    }
   },
   "expect": {
    "accepted": {
     "operation_id": {
      "$type": "string"
     }
    }
   },
   "because": "HP PM-5"
  },
  {
   "control": {
    "op": "await_package",
    "package": "demo",
    "settled": true
   },
   "because": "HP PM-10"
  },
  {
   "control": {
    "op": "client_verb",
    "kind": "package",
    "verb": "invoke",
    "id": "demo",
    "args": {
     "action": "enable"
    }
   },
   "expect": {
    "error": {
     "$absent": true
    }
   },
   "because": "HP PM-10"
  },
  {
   "control": {
    "op": "await_package",
    "package": "demo",
    "settled": true
   },
   "because": "HP PM-10"
  },
  {
   "control": {
    "op": "client_verb",
    "kind": "package",
    "verb": "invoke",
    "id": "demo",
    "args": {
     "action": "disable"
    }
   },
   "expect": {
    "error": {
     "$absent": true
    }
   },
   "because": "HP PM-10"
  },
  {
   "control": {
    "op": "await_package",
    "package": "demo",
    "settled": true
   },
   "because": "HP PM-10"
  },
  {
   "control": {
    "op": "client_verb",
    "kind": "package",
    "verb": "invoke",
    "id": "demo",
    "args": {
     "action": "pin",
     "ref": "v1"
    }
   },
   "expect": {
    "committed": true
   },
   "because": "HP PM-10"
  },
  {
   "control": {
    "op": "client_verb",
    "kind": "package",
    "verb": "invoke",
    "id": "demo",
    "args": {
     "action": "unpin"
    }
   },
   "expect": {
    "committed": true
   },
   "because": "HP PM-10"
  },
  {
   "control": {
    "op": "script_git",
    "url": "https://git.example/a.git",
    "refs": {
     "v1": {
      "commit": "2222222222222222222222222222222222222222",
      "files": {
       "botster-plugin.json": {
        "json": {
         "botster_plugin_api": 1,
         "name": "demo",
         "version": "2.0.0",
         "entrypoints": {
          "service": {
           "lua": "main.lua"
          }
         }
        }
       },
       "main.lua": {
        "text": "-- v2.0.0\n"
       }
      }
     }
    }
   }
  },
  {
   "control": {
    "op": "client_verb",
    "kind": "package",
    "verb": "invoke",
    "id": "demo",
    "args": {
     "action": "upgrade"
    }
   },
   "expect": {
    "accepted": {
     "operation_id": {
      "$type": "string"
     }
    }
   },
   "because": "HP PM-10"
  },
  {
   "control": {
    "op": "await_package",
    "package": "demo",
    "settled": true
   },
   "because": "HP PM-10"
  },
  {
   "control": {
    "op": "client_verb",
    "kind": "package",
    "verb": "invoke",
    "id": "demo",
    "args": {
     "action": "rollback"
    }
   },
   "expect": {
    "accepted": {
     "operation_id": {
      "$type": "string"
     }
    }
   },
   "because": "HP PM-10"
  },
  {
   "control": {
    "op": "await_package",
    "package": "demo",
    "settled": true
   },
   "because": "HP PM-10"
  },
  {
   "control": {
    "op": "client_read",
    "kind": "package",
    "id": "demo"
   },
   "expect": {
    "status": {
     "$type": "string"
    }
   },
   "because": "HP PM-10"
  },
  {
   "control": {
    "op": "script_catalog",
    "url": "https://catalog.example/k1.json",
    "document": {
     "catalog_version": 1,
     "entries": []
    }
   }
  },
  {
   "control": {
    "op": "client_verb",
    "kind": "catalog",
    "verb": "create",
    "args": {
     "url": "https://catalog.example/k1.json"
    }
   },
   "expect": {
    "committed": true
   },
   "because": "HP PM-2"
  },
  {
   "control": {
    "op": "client_verb",
    "kind": "catalog",
    "verb": "invoke",
    "id": "https://catalog.example/k1.json",
    "args": {
     "action": "refresh"
    }
   },
   "expect": {
    "accepted": {
     "operation_id": {
      "$type": "string"
     }
    }
   },
   "because": "HP PM-10"
  },
  {
   "control": {
    "op": "client_verb",
    "kind": "package",
    "verb": "delete",
    "id": "demo",
    "args": {}
   },
   "expect": {
    "accepted": {
     "operation_id": {
      "$type": "string"
     }
    }
   },
   "because": "HP PM-10"
  },
  {
   "control": {
    "op": "await_package",
    "package": "demo",
    "settled": true
   },
   "because": "HP PM-10"
  }
 ]
}

{
 "id": "conf::px_3_timeout_kills_the_group",
 "contract": "hp",
 "clause": "PX-3",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "await_operation",
   "invoke",
   "process_group_alive"
  ]
 },
 "setup": {
  "given": "the command sleeps 60 s; timeout_ms is 100",
  "grants": [
   {
    "surface": "session_actions",
    "scope": "process_run"
   }
  ]
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      },
      {
       "id": "op",
       "kind": "operation",
       "descriptor": {}
      }
     ],
     "operations": {
      "subscribed": "op"
     }
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "invoke",
    "handler": "h1"
   },
   "bind": {
    "t": "/ticket"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "handler": "h1"
    }
   },
   "because": "HP IV-1"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 1,
     "call": "process.run",
     "context": {
      "request": "$r"
     },
     "args": {
      "argv": [
       "sleep",
       "60"
      ],
      "timeout_ms": 100
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 1,
     "result": {
      "ok": true,
      "value": {
       "operation_id": "$op",
       "kind": "process",
       "state": "queued",
       "terminal": false
      }
     },
     "effect": "committed"
    }
   },
   "because": "HP PX-1"
  },
  {
   "control": {
    "op": "await_operation",
    "operation_id": "$op",
    "state": "running"
   }
  },
  {
   "control": {
    "op": "process_group_alive",
    "operation_id": "$op"
   },
   "expect": {
    "alive": true
   },
   "because": "HP PX-3"
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  },
  {
   "advance_clock": {
    "ms": 100
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$rn",
     "handler": "op",
     "payload": {
      "operation_id": "$op",
      "state": "failed",
      "terminal": true,
      "error": {
       "kind": "timed_out"
      }
     },
     "origin": "operation"
    }
   },
   "because": "HP PX-3"
  },
  {
   "control": {
    "op": "await_operation",
    "operation_id": "$op",
    "terminal": true
   }
  },
  {
   "control": {
    "op": "process_group_alive",
    "operation_id": "$op"
   },
   "expect": {
    "alive": false
   },
   "because": "HP PX-3"
  }
 ]
}

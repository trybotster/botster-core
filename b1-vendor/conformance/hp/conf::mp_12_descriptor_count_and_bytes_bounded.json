{
 "id": "conf::mp_12_descriptor_count_and_bytes_bounded",
 "contract": "hp",
 "clause": "MP-12",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "await_mcp_server",
   "mcp_list",
   "mcp_server_state",
   "script_mcp"
  ]
 },
 "setup": {
  "given": "steward R-26: mcp_proxy_tools_max (3) bounds the tool descriptors of one server, and one descriptor's bytes are bounded by mcp_proxy_message_bytes (4096); server s lists four tools in two pages, p and q list two tools each, and server d lists one descriptor larger than a message",
  "limits": {
   "mcp_proxy_tools_max": 3,
   "mcp_proxy_message_bytes": 4096
  },
  "plugins": {
   "demo": {
    "grants": [
     {
      "surface": "mcp",
      "scope": "mcp_proxy"
     },
     {
      "surface": "mcp",
      "scope": "mcp_proxy_stdio"
     },
     {
      "surface": "net",
      "scope": "net",
      "allow": [
       "https://mcp.example"
      ]
     }
    ],
    "mcp_servers": [
     {
      "id": "s",
      "transport": "stdio",
      "command": "mcp-server",
      "args": [
       "--x"
      ],
      "env": {
       "A": "1"
      }
     },
     {
      "id": "p",
      "transport": "stdio",
      "command": "mcp-server",
      "args": [
       "--x"
      ],
      "env": {
       "A": "1"
      }
     },
     {
      "id": "q",
      "transport": "stdio",
      "command": "mcp-server",
      "args": [
       "--x"
      ],
      "env": {
       "A": "1"
      }
     },
     {
      "id": "d",
      "transport": "stdio",
      "command": "mcp-server",
      "args": [
       "--x"
      ],
      "env": {
       "A": "1"
      }
     }
    ],
    "entry": "the plugin declares the MCP servers in its manifest (MP-1)"
   }
  }
 },
 "steps": [
  {
   "control": {
    "op": "script_mcp",
    "plugin": "demo",
    "server": "s",
    "transport": "stdio",
    "tools": [
     {
      "name": "echo",
      "description": "echo tool",
      "inputSchema": {
       "type": "object",
       "properties": {
        "n": {
         "type": "integer"
        }
       }
      },
      "behavior": {
       "kind": "echo"
      }
     }
    ],
    "pages": [
     [
      {
       "name": "a",
       "description": "echo tool",
       "inputSchema": {
        "type": "object",
        "properties": {
         "n": {
          "type": "integer"
         }
        }
       },
       "behavior": {
        "kind": "echo"
       }
      },
      {
       "name": "b",
       "description": "echo tool",
       "inputSchema": {
        "type": "object",
        "properties": {
         "n": {
          "type": "integer"
         }
        }
       },
       "behavior": {
        "kind": "echo"
       }
      }
     ],
     [
      {
       "name": "c",
       "description": "echo tool",
       "inputSchema": {
        "type": "object",
        "properties": {
         "n": {
          "type": "integer"
         }
        }
       },
       "behavior": {
        "kind": "echo"
       }
      },
      {
       "name": "d",
       "description": "echo tool",
       "inputSchema": {
        "type": "object",
        "properties": {
         "n": {
          "type": "integer"
         }
        }
       },
       "behavior": {
        "kind": "echo"
       }
      }
     ]
    ]
   }
  },
  {
   "control": {
    "op": "script_mcp",
    "plugin": "demo",
    "server": "p",
    "transport": "stdio",
    "tools": [
     {
      "name": "x",
      "description": "echo tool",
      "inputSchema": {
       "type": "object",
       "properties": {
        "n": {
         "type": "integer"
        }
       }
      },
      "behavior": {
       "kind": "echo"
      }
     },
     {
      "name": "y",
      "description": "echo tool",
      "inputSchema": {
       "type": "object",
       "properties": {
        "n": {
         "type": "integer"
        }
       }
      },
      "behavior": {
       "kind": "echo"
      }
     }
    ]
   }
  },
  {
   "control": {
    "op": "script_mcp",
    "plugin": "demo",
    "server": "q",
    "transport": "stdio",
    "tools": [
     {
      "name": "z",
      "description": "echo tool",
      "inputSchema": {
       "type": "object",
       "properties": {
        "n": {
         "type": "integer"
        }
       }
      },
      "behavior": {
       "kind": "echo"
      }
     },
     {
      "name": "w",
      "description": "echo tool",
      "inputSchema": {
       "type": "object",
       "properties": {
        "n": {
         "type": "integer"
        }
       }
      },
      "behavior": {
       "kind": "echo"
      }
     }
    ]
   }
  },
  {
   "control": {
    "op": "script_mcp",
    "plugin": "demo",
    "server": "d",
    "transport": "stdio",
    "tools": [
     {
      "name": "big",
      "description": "",
      "inputSchema": {
       "type": "object",
       "properties": {
        "n": {
         "type": "integer"
        }
       }
      },
      "behavior": {
       "kind": "echo"
      }
     }
    ]
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      }
     ]
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "await_mcp_server",
    "plugin": "demo",
    "server": "s",
    "state": "unavailable"
   }
  },
  {
   "control": {
    "op": "await_mcp_server",
    "plugin": "demo",
    "server": "p",
    "state": "available"
   }
  },
  {
   "control": {
    "op": "await_mcp_server",
    "plugin": "demo",
    "server": "q",
    "state": "available"
   }
  },
  {
   "control": {
    "op": "await_mcp_server",
    "plugin": "demo",
    "server": "d",
    "state": "unavailable"
   }
  },
  {
   "control": {
    "op": "mcp_server_state",
    "plugin": "demo",
    "server": "s"
   },
   "expect": {
    "state": "unavailable",
    "error": {
     "detail": {
      "code": "mcp_bound_exceeded"
     }
    }
   },
   "because": "HP MP-12"
  },
  {
   "control": {
    "op": "mcp_server_state",
    "plugin": "demo",
    "server": "d"
   },
   "expect": {
    "state": "unavailable",
    "error": {
     "detail": {
      "code": "mcp_bound_exceeded"
     }
    }
   },
   "because": "HP MP-12"
  },
  {
   "control": {
    "op": "mcp_list",
    "kind": "tools",
    "plugin": "demo"
   },
   "expect": {
    "items": [
     {
      "name": "demo__p__x"
     },
     {
      "name": "demo__p__y"
     },
     {
      "name": "demo__q__z"
     },
     {
      "name": "demo__q__w"
     }
    ]
   },
   "because": "HP MP-12"
  }
 ]
}

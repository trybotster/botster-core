{
 "id": "conf::ld_3_old_write_authority_fenced",
 "contract": "hp",
 "clause": "LD-3",
 "subject": "plugin_hub",
 "requires": {
  "controls": [
   "invoke",
   "reload",
   "expire_drain"
  ]
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      }
     ]
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "invoke",
    "handler": "h1"
   },
   "bind": {
    "t": "/ticket"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "handler": "h1"
    }
   },
   "because": "HP IV-1"
  },
  {
   "control": {
    "op": "reload"
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e2",
     "resumed": false,
     "instance": "$i2"
    }
   },
   "because": "HP LD-3",
   "on": "cand"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e2",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      }
     ]
    }
   },
   "conn": "cand"
  },
  {
   "control": {
    "op": "expire_drain"
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Cancel",
    "payload": {
     "epoch": "$e",
     "request_id": "$r"
    }
   },
   "because": [
    "HP LD-3",
    "HP MD-1"
   ]
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e2"
    }
   },
   "because": "HP LD-3",
   "on": "cand"
  },
  {
   "expect": {
    "lane": "control",
    "type": "Shutdown",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": [
    "HP LD-3",
    "HP MD-1"
   ]
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 31,
     "call": "store.put",
     "context": {
      "request": "$r"
     },
     "args": {
      "collection": "c",
      "id": "a",
      "doc": {
       "v": 1
      }
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 31,
     "result": {
      "ok": false
     },
     "effect": "none"
    }
   },
   "because": [
    "HP LD-3",
    "HP A2-11"
   ]
  }
 ],
 "setup": {
  "calls": {
   "store.put": [
    {
     "result": {
      "ok": true,
      "value": {
       "revision": "r2"
      }
     },
     "effect": "committed"
    }
   ]
  }
 }
}

   "because": "HP PM-9"
  },
  {
   "control": {
    "op": "await_package",
    "package": "demo",
    "settled": true
   },
   "because": "HP PM-9"
  },
  {
   "control": {
    "op": "lock_record_stored",
    "package": "demo"
   },
   "expect": {
    "current": {
     "version": "2.0.0"
    },
    "history": [
     {
      "version": "1.0.0"
     }
    ]
   },
   "because": "HP A7-1"
  },
  {
   "control": {
    "op": "client_verb",
    "kind": "package",
    "verb": "invoke",
    "id": "demo",
    "args": {
     "action": "rollback"
    }
   },
   "expect": {
    "accepted": {
     "operation_id": {
      "$type": "string"
     }
    }
   },
   "because": "HP PM-9"
  },
  {
   "control": {
    "op": "await_package",
    "package": "demo",
    "settled": true
   },
   "because": "HP PM-9"
  },
  {
   "control": {
    "op": "lock_record_stored",

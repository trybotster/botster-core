{
 "id": "conf::a7_1_rollback_drops_the_replaced_lock",
 "contract": "hp",
 "clause": "A7-1",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "await_package",
   "client_verb",
   "lock_record_stored",
   "script_git"
  ]
 },
 "setup": {
  "given": "lock_history_max is 3; demo is installed and updated to v3; the operator rolls back and then updates",
  "limits": {
   "lock_history_max": 3
  },
  "plugins": {
   "demo": {
    "grants": []
   }
  }
 },
 "steps": [
  {
   "control": {
    "op": "script_git",
    "url": "https://git.example/a.git",
    "refs": {
     "v1": {
      "commit": "1111111111111111111111111111111111111111",
      "files": {
       "botster-plugin.json": {
        "json": {
         "botster_plugin_api": 1,
         "name": "demo",
         "version": "1.0.0",
         "entrypoints": {
          "service": {
           "lua": "main.lua"
          }
         }
        }
       },
       "main.lua": {
        "text": "-- v1.0.0\n"
       }
      }
     }
    }
   }
  },
  {
   "control": {
    "op": "client_verb",
    "kind": "package",
    "verb": "create",
    "args": {
     "source": {
      "kind": "git",
      "url": "https://git.example/a.git",
      "ref": "v1"
     }
    }
   },
   "expect": {
    "accepted": {
     "operation_id": {
      "$type": "string"
     }
    }
   },
   "because": "HP PM-5"
  },
  {
   "control": {
    "op": "await_package",
    "package": "demo",
    "settled": true
   },
   "because": "HP PM-7"
  },
  {
   "control": {
    "op": "script_git",
    "url": "https://git.example/a.git",
    "refs": {
     "v1": {
      "commit": "2222222222222222222222222222222222222222",
      "files": {
       "botster-plugin.json": {
        "json": {
         "botster_plugin_api": 1,
         "name": "demo",
         "version": "2.0.0",
         "entrypoints": {
          "service": {
           "lua": "main.lua"
          }
         }
        }
       },
       "main.lua": {
        "text": "-- v2.0.0\n"
       }
      }
     }
    }
   }
  },
  {
   "control": {
    "op": "client_verb",
    "kind": "package",
    "verb": "invoke",
    "id": "demo",
    "args": {
     "action": "upgrade"
    }
   },
   "expect": {
    "accepted": {
     "operation_id": {
      "$type": "string"
     }
    }
   },
   "because": "HP PM-7"
  },
  {
   "control": {
    "op": "await_package",
    "package": "demo",
    "settled": true
   },
   "because": "HP PM-7"
  },
  {
   "control": {
    "op": "script_git",
    "url": "https://git.example/a.git",
    "refs": {
     "v1": {
      "commit": "3333333333333333333333333333333333333333",
      "files": {
       "botster-plugin.json": {
        "json": {
         "botster_plugin_api": 1,
         "name": "demo",
         "version": "3.0.0",
         "entrypoints": {
          "service": {
           "lua": "main.lua"
          }
         }
        }
       },
       "main.lua": {
        "text": "-- v3.0.0\n"
       }
      }
     }
    }
   }
  },
  {
   "control": {
    "op": "client_verb",
    "kind": "package",
    "verb": "invoke",
    "id": "demo",
    "args": {
     "action": "upgrade"
    }
   },
   "expect": {
    "accepted": {
     "operation_id": {
      "$type": "string"
     }
    }
   },
   "because": "HP PM-7"
  },
  {
   "control": {
    "op": "await_package",
    "package": "demo",
    "settled": true
   },
   "because": "HP PM-7"
  },
  {
   "control": {
    "op": "lock_record_stored",
    "package": "demo"
   },
   "expect": {
    "current": {
     "version": "3.0.0"
    },
    "history": [
     {
      "version": "2.0.0"
     },
     {
      "version": "1.0.0"
     }
    ]
   },
   "because": "HP A7-1"
  },
  {
   "control": {
    "op": "client_verb",
    "kind": "package",
    "verb": "invoke",
    "id": "demo",
    "args": {
     "action": "rollback"
    }
   },
   "expect": {
    "accepted": {
     "operation_id": {
      "$type": "string"
     }
    }

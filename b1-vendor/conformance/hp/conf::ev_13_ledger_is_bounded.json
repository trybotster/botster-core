{
 "id": "conf::ev_13_ledger_is_bounded",
 "contract": "hp",
 "clause": "EV-13",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "emit_events",
   "invoke",
   "settle"
  ]
 },
 "setup": {
  "given": "six distinct names reach a normal queue of one copy while the handler h1 runs; the ledger holds four entries",
  "limits": {
   "event_queue_normal": 1,
   "loss_ledger_entries": 4
  },
  "grants": [
   {
    "surface": "events",
    "scope": "events_plugin:o1"
   },
   {
    "surface": "events",
    "scope": "events_plugin:o2"
   },
   {
    "surface": "events",
    "scope": "events_plugin:o3"
   },
   {
    "surface": "events",
    "scope": "events_plugin:o4"
   },
   {
    "surface": "events",
    "scope": "events_plugin:o5"
   },
   {
    "surface": "events",
    "scope": "events_plugin:o6"
   }
  ]
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      },
      {
       "id": "he",
       "kind": "event",
       "descriptor": {}
      },
      {
       "id": "hg",
       "kind": "event_gap",
       "descriptor": {}
      }
     ],
     "events": {
      "subscribed": [
       {
        "handler_id": "he",
        "pattern": {
         "owner": "o1",
         "name": "n"
        }
       },
       {
        "handler_id": "he",
        "pattern": {
         "owner": "o2",
         "name": "n"
        }
       },
       {
        "handler_id": "he",
        "pattern": {
         "owner": "o3",
         "name": "n"
        }
       },
       {
        "handler_id": "he",
        "pattern": {
         "owner": "o4",
         "name": "n"
        }
       },
       {
        "handler_id": "he",
        "pattern": {
         "owner": "o5",
         "name": "n"
        }
       },
       {
        "handler_id": "he",
        "pattern": {
         "owner": "o6",
         "name": "n"
        }
       }
      ],
      "gap_handler": "hg"
     }
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "invoke",
    "handler": "h1"
   },
   "bind": {
    "t": "/ticket"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "handler": "h1"
    }
   },
   "because": "HP IV-1"
  },
  {
   "control": {
    "op": "emit_events",
    "emitters": [
     {
      "owner": "o1",
      "name": "n",
      "count": 1
     }
    ]
   }
  },
  {
   "control": {
    "op": "emit_events",
    "emitters": [
     {
      "owner": "o2",
      "name": "n",
      "count": 1
     }
    ]
   }
  },
  {
   "control": {
    "op": "emit_events",
    "emitters": [
     {
      "owner": "o3",
      "name": "n",
      "count": 1
     }
    ]
   }
  },
  {
   "control": {
    "op": "emit_events",
    "emitters": [
     {
      "owner": "o4",
      "name": "n",
      "count": 1
     }
    ]
   }
  },
  {
   "control": {
    "op": "emit_events",
    "emitters": [
     {
      "owner": "o5",
      "name": "n",
      "count": 1
     }
    ]
   }
  },
  {
   "control": {
    "op": "emit_events",
    "emitters": [
     {
      "owner": "o6",
      "name": "n",
      "count": 1
     }
    ]
   }
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$g",
     "handler": "hg",
     "origin": "event_gap",
     "payload": {
      "owner": "*",
      "count": 5,
      "aggregated": true
     }
    }
   },
   "because": "HP EV-13"
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$g",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$c6",
     "handler": "he",
     "origin": "event",
     "payload": {
      "owner": "o6",
      "name": "n"
     }
    }
   },
   "because": "HP EV-13"
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$c6",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  },
  {
   "expect_quiet_until": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "origin": "event_gap"
    }
   },
   "barrier": {
    "control": {
     "op": "settle"
    }
   },
   "until": {
    "settled": true
   },
   "because": "HP EV-13"
  }
 ]
}

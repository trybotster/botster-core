{
 "id": "conf::nt_7_loopback_only",
 "contract": "hp",
 "clause": "NT-7",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "listener"
  ]
 },
 "setup": {
  "given": "the plugin demo holds net_inbound and registers the webhook handler wh for /hook; its package configuration sets webhook_auth bearer and the webhook_secret whs3cret; b holds net_inbound and registers /other",
  "grants": [
   {
    "surface": "net",
    "scope": "net_inbound"
   }
  ]
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      },
      {
       "id": "op",
       "kind": "operation",
       "descriptor": {}
      },
      {
       "id": "he",
       "kind": "event",
       "descriptor": {}
      },
      {
       "id": "hg",
       "kind": "event_gap",
       "descriptor": {}
      },
      {
       "id": "wh",
       "kind": "webhook",
       "descriptor": {
        "path": "/hook"
       }
      }
     ],
     "operations": {
      "subscribed": "op"
     }
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "listener"
   },
   "expect": {
    "bound": {
     "$array": {
      "each": {
       "$one_of": [
        {
         "$starts_with": "127."
        },
        {
         "$starts_with": "[::1]"
        }
       ]
      },
      "min": 1
     }
    }
   },
   "because": "HP NT-7"
  }
 ]
}

{
 "id": "conf::pm_5_install_order",
 "contract": "hp",
 "clause": "PM-5",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "await_package",
   "client_read",
   "client_verb",
   "edge_requests",
   "execution_count",
   "script_git",
   "settle"
  ]
 },
 "setup": {
  "given": "demo asks for the grant assets; the operator installs with enable and approves later",
  "plugins": {
   "demo": {
    "grants": []
   }
  }
 },
 "steps": [
  {
   "control": {
    "op": "script_git",
    "url": "https://git.example/a.git",
    "refs": {
     "v1": {
      "commit": "1111111111111111111111111111111111111111",
      "files": {
       "botster-plugin.json": {
        "json": {
         "botster_plugin_api": 1,
         "name": "demo",
         "version": "1.0.0",
         "entrypoints": {
          "service": {
           "lua": "main.lua"
          }
         },
         "capabilities": [
          {
           "surface": "assets"
          }
         ]
        }
       },
       "main.lua": {
        "text": "-- v1.0.0\n"
       }
      }
     }
    }
   }
  },
  {
   "control": {
    "op": "client_verb",
    "kind": "package",
    "verb": "create",
    "args": {
     "source": {
      "kind": "git",
      "url": "https://git.example/a.git",
      "ref": "v1"
     },
     "enable": true
    }
   },
   "expect": {
    "accepted": {
     "operation_id": {
      "$type": "string"
     }
    }
   },
   "bind": {
    "op": "/accepted/operation_id"
   },
   "because": "HP PM-5"
  },
  {
   "control": {
    "op": "await_package",
    "package": "demo",
    "status": "staged"
   }
  },
  {
   "control": {
    "op": "edge_requests",
    "edge": "git"
   },
   "expect": {
    "requests": {
     "$array": {
      "min": 1
     }
    }
   },
   "because": "HP PM-5"
  },
  {
   "control": {
    "op": "client_read",
    "kind": "package",
    "id": "demo"
   },
   "expect": {
    "status": "staged",
    "lock": {
     "resolved_commit": "1111111111111111111111111111111111111111"
    },
    "pending_grants": [
     {
      "surface": "assets"
     }
    ]
   },
   "because": "HP PM-5"
  },
  {
   "control": {
    "op": "execution_count"
   },
   "expect": {
    "started": 0
   },
   "because": "HP PM-5"
  },
  {
   "expect_quiet_until": {
    "lane": "control",
    "type": "Hello"
   },
   "on": "main",
   "barrier": {
    "control": {
     "op": "settle",
     "conn": "main"
    }
   },
   "until": {
    "settled": true
   },
   "because": "HP PM-5"
  },
  {
   "control": {
    "op": "client_verb",
    "kind": "package",
    "verb": "invoke",
    "id": "demo",
    "args": {
     "action": "approve_grants",
     "grants": [
      {
       "surface": "assets"
      }
     ]
    }
   },
   "expect": {
    "committed": true
   },
   "because": "HP PM-5"
  },
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  }
 ]
}

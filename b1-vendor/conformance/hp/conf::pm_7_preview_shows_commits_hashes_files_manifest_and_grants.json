{
 "id": "conf::pm_7_preview_shows_commits_hashes_files_manifest_and_grants",
 "contract": "hp",
 "clause": "PM-7",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "await_package",
   "client_read",
   "client_verb",
   "script_git"
  ]
 },
 "setup": {
  "given": "demo 1.0.0 runs; the source has demo 2.0.0: main.lua and the manifest changed (version 2.0.0, a new grant assets) and keep.lua did not",
  "plugins": {
   "demo": {
    "grants": []
   }
  }
 },
 "steps": [
  {
   "control": {
    "op": "script_git",
    "url": "https://git.example/a.git",
    "refs": {
     "v1": {
      "commit": "1111111111111111111111111111111111111111",
      "files": {
       "botster-plugin.json": {
        "json": {
         "botster_plugin_api": 1,
         "name": "demo",
         "version": "1.0.0",
         "entrypoints": {
          "service": {
           "lua": "main.lua"
          }
         }
        }
       },
       "main.lua": {
        "text": "-- v1.0.0\n"
       },
       "keep.lua": {
        "text": "keep"
       }
      }
     }
    }
   }
  },
  {
   "control": {
    "op": "client_verb",
    "kind": "package",
    "verb": "create",
    "args": {
     "source": {
      "kind": "git",
      "url": "https://git.example/a.git",
      "ref": "v1"
     },
     "enable": true
    }
   },
   "expect": {
    "accepted": {
     "operation_id": {
      "$type": "string"
     }
    }
   },
   "because": "HP PM-5"
  },
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      }
     ]
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "await_package",
    "package": "demo",
    "settled": true
   },
   "because": "HP PM-5"
  },
  {
   "control": {
    "op": "client_read",
    "kind": "package",
    "id": "demo"
   },
   "expect": {
    "lock": {
     "content_hash": {
      "$type": "string"
     }
    }
   },
   "because": "HP PM-3",
   "bind": {
    "h1": "/lock/content_hash"
   }
  },
  {
   "control": {
    "op": "script_git",
    "url": "https://git.example/a.git",
    "refs": {
     "v1": {
      "commit": "2222222222222222222222222222222222222222",
      "files": {
       "botster-plugin.json": {
        "json": {
         "botster_plugin_api": 1,
         "name": "demo",
         "version": "2.0.0",
         "entrypoints": {
          "service": {
           "lua": "main.lua"
          }
         },
         "capabilities": [
          {
           "surface": "assets"
          }
         ]
        }
       },
       "main.lua": {
        "text": "-- changed main\\n"
       },
       "keep.lua": {
        "text": "keep"
       }
      }
     }
    }
   }
  },
  {
   "control": {
    "op": "client_verb",
    "kind": "package",
    "verb": "invoke",
    "id": "demo",
    "args": {
     "action": "preview_upgrade"
    }
   },
   "expect": {
    "result": {
     "old_commit": "1111111111111111111111111111111111111111",
     "new_commit": "2222222222222222222222222222222222222222",
     "old_hash": "$h1",
     "new_hash": "18b1ac38f8d3824b32ccffe80d92859366817006030e871892c8d60c7417baab"
    }
   },
   "because": "HP PM-7"
  },
  {
   "control": {
    "op": "client_verb",
    "kind": "package",
    "verb": "invoke",
    "id": "demo",
    "args": {
     "action": "preview_upgrade"
    }
   },
   "expect": {
    "text": {
     "changed_files": {
      "$contains": "main.lua"
     }
    }
   },
   "because": "HP PM-7"
  },
  {
   "control": {
    "op": "client_verb",
    "kind": "package",
    "verb": "invoke",
    "id": "demo",
    "args": {
     "action": "preview_upgrade"
    }
   },
   "expect": {
    "text": {
     "changed_files": {
      "$contains": "botster-plugin.json"
     }
    }
   },
   "because": "HP PM-7"
  },
  {
   "control": {
    "op": "client_verb",
    "kind": "package",
    "verb": "invoke",
    "id": "demo",
    "args": {
     "action": "preview_upgrade"
    }
   },
   "expect": {
    "text": {
     "changed_files": {
      "$not": {
       "$contains": "keep.lua"
      }
     }
    }
   },
   "because": "HP PM-7"
  },
  {
   "control": {
    "op": "client_verb",
    "kind": "package",
    "verb": "invoke",
    "id": "demo",
    "args": {
     "action": "preview_upgrade"
    }
   },
   "expect": {
    "text": {
     "manifest_diff": {
      "$contains": "2.0.0"
     }
    }
   },
   "because": "HP PM-7"
  },
  {
   "control": {
    "op": "client_verb",
    "kind": "package",
    "verb": "invoke",
    "id": "demo",
    "args": {
     "action": "preview_upgrade"
    }
   },
   "expect": {
    "text": {
     "grant_diff": {
      "$contains": "assets"
     }
    }
   },
   "because": "HP PM-7"
  }
 ]
}

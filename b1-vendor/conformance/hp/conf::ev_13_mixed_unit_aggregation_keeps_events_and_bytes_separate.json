{
 "id": "conf::ev_13_mixed_unit_aggregation_keeps_events_and_bytes_separate",
 "contract": "hp",
 "clause": "EV-13",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "emit_events",
   "invoke",
   "settle",
   "terminal_feed"
  ]
 },
 "setup": {
  "given": "the session s1 is spawned by the plugin; the plugin's handler h1 runs; the ledger holds one entry",
  "limits": {
   "event_queue_normal": 1,
   "event_queue_low": 1,
   "loss_ledger_entries": 1
  },
  "grants": [
   {
    "surface": "events",
    "scope": "events_hub"
   },
   {
    "surface": "events",
    "scope": "session_output:read"
   }
  ]
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      },
      {
       "id": "he",
       "kind": "event",
       "descriptor": {}
      },
      {
       "id": "hg",
       "kind": "event_gap",
       "descriptor": {}
      }
     ],
     "events": {
      "subscribed": [
       {
        "handler_id": "he",
        "pattern": {
         "owner": "hub",
         "name": "x"
        }
       },
       {
        "handler_id": "he",
        "pattern": {
         "owner": "terminal",
         "name": "output"
        }
       }
      ],
      "gap_handler": "hg"
     }
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "invoke",
    "handler": "h1"
   },
   "bind": {
    "t": "/ticket"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "handler": "h1"
    }
   },
   "because": "HP IV-1"
  },
  {
   "control": {
    "op": "emit_events",
    "emitters": [
     {
      "owner": "hub",
      "name": "x",
      "count": 1
     }
    ]
   }
  },
  {
   "control": {
    "op": "emit_events",
    "emitters": [
     {
      "owner": "hub",
      "name": "x",
      "count": 0
     },
     {
      "owner": "hub",
      "name": "x",
      "count": 1
     }
    ]
   }
  },
  {
   "control": {
    "op": "emit_events",
    "emitters": [
     {
      "owner": "hub",
      "name": "x",
      "count": 0
     },
     {
      "owner": "hub",
      "name": "x",
      "count": 0
     },
     {
      "owner": "hub",
      "name": "x",
      "count": 1
     }
    ]
   }
  },
  {
   "control": {
    "op": "terminal_feed",
    "session": {
     "hub_id": "hub-1",
     "session_id": "s1"
    },
    "kind": "output",
    "bytes_b64": "QUJDRA=="
   }
  },
  {
   "control": {
    "op": "terminal_feed",
    "session": {
     "hub_id": "hub-1",
     "session_id": "s1"
    },
    "kind": "output",
    "bytes_b64": "RUZHSA=="
   }
  },
  {
   "control": {
    "op": "terminal_feed",
    "session": {
     "hub_id": "hub-1",
     "session_id": "s1"
    },
    "kind": "output",
    "bytes_b64": "SUpLTA=="
   }
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  },
  {
   "expect_set": [
    {
     "lane": "invoke",
     "type": "Invoke",
     "payload": {
      "handler": "he",
      "origin": "event",
      "payload": {
       "owner": "hub",
       "name": "x",
       "payload": {
        "seq": 1,
        "emitter": 2
       }
      }
     }
    },
    {
     "lane": "invoke",
     "type": "Invoke",
     "payload": {
      "handler": "he",
      "origin": "event",
      "payload": {
       "owner": "terminal",
       "name": "output",
       "priority": "low",
       "payload": {
        "bytes_b64": "SUpLTA=="
       }
      }
     }
    },
    {
     "lane": "invoke",
     "type": "Invoke",
     "payload": {
      "handler": "hg",
      "origin": "event_gap",
      "payload": {
       "owner": "*",
       "count": 4,
       "lost_bytes": 8,
       "aggregated": true,
       "recovery": "partial",
       "gap_id": {
        "$any": true
       }
      }
     }
    }
   ],
   "ack": {
    "send_frame": {
     "lane": "invoke",
     "type": "Result",
     "payload": {
      "epoch": "$e",
      "request_id": {
       "$item": "/payload/request_id"
      },
      "result": {
       "ok": true,
       "value": {}
      }
     }
    }
   },
   "because": [
    "HP EV-13",
    "HP EV-14"
   ]
  },
  {
   "expect_quiet_until": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "origin": "event_gap"
    }
   },
   "barrier": {
    "control": {
     "op": "settle"
    }
   },
   "until": {
    "settled": true
   },
   "because": "HP EV-13"
  }
 ]
}

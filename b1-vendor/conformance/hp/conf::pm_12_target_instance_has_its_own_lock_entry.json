{
 "id": "conf::pm_12_target_instance_has_its_own_lock_entry",
 "contract": "hp",
 "clause": "PM-12",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "await_package",
   "client_read",
   "client_verb",
   "discover_targets",
   "target_dir"
  ]
 },
 "setup": {
  "given": "two targets t1 and t2 each hold the package demo, which asks for the grant assets; the operator approves it for t1 only",
  "plugins": {
   "demo": {
    "grants": []
   }
  }
 },
 "steps": [
  {
   "control": {
    "op": "target_dir",
    "target_id": "t1",
    "files": {
     "botster-plugin.json": {
      "json": {
       "botster_plugin_api": 1,
       "name": "demo",
       "version": "1.0.0",
       "entrypoints": {
        "service": {
         "lua": "main.lua"
        }
       },
       "capabilities": [
        {
         "surface": "assets"
        }
       ]
      }
     },
     "main.lua": {
      "text": "-- v1.0.0\n"
     }
    }
   },
   "bind": {
    "path_t1": "/path"
   }
  },
  {
   "control": {
    "op": "target_dir",
    "target_id": "t2",
    "files": {
     "botster-plugin.json": {
      "json": {
       "botster_plugin_api": 1,
       "name": "demo",
       "version": "1.0.0",
       "entrypoints": {
        "service": {
         "lua": "main.lua"
        }
       },
       "capabilities": [
        {
         "surface": "assets"
        }
       ]
      }
     },
     "main.lua": {
      "text": "-- v1.0.0\n"
     }
    }
   },
   "bind": {
    "path_t2": "/path"
   }
  },
  {
   "control": {
    "op": "discover_targets"
   }
  },
  {
   "control": {
    "op": "await_package",
    "package": "demo@t1",
    "status": "staged"
   }
  },
  {
   "control": {
    "op": "await_package",
    "package": "demo@t2",
    "status": "staged"
   }
  },
  {
   "control": {
    "op": "client_read",
    "kind": "package",
    "id": "demo@t1"
   },
   "expect": {
    "source": {
     "kind": "local",
     "path": "$path_t1"
    },
    "lock": {
     "package": "demo@t1"
    }
   },
   "because": "HP PM-12"
  },
  {
   "control": {
    "op": "client_read",
    "kind": "package",
    "id": "demo@t2"
   },
   "expect": {
    "source": {
     "kind": "local",
     "path": "$path_t2"
    },
    "lock": {
     "package": "demo@t2"
    }
   },
   "because": "HP PM-12"
  },
  {
   "control": {
    "op": "client_verb",
    "kind": "package",
    "verb": "invoke",
    "id": "demo@t1",
    "args": {
     "action": "approve_grants",
     "grants": [
      {
       "surface": "assets"
      }
     ]
    }
   },
   "expect": {
    "committed": true
   },
   "because": "HP PM-12"
  },
  {
   "control": {
    "op": "client_read",
    "kind": "package",
    "id": "demo@t1"
   },
   "expect": {
    "pending_grants": []
   },
   "because": "HP PM-12"
  },
  {
   "control": {
    "op": "client_read",
    "kind": "package",
    "id": "demo@t2"
   },
   "expect": {
    "status": "staged",
    "pending_grants": [
     {
      "surface": "assets"
     }
    ]
   },
   "because": "HP PM-12"
  }
 ]
}

{
 "id": "conf::lb_21_route_ended_is_client_only",
 "contract": "lb",
 "clause": "LB-21",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "status",
   "published",
   "raise_hub_event",
   "settle"
  ]
 },
 "setup": {
  "given": "the plugin holds events_hub and every other event grant that its manifest can declare; no grant admits hub/route.ended (steward ruling R-23: the refusal is the Hub's, at registration)"
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "he",
       "kind": "event",
       "descriptor": {}
      }
     ],
     "grants": [
      {
       "surface": "events",
       "scope": "events_hub"
      }
     ],
     "events": {
      "subscribed": [
       {
        "handler_id": "he",
        "pattern": {
         "owner": "hub",
         "name": "route.ended"
        }
       }
      ]
     },
     "tools": []
    }
   }
  },
  {
   "control": {
    "op": "status"
   },
   "expect": {
    "state": "load_failed"
   },
   "because": [
    "LB LB-21",
    "HP HS-2"
   ]
  },
  {
   "control": {
    "op": "published"
   },
   "expect": {
    "subscriptions": [],
    "handlers": []
   },
   "because": [
    "LB LB-21",
    "HP HS-2"
   ]
  },
  {
   "control": {
    "op": "raise_hub_event",
    "name": "route.ended",
    "subject": {
     "route_id": "r1"
    },
    "payload": {
     "reason": "closed"
    }
   }
  },
  {
   "expect_quiet_until": {
    "lane": "invoke",
    "type": "Invoke"
   },
   "barrier": {
    "control": {
     "op": "settle"
    }
   },
   "until": {
    "settled": true
   },
   "because": "LB LB-21"
  }
 ]
}

       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      },
      {
       "id": "p1",
       "kind": "mcp_prompt",
       "descriptor": {}
      },
      {
       "id": "r1",
       "kind": "mcp_resource",
       "descriptor": {}
      }
     ],
     "tools": [
      {
       "name": "bad__name",
       "description": "d",
       "input_schema": {},
       "handler": "h1"
      }
     ],
     "prompts": [],
     "resources": []
    }
   }
  },
  {
   "control": {
    "op": "status"

{
 "id": "conf::vr_2_unknown_advisory_ignored",
 "contract": "hp",
 "clause": "VR-2",
 "subject": "plugin_hub",
 "requires": {
  "controls": [
   "counters",
   "invoke",
   "settle"
  ]
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      }
     ]
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "send_frame_raw": {
    "lane": 0,
    "type": 128,
    "payload": {
     "epoch": "$e",
     "note": "x"
    }
   }
  },
  {
   "expect_quiet_until": {
    "type": {
     "$any": true
    }
   },
   "barrier": {
    "control": {
     "op": "settle"
    }
   },
   "until": {
    "settled": true
   },
   "because": "HP VR-2"
  },
  {
   "control": {
    "op": "counters"
   },
   "expect": {
    "ignored_advisory": 1
   },
   "because": "HP VR-2"
  },
  {
   "control": {
    "op": "invoke",
    "handler": "h1"
   },
   "bind": {
    "t": "/ticket"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "handler": "h1"
    }
   },
   "because": "HP VR-2"
  },
  {
   "send_frame_raw": {
    "lane": 0,
    "type": 129,
    "payload_hex": "ff"
   }
  },
  {
   "expect_closed": null,
   "because": [
    "HP VR-2",
    "HP WF-2"
   ]
  }
 ],
 "setup": {
  "calls": {
   "log.write": [
    {
     "result": {
      "ok": true,
      "value": {
       "seq": 1
      }
     }
    }
   ]
  }
 }
}

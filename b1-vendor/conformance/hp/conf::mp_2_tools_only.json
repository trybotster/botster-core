{
 "id": "conf::mp_2_tools_only",
 "contract": "hp",
 "clause": "MP-2",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "await_mcp_server",
   "mcp_list",
   "mcp_server_log",
   "script_mcp"
  ]
 },
 "setup": {
  "given": "the scripted server advertises resources, prompts and sampling, lists resources and prompts, and sends a sampling request",
  "plugins": {
   "demo": {
    "grants": [
     {
      "surface": "mcp",
      "scope": "mcp_proxy"
     },
     {
      "surface": "mcp",
      "scope": "mcp_proxy_stdio"
     },
     {
      "surface": "net",
      "scope": "net",
      "allow": [
       "https://mcp.example"
      ]
     }
    ],
    "mcp_servers": [
     {
      "id": "s",
      "transport": "stdio",
      "command": "mcp-server",
      "args": [
       "--x"
      ],
      "env": {
       "A": "1"
      }
     }
    ],
    "entry": "the plugin declares the MCP servers in its manifest (MP-1)"
   }
  }
 },
 "steps": [
  {
   "control": {
    "op": "script_mcp",
    "plugin": "demo",
    "server": "s",
    "transport": "stdio",
    "tools": [
     {
      "name": "echo",
      "description": "echo tool",
      "inputSchema": {
       "type": "object",
       "properties": {
        "n": {
         "type": "integer"
        }
       }
      },
      "behavior": {
       "kind": "echo"
      }
     }
    ],
    "capabilities": {
     "tools": {},
     "resources": {},
     "prompts": {},
     "sampling": {}
    },
    "server_requests": [
     {
      "method": "sampling/createMessage",
      "id": 91,
      "params": {}
     }
    ],
    "resources": [
     {
      "uri": "x://r",
      "name": "r"
     }
    ],
    "prompts": [
     {
      "name": "p"
     }
    ]
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      }
     ]
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "await_mcp_server",
    "plugin": "demo",
    "server": "s",
    "state": "available"
   }
  },
  {
   "control": {
    "op": "mcp_list",
    "kind": "resources",
    "plugin": "demo"
   },
   "expect": {
    "items": []
   },
   "because": "HP MP-2"
  },
  {
   "control": {
    "op": "mcp_list",
    "kind": "prompts",
    "plugin": "demo"
   },
   "expect": {
    "items": []
   },
   "because": "HP MP-2"
  },
  {
   "control": {
    "op": "mcp_server_log",
    "plugin": "demo",
    "server": "s"
   },
   "expect": {
    "messages": {
     "$array": {
      "each": {
       "dir": {
        "$type": "string"
       }
      },
      "min": 1
     }
    }
   },
   "because": "HP MP-2"
  },
  {
   "control": {
    "op": "mcp_server_log",
    "plugin": "demo",
    "server": "s"
   },
   "expect": {
    "messages": {
     "$array": {
      "each": {
       "$not": {
        "dir": "out",
        "id": 91,
        "result": {
         "$type": "object"
        }
       }
      }
     }
    }
   },
   "because": "HP MP-2"
  }
 ]
}

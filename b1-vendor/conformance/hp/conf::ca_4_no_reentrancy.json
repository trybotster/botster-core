{
 "id": "conf::ca_4_no_reentrancy",
 "contract": "hp",
 "clause": "CA-4",
 "subject": "plugin_hub",
 "requires": {
  "controls": [
   "invoke",
   "settle"
  ]
 },
 "setup": {
  "calls": {
   "hub.identity": [
    {
     "result": {
      "ok": true,
      "value": {
       "hub_id": "hub-1",
       "display_name": "Hub"
      }
     }
    }
   ]
  }
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      }
     ]
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "invoke",
    "handler": "h1",
    "payload": {
     "n": "a"
    }
   },
   "bind": {
    "ta": "/ticket"
   }
  },
  {
   "control": {
    "op": "invoke",
    "handler": "h1",
    "payload": {
     "n": "b"
    }
   },
   "bind": {
    "tb": "/ticket"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$ra",
     "handler": "h1",
     "payload": {
      "n": "a"
     }
    }
   },
   "because": "HP IV-4"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 1,
     "call": "hub.identity",
     "context": {
      "request": "$ra"
     },
     "args": {}
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 1,
     "result": {
      "ok": true,
      "value": {
       "hub_id": "hub-1"
      }
     }
    }
   },
   "because": "HP CA-4"
  },
  {
   "expect_quiet_until": {
    "lane": "invoke",
    "type": "Invoke"
   },
   "barrier": {
    "control": {
     "op": "settle"
    }
   },
   "until": {
    "settled": true
   },
   "because": "HP CA-4"
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$ra",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$rb",
     "handler": "h1",
     "payload": {
      "n": "b"
     }
    }
   },
   "because": "HP IV-4"
  }
 ]
}

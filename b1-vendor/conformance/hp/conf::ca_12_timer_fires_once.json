{
 "id": "conf::ca_12_timer_fires_once",
 "contract": "hp",
 "clause": "CA-12",
 "subject": "plugin_hub",
 "requires": {
  "controls": [
   "invoke",
   "settle"
  ]
 },
 "setup": {
  "calls": {
   "timers.arm": [
    {
     "result": {
      "ok": true,
      "value": {}
     },
     "effect": "committed"
    }
   ]
  }
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      },
      {
       "id": "tm",
       "kind": "timer",
       "descriptor": {}
      }
     ]
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "invoke",
    "handler": "h1"
   },
   "bind": {
    "t": "/ticket"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "handler": "h1"
    }
   },
   "because": "HP IV-1"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 1,
     "call": "timers.arm",
     "context": {
      "request": "$r"
     },
     "args": {
      "timer_id": "tick",
      "delay_ms": 100,
      "handler_id": "tm"
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 1,
     "result": {
      "ok": true
     },
     "effect": "committed"
    }
   },
   "because": "HP CA-12"
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  },
  {
   "control": {
    "op": "invoke",
    "handler": "tm",
    "payload": {
     "timer_id": "tick"
    },
    "kind": "timer",
    "origin": "timer"
   },
   "bind": {
    "tt": "/ticket"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$rt",
     "handler": "tm",
     "payload": {
      "timer_id": "tick"
     },
     "origin": "timer"
    }
   },
   "because": "HP CA-12"
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$rt",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  },
  {
   "expect_quiet_until": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "handler": "tm"
    }
   },
   "barrier": {
    "control": {
     "op": "settle"
    }
   },
   "until": {
    "settled": true
   },
   "because": "HP CA-12"
  }
 ]
}

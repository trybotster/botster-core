{
 "id": "conf::fs_3_unload_cancels_watches",
 "contract": "hp",
 "clause": "FS-3",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "invoke",
   "unload",
   "watches"
  ]
 },
 "setup": {
  "given": "the plugin holds one fs watch and is unloaded"
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      },
      {
       "id": "fw",
       "kind": "fs_watch",
       "descriptor": {}
      }
     ]
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "invoke",
    "handler": "h1"
   },
   "bind": {
    "t": "/ticket"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "handler": "h1"
    }
   },
   "because": "HP IV-1"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 1,
     "call": "fs.watch",
     "context": {
      "request": "$r"
     },
     "args": {
      "root": "vault",
      "path": "docs",
      "handler_id": "fw"
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 1,
     "result": {
      "ok": true,
      "value": {
       "watch_id": "$w"
      }
     },
     "effect": "committed"
    }
   },
   "because": "HP FS-3"
  },
  {
   "control": {
    "op": "watches"
   },
   "expect": {
    "fs": 1
   },
   "because": "HP FS-3"
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  },
  {
   "control": {
    "op": "unload"
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Shutdown"
   },
   "because": "HP LD-4"
  },
  {
   "close_channel": {}
  },
  {
   "control": {
    "op": "watches"
   },
   "expect": {
    "fs": 0
   },
   "because": "HP FS-3"
  }
 ]
}

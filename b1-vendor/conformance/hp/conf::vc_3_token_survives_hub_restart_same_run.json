{
 "id": "conf::vc_3_token_survives_hub_restart_same_run",
 "contract": "hp",
 "clause": "VC-3",
 "subject": "plugin_hub",
 "requires": {
  "controls": [
   "invoke",
   "hub_restart",
   "service_connected"
  ]
 },
 "setup": {
  "proofs": {
   "op_socket": {
    "kind": "operator"
   },
   "op_rtc": {
    "kind": "operator",
    "credential_id": "cred-1"
   },
   "tok_s1": {
    "kind": "session",
    "session": {
     "hub_id": "hub-1",
     "session_id": "s1"
    }
   }
  },
  "given": "an operator on the Unix socket (no credential id), an operator with WebRTC credential cred-1, and a session s1 with a valid bearer token; session s1 survives the Hub restart (adopted by Core)"
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      }
     ]
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "invoke",
    "handler": "h1",
    "proof": "tok_s1"
   },
   "bind": {
    "t1": "/ticket"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$r1",
     "handler": "h1",
     "caller": {
      "kind": "session",
      "session": {
       "session_id": "s1"
      }
     }
    }
   },
   "because": "HP VC-3"
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$r1",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  },
  {
   "control": {
    "op": "hub_restart"
   }
  },
  {
   "control": {
    "op": "service_connected"
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e2",
     "resumed": true
    }
   },
   "because": "HP VC-3"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e2",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      }
     ]
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e2"
    }
   },
   "because": "HP HS-6"
  },
  {
   "control": {
    "op": "invoke",
    "handler": "h1",
    "proof": "tok_s1"
   },
   "bind": {
    "t2": "/ticket"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e2",
     "request_id": "$r2",
     "handler": "h1",
     "caller": {
      "kind": "session",
      "session": {
       "session_id": "s1"
      }
     }
    }
   },
   "because": "HP VC-3"
  }
 ]
}

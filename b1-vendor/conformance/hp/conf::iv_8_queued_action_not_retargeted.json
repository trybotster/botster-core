{
 "id": "conf::iv_8_queued_action_not_retargeted",
 "contract": "hp",
 "clause": "IV-8",
 "subject": "plugin_hub",
 "requires": {
  "controls": [
   "invoke",
   "reload",
   "descriptors",
   "completions",
   "settle"
  ]
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      }
     ]
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "descriptors"
   },
   "bind": {
    "d1": "/h1"
   }
  },
  {
   "control": {
    "op": "invoke",
    "handler": "h1"
   },
   "bind": {
    "ta": "/ticket"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$ra",
     "handler": "h1"
    }
   },
   "because": "HP IV-1"
  },
  {
   "control": {
    "op": "invoke",
    "handler": "h1",
    "descriptor_id": "$d1"
   },
   "bind": {
    "tb": "/ticket"
   }
  },
  {
   "control": {
    "op": "reload"
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e2",
     "resumed": false,
     "instance": "$i2"
    }
   },
   "because": "HP LD-3",
   "on": "cand"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e2",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      }
     ]
    }
   },
   "conn": "cand"
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$ra",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e2"
    }
   },
   "because": "HP IV-8",
   "on": "cand"
  },
  {
   "expect": {
    "lane": "control",
    "type": "Shutdown",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP IV-8"
  },
  {
   "expect_quiet_until": {
    "lane": "invoke",
    "type": "Invoke"
   },
   "barrier": {
    "control": {
     "op": "settle",
     "conn": "cand"
    }
   },
   "until": {
    "settled": true
   },
   "because": "HP IV-8",
   "on": "cand"
  },
  {
   "control": {
    "op": "completions"
   },
   "expect": [
    {
     "ticket": "$ta",
     "answer": {
      "ok": true
     }
    },
    {
     "ticket": "$tb",
     "answer": {
      "ok": false,
      "error": {
       "kind": "conflict",
       "detail": {
        "code": "stale_descriptor"
       },
       "effect": "none"
      }
     }
    }
   ],
   "because": [
    "HP IV-8",
    "HP ER-5"
   ]
  }
 ]
}

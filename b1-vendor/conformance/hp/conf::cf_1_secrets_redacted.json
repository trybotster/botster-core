{
 "id": "conf::cf_1_secrets_redacted",
 "contract": "hp",
 "clause": "CF-1",
 "subject": "plugin_hub",
 "requires": {
  "controls": [
   "invoke"
  ]
 },
 "setup": {
  "given": "the config name token is a secret that the operator set to hunter2; the config name other_secret is a secret that is unset",
  "calls": {
   "config.get": [
    {
     "result": {
      "ok": true,
      "value": {
       "values": {
        "token": "***"
       },
       "missing_required": [
        "other_secret"
       ],
       "diagnostics": []
      }
     },
     "effect": "none"
    },
    {
     "result": {
      "ok": true,
      "value": {
       "values": {
        "token": "***"
       },
       "missing_required": [
        "other_secret"
       ],
       "diagnostics": []
      }
     },
     "effect": "none"
    },
    {
     "result": {
      "ok": true,
      "value": {
       "values": {
        "token": "***"
       },
       "missing_required": [
        "other_secret"
       ],
       "diagnostics": []
      }
     },
     "effect": "none"
    }
   ]
  }
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      }
     ]
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "invoke",
    "handler": "h1"
   },
   "bind": {
    "t": "/ticket"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "handler": "h1"
    }
   },
   "because": "HP IV-1"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 1,
     "call": "config.get",
     "context": {
      "request": "$r"
     },
     "args": {}
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 1,
     "result": {
      "ok": true,
      "value": {
       "values": {
        "token": {
         "$not": {
          "$one_of": [
           {
            "$not": {
             "$type": "string"
            }
           },
           {
            "$contains": "hunter2"
           }
          ]
         }
        },
        "other_secret": {
         "$absent": true
        }
       },
       "missing_required": [
        "other_secret"
       ]
      }
     },
     "effect": "none"
    }
   },
   "because": "HP CF-1"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 2,
     "call": "config.get",
     "context": {
      "request": "$r"
     },
     "args": {}
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 2,
     "result": {
      "ok": true,
      "value": {
       "values": {
        "token": {
         "$not": {
          "$one_of": [
           {
            "$not": {
             "$type": "string"
            }
           },
           {
            "$contains": "hunter2"
           }
          ]
         }
        },
        "other_secret": {
         "$absent": true
        }
       },
       "missing_required": [
        "other_secret"
       ]
      }
     },
     "effect": "none"
    }
   },
   "because": "HP CF-1"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 3,
     "call": "config.get",
     "context": {
      "request": "$r"
     },
     "args": {}
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 3,
     "result": {
      "ok": true,
      "value": {
       "values": {
        "token": {
         "$not": {
          "$one_of": [
           {
            "$not": {
             "$type": "string"
            }
           },
           {
            "$contains": "hunter2"
           }
          ]
         }
        },
        "other_secret": {
         "$absent": true
        }
       },
       "missing_required": [
        "other_secret"
       ]
      }
     },
     "effect": "none"
    }
   },
   "because": "HP CF-1"
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  }
 ]

{
 "id": "conf::lm_3_core_limit_effect_is_observable",
 "contract": "hp",
 "clause": "LM-3",
 "subject": "plugin_hub",
 "requires": {
  "controls": [
   "service_exited",
   "status"
  ]
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      }
     ]
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "service_exited",
    "signal": 9
   }
  },
  {
   "control": {
    "op": "status"
   },
   "expect": {
    "state": "restarting",
    "cause": {
     "exit": {
      "signal": 9
     },
     "limit": {
      "$absent": true
     }
    }
   },
   "because": [
    "HP LM-3",
    "HP CR-1"
   ]
  }
 ]
}

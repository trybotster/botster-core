{
 "id": "conf::ev_9_session_notification_reaches_clients",
 "contract": "hp",
 "clause": "EV-9",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "client_events",
   "terminal_feed"
  ]
 },
 "setup": {
  "given": "the session s1 exists; client c2 is connected and not attached to s1; the session type declares no notification policy",
  "grants": []
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      },
      {
       "id": "he",
       "kind": "event",
       "descriptor": {}
      },
      {
       "id": "hg",
       "kind": "event_gap",
       "descriptor": {}
      }
     ],
     "events": {
      "subscribed": [],
      "gap_handler": "hg"
     }
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "terminal_feed",
    "session": {
     "hub_id": "hub-1",
     "session_id": "s1"
    },
    "kind": "notification",
    "source": "osc9",
    "body": "done"
   }
  },
  {
   "control": {
    "op": "client_events",
    "client": "c2"
   },
   "expect": {
    "events": {
     "$array": {
      "min": 1,
      "max": 1,
      "each": {
       "owner": "hub",
       "name": "session_notification",
       "payload": {
        "session": {
         "hub_id": "hub-1",
         "session_id": "s1"
        },
        "source": "osc9",
        "body": "done"
       }
      }
     }
    }
   },
   "because": "HP EV-9"
  }
 ]
}

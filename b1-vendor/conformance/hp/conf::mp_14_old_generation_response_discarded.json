{
 "id": "conf::mp_14_old_generation_response_discarded",
 "contract": "hp",
 "clause": "MP-14",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "await_mcp_list",
   "await_mcp_server",
   "mcp_call",
   "mcp_response",
   "mcp_server_event",
   "script_mcp"
  ]
 },
 "setup": {
  "given": "a call to b is in flight; the server restarts (a new instance and a new generation); the old instance's late answer arrives; a new call to b is made",
  "plugins": {
   "demo": {
    "grants": [
     {
      "surface": "mcp",
      "scope": "mcp_proxy"
     },
     {
      "surface": "mcp",
      "scope": "mcp_proxy_stdio"
     },
     {
      "surface": "net",
      "scope": "net",
      "allow": [
       "https://mcp.example"
      ]
     }
    ],
    "mcp_servers": [
     {
      "id": "s",
      "transport": "stdio",
      "command": "mcp-server",
      "args": [
       "--x"
      ],
      "env": {
       "A": "1"
      },
      "restart": {
       "max": 2,
       "window": 60000
      }
     }
    ],
    "entry": "the plugin declares the MCP servers in its manifest (MP-1)"
   }
  }
 },
 "steps": [
  {
   "control": {
    "op": "script_mcp",
    "plugin": "demo",
    "server": "s",
    "transport": "stdio",
    "tools": [
     {
      "name": "b",
      "description": "echo tool",
      "inputSchema": {
       "type": "object",
       "properties": {
        "n": {
         "type": "integer"
        }
       }
      },
      "behavior": {
       "kind": "hang"
      }
     }
    ]
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      }
     ]
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "await_mcp_server",
    "plugin": "demo",
    "server": "s",
    "state": "available"
   }
  },
  {
   "control": {
    "op": "mcp_call",
    "tool": "demo__s__b",
    "arguments": {}
   },
   "bind": {
    "tk1": "/ticket"
   },
   "because": "HP MP-14"
  },
  {
   "control": {
    "op": "mcp_server_event",
    "plugin": "demo",
    "server": "s",
    "event": "restart"
   }
  },
  {
   "control": {
    "op": "await_mcp_server",
    "plugin": "demo",
    "server": "s",
    "state": "available"
   }
  },
  {
   "control": {
    "op": "mcp_server_event",
    "plugin": "demo",
    "server": "s",
    "event": "old_instance_answer",
    "result": {
     "content": [
      {
       "type": "text",
       "text": "OLD"
      }
     ]
    }
   }
  },
  {
   "control": {
    "op": "mcp_response",
    "ticket": "$tk1"
   },
   "expect": {
    "is_error": true,
    "error": {
     "kind": "failed",
     "detail": {
      "code": "mcp_server_restarted"
     }
    }
   },
   "because": "HP MP-14"
  },
  {
   "control": {
    "op": "script_mcp",
    "plugin": "demo",
    "server": "s",
    "transport": "stdio",
    "tools": [
     {
      "name": "b",
      "description": "echo tool",
      "inputSchema": {
       "type": "object",
       "properties": {
        "n": {
         "type": "integer"
        }
       }
      },
      "behavior": {
       "kind": "echo",
       "text": "NEW"
      }
     }
    ]
   }
  },
  {
   "control": {
    "op": "mcp_server_event",
    "plugin": "demo",
    "server": "s",
    "event": "list_changed",
    "tools": [
     {
      "name": "b",
      "description": "echo tool",
      "inputSchema": {
       "type": "object",
       "properties": {
        "n": {
         "type": "integer"
        }
       }
      },
      "behavior": {
       "kind": "echo",
       "text": "NEW"
      }
     }
    ]
   }
  },
  {
   "control": {
    "op": "await_mcp_list",
    "plugin": "demo",
    "server": "s",
    "generation": 3
   }
  },
  {
   "control": {
    "op": "mcp_call",
    "tool": "demo__s__b",
    "arguments": {}
   },
   "bind": {
    "tk2": "/ticket"
   },
   "because": "HP MP-14"
  },
  {
   "control": {
    "op": "mcp_response",
    "ticket": "$tk2"
   },
   "expect": {
    "is_error": false,
    "content": {
     "$not": [
      {
       "type": "text",
       "text": "OLD"
      }
     ]
    }
   },
   "because": "HP MP-14"
  }
 ]
}

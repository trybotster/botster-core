{
 "id": "conf::ev_9_target_scoped_instance_receives_only_its_target_notifications",
 "contract": "hp",
 "clause": "EV-9",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "settle",
   "terminal_feed"
  ]
 },
 "setup": {
  "given": "the plugin is the instance demo@t1 of a target-scoped package; the session s1 runs on target t1 and s2 on target t2; the operator approved events_terminal:any",
  "grants": [
   {
    "surface": "events",
    "scope": "events_terminal:any"
   }
  ]
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      },
      {
       "id": "he",
       "kind": "event",
       "descriptor": {}
      },
      {
       "id": "hg",
       "kind": "event_gap",
       "descriptor": {}
      }
     ],
     "events": {
      "subscribed": [
       {
        "handler_id": "he",
        "pattern": {
         "owner": "hub",
         "name": "session_notification"
        }
       }
      ],
      "gap_handler": "hg"
     }
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "terminal_feed",
    "session": {
     "hub_id": "hub-1",
     "session_id": "s2"
    },
    "kind": "notification",
    "source": "osc9",
    "body": "done"
   }
  },
  {
   "expect_quiet_until": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "payload": {
      "name": "session_notification"
     }
    }
   },
   "barrier": {
    "control": {
     "op": "settle"
    }
   },
   "until": {
    "settled": true
   },
   "because": "HP EV-9"
  },
  {
   "control": {
    "op": "terminal_feed",
    "session": {
     "hub_id": "hub-1",
     "session_id": "s1"
    },
    "kind": "notification",
    "source": "osc9",
    "body": "done"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$c1",
     "handler": "he",
     "origin": "event",
     "payload": {
      "owner": "hub",
      "name": "session_notification",
      "payload": {
       "session": {
        "hub_id": "hub-1",
        "session_id": "s1"
       }
      },
      "subject": {
       "hub_id": "hub-1",
       "session_id": "s1"
      }
     }
    }
   },
   "because": [
    "HP EV-9",
    "HP CP-8"
   ]
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$c1",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  }
 ]
}

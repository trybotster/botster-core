{
 "id": "conf::vc_7_event_source_separate_from_caller",
 "contract": "hp",
 "clause": "VC-7",
 "subject": "plugin_hub",
 "requires": {
  "controls": [
   "invoke"
  ]
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      }
     ]
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "invoke",
    "handler": "h1",
    "kind": "event",
    "origin": "event",
    "source": {
     "kind": "plugin",
     "instance": "inst-9"
    },
    "payload": {
     "owner": "p",
     "name": "e"
    }
   },
   "bind": {
    "t": "/ticket"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "handler": "h1",
     "kind": "event",
     "origin": "event",
     "caller": {
      "kind": "system"
     },
     "source": {
      "kind": "plugin",
      "instance": "inst-9"
     }
    }
   },
   "because": "HP VC-7"
  }
 ]
}

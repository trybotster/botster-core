{
 "id": "conf::mp_5_hub_forwards_no_credential_or_session_authority",
 "contract": "hp",
 "clause": "MP-5",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "await_mcp_server",
   "mcp_call",
   "mcp_response",
   "mcp_server_log",
   "script_mcp",
   "set_secret"
  ]
 },
 "setup": {
  "given": "an http server declares the header x-api-key from a secret; a client calls it with the MCP session token of a session",
  "plugins": {
   "demo": {
    "grants": [
     {
      "surface": "mcp",
      "scope": "mcp_proxy"
     },
     {
      "surface": "mcp",
      "scope": "mcp_proxy_stdio"
     },
     {
      "surface": "net",
      "scope": "net",
      "allow": [
       "https://mcp.example"
      ]
     }
    ],
    "mcp_servers": [
     {
      "id": "h",
      "transport": "http",
      "url": "https://mcp.example/mcp",
      "headers": {
       "x-api-key": "{{secret:k}}"
      }
     }
    ],
    "entry": "the plugin declares the MCP servers in its manifest (MP-1)"
   }
  }
 },
 "steps": [
  {
   "control": {
    "op": "script_mcp",
    "plugin": "demo",
    "server": "h",
    "transport": "http",
    "tools": [
     {
      "name": "echo",
      "description": "echo tool",
      "inputSchema": {
       "type": "object",
       "properties": {
        "n": {
         "type": "integer"
        }
       }
      },
      "behavior": {
       "kind": "echo"
      }
     }
    ]
   }
  },
  {
   "control": {
    "op": "set_secret",
    "plugin": "demo",
    "name": "k",
    "value": "sekret-123"
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      }
     ]
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "await_mcp_server",
    "plugin": "demo",
    "server": "h",
    "state": "available"
   }
  },
  {
   "control": {
    "op": "mcp_call",
    "tool": "demo__h__echo",
    "arguments": {
     "n": 1
    },
    "client": {
     "token_of_session": {
      "hub_id": "hub-1",
      "session_id": "s1"
     }
    }
   },
   "bind": {
    "tk": "/ticket"
   }
  },
  {
   "control": {
    "op": "mcp_response",
    "ticket": "$tk"
   },
   "expect": {
    "is_error": false
   },
   "because": "HP MP-5"
  },
  {
   "control": {
    "op": "mcp_server_log",
    "plugin": "demo",
    "server": "h"
   },
   "expect": {
    "calls": [
     {
      "headers": {
       "authorization": {
        "$absent": true
       },
       "cookie": {
        "$absent": true
       },
       "x-api-key": {
        "$type": "string"
       }
      }
     }
    ]
   },
   "because": "HP MP-5"
  }
 ]
}

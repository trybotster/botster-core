{
 "id": "conf::wp_5_serves_get_and_head_only_from_the_root",
 "contract": "hp",
 "clause": "WP-5",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "web_request"
  ]
 },
 "setup": {
  "given": "the plugin holds net_serve and fs:web and declares the static route {route: /, root: web}; the root web holds index.html (<h1>hi</h1>), other.html, data.json, app.js, and a link escape that points to the file /outside/secret.txt (content OUTSIDE-SECRET)",
  "grants": [
   {
    "surface": "net_serve"
   },
   {
    "surface": "fs",
    "scope": "fs:web"
   }
  ]
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      },
      {
       "id": "op",
       "kind": "operation",
       "descriptor": {}
      },
      {
       "id": "he",
       "kind": "event",
       "descriptor": {}
      },
      {
       "id": "hg",
       "kind": "event_gap",
       "descriptor": {}
      }
     ],
     "operations": {
      "subscribed": "op"
     }
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "web_request",
    "plugin": "demo",
    "method": "GET",
    "path": "/index.html"
   },
   "expect": {
    "status": 200,
    "body_b64": "PGgxPmhpPC9oMT4="
   },
   "because": "HP WP-5"
  },
  {
   "control": {
    "op": "web_request",
    "plugin": "demo",
    "method": "HEAD",
    "path": "/index.html"
   },
   "expect": {
    "status": 200,
    "body_b64": {
     "$one_of": [
      {
       "$absent": true
      },
      ""
     ]
    }
   },
   "because": "HP WP-5"
  },
  {
   "control": {
    "op": "web_request",
    "plugin": "demo",
    "method": "POST",
    "path": "/index.html",
    "body_b64": ""
   },
   "expect": {
    "status": {
     "$between": [
      400,
      499
     ]
    }
   },
   "because": "HP WP-5"
  },
  {
   "control": {
    "op": "web_request",
    "plugin": "demo",
    "method": "PUT",
    "path": "/index.html",
    "body_b64": ""
   },
   "expect": {
    "status": {
     "$between": [
      400,
      499
     ]
    }
   },
   "because": "HP WP-5"
  },
  {
   "control": {
    "op": "web_request",
    "plugin": "demo",
    "method": "DELETE",
    "path": "/index.html",
    "body_b64": ""
   },
   "expect": {
    "status": {
     "$between": [
      400,
      499
     ]
    }
   },
   "because": "HP WP-5"
  },
  {
   "control": {
    "op": "web_request",
    "plugin": "demo",
    "method": "PATCH",
    "path": "/index.html",
    "body_b64": ""
   },
   "expect": {
    "status": {
     "$between": [
      400,
      499
     ]
    }
   },
   "because": "HP WP-5"
  },
  {
   "control": {
    "op": "web_request",
    "plugin": "demo",
    "method": "GET",
    "path": "/missing.html"
   },
   "expect": {
    "status": {
     "$between": [
      400,
      499
     ]
    }
   },
   "because": "HP WP-5"
  }
 ]
}

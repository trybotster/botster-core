{
 "id": "conf::ld_1_failed_load_leaves_nothing",
 "contract": "hp",
 "clause": "LD-1",
 "subject": "plugin_hub",
 "requires": {
  "controls": [
   "published",
   "diagnostics"
  ]
 },
 "setup": {
  "reject_registration": "capability_missing",
  "calls": {
   "log.write": [
    {
     "result": {
      "ok": true,
      "value": {
       "seq": 1
      }
     }
    }
   ]
  }
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "bulk",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 1,
     "call": "log.write",
     "context": "bootstrap",
     "args": {
      "level": "error",
      "message": "boom"
     }
    }
   }
  },
  {
   "expect": {
    "lane": "bulk",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 1,
     "result": {
      "ok": true
     }
    }
   },
   "because": "HP HS-7"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      }
     ]
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Shutdown",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP LD-1"
  },
  {
   "expect_closed": null,
   "because": "HP LD-1"
  },
  {
   "control": {
    "op": "published"
   },
   "expect": {
    "handlers": [],
    "tools": [],
    "prompts": [],
    "resources": [],
    "timers": [],
    "subscriptions": [],
    "declared_events": [],
    "entity_providers": [],
    "held_subscriptions": []
   },
   "because": "HP LD-1"
  },
  {
   "control": {
    "op": "diagnostics"
   },
   "expect": {
    "reason": "capability_missing",
    "bootstrap_logs": [
     {
      "level": "error",
      "message": "boom"
     }
    ]
   },
   "because": "HP LD-1"
  }
 ]
}

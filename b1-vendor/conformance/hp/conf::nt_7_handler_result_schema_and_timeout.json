{
 "id": "conf::nt_7_handler_result_schema_and_timeout",
 "contract": "hp",
 "clause": "NT-7",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "webhook_answer",
   "webhook_post"
  ]
 },
 "setup": {
  "given": "the plugin demo holds net_inbound and registers the webhook handler wh for /hook; its package configuration sets webhook_auth bearer and the webhook_secret whs3cret; b holds net_inbound and registers /other",
  "limits": {
   "webhook_timeout_ms": 100
  },
  "grants": [
   {
    "surface": "net",
    "scope": "net_inbound"
   }
  ]
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      },
      {
       "id": "op",
       "kind": "operation",
       "descriptor": {}
      },
      {
       "id": "he",
       "kind": "event",
       "descriptor": {}
      },
      {
       "id": "hg",
       "kind": "event_gap",
       "descriptor": {}
      },
      {
       "id": "wh",
       "kind": "webhook",
       "descriptor": {
        "path": "/hook"
       }
      }
     ],
     "operations": {
      "subscribed": "op"
     }
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "webhook_post",
    "plugin": "demo",
    "path": "/hook",
    "headers": [
     [
      "Authorization",
      "Bearer whs3cret"
     ]
    ],
    "body_b64": ""
   },
   "bind": {
    "q1": "/request"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$w1",
     "handler": "wh",
     "origin": "webhook",
     "payload": {
      "path": "/hook"
     },
     "caller": {
      "kind": "system"
     }
    }
   },
   "because": "HP NT-7"
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$w1",
     "result": {
      "ok": true,
      "value": {
       "status": 201,
       "headers": [
        [
         "x-a",
         "b"
        ]
       ],
       "body_b64": "b2s="
      }
     }
    }
   }
  },
  {
   "control": {
    "op": "webhook_answer",
    "request": "$q1"
   },
   "expect": {
    "status": 201,
    "body_b64": "b2s=",
    "headers": {
     "$type": "array"
    }
   },
   "because": "HP NT-7"
  },
  {
   "control": {
    "op": "webhook_post",
    "plugin": "demo",
    "path": "/hook",
    "headers": [
     [
      "Authorization",
      "Bearer whs3cret"
     ]
    ],
    "body_b64": ""
   },
   "bind": {
    "q2": "/request"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$w2",
     "handler": "wh",
     "origin": "webhook",
     "payload": {
      "path": "/hook"
     },
     "caller": {
      "kind": "system"
     }
    }
   },
   "because": "HP NT-7"
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$w2",
     "result": {
      "ok": true,
      "value": {
       "status": 99
      }
     }
    }
   }
  },
  {
   "control": {
    "op": "webhook_answer",
    "request": "$q2"
   },
   "expect": {
    "status": 502
   },
   "because": "HP NT-7"
  },
  {
   "control": {
    "op": "webhook_post",
    "plugin": "demo",
    "path": "/hook",
    "headers": [
     [
      "Authorization",
      "Bearer whs3cret"
     ]
    ],
    "body_b64": ""
   },
   "bind": {
    "q3": "/request"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$w3",
     "handler": "wh",
     "origin": "webhook",
     "payload": {
      "path": "/hook"
     },
     "caller": {
      "kind": "system"
     }
    }
   },
   "because": "HP NT-7"
  },
  {
   "advance_clock": {
    "ms": 100
   }
  },
  {
   "control": {
    "op": "webhook_answer",
    "request": "$q3"
   },
   "expect": {
    "status": 504
   },
   "because": "HP NT-7"
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$w3",
     "result": {
      "ok": true,
      "value": {
       "status": 200
      }
     }
    }
   }
  }
 ]
}

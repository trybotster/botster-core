{
 "id": "conf::mp_2_negotiates_the_mc0_revision",
 "contract": "hp",
 "clause": "MP-2",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "await_mcp_server",
   "mcp_list",
   "mcp_server_log",
   "script_mcp"
  ]
 },
 "setup": {
  "given": "the scripted stdio server negotiates the revision 2025-06-18; the Hub is the MCP client",
  "plugins": {
   "demo": {
    "grants": [
     {
      "surface": "mcp",
      "scope": "mcp_proxy"
     },
     {
      "surface": "mcp",
      "scope": "mcp_proxy_stdio"
     },
     {
      "surface": "net",
      "scope": "net",
      "allow": [
       "https://mcp.example"
      ]
     }
    ],
    "mcp_servers": [
     {
      "id": "s",
      "transport": "stdio",
      "command": "mcp-server",
      "args": [
       "--x"
      ],
      "env": {
       "A": "1"
      }
     }
    ],
    "entry": "the plugin declares the MCP servers in its manifest (MP-1)"
   }
  }
 },
 "steps": [
  {
   "control": {
    "op": "script_mcp",
    "plugin": "demo",
    "server": "s",
    "transport": "stdio",
    "tools": [
     {
      "name": "echo",
      "description": "echo tool",
      "inputSchema": {
       "type": "object",
       "properties": {
        "n": {
         "type": "integer"
        }
       }
      },
      "behavior": {
       "kind": "echo"
      }
     }
    ],
    "protocol_version": "2025-06-18"
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      }
     ]
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "await_mcp_server",
    "plugin": "demo",
    "server": "s",
    "state": "available"
   }
  },
  {
   "control": {
    "op": "mcp_server_log",
    "plugin": "demo",
    "server": "s",
    "ordered": [
     {
      "dir": "in",
      "method": "initialize",
      "params": {
       "protocolVersion": {
        "$type": "string"
       }
      }
     },
     {
      "dir": "out",
      "result": {
       "protocolVersion": "2025-06-18"
      }
     },
     {
      "dir": "in",
      "method": "notifications/initialized"
     },
     {
      "dir": "in",
      "method": "tools/list"
     },
     {
      "dir": "out",
      "result": {
       "tools": {
        "$type": "array"
       }
      }
     }
    ]
   },
   "expect": {
    "in_order": true
   },
   "because": "HP MP-2"
  },
  {
   "control": {
    "op": "mcp_list",
    "kind": "tools",
    "plugin": "demo"
   },
   "expect": {
    "items": [
     {
      "name": "demo__s__echo"
     }
    ]
   },
   "because": "HP MP-2"
  }
 ]
}

{
 "id": "conf::vc_6_argument_is_never_identity",
 "contract": "hp",
 "clause": "VC-6",
 "subject": "plugin_hub",
 "requires": {
  "controls": [
   "invoke"
  ]
 },
 "setup": {
  "proofs": {
   "op_socket": {
    "kind": "operator"
   },
   "op_rtc": {
    "kind": "operator",
    "credential_id": "cred-1"
   },
   "tok_s1": {
    "kind": "session",
    "session": {
     "hub_id": "hub-1",
     "session_id": "s1"
    }
   }
  },
  "given": "an operator on the Unix socket (no credential id), an operator with WebRTC credential cred-1, and a session s1 with a valid bearer token"
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      }
     ]
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "invoke",
    "handler": "h1",
    "proof": "tok_s1",
    "payload": {
     "session_id": "s9",
     "acting_as": "s9"
    }
   },
   "bind": {
    "t": "/ticket"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "handler": "h1",
     "caller": {
      "kind": "session",
      "session": {
       "session_id": "s1"
      }
     },
     "payload": {
      "session_id": "s9",
      "acting_as": "s9"
     }
    }
   },
   "because": "HP VC-6"
  }
 ]
}

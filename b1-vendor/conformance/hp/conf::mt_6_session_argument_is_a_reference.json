{
 "id": "conf::mt_6_session_argument_is_a_reference",
 "contract": "hp",
 "clause": "MT-6",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "mcp_call",
   "mcp_response"
  ]
 },
 "setup": {
  "given": "the tool takes a session argument that is a reference and its descriptor does not let an argument stand in for identity; a client calls it with the token of session s1 and names session s2 in the argument",
  "plugins": {
   "demo": {
    "grants": [
     {
      "surface": "mcp"
     }
    ]
   }
  }
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      },
      {
       "id": "p1",
       "kind": "mcp_prompt",
       "descriptor": {}
      },
      {
       "id": "r1",
       "kind": "mcp_resource",
       "descriptor": {}
      }
     ],
     "tools": [
      {
       "name": "echo",
       "description": "d",
       "input_schema": {
        "type": "object",
        "required": [
         "n"
        ],
        "properties": {
         "n": {
          "type": "integer"
         }
        },
        "additionalProperties": true
       },
       "handler": "h1"
      }
     ],
     "prompts": [],
     "resources": []
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "mcp_call",
    "tool": "demo__echo",
    "arguments": {
     "n": 6,
     "session": {
      "hub_id": "hub-1",
      "session_id": "s2"
     }
    },
    "client": {
     "token_of_session": {
      "hub_id": "hub-1",
      "session_id": "s1"
     }
    }
   },
   "bind": {
    "tk1": "/ticket"
   },
   "because": "HP MT-6"
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "handler": "h1",
     "origin": "mcp_tool",
     "payload": {
      "n": 6,
      "session": {
       "hub_id": "hub-1",
       "session_id": "s2"
      }
     },
     "caller": {
      "kind": "session",
      "session": {
       "hub_id": "hub-1",
       "session_id": "s1"
      }
     }
    }
   },
   "because": "HP MT-6"
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  },
  {
   "control": {
    "op": "mcp_response",
    "ticket": "$tk1"
   },
   "expect": {
    "is_error": false
   },
   "because": "HP MT-5"
  }
 ]
}

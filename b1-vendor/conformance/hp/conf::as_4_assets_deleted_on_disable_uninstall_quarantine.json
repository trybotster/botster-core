    "views": [
     {
      "key": "view",
      "kind": "embed",
      "permission": "embed.view",
      "actions": [
       {
        "id": "refresh",
        "handler": "h1"
       }
      ]
     }
    ]
   },
   "p1": {
    "grants": [
     {
      "surface": "assets"
     }
    ],
    "views": [
     {
      "key": "view",
      "kind": "embed",

{
 "id": "conf::pm_4_every_fetch_applies_nt2_including_catalog_selected_urls",
 "contract": "hp",
 "clause": "PM-4",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "await_catalog",
   "await_client_operation",
   "client_read",
   "client_verb",
   "edge_requests",
   "package_cache_wipe",
   "script_catalog",
   "script_git",
   "script_redirect",
   "script_resolve"
  ]
 },
 "setup": {
  "given": "an install, an upgrade, a rollback and a catalog refresh each name a url that resolves to a private address, redirects to one or is selected by an untrusted catalog; a public package is installed beside them",
  "plugins": {
   "demo": {
    "grants": []
   }
  }
 },
 "steps": [
  {
   "control": {
    "op": "script_resolve",
    "host": "priv.example",
    "addresses": [
     "10.0.0.9"
    ]
   }
  },
  {
   "control": {
    "op": "script_resolve",
    "host": "git.example",
    "addresses": [
     "93.184.216.34"
    ]
   }
  },
  {
   "control": {
    "op": "script_resolve",
    "host": "catalog.example",
    "addresses": [
     "93.184.216.35"
    ]
   }
  },
  {
   "control": {
    "op": "script_git",
    "url": "https://priv.example/a.git",
    "refs": {

{
 "id": "conf::pm_6_hash_verified_before_every_load",
 "contract": "hp",
 "clause": "PM-6",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "await_package",
   "client_read",
   "client_verb",
   "package_file_write",
   "script_git",
   "settle"
  ]
 },
 "setup": {
  "given": "demo loads once; it is disabled; a file changes on disk; it is enabled again",
  "plugins": {
   "demo": {
    "grants": []
   }
  }
 },
 "steps": [
  {
   "control": {
    "op": "script_git",
    "url": "https://git.example/a.git",
    "refs": {
     "v1": {
      "commit": "1111111111111111111111111111111111111111",
      "files": {
       "botster-plugin.json": {
        "json": {
         "botster_plugin_api": 1,
         "name": "demo",
         "version": "1.0.0",
         "entrypoints": {
          "service": {
           "lua": "main.lua"
          }
         }
        }
       },
       "main.lua": {
        "text": "-- v1.0.0\n"
       }
      }
     }
    }
   }
  },
  {
   "control": {
    "op": "client_verb",
    "kind": "package",
    "verb": "create",
    "args": {
     "source": {
      "kind": "git",
      "url": "https://git.example/a.git",
      "ref": "v1"
     },
     "enable": true
    }
   },
   "expect": {
    "accepted": {
     "operation_id": {
      "$type": "string"
     }
    }
   },
   "because": "HP PM-5"
  },
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      }
     ]
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "await_package",
    "package": "demo",
    "settled": true
   },
   "because": "HP PM-5"
  },
  {
   "control": {
    "op": "client_verb",
    "kind": "package",
    "verb": "invoke",
    "id": "demo",
    "args": {
     "action": "disable"
    }
   },
   "expect": {
    "error": {
     "$absent": true
    }
   },
   "because": "HP PM-10"
  },
  {
   "control": {
    "op": "await_package",
    "package": "demo",
    "settled": true
   },
   "because": "HP PM-10"
  },
  {
   "control": {
    "op": "package_file_write",
    "package": "demo",
    "file": "main.lua",
    "text": "-- tampered\\n"
   }
  },
  {
   "control": {
    "op": "client_verb",
    "kind": "package",
    "verb": "invoke",
    "id": "demo",
    "args": {
     "action": "enable"
    }
   },
   "expect": {
    "error": {
     "$absent": true
    }
   },
   "because": "HP PM-6"
  },
  {
   "control": {
    "op": "await_package",
    "package": "demo",
    "settled": true
   },
   "because": "HP PM-6"
  },
  {
   "control": {
    "op": "client_read",
    "kind": "operation",
    "package": "demo",
    "latest": true
   },
   "expect": {
    "state": "failed",
    "error": {
     "kind": "failed",
     "detail": {
      "code": "hash_mismatch"
     }
    }
   },
   "because": "HP PM-6"
  },
  {
   "expect_quiet_until": {
    "lane": "control",
    "type": "Hello"
   },
   "on": "main",
   "barrier": {
    "control": {
     "op": "settle",
     "conn": "main"
    }
   },
   "until": {
    "settled": true
   },
   "because": "HP PM-6"
  }
 ]
}

{
 "id": "conf::mp_11_session_id_and_version_headers",
 "contract": "hp",
 "clause": "MP-11",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "await_mcp_server",
   "mcp_call",
   "mcp_response",
   "mcp_server_log",
   "script_mcp"
  ]
 },
 "setup": {
  "given": "the scripted http server returns Mcp-Session-Id on initialize",
  "plugins": {
   "demo": {
    "grants": [
     {
      "surface": "mcp",
      "scope": "mcp_proxy"
     },
     {
      "surface": "mcp",
      "scope": "mcp_proxy_stdio"
     },
     {
      "surface": "net",
      "scope": "net",
      "allow": [
       "https://mcp.example"
      ]
     }
    ],
    "mcp_servers": [
     {
      "id": "h",
      "transport": "http",
      "url": "https://mcp.example/mcp"
     }
    ],
    "entry": "the plugin declares the MCP servers in its manifest (MP-1)"
   }
  }
 },
 "steps": [
  {
   "control": {
    "op": "script_mcp",
    "plugin": "demo",
    "server": "h",
    "transport": "http",
    "tools": [
     {
      "name": "echo",
      "description": "echo tool",
      "inputSchema": {
       "type": "object",
       "properties": {
        "n": {
         "type": "integer"
        }
       }
      },
      "behavior": {
       "kind": "echo"
      }
     }
    ],
    "session_id": "sess-42",
    "protocol_version": "2025-06-18"
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      }
     ]
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "await_mcp_server",
    "plugin": "demo",
    "server": "h",
    "state": "available"
   }
  },
  {
   "control": {
    "op": "mcp_call",
    "tool": "demo__h__echo",
    "arguments": {
     "n": 1
    }
   },
   "bind": {
    "tk1": "/ticket"
   },
   "because": "HP MP-11"
  },
  {
   "control": {
    "op": "mcp_response",
    "ticket": "$tk1"
   },
   "expect": {
    "is_error": false
   },
   "because": "HP MP-11"
  },
  {
   "control": {
    "op": "mcp_server_log",
    "plugin": "demo",
    "server": "h"
   },
   "expect": {
    "calls": [
     {
      "method": "POST",
      "headers": {
       "mcp-session-id": "sess-42",
       "mcp-protocol-version": "2025-06-18"
      }
     }
    ]
   },
   "because": "HP MP-11"
  }
 ]
}

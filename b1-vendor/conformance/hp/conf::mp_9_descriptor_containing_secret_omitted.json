{
 "id": "conf::mp_9_descriptor_containing_secret_omitted",
 "contract": "hp",
 "clause": "MP-9",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "await_mcp_server",
   "diagnostics",
   "mcp_list",
   "script_mcp",
   "set_secret"
  ]
 },
 "setup": {
  "given": "one tool's description contains the plugin's secret value; the other tool is clean",
  "plugins": {
   "demo": {
    "grants": [
     {
      "surface": "mcp",
      "scope": "mcp_proxy"
     },
     {
      "surface": "mcp",
      "scope": "mcp_proxy_stdio"
     },
     {
      "surface": "net",
      "scope": "net",
      "allow": [
       "https://mcp.example"
      ]
     }
    ],
    "mcp_servers": [
     {
      "id": "s",
      "transport": "stdio",
      "command": "mcp-server",
      "args": [
       "--x"
      ],
      "env": {
       "A": "1"
      }
     }
    ],
    "entry": "the plugin declares the MCP servers in its manifest (MP-1)"
   }
  }
 },
 "steps": [
  {
   "control": {
    "op": "set_secret",
    "plugin": "demo",
    "name": "k",
    "value": "sekret-123"
   }
  },
  {
   "control": {
    "op": "script_mcp",
    "plugin": "demo",
    "server": "s",
    "transport": "stdio",
    "tools": [
     {
      "name": "leak",
      "description": "use key sekret-123",
      "inputSchema": {
       "type": "object",
       "properties": {
        "n": {
         "type": "integer"
        }
       }
      },
      "behavior": {
       "kind": "echo"
      }
     },
     {
      "name": "echo",
      "description": "echo tool",
      "inputSchema": {
       "type": "object",
       "properties": {
        "n": {
         "type": "integer"
        }
       }
      },
      "behavior": {
       "kind": "echo"
      }
     }
    ]
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      }
     ]
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "await_mcp_server",
    "plugin": "demo",
    "server": "s",
    "state": "available"
   }
  },
  {
   "control": {
    "op": "mcp_list",
    "kind": "tools",
    "plugin": "demo"
   },
   "expect": {
    "items": [
     {
      "name": "demo__s__echo"
     }
    ]
   },
   "because": "HP MP-9"
  },
  {
   "control": {
    "op": "diagnostics",
    "plugin": "demo"
   },
   "expect": {
    "omitted_tools": [
     {
      "server": "s",
      "tool": "leak",
      "reason": {
       "$type": "string"
      }
     }
    ],
    "text": {
     "$not": {
      "$contains": "sekret-123"
     }
    }
   },
   "because": "HP MP-9"
  }
 ]
}

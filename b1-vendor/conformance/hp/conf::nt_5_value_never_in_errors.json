{
 "id": "conf::nt_5_value_never_in_errors",
 "contract": "hp",
 "clause": "NT-5",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "await_operation",
   "hub_output",
   "invoke",
   "net_world"
  ]
 },
 "setup": {
  "given": "the plugin holds net with allow [https://api.example] and declares the secret bot_token (the operator set the value s3cret-TOKEN); the outside world is scripted by net_world; the host names missing.example is not allowed and nodns.example is allowed and does not resolve",
  "grants": [
   {
    "surface": "net",
    "scope": "net",
    "allow": [
     "https://api.example",
     "https://nodns.example"
    ]
   }
  ]
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      },
      {
       "id": "op",
       "kind": "operation",
       "descriptor": {}
      },
      {
       "id": "he",
       "kind": "event",
       "descriptor": {}
      },
      {
       "id": "hg",
       "kind": "event_gap",
       "descriptor": {}
      }
     ],
     "operations": {
      "subscribed": "op"
     }
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "invoke",
    "handler": "h1"
   },
   "bind": {
    "t": "/ticket"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "handler": "h1"
    }
   },
   "because": "HP IV-1"
  },
  {
   "control": {
    "op": "net_world",
    "endpoints": [
     {
      "origin": "https://api.example",
      "addresses": [
       "203.0.113.5"
      ],
      "answers": [
       {
        "status": 200,
        "body_b64": "b2s="
       }
      ]
     },
     {
      "origin": "https://nodns.example",
      "addresses": [],
      "answers": [
       {
        "status": 200,
        "body_b64": "b2s="
       }
      ],
      "fail": "net_dns"
     }
    ]
   }
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 1,
     "call": "http.request",
     "context": {
      "request": "$r"
     },
     "args": {
      "method": "GET",
      "url": "https://missing.example/bot{{secret:bot_token}}/x",
      "timeout_ms": 1000
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 1,
     "result": {
      "ok": false,
      "error": {
       "kind": "capability_denied",
       "message": {
        "$not": {
         "$contains": "s3cret-TOKEN"
        }
       },
       "detail": {
        "code": "net_denied"
       }
      }
     },
     "effect": "none"
    }
   },
   "because": "HP NT-5"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 2,
     "call": "http.request",
     "context": {
      "request": "$r"
     },
     "args": {
      "method": "GET",
      "url": "https://nodns.example/bot{{secret:bot_token}}/x",
      "timeout_ms": 1000
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 2,
     "result": {
      "ok": true,
      "value": {
       "operation_id": "$op25",
       "kind": "http",
       "state": "queued",
       "terminal": false
      }
     },
     "effect": "committed"
    }
   },
   "because": "HP NT-5"
  },
  {
   "control": {
    "op": "await_operation",
    "operation_id": "$op25",
    "terminal": true
   }
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 3,
     "call": "operations.get",
     "context": {
      "request": "$r"
     },
     "args": {
      "operation_id": "$op25"
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 3,
     "result": {
      "ok": true,
      "value": {
       "operation_id": "$op25",
       "state": "failed",
       "terminal": true,
       "error": {
        "kind": "failed",
        "message": {
         "$not": {
          "$contains": "s3cret-TOKEN"
         }
        },
        "detail": {
         "code": "net_dns"
        }
       }
      }
     },
     "effect": "none"
    }
   },
   "because": "HP NT-5"
  },
  {
   "control": {
    "op": "hub_output"
   },
   "expect": {
    "errors": {
     "$not": {
      "$contains": "s3cret-TOKEN"
     }
    },
    "log": {
     "$not": {
      "$contains": "s3cret-TOKEN"
     }
    }
   },
   "because": "HP NT-5"
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  }
 ]
}

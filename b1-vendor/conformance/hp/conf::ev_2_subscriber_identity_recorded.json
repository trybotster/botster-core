{
 "id": "conf::ev_2_subscriber_identity_recorded",
 "contract": "hp",
 "clause": "EV-2",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "subscriptions"
  ]
 },
 "setup": {
  "given": "the plugin key is demo",
  "grants": [
   {
    "surface": "events",
    "scope": "events_plugin:b"
   }
  ]
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      },
      {
       "id": "he",
       "kind": "event",
       "descriptor": {}
      },
      {
       "id": "hg",
       "kind": "event_gap",
       "descriptor": {}
      }
     ],
     "events": {
      "subscribed": [
       {
        "handler_id": "he",
        "pattern": {
         "owner": "b",
         "name": "x"
        }
       }
      ],
      "gap_handler": "hg"
     }
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "subscriptions"
   },
   "expect": [
    {
     "plugin": "demo",
     "generation": {
      "$any": true
     },
     "handler_id": "he",
     "pattern": {
      "owner": "b",
      "name": "x"
     }
    }
   ],
   "because": "HP EV-2"
  }
 ]
}

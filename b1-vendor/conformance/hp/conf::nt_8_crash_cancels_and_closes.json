{
 "id": "conf::nt_8_crash_cancels_and_closes",
 "contract": "hp",
 "clause": "NT-8",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "await_operation",
   "invoke",
   "net_state",
   "net_world",
   "webhook_answer",
   "webhook_post"
  ]
 },
 "setup": {
  "given": "the plugin demo holds net with allow [https://api.example, https://ws.example] and net_inbound; it has a pending request, an open WebSocket and a webhook path; the outside world is scripted by net_world",
  "grants": [
   {
    "surface": "net",
    "scope": "net",
    "allow": [
     "https://api.example",
     "https://ws.example"
    ]
   },
   {
    "surface": "net",
    "scope": "net_inbound"
   }
  ]
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      },
      {
       "id": "op",
       "kind": "operation",
       "descriptor": {}
      },
      {
       "id": "he",
       "kind": "event",
       "descriptor": {}
      },
      {
       "id": "hg",
       "kind": "event_gap",
       "descriptor": {}
      },
      {
       "id": "wh",
       "kind": "webhook",
       "descriptor": {
        "path": "/hook"
       }
      }
     ],
     "operations": {
      "subscribed": "op"
     }
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "invoke",
    "handler": "h1"
   },
   "bind": {
    "t": "/ticket"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "handler": "h1"
    }
   },
   "because": "HP IV-1"
  },
  {
   "control": {
    "op": "net_world",
    "endpoints": [
     {
      "origin": "https://api.example",
      "addresses": [
       "203.0.113.5"
      ],
      "answers": [
       {
        "status": 200,
        "body_b64": "b2s=",
        "hold": true
       }
      ]
     },
     {
      "origin": "https://ws.example",
      "addresses": [
       "203.0.113.20"
      ],
      "ws": {
       "accept": true
      }
     }
    ]
   }
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 1,
     "call": "http.request",
     "context": {
      "request": "$r"
     },
     "args": {
      "method": "GET",
      "url": "https://api.example/poll",
      "timeout_ms": 30000
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 1,
     "result": {
      "ok": true,
      "value": {
       "operation_id": "$op3",
       "kind": "http",
       "state": "queued",
       "terminal": false
      }
     },
     "effect": "committed"
    }
   },
   "because": "HP NT-3"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 2,
     "call": "ws.open",
     "context": {
      "request": "$r"
     },
     "args": {
      "url": "wss://ws.example/s"
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 2,
     "result": {
      "ok": true,
      "value": {
       "operation_id": "$op4",
       "kind": "ws",
       "state": "queued",
       "terminal": false
      }
     },
     "effect": "committed"
    }
   },
   "because": "HP NT-4"
  },
  {
   "control": {
    "op": "await_operation",
    "operation_id": "$op4",
    "terminal": true
   }
  },
  {
   "control": {
    "op": "net_state"
   },
   "expect": {
    "open_requests": 1,
    "open_sockets": 1
   },
   "because": "HP NT-8"
  },
  {
   "close_channel": {}
  },
  {
   "control": {
    "op": "net_state",
    "plugin": "demo"
   },
   "expect": {
    "open_requests": 0,
    "open_sockets": 0
   },
   "because": "HP NT-8"
  },
  {
   "control": {
    "op": "webhook_post",
    "plugin": "demo",
    "path": "/hook",
    "headers": [
     [
      "Authorization",
      "Bearer whs3cret"
     ]
    ],
    "body_b64": ""
   },
   "bind": {
    "q": "/request"
   }
  },
  {
   "control": {
    "op": "webhook_answer",
    "request": "$q"
   },
   "expect": {
    "status": {
     "$between": [
      400,
      599
     ]
    }
   },
   "because": "HP NT-8"
  }
 ]
}

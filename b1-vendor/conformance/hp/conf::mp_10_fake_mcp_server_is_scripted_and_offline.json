{
 "id": "conf::mp_10_fake_mcp_server_is_scripted_and_offline",
 "contract": "hp",
 "clause": "MP-10",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "await_mcp_server",
   "mcp_call",
   "mcp_list",
   "mcp_response",
   "real_network_attempts",
   "script_mcp"
  ]
 },
 "setup": {
  "given": "the Hub's test harness provides a scripted MCP server for both transports as injected I/O edges of the real Hub (A3-1): an echo tool, a slow tool, a tool that returns an oversize result, and a tool that changes its list; no real network",
  "limits": {
   "max_result_bytes": 64
  },
  "plugins": {
   "demo": {
    "grants": [
     {
      "surface": "mcp",
      "scope": "mcp_proxy"
     },
     {
      "surface": "mcp",
      "scope": "mcp_proxy_stdio"
     },
     {
      "surface": "net",
      "scope": "net",
      "allow": [
       "https://mcp.example"
      ]
     }
    ],
    "mcp_servers": [
     {
      "id": "s",
      "transport": "stdio",
      "command": "mcp-server",
      "args": [
       "--x"
      ],
      "env": {
       "A": "1"
      }
     },
     {
      "id": "h",
      "transport": "http",
      "url": "https://mcp.example/mcp"
     }
    ],
    "entry": "the plugin declares the MCP servers in its manifest (MP-1)"
   }
  }
 },
 "steps": [
  {
   "control": {
    "op": "script_mcp",
    "plugin": "demo",
    "server": "s",
    "transport": "stdio",
    "tools": [
     {
      "name": "echo",
      "description": "echo tool",
      "inputSchema": {
       "type": "object",
       "properties": {
        "n": {
         "type": "integer"
        }
       }
      },
      "behavior": {
       "kind": "echo"
      }
     },
     {
      "name": "slow",
      "description": "slow tool",
      "inputSchema": {
       "type": "object"
      },
      "behavior": {
       "kind": "hang"
      }
     },
     {
      "name": "big",
      "description": "oversize",
      "inputSchema": {
       "type": "object"
      },
      "behavior": {
       "kind": "oversize",
       "bytes": 4096
      }
     },
     {
      "name": "chg",
      "description": "changes list",
      "inputSchema": {
       "type": "object"
      },
      "behavior": {
       "kind": "change_list",
       "to": [
        "echo"
       ]
      }
     }
    ]
   }
  },
  {
   "control": {
    "op": "script_mcp",
    "plugin": "demo",
    "server": "h",
    "transport": "http",
    "tools": [
     {
      "name": "echo",
      "description": "echo tool",
      "inputSchema": {
       "type": "object",
       "properties": {
        "n": {
         "type": "integer"
        }
       }
      },
      "behavior": {
       "kind": "echo"
      }
     }
    ]
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      }
     ]
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "await_mcp_server",
    "plugin": "demo",
    "server": "s",
    "state": "available"
   }
  },
  {
   "control": {
    "op": "await_mcp_server",
    "plugin": "demo",
    "server": "h",
    "state": "available"
   }
  },
  {
   "control": {
    "op": "mcp_list",
    "kind": "tools",
    "plugin": "demo"
   },
   "expect": {
    "items": [
     {
      "name": "demo__s__echo"
     },
     {
      "name": "demo__s__slow"
     },
     {
      "name": "demo__s__big"
     },
     {
      "name": "demo__s__chg"
     },
     {
      "name": "demo__h__echo"
     }
    ]
   },
   "because": "HP MP-10"
  },
  {
   "control": {
    "op": "mcp_call",
    "tool": "demo__s__echo",
    "arguments": {
     "n": 1
    }
   },
   "bind": {
    "tk1": "/ticket"
   },
   "because": "HP MP-10"
  },
  {
   "control": {
    "op": "mcp_response",
    "ticket": "$tk1"
   },
   "expect": {
    "is_error": false
   },
   "because": "HP MP-10"
  },
  {
   "control": {
    "op": "mcp_call",
    "tool": "demo__s__big",
    "arguments": {}
   },
   "bind": {
    "tk2": "/ticket"
   },
   "because": "HP MP-10"
  },
  {
   "control": {
    "op": "mcp_response",
    "ticket": "$tk2"
   },
   "expect": {
    "is_error": true,
    "error": {
     "kind": "response_too_large"
    }
   },
   "because": "HP MP-10"
  },
  {
   "control": {
    "op": "mcp_call",
    "tool": "demo__s__chg",
    "arguments": {}
   },
   "bind": {
    "tk3": "/ticket"
   },
   "because": "HP MP-10"
  },
  {
   "control": {
    "op": "mcp_response",
    "ticket": "$tk3"
   },
   "expect": {
    "is_error": false
   },
   "because": "HP MP-10"
  },
  {
   "control": {
    "op": "real_network_attempts"
   },
   "expect": {
    "count": 0
   },
   "because": "HP MP-10"
  }
 ]
}

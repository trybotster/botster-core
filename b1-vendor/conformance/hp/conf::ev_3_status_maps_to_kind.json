{
 "id": "conf::ev_3_status_maps_to_kind",
 "contract": "hp",
 "clause": "EV-3",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "hold_ingress",
   "invoke",
   "release_ingress"
  ]
 },
 "setup": {
  "given": "the plugin declares the public plugins-audience event done (payload schema: an object with an integer n) and holds no grant for any other event; the Hub's event ingress holds two emits (ingress_queue 2) and its injected scheduler can hold the ingress drain",
  "limits": {
   "ingress_queue": 2
  }
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      },
      {
       "id": "he",
       "kind": "event",
       "descriptor": {}
      },
      {
       "id": "hg",
       "kind": "event_gap",
       "descriptor": {}
      }
     ],
     "events": {
      "subscribed": [],
      "gap_handler": "hg",
      "declared": [
       {
        "name": "done",
        "payload_schema": {
         "type": "object",
         "required": [
          "n"
         ],
         "properties": {
          "n": {
           "type": "integer"
          }
         }
        },
        "audience": [
         "plugins"
        ],
        "public": true,
        "priority": "normal"
       }
      ]
     }
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "invoke",
    "handler": "h1"
   },
   "bind": {
    "t": "/ticket"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "handler": "h1"
    }
   },
   "because": "HP IV-1"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 1,
     "call": "events.emit",
     "context": {
      "request": "$r"
     },
     "args": {
      "name": "done",
      "payload": {
       "n": 1
      }
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 1,
     "result": {
      "ok": true,
      "value": {
       "status": "accepted"
      }
     },
     "effect": "committed"
    }
   },
   "because": "HP EV-3"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 2,
     "call": "events.emit",
     "context": {
      "request": "$r"
     },
     "args": {
      "name": "undeclared",
      "payload": {
       "n": 1
      }
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 2,
     "result": {
      "ok": false,
      "error": {
       "kind": "capability_denied",
       "detail": {
        "status": "rejected_undeclared"
       }
      }
     },
     "effect": "none"
    }
   },
   "because": [
    "HP EV-1",
    "HP EV-3"
   ]
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 3,
     "call": "events.emit",
     "context": {
      "request": "$r"
     },
     "args": {
      "name": "done",
      "payload": {
       "n": "x"
      }
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 3,
     "result": {
      "ok": false,
      "error": {
       "kind": "invalid_request",
       "detail": {
        "status": "rejected_invalid"
       }
      }
     },
     "effect": "none"
    }
   },
   "because": [
    "HP EV-1",
    "HP EV-3"
   ]
  },
  {
   "control": {
    "op": "hold_ingress"
   }
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 4,
     "call": "events.emit",
     "context": {
      "request": "$r"
     },
     "args": {
      "name": "done",
      "payload": {
       "n": 2
      }
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 4,
     "result": {
      "ok": true,
      "value": {
       "status": "accepted"
      }
     },
     "effect": "committed"
    }
   },
   "because": "HP EV-3"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 5,
     "call": "events.emit",
     "context": {
      "request": "$r"
     },
     "args": {
      "name": "done",
      "payload": {
       "n": 3
      }
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 5,
     "result": {
      "ok": true,
      "value": {
       "status": "accepted"
      }
     },
     "effect": "committed"
    }
   },
   "because": "HP EV-3"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 6,
     "call": "events.emit",
     "context": {
      "request": "$r"
     },
     "args": {
      "name": "done",
      "payload": {
       "n": 4
      }
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 6,
     "result": {
      "ok": false,
      "error": {
       "kind": "backpressured",
       "detail": {
        "status": "shed_ingress_full"
       }
      }
     },
     "effect": "none"
    }
   },
   "because": "HP EV-3"
  },
  {
   "control": {
    "op": "release_ingress"
   }
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  }
 ]
}

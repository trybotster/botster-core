{
 "id": "conf::cf_1_own_config_only",
 "contract": "hp",
 "clause": "CF-1",
 "subject": "plugin_hub",
 "requires": {
  "controls": [
   "invoke"
  ]
 },
 "setup": {
  "given": "the plugin sets the config name greeting to hi",
  "calls": {
   "config.get": [
    {
     "result": {
      "ok": true,
      "value": {
       "values": {
        "greeting": "hi"
       },
       "missing_required": [],
       "diagnostics": []
      }
     }
    },
    {
     "result": {
      "ok": true,
      "value": {
       "values": {
        "greeting": "hi"
       },
       "missing_required": [],
       "diagnostics": []
      }
     },
     "effect": "none"
    },
    {
     "result": {
      "ok": false,
      "error": {
       "kind": "invalid_request",
       "message": "invalid_request",
       "retryable": false
      }
     },
     "effect": "none"
    }
   ]
  }
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 1,
     "call": "config.get",
     "context": "bootstrap",
     "args": {}
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 1,
     "result": {
      "ok": true,
      "value": {
       "values": {
        "greeting": "hi"
       },
       "missing_required": []
      }
     },
     "effect": "none"
    }
   },
   "because": "HP CF-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      }
     ]
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "invoke",
    "handler": "h1"
   },
   "bind": {
    "t": "/ticket"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "handler": "h1"
    }
   },
   "because": "HP IV-1"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 2,
     "call": "config.get",
     "context": {
      "request": "$r"
     },
     "args": {}
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 2,
     "result": {
      "ok": true,
      "value": {
       "values": {
        "greeting": "hi"
       }
      }
     },
     "effect": "none"
    }
   },
   "because": "HP CF-1"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 3,
     "call": "config.get",
     "context": {
      "request": "$r"
     },
     "args": {
      "package": "other"
     }
    }
   },
   "violates_args": "CF-1: no arguments"
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 3,
     "result": {
      "ok": false,
      "error": {
       "kind": "invalid_request"
      }
     },
     "effect": "none"
    }
   },
   "because": "HP CF-1"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 4,
     "call": "config.set",
     "context": {
      "request": "$r"
     },
     "args": {
      "name": "greeting",
      "value": "yo"
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 4,
     "result": {
      "ok": false,
      "error": {
       "kind": "invalid_request",
       "detail": {
        "code": "unknown_call"
       }
      }
     },
     "effect": "none"
    }
   },
   "because": "HP CF-1"
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  }
 ]
}

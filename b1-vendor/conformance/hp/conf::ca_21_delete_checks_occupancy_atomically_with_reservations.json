{
 "id": "conf::ca_21_delete_checks_occupancy_atomically_with_reservations",
 "contract": "hp",
 "clause": "CA-21",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "await_session",
   "hold_spawn",
   "invoke",
   "release_spawn"
  ]
 },
 "setup": {
  "given": "the worktree w1 exists, this plugin created it, and no session uses it; the plugin holds worktree_delete (own) and session_type_managed_git_spawn; the next spawn is held before its payload starts"
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      }
     ]
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "invoke",
    "handler": "h1"
   },
   "bind": {
    "t": "/ticket"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "handler": "h1"
    }
   },
   "because": "HP IV-1"
  },
  {
   "control": {
    "op": "hold_spawn"
   },
   "because": "HP CA-21"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 1,
     "call": "worktrees.list",
     "context": {
      "request": "$r"
     },
     "args": {}
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 1,
     "result": {
      "ok": true,
      "value": {
       "worktrees": [
        {
         "worktree_id": "$w"
        }
       ]
      }
     },
     "effect": "none"
    }
   },
   "because": "HP CA-13"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 2,
     "call": "session_types.spawn",
     "context": {
      "request": "$r"
     },
     "args": {
      "session_type_id": "dev",
      "target_id": "t1",
      "worktree_id": "$w"
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 2,
     "result": {
      "ok": true,
      "value": {
       "state": "starting",
       "terminal": false,
       "session": {
        "hub_id": "$h",
        "session_id": "$s2"
       }
      }
     },
     "effect": "committed"
    }
   },
   "because": "HP CA-14"
  },
  {
   "control": {
    "op": "await_session",
    "session": {
     "hub_id": "$h",
     "session_id": "$s2"
    },
    "state": "starting"
   },
   "because": "HP CA-21"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 3,
     "call": "worktrees.delete",
     "context": {
      "request": "$r"
     },
     "args": {
      "worktree_id": "$w"
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 3,
     "result": {
      "ok": false,
      "error": {
       "kind": "failed",
       "detail": {
        "reason": "occupied",
        "code": "wrong_state"
       }
      }
     },
     "effect": "none"
    }
   },
   "because": "HP CA-21"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 4,
     "call": "worktrees.list",
     "context": {
      "request": "$r"
     },
     "args": {}
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 4,
     "result": {
      "ok": true,
      "value": {
       "worktrees": [
        {
         "worktree_id": "$w"
        }
       ]
      }
     },
     "effect": "none"
    }
   },
   "because": "HP CA-13"
  },
  {
   "control": {
    "op": "release_spawn"
   },
   "because": "HP CA-21"
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  }
 ]
}

{
 "id": "conf::px_2_command_exit_versus_bridge_exit",
 "contract": "hp",
 "clause": "PX-2",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "invoke",
   "kill_process_bridge"
  ]
 },
 "setup": {
  "given": "op1: the command exits with 1; op2: the process bridge dies before it reports",
  "grants": [
   {
    "surface": "session_actions",
    "scope": "process_run"
   }
  ]
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      },
      {
       "id": "op",
       "kind": "operation",
       "descriptor": {}
      }
     ],
     "operations": {
      "subscribed": "op"
     }
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "invoke",
    "handler": "h1"
   },
   "bind": {
    "t": "/ticket"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "handler": "h1"
    }
   },
   "because": "HP IV-1"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 1,
     "call": "process.run",
     "context": {
      "request": "$r"
     },
     "args": {
      "argv": [
       "sh",
       "-c",
       "exit 1"
      ],
      "timeout_ms": 5000
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 1,
     "result": {
      "ok": true,
      "value": {
       "operation_id": "$op1",
       "kind": "process",
       "state": "queued",
       "terminal": false
      }
     },
     "effect": "committed"
    }
   },
   "because": "HP PX-1"
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$ra",
     "handler": "op",
     "payload": {
      "operation_id": "$op1",
      "kind": "process",
      "state": "done",
      "terminal": true,
      "exit_code": 1
     },
     "origin": "operation"
    }
   },
   "because": "HP PX-2"
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$ra",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  },
  {
   "control": {
    "op": "invoke",
    "handler": "h1"
   },
   "bind": {
    "t2": "/ticket"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$r2",
     "handler": "h1"
    }
   },
   "because": "HP IV-1"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 2,
     "call": "process.run",
     "context": {
      "request": "$r2"
     },
     "args": {
      "argv": [
       "sleep",
       "60"
      ],
      "timeout_ms": 5000
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 2,
     "result": {
      "ok": true,
      "value": {
       "operation_id": "$op2"
      }
     },
     "effect": "committed"
    }
   },
   "because": "HP PX-1"
  },
  {
   "control": {
    "op": "kill_process_bridge",
    "operation_id": "$op2"
   }
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$r2",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$rb",
     "handler": "op",
     "payload": {
      "operation_id": "$op2",
      "kind": "process",
      "state": "failed",
      "terminal": true,
      "effect": "unknown",
      "error": {
       "kind": "failed",
       "detail": {
        "code": "process_bridge_failed"
       }
      }
     },
     "origin": "operation"
    }
   },
   "because": "HP PX-2"
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$rb",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  }
 ]
}

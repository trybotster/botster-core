{
 "id": "conf::mp_1_declaration_fields",
 "contract": "hp",
 "clause": "MP-1",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "admit_manifest"
  ]
 },
 "setup": {
  "given": "a manifest declares a stdio server and an http server with every field of MP-1, and secret placeholders in env and headers",
  "plugins": {
   "demo": {
    "grants": [
     {
      "surface": "mcp",
      "scope": "mcp_proxy"
     },
     {
      "surface": "mcp",
      "scope": "mcp_proxy_stdio"
     },
     {
      "surface": "net",
      "scope": "net",
      "allow": [
       "https://mcp.example"
      ]
     }
    ],
    "mcp_servers": [],
    "entry": "the plugin declares the MCP servers in its manifest (MP-1)"
   }
  }
 },
 "steps": [
  {
   "control": {
    "op": "admit_manifest",
    "file": "botster-plugin.json",
    "content": {
     "botster_plugin_api": 1,
     "name": "demo",
     "version": "1.0.0",
     "entrypoints": {
      "service": {
       "lua": "main.lua"
      }
     },
     "capabilities": [
      {
       "surface": "mcp",
       "scope": "mcp_proxy"
      },
      {
       "surface": "mcp",
       "scope": "mcp_proxy_stdio"
      },
      {
       "surface": "net",
       "scope": "net",
       "allow": [
        "https://mcp.example"
       ]
      }
     ],
     "mcp_servers": [
      {
       "id": "s",
       "transport": "stdio",
       "command": "mcp-server",
       "args": [
        "--x"
       ],
       "env": {
        "K": "{{secret:k}}"
       },
       "allow_tools": [
        "echo"
       ],
       "restart": {
        "max": 2,
        "window": 60000
       }
      },
      {
       "id": "h",
       "transport": "http",
       "url": "https://mcp.example/mcp",
       "headers": {
        "x-api-key": "{{secret:k}}"
       }
      }
     ]
    }
   },
   "expect": {
    "error": {
     "$absent": true
    }
   },
   "because": "HP MP-1"
  }
 ]
}

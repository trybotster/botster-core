{
 "id": "conf::ev_2_each_subscription_names_a_registered_handler",
 "contract": "hp",
 "clause": "EV-2",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "published",
   "status"
  ]
 },
 "setup": {
  "given": "the plugin holds events_hub"
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      },
      {
       "id": "he",
       "kind": "event",
       "descriptor": {}
      },
      {
       "id": "hg",
       "kind": "event_gap",
       "descriptor": {}
      }
     ],
     "events": {
      "subscribed": [
       {
        "handler_id": "ghost",
        "pattern": {
         "owner": "hub",
         "name": "plugin.loaded"
        }
       }
      ],
      "gap_handler": "hg"
     }
    }
   }
  },
  {
   "control": {
    "op": "status"
   },
   "expect": {
    "state": "load_failed"
   },
   "because": "HP EV-2"
  },
  {
   "control": {
    "op": "published"
   },
   "expect": {
    "subscriptions": [],
    "handlers": []
   },
   "because": "HP EV-2"
  }
 ]
}

{
 "id": "conf::mp_13_uncarriable_descriptor_omitted",
 "contract": "hp",
 "clause": "MP-13",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "await_mcp_server",
   "diagnostics",
   "mcp_call",
   "mcp_list",
   "mcp_response",
   "script_mcp"
  ]
 },
 "setup": {
  "given": "steward R-24: a descriptor with a repeated key, or with an integer outside plus or minus (2^53 - 1), cannot be carried losslessly; the server lists one of each beside an ordinary tool",
  "plugins": {
   "demo": {
    "grants": [
     {
      "surface": "mcp",
      "scope": "mcp_proxy"
     },
     {
      "surface": "mcp",
      "scope": "mcp_proxy_stdio"
     },
     {
      "surface": "net",
      "scope": "net",
      "allow": [
       "https://mcp.example"
      ]
     }
    ],
    "mcp_servers": [
     {
      "id": "s",
      "transport": "stdio",
      "command": "mcp-server",
      "args": [
       "--x"
      ],
      "env": {
       "A": "1"
      }
     }
    ],
    "entry": "the plugin declares the MCP servers in its manifest (MP-1)"
   }
  }
 },
 "steps": [
  {
   "control": {
    "op": "script_mcp",
    "plugin": "demo",
    "server": "s",
    "transport": "stdio",
    "tools": [
     {
      "name": "dup",
      "description": "echo tool",
      "inputSchema": {
       "type": "object",
       "properties": {
        "n": {
         "type": "integer"
        }
       }
      },
      "behavior": {
       "kind": "echo"
      },
      "raw_input_schema": "{\"type\":\"object\",\"a\":1,\"a\":2}"
     },
     {
      "name": "big",
      "description": "echo tool",
      "inputSchema": {
       "type": "object",
       "properties": {
        "n": {
         "type": "integer"
        }
       }
      },
      "behavior": {
       "kind": "echo"
      },
      "raw_input_schema": "{\"type\":\"object\",\"maximum\":9007199254740993}"
     },
     {
      "name": "echo",
      "description": "echo tool",
      "inputSchema": {
       "type": "object",
       "properties": {
        "n": {
         "type": "integer"
        }
       }
      },
      "behavior": {
       "kind": "echo"
      }
     }
    ]
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      }
     ]
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "await_mcp_server",
    "plugin": "demo",
    "server": "s",
    "state": "available"
   }
  },
  {
   "control": {
    "op": "mcp_list",
    "kind": "tools",
    "plugin": "demo"
   },
   "expect": {
    "items": [
     {
      "name": "demo__s__echo"
     }
    ]
   },
   "because": "HP MP-13"
  },
  {
   "control": {
    "op": "diagnostics",
    "plugin": "demo"
   },
   "expect": {
    "omitted_tools": [
     {
      "server": "s",
      "tool": "dup",
      "reason": {
       "$type": "string"
      }
     },
     {
      "server": "s",
      "tool": "big",
      "reason": {
       "$type": "string"
      }
     }
    ]
   },
   "because": "HP MP-13"
  },
  {
   "control": {
    "op": "mcp_call",
    "tool": "demo__s__echo",
    "arguments": {
     "n": 1
    }
   },
   "bind": {
    "tk": "/ticket"
   },
   "because": "HP MP-13"
  },
  {
   "control": {
    "op": "mcp_response",
    "ticket": "$tk"
   },
   "expect": {
    "is_error": false
   },
   "because": "HP MP-13"
  }
 ]
}

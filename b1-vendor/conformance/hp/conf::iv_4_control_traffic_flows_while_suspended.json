{
 "id": "conf::iv_4_control_traffic_flows_while_suspended",
 "contract": "hp",
 "clause": "IV-4",
 "subject": "plugin_hub",
 "requires": {
  "controls": [
   "invoke",
   "cancel",
   "hold_commits"
  ]
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      }
     ]
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "hold_commits"
   }
  },
  {
   "control": {
    "op": "invoke",
    "handler": "h1"
   },
   "bind": {
    "t": "/ticket"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "handler": "h1"
    }
   },
   "because": "HP IV-4"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 1,
     "call": "store.put",
     "context": {
      "request": "$r"
     },
     "args": {
      "collection": "c",
      "id": "a",
      "doc": {
       "v": 1
      }
     }
    }
   }
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 2,
     "call": "hub.identity",
     "context": {
      "request": "$r"
     },
     "args": {}
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 2,
     "result": {
      "ok": true
     }
    }
   },
   "because": "HP IV-4"
  },
  {
   "control": {
    "op": "cancel",
    "ticket": "$t"
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Cancel",
    "payload": {
     "epoch": "$e",
     "request_id": "$r"
    }
   },
   "because": "HP IV-4"
  }
 ],
 "setup": {
  "calls": {
   "store.put": [
    {
     "result": {
      "ok": true,
      "value": {
       "revision": "r2"
      }
     },
     "effect": "committed"
    }
   ],
   "hub.identity": [
    {
     "result": {
      "ok": true,
      "value": {
       "hub_id": "hub-1",
       "display_name": "hub"
      }
     }
    }
   ]
  }
 }
}

{
 "id": "conf::pm_4_fetch_uses_the_isolated_io_service",
 "contract": "hp",
 "clause": "PM-4",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "await_catalog",
   "await_package",
   "client_verb",
   "edge_requests",
   "script_catalog",
   "script_git"
  ]
 },
 "setup": {
  "given": "the operator installs from git and refreshes a catalog; the injected edges record which component opened each connection",
  "plugins": {
   "demo": {
    "grants": []
   }
  }
 },
 "steps": [
  {
   "control": {
    "op": "script_git",
    "url": "https://git.example/a.git",
    "refs": {
     "v1": {
      "commit": "1111111111111111111111111111111111111111",
      "files": {
       "botster-plugin.json": {
        "json": {
         "botster_plugin_api": 1,
         "name": "demo",
         "version": "1.0.0",
         "entrypoints": {
          "service": {
           "lua": "main.lua"
          }
         }
        }
       },
       "main.lua": {
        "text": "-- v1.0.0\n"
       }
      }
     }
    }
   }
  },
  {
   "control": {
    "op": "script_catalog",
    "url": "https://catalog.example/k1.json",
    "document": {
     "catalog_version": 1,
     "entries": [
      {
       "id": "e1",
       "kind": "plugin",
       "name": "demo",
       "description": "d",
       "source": {
        "url": "https://git.example/a.git",
        "ref": "v1"
       }
      }
     ]
    }
   }
  },
  {
   "control": {
    "op": "client_verb",
    "kind": "catalog",
    "verb": "create",
    "args": {
     "url": "https://catalog.example/k1.json"
    }
   },
   "expect": {
    "committed": true
   },
   "because": "HP PM-2"
  },
  {
   "control": {
    "op": "await_catalog",
    "catalog": "https://catalog.example/k1.json",
    "settled": true
   }
  },
  {
   "control": {
    "op": "client_verb",
    "kind": "package",
    "verb": "create",
    "args": {
     "source": {
      "kind": "git",
      "url": "https://git.example/a.git",
      "ref": "v1"
     }
    }
   },
   "expect": {
    "accepted": {
     "operation_id": {
      "$type": "string"
     }
    }
   },
   "because": "HP PM-5"
  },
  {
   "control": {
    "op": "await_package",
    "package": "demo",
    "settled": true
   },
   "because": "HP PM-4"
  },
  {
   "control": {
    "op": "edge_requests",
    "edge": "git"
   },
   "expect": {
    "requests": {
     "$array": {
      "each": {
       "via": "io_service"
      },
      "min": 1
     }
    }
   },
   "because": "HP PM-4"
  },
  {
   "control": {
    "op": "edge_requests",
    "edge": "catalog"
   },
   "expect": {
    "requests": {
     "$array": {
      "each": {
       "via": "io_service"
      },
      "min": 1
     }
    }
   },
   "because": "HP PM-4"
  }
 ]
}

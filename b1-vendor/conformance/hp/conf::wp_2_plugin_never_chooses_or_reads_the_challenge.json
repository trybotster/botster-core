{
 "id": "conf::wp_2_plugin_never_chooses_or_reads_the_challenge",
 "contract": "hp",
 "clause": "WP-2",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "invoke",
   "peer_signal"
  ]
 },
 "setup": {
  "given": "the plugin holds relay_signaling and registers the relay handler rl; the Hub mints relay ids; a client is connecting",
  "grants": [
   {
    "surface": "web_origin"
   },
   {
    "surface": "relay",
    "scope": "relay_signaling"
   }
  ]
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      },
      {
       "id": "op",
       "kind": "operation",
       "descriptor": {}
      },
      {
       "id": "he",
       "kind": "event",
       "descriptor": {}
      },
      {
       "id": "hg",
       "kind": "event_gap",
       "descriptor": {}
      },
      {
       "id": "rl",
       "kind": "relay",
       "descriptor": {}
      }
     ],
     "operations": {
      "subscribed": "op"
     },
     "events": {
      "subscribed": [
       {
        "handler_id": "he",
        "pattern": {
         "owner": "net",
         "name": "ws.*"
        }
       }
      ],
      "gap_handler": "hg"
     }
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "invoke",
    "handler": "h1"
   },
   "bind": {
    "t": "/ticket"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "handler": "h1"
    }
   },
   "because": "HP IV-1"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 1,
     "call": "relay.open",
     "context": {
      "request": "$r"
     },
     "args": {}
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 1,
     "result": {
      "ok": true,
      "value": {
       "relay_id": "$r1"
      }
     },
     "effect": "committed"
    }
   },
   "because": "HP WP-2"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 2,
     "call": "relay.open",
     "context": {
      "request": "$r"
     },
     "args": {
      "relay_id": "mine"
     }
    }
   },
   "violates_args": true
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 2,
     "result": {
      "ok": false,
      "error": {
       "kind": "invalid_request"
      }
     },
     "effect": "none"
    }
   },
   "because": "HP WP-2"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 3,
     "call": "relay.deliver",
     "context": {
      "request": "$r"
     },
     "args": {
      "relay_id": "$r1",
      "envelope_b64": "AAEC",
      "connection_id": "c9",
      "challenge": "x"
     }
    }
   },
   "violates_args": true
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 3,
     "result": {
      "ok": false,
      "error": {
       "kind": "invalid_request"
      }
     },
     "effect": "none"
    }
   },
   "because": "HP WP-2"
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  },
  {
   "control": {
    "op": "peer_signal",
    "relay_id": "$r1",
    "envelope_b64": "AAEC"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$rq",
     "handler": "rl",
     "origin": "relay",
     "payload": {
      "relay_id": "$r1",
      "envelope_b64": "AAEC",
      "challenge": {
       "$absent": true
      },
      "connection_id": {
       "$absent": true
      }
     }
    }
   },
   "because": "HP WP-2"
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$rq",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  }
 ]
}

{
 "id": "conf::mp_15_dispatched_call_not_replayed_after_restart",
 "contract": "hp",
 "clause": "MP-15",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "await_mcp_server",
   "mcp_call",
   "mcp_response",
   "mcp_server_event",
   "mcp_server_log",
   "script_mcp"
  ]
 },
 "setup": {
  "given": "a call to the slow tool was sent; the server restarts",
  "plugins": {
   "demo": {
    "grants": [
     {
      "surface": "mcp",
      "scope": "mcp_proxy"
     },
     {
      "surface": "mcp",
      "scope": "mcp_proxy_stdio"
     },
     {
      "surface": "net",
      "scope": "net",
      "allow": [
       "https://mcp.example"
      ]
     }
    ],
    "mcp_servers": [
     {
      "id": "s",
      "transport": "stdio",
      "command": "mcp-server",
      "args": [
       "--x"
      ],
      "env": {
       "A": "1"
      },
      "restart": {
       "max": 2,
       "window": 60000
      }
     }
    ],
    "entry": "the plugin declares the MCP servers in its manifest (MP-1)"
   }
  }
 },
 "steps": [
  {
   "control": {
    "op": "script_mcp",
    "plugin": "demo",
    "server": "s",
    "transport": "stdio",
    "tools": [
     {
      "name": "slow",
      "description": "slow tool",
      "inputSchema": {
       "type": "object"
      },
      "behavior": {
       "kind": "hang"
      }
     }
    ]
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      }
     ]
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "await_mcp_server",
    "plugin": "demo",
    "server": "s",
    "state": "available"
   }
  },
  {
   "control": {
    "op": "mcp_call",
    "tool": "demo__s__slow",
    "arguments": {}
   },
   "bind": {
    "tk": "/ticket"
   },
   "because": "HP MP-15"
  },
  {
   "control": {
    "op": "mcp_server_log",
    "plugin": "demo",
    "server": "s"
   },
   "expect": {
    "calls": [
     {
      "params": {
       "name": "slow"
      }
     }
    ]
   },
   "because": "HP MP-15",
   "bind": {
    "m": "/mark"
   }
  },
  {
   "control": {
    "op": "mcp_server_event",
    "plugin": "demo",
    "server": "s",
    "event": "restart"
   }
  },
  {
   "control": {
    "op": "await_mcp_server",
    "plugin": "demo",
    "server": "s",
    "state": "available"
   }
  },
  {
   "control": {
    "op": "mcp_response",
    "ticket": "$tk"
   },
   "expect": {
    "is_error": true,
    "error": {
     "kind": "failed",
     "detail": {
      "code": "mcp_server_restarted"
     },
     "effect": "unknown"
    }
   },
   "because": "HP MP-15"
  },
  {
   "control": {
    "op": "mcp_server_log",
    "plugin": "demo",
    "server": "s"
   },
   "expect": {
    "calls_all_instances": [
     {
      "params": {
       "name": "slow"
      }
     }
    ]
   },
   "because": "HP MP-15"
  }
 ]
}

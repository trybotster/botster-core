{
 "id": "conf::nt_4_close_is_typed_high_priority",
 "contract": "hp",
 "clause": "NT-4",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "await_operation",
   "invoke",
   "net_close",
   "net_world"
  ]
 },
 "setup": {
  "given": "the plugin holds net with allow [https://ws.example] and subscribes to net/ws.* with the gap handler hg; the outside world accepts the WebSocket wss://ws.example/s; the plugin also holds the allow entry https://ws2.example, which accepts a WebSocket",
  "grants": [
   {
    "surface": "net",
    "scope": "net",
    "allow": [
     "https://ws.example",
     "https://ws2.example"
    ]
   }
  ]
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      },
      {
       "id": "op",
       "kind": "operation",
       "descriptor": {}
      },
      {
       "id": "he",
       "kind": "event",
       "descriptor": {}
      },
      {
       "id": "hg",
       "kind": "event_gap",
       "descriptor": {}
      }
     ],
     "operations": {
      "subscribed": "op"
     },
     "events": {
      "subscribed": [
       {
        "handler_id": "he",
        "pattern": {
         "owner": "net",
         "name": "ws.*"
        }
       }
      ],
      "gap_handler": "hg"
     }
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "invoke",
    "handler": "h1"
   },
   "bind": {
    "t": "/ticket"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "handler": "h1"
    }
   },
   "because": "HP IV-1"
  },
  {
   "control": {
    "op": "net_world",
    "endpoints": [
     {
      "origin": "https://ws.example",
      "addresses": [
       "203.0.113.20"
      ],
      "ws": {
       "accept": true
      }
     },
     {
      "origin": "https://ws2.example",
      "addresses": [
       "203.0.113.23"
      ],
      "ws": {
       "accept": true
      }
     }
    ]
   }
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 1,
     "call": "ws.open",
     "context": {
      "request": "$r"
     },
     "args": {
      "url": "wss://ws.example/s"
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 1,
     "result": {
      "ok": true,
      "value": {
       "operation_id": "$op12",
       "kind": "ws",
       "state": "queued",
       "terminal": false
      }
     },
     "effect": "committed"
    }
   },
   "because": "HP NT-4"
  },
  {
   "control": {
    "op": "await_operation",
    "operation_id": "$op12",
    "terminal": true
   }
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 2,
     "call": "operations.get",
     "context": {
      "request": "$r"
     },
     "args": {
      "operation_id": "$op12"
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 2,
     "result": {
      "ok": true,
      "value": {
       "operation_id": "$op12",
       "kind": "ws",
       "state": "open",
       "terminal": true,
       "ws_id": "$w"
      }
     },
     "effect": "none"
    }
   },
   "because": "HP NT-4"
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 3,
     "call": "ws.open",
     "context": {
      "request": "$r"
     },
     "args": {
      "url": "wss://ws2.example/s"
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 3,
     "result": {
      "ok": true,
      "value": {
       "operation_id": "$op13",
       "kind": "ws",
       "state": "queued",
       "terminal": false
      }
     },
     "effect": "committed"
    }
   },
   "because": "HP NT-4"
  },
  {
   "control": {
    "op": "await_operation",
    "operation_id": "$op13",
    "terminal": true
   }
  },
  {
   "send_frame": {
    "lane": "call",
    "type": "HostCall",
    "payload": {
     "$ref": "host_call",
     "epoch": "$e",
     "call_id": 4,
     "call": "operations.get",
     "context": {
      "request": "$r"
     },
     "args": {
      "operation_id": "$op13"
     }
    }
   }
  },
  {
   "expect": {
    "lane": "call",
    "type": "HostResult",
    "payload": {
     "epoch": "$e",
     "call_id": 4,
     "result": {
      "ok": true,
      "value": {
       "operation_id": "$op13",
       "kind": "ws",
       "state": "open",
       "terminal": true,
       "ws_id": "$w2"
      }
     },
     "effect": "none"
    }
   },
   "because": "HP NT-4"
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  },
  {
   "control": {
    "op": "net_close",
    "origin": "https://ws.example",
    "code": 1000,
    "reason": "bye"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$c1",
     "handler": "he",
     "origin": "event",
     "payload": {
      "owner": "net",
      "name": "ws.close",
      "priority": "high",
      "payload": {
       "ws_id": "$w",
       "code": 1000,
       "reason": "bye"
      }
     }
    }
   },
   "because": "HP NT-4"
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$c1",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  },
  {
   "control": {
    "op": "net_close",
    "origin": "https://ws2.example",
    "drop": true
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$c2",
     "handler": "he",
     "origin": "event",
     "payload": {
      "owner": "net",
      "name": "ws.close",
      "priority": "high",
      "payload": {
       "ws_id": "$w2",
       "error": {
        "$one_of": [
         "net_denied",
         "net_dns",
         "net_connect",
         "net_tls",
         "net_timeout",
         "net_too_large",
         "net_cancelled"
        ]
       }
      }
     }
    }
   },
   "because": "HP NT-4"
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$c2",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  }
 ]
}

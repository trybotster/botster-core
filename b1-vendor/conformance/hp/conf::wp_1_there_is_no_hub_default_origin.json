{
 "id": "conf::wp_1_there_is_no_hub_default_origin",
 "contract": "hp",
 "clause": "WP-1",
 "subject": "plugin_hub",
 "fake": "structural",
 "ruling": "R-1.3",
 "requires": {
  "controls": [
   "client_invoke",
   "invoke"
  ]
 },
 "setup": {
  "given": "no plugin has set a web origin; an operator client is connected",
  "grants": [
   {
    "surface": "web_origin"
   }
  ]
 },
 "steps": [
  {
   "expect": {
    "lane": "control",
    "type": "Hello",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-1"
  },
  {
   "send_frame": {
    "lane": "control",
    "type": "Ready",
    "payload": {
     "$ref": "ready",
     "epoch": "$e",
     "handlers": [
      {
       "id": "h1",
       "kind": "mcp_tool",
       "descriptor": {}
      },
      {
       "id": "op",
       "kind": "operation",
       "descriptor": {}
      },
      {
       "id": "he",
       "kind": "event",
       "descriptor": {}
      },
      {
       "id": "hg",
       "kind": "event_gap",
       "descriptor": {}
      },
      {
       "id": "rl",
       "kind": "relay",
       "descriptor": {}
      }
     ],
     "operations": {
      "subscribed": "op"
     },
     "events": {
      "subscribed": [
       {
        "handler_id": "he",
        "pattern": {
         "owner": "net",
         "name": "ws.*"
        }
       }
      ],
      "gap_handler": "hg"
     }
    }
   }
  },
  {
   "expect": {
    "lane": "control",
    "type": "Activated",
    "payload": {
     "epoch": "$e"
    }
   },
   "because": "HP HS-2"
  },
  {
   "control": {
    "op": "invoke",
    "handler": "h1"
   },
   "bind": {
    "t": "/ticket"
   }
  },
  {
   "expect": {
    "lane": "invoke",
    "type": "Invoke",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "handler": "h1"
    }
   },
   "because": "HP IV-1"
  },
  {
   "control": {
    "op": "client_invoke",
    "kind": "hub",
    "verb": "issue_pairing",
    "args": {}
   },
   "expect": {
    "ok": false,
    "error": {
     "kind": "wrong_state",
     "detail": {
      "$one_of": [
       {
        "reason": "no_web_origin"
       },
       {
        "code": "no_web_origin"
       }
      ]
     }
    }
   },
   "because": "HP WP-1"
  },
  {
   "send_frame": {
    "lane": "invoke",
    "type": "Result",
    "payload": {
     "epoch": "$e",
     "request_id": "$r",
     "result": {
      "ok": true,
      "value": {}
     }
    }
   }
  }
 ]
}

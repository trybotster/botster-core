    "main.lua": "botster.events.on({ owner = \"hub\", name = \"config.changed\" }, function(record, request)\n  return { keys = #record.payload.keys, restart_required = record.payload.restart_required }\nend)\nbotster.events.on({ owner = \"hub\", name = \"package.configuration_changed\" }, function(record, request)\n  local uses = false\n  for _, n in ipairs(record.payload.names) do if n == \"token\" then uses = true end end\n  local re\n  if uses then re = botster.config.get{} end\n  return { plugin_key = record.payload.plugin_key, reread = re ~= nil, token = re and re.value.values.token }\nend)\nbotster.register{ tools = {} }\n"
   }
  }
 },

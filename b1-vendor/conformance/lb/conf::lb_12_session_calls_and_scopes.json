    "main.lua": "botster.register{\n  handlers = {{ kind = \"mcp_tool\", id = \"h_t\", name = \"t\", description = \"d\", input_schema = { type = \"object\" },\n    call = function(payload, request)\n\n      local s = { hub_id = \"hub-1\", session_id = \"s1\" }\n      local c = botster.sessions.create_command{ argv = { \"ls\", \"-l\" } }\n      local ts = botster.sessions.terminal_state{ session = s }\n      local rc = botster.sessions.read_cursor{ session = s }\n      local rs = botster.sessions.read_screen{ session = s }\n      local st = botster.sessions.stop{ session = s }\n      local de = botster.sessions.delete{ session = s }\n      local up = botster.sessions.update{ session = s, label = \"new\" }\n      local re = botster.sessions.restart{ session = s }\n      return { create_state = c.value.state, create_terminal = c.value.terminal, create_session = c.value.session.session_id,\n               screen_text = rs.value.text, cursor_row = rc.value.cursor.row, stop_decision = st.value.decision,\n               all_ok = c.ok and ts.ok and rc.ok and rs.ok and st.ok and de.ok and up.ok and re.ok }\n    end }},\n}\n"
   }
  }
 },

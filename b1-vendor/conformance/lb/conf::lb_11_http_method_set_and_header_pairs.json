    "main.lua": "botster.register{\n  handlers = {\n    { kind = \"mcp_tool\", id = \"h_t\", name = \"t\", description = \"d\", input_schema = { type = \"object\" }, call = function(payload, request)\n\n      local out = {}\n      for _, m in ipairs({ \"GET\", \"HEAD\", \"POST\", \"PUT\", \"PATCH\", \"DELETE\", \"OPTIONS\" }) do\n        local r = botster.http.request{ method = m, url = \"https://example.test/\", timeout_ms = 1000 }\n        out[#out + 1] = r.ok\n      end\n      local pairs_call = botster.http.request{ method = \"POST\", url = \"https://example.test/p\", timeout_ms = 1000,\n        headers = { { \"A\", \"1\" }, { \"B\", \"2\" }, { \"A\", \"3\" } }, body_b64 = \"aGk=\" }\n      return { all_methods_ok = #out == 7, pairs_ok = pairs_call.ok }\n    end },\n    { kind = \"mcp_tool\", id = \"h_u\", name = \"u\", description = \"d\", input_schema = { type = \"object\" }, call = function(payload, request)\n\n      local bad = botster.http.request{ method = \"TRACE\", url = \"https://example.test/\", timeout_ms = 1000 }\n      return { ok = bad.ok, kind = bad.error and bad.error.kind, effect = bad.error and bad.error.effect }\n    end },\n  },\n}\n"
   }
  }

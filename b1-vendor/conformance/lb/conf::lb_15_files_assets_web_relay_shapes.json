    "main.lua": "botster.relay.on(function(p, request) return { got = p.relay_id } end)\nbotster.register{\n  handlers = {\n    { kind = \"mcp_tool\", id = \"h_t\", name = \"t\", description = \"d\", input_schema = { type = \"object\" }, call = function(payload, request)\n\n      local r = botster.fs.read{ root = \"docs\", path = \"a.txt\" }\n      local p = botster.assets.publish{ name = \"page\", content_type = \"text/html\", bytes_b64 = \"PGI+\" }\n      local l = botster.assets.lookup{ name = \"page\" }\n      local c = botster.web.set_origin{ origin = botster.json.null }\n      local s = botster.web.set_origin{ origin = { served = true } }\n      local o = botster.relay.open{}\n      local d = botster.relay.deliver{ relay_id = o.value.relay_id, envelope_b64 = \"e30=\" }\n      return { bytes = r.value.bytes_b64, eof = r.value.eof, asset = p.value.asset_id, lookup_type = l.value.content_type,\n               cleared = c.ok, served = s.ok,\n               relay = o.value.relay_id, delivered = d.value.status }\n    end },\n    { kind = \"mcp_tool\", id = \"h_u\", name = \"u\", description = \"d\", input_schema = { type = \"object\" }, call = function(payload, request)\n\n      local n = botster.web.set_origin{}\n      return { ok = n.ok, kind = n.error and n.error.kind, effect = n.error and n.error.effect }\n    end },\n  },\n}\n"
   }
